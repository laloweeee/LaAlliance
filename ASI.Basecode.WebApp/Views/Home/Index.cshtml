@{
    ViewData["Title"] = "La Alliance";
}

<main class="min-h-screen">
    <!-- Hero Section -->
    <div class="relative py-20 overflow-hidden" style="background: url('https://i.pinimg.com/1200x/90/1e/0e/901e0e2c5062a2f3d95cb276b6c404d3.jpg') center center / cover no-repeat;">
        <!-- Overlay tint -->
        <div class="absolute inset-0 bg-gray-900 bg-opacity-40"></div>
        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center gap-16">
            <!-- Hero Text -->
            <div class="flex-1 hero-text">
                <h1 class="text-5xl lg:text-6xl font-extrabold text-white mb-6 leading-tight drop-shadow-lg">
                    Good Food For Good Health
                </h1>
                <p class="text-lg text-gray-100 mb-8 max-w-lg drop-shadow">
                    Enjoy a curated menu from top chefs and restaurants. FastFood delivers fresh, delicious meals to your door, every time. Experience healthy, chef-crafted meals with fast delivery and premium service.
                </p>
                <div class="flex gap-4 mb-10">
                    
                </div>
                <div class="grid grid-cols-2 gap-6 mt-6 max-w-md">
                    <div class="bg-gray-50 border border-gray-200 rounded-xl p-5 flex items-center gap-4">
                        <div class="bg-green-100 rounded-full p-3">
                            <i class="fas fa-shipping-fast text-green-600 text-2xl"></i>
                        </div>
                        <div>
                            <div class="font-semibold text-gray-800">Fast Delivery</div>
                            <div class="text-sm text-gray-500">Delivery within 30 minutes</div>
                        </div>
                    </div>
                    <div class="bg-gray-50 border border-gray-200 rounded-xl p-5 flex items-center gap-4">
                        <div class="bg-green-100 rounded-full p-3">
                            <i class="fas fa-utensils text-green-600 text-2xl"></i>
                        </div>
                        <div>
                            <div class="font-semibold text-gray-800">Dine In</div>
                            <div class="text-sm text-gray-500">Enjoy fresh food, crispy and hot</div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Hero Slideshow (square image) -->
            <div class="flex-1 flex items-center justify-center relative">
                <div class="relative w-full max-w-lg h-[400px] bg-gray-200 rounded-2xl shadow-2xl overflow-hidden flex items-center justify-center">
                    <div id="heroSlideshow" class="w-full h-full relative">
                        <img src="https://i.pinimg.com/1200x/fc/47/0d/fc470d4314244058317c663b74ede79b.jpg" alt="Healthy Food" class="object-cover w-full h-full rounded-2xl absolute inset-0 transition-opacity duration-700 opacity-100" />
                        <img src="https://i.pinimg.com/736x/d8/a6/ed/d8a6ed154ed3484e1373e46f58a45f8e.jpg" alt="Fresh Ingredients" class="object-cover w-full h-full rounded-2xl absolute inset-0 transition-opacity duration-700 opacity-0" />
                        <img src="https://i.pinimg.com/1200x/68/81/d7/6881d79053c11639a8f9b31006fb68db.jpg" alt="Team" class="object-cover w-full h-full rounded-2xl absolute inset-0 transition-opacity duration-700 opacity-0" />
                    </div>
                    <!-- Slideshow Controls -->
                    <button id="prevSlide" class="absolute left-4 top-1/2 transform -translate-y-1/2 bg-white bg-opacity-70 rounded-full p-2 shadow hover:bg-opacity-100 transition">
                        <i class="fas fa-chevron-left text-green-700"></i>
                    </button>
                    <button id="nextSlide" class="absolute right-4 top-1/2 transform -translate-y-1/2 bg-white bg-opacity-70 rounded-full p-2 shadow hover:bg-opacity-100 transition">
                        <i class="fas fa-chevron-right text-green-700"></i>
                    </button>
                    <!-- Slide Indicators -->
                    <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 flex gap-2">
                        <span class="w-3 h-3 rounded-full bg-green-500 opacity-80" id="slideDot0"></span>
                        <span class="w-3 h-3 rounded-full bg-white opacity-60" id="slideDot1"></span>
                        <span class="w-3 h-3 rounded-full bg-white opacity-60" id="slideDot2"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gallery Section -->
    <div class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold text-center mb-10 text-gray-800">Gallery</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-gray-100 rounded-xl overflow-hidden shadow-md card-hover">
                    <div class="h-56 bg-gray-300 flex items-center justify-center">
                        <img src="https://i.pinimg.com/736x/1c/07/57/1c0757023c244aacef3a10699b0dc803.jpg" alt="Signature Pizza" class="object-cover w-full h-full" />
                    </div>
                    <div class="p-4">
                        <h3 class="font-semibold text-lg mb-2">Signature Pizza</h3>
                        <p class="text-gray-600 text-sm">Our best-selling Margherita and Pepperoni pizzas, made fresh daily.</p>
                    </div>
                </div>
                <div class="bg-gray-100 rounded-xl overflow-hidden shadow-md card-hover">
                    <div class="h-56 bg-gray-300 flex items-center justify-center">
                        <img src="https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=400&q=80" alt="Gourmet Burgers" class="object-cover w-full h-full" />
                    </div>
                    <div class="p-4">
                        <h3 class="font-semibold text-lg mb-2">Gourmet Burgers</h3>
                        <p class="text-gray-600 text-sm">Juicy burgers with premium ingredients and customizable options.</p>
                    </div>
                </div>
                <div class="bg-gray-100 rounded-xl overflow-hidden shadow-md card-hover">
                    <div class="h-56 bg-gray-300 flex items-center justify-center">
                        <img src="https://i.pinimg.com/1200x/49/8a/74/498a749dfbab1dc58fa76c7f1eeb3af5.jpg" alt="Desserts & Treats" class="object-cover w-full h-full" />
                    </div>
                    <div class="p-4">
                        <h3 class="font-semibold text-lg mb-2">Desserts & Treats</h3>
                        <p class="text-gray-600 text-sm">Indulge in our decadent cakes, tiramisu, and more sweet delights.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- About Us Section -->
    <div class="py-20 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row items-center gap-12">
                <!-- About Text -->
                <div class="flex-1">
                    <span class="block text-sm text-gray-500 mb-2">Discover the FastFood difference.</span>
                    <h2 class="text-4xl font-extrabold mb-6 text-gray-900 leading-tight">
                        FastFood: Premium Food Delivery, Every Time
                    </h2>
                    <p class="text-lg text-gray-700 mb-8 leading-relaxed">
                        FastFood is your trusted partner for premium food delivery. We combine technology and culinary expertise to bring you the best dishes from top restaurants, delivered quickly and reliably. Our mission is to make healthy, delicious food accessible to everyone, every day.
                    </p>
                    <button class="bg-white border border-green-600 text-green-700 px-6 py-3 rounded-lg font-semibold hover:bg-green-50 transition-all shadow">
                        Learn More
                    </button>
                </div>
                <!-- About Image -->
                <div class="flex-1 flex items-center justify-center">
                    <div class="w-full h-[400px] bg-gray-200 rounded-2xl shadow-lg overflow-hidden flex items-center justify-center">
                        <img src="https://i.pinimg.com/1200x/be/f6/d9/bef6d97ab4f7b3166f8f46c03ab8ab18.jpg" alt="FastFood Team" class="object-cover w-full h-full rounded-2xl" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Latest Updates Section -->
    <div class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold text-center mb-12 text-gray-800">Latest Updates</h2>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="bg-white rounded-xl shadow-sm card-hover overflow-hidden">
                    <div class="h-48 bg-gray-200 flex items-center justify-center">
                        <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=400&q=80" alt="Mobile App" class="object-cover w-full h-full" />
                    </div>
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-3">New Mobile App</h3>
                        <p class="text-gray-600 mb-4">Download our new mobile app for faster ordering and exclusive mobile-only deals.</p>
                        <button class="text-blue-600 font-medium hover:text-blue-700">Learn More →</button>
                    </div>
                </div>
                <div class="bg-white rounded-xl shadow-sm card-hover overflow-hidden">
                    <div class="h-48 bg-gray-200 flex items-center justify-center">
                        <img src="https://i.pinimg.com/736x/ac/e1/d2/ace1d24106f90942abd7f24bc1fab715.jpg" alt="Eco Packaging" class="object-cover w-full h-full" />
                    </div>
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-3">Eco-Friendly Packaging</h3>
                        <p class="text-gray-600 mb-4">We've switched to 100% biodegradable packaging to help protect our environment.</p>
                        <button class="text-green-600 font-medium hover:text-green-700">Read More →</button>
                    </div>
                </div>
                <div class="bg-white rounded-xl shadow-sm card-hover overflow-hidden">
                    <div class="h-48 bg-gray-200 flex items-center justify-center">
                        <img src="https://i.pinimg.com/1200x/37/70/8a/37708a07e91d2aad20b1a8f885ea393b.jpg" alt="Loyalty Program" class="object-cover w-full h-full" />
                    </div>
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-3">Loyalty Program</h3>
                        <p class="text-gray-600 mb-4">Earn points with every order and unlock exclusive rewards and discounts.</p>
                        <button class="text-orange-600 font-medium hover:text-orange-700">Join Now →</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- App Download CTA -->
    <div class="py-16 bg-gradient-to-r from-green-500 to-green-600 text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-3xl font-bold mb-6">Get the FastFood App</h2>
            <p class="text-xl mb-8 opacity-90">Download our app for exclusive deals and faster ordering</p>
            <div class="flex justify-center space-x-4">
                <button class="bg-white text-green-600 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors flex items-center">
                    <i class="fab fa-apple text-2xl mr-2"></i>
                    App Store
                </button>
                <button class="bg-white text-green-600 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors flex items-center">
                    <i class="fab fa-google-play text-2xl mr-2"></i>
                    Google Play
                </button>
            </div>
        </div>
    </div>
</main>

