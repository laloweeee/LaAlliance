@{
    ViewData["Title"] = "La Alliance";
}

<!-- Hero Section -->
<section class="py-5 position-relative text-white" style="background:url('https://i.pinimg.com/1200x/90/1e/0e/901e0e2c5062a2f3d95cb276b6c404d3.jpg') center/cover no-repeat;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background:rgba(17,24,39,.4)"></div>
    <div class="container position-relative py-5">
        <div class="row align-items-center gy-4">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4">Good Food For Good Health</h1>
                <p class="lead mb-4">Enjoy a curated menu from top chefs and restaurants. FastFood delivers fresh, delicious meals to your door, every time. Experience healthy, chef-crafted meals with fast delivery and premium service.</p>
                <div class="d-flex flex-wrap gap-3 mb-5">
                    <a class="btn btn-success btn-lg px-4 py-3 fw-semibold shadow" asp-page="/Menu/Index">Order Now</a>
                    <button class="btn btn-outline-light btn-lg px-4 py-3 fw-semibold shadow">Book Now</button>
                </div>
                <!-- Feature chips -->
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center p-4 bg-light bg-opacity-90 rounded-3 border">
                            <div class="rounded-circle p-3 bg-success bg-opacity-10 me-3">
                                <i class="fas fa-shipping-fast text-success fs-4"></i>
                            </div>
                            <div>
                                <div class="fw-semibold text-dark">Fast Delivery</div>
                                <small class="text-muted">Delivery within 30 minutes</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center p-4 bg-light bg-opacity-90 rounded-3 border">
                            <div class="rounded-circle p-3 bg-success bg-opacity-10 me-3">
                                <i class="fas fa-utensils text-success fs-4"></i>
                            </div>
                            <div>
                                <div class="fw-semibold text-dark">Dine In</div>
                                <small class="text-muted">Enjoy fresh food, crispy and hot</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Hero Slideshow -->
            <div class="col-lg-6">
                <div class="position-relative">
                    <div id="heroSlideshow" class="carousel slide rounded-4 shadow-lg overflow-hidden" data-bs-ride="carousel">
                        <div class="carousel-inner ratio ratio-1x1">
                            <div class="carousel-item active">
                                <img src="https://i.pinimg.com/1200x/fc/47/0d/fc470d4314244058317c663b74ede79b.jpg" class="d-block w-100 h-100 object-fit-cover" alt="Healthy Food">
                            </div>
                            <div class="carousel-item">
                                <img src="https://i.pinimg.com/736x/d8/a6/ed/d8a6ed154ed3484e1373e46f58a45f8e.jpg" class="d-block w-100 h-100 object-fit-cover" alt="Fresh Ingredients">
                            </div>
                            <div class="carousel-item">
                                <img src="https://i.pinimg.com/1200x/68/81/d7/6881d79053c11639a8f9b31006fb68db.jpg" class="d-block w-100 h-100 object-fit-cover" alt="Team">
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#heroSlideshow" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon bg-white bg-opacity-70 rounded-circle p-2" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#heroSlideshow" data-bs-slide="next">
                            <span class="carousel-control-next-icon bg-white bg-opacity-70 rounded-circle p-2" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                        <div class="carousel-indicators position-absolute bottom-0 mb-3">
                            <button type="button" data-bs-target="#heroSlideshow" data-bs-slide-to="0" class="active bg-success opacity-75" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#heroSlideshow" data-bs-slide-to="1" class="bg-white opacity-50" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#heroSlideshow" data-bs-slide-to="2" class="bg-white opacity-50" aria-label="Slide 3"></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Gallery Section -->
<section class="py-5 bg-white">
    <div class="container">
        <h2 class="fw-bold text-center mb-5">Gallery</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 card-hover overflow-hidden">
                    <div class="overflow-hidden" style="height: 250px;">
                        <img src="https://i.pinimg.com/736x/1c/07/57/1c0757023c244aacef3a10699b0dc803.jpg" class="card-img-top w-100 h-100 object-fit-cover" alt="Signature Pizza">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title fw-semibold">Signature Pizza</h5>
                        <p class="card-text text-muted">Our best-selling Margherita and Pepperoni pizzas, made fresh daily.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 card-hover overflow-hidden">
                    <div class="overflow-hidden" style="height: 250px;">
                        <img src="https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=400&q=80" class="card-img-top w-100 h-100 object-fit-cover" alt="Gourmet Burgers">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title fw-semibold">Gourmet Burgers</h5>
                        <p class="card-text text-muted">Juicy burgers with premium ingredients and customizable options.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 card-hover overflow-hidden">
                    <div class="overflow-hidden" style="height: 250px;">
                        <img src="https://i.pinimg.com/1200x/49/8a/74/498a749dfbab1dc58fa76c7f1eeb3af5.jpg" class="card-img-top w-100 h-100 object-fit-cover" alt="Desserts & Treats">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title fw-semibold">Desserts & Treats</h5>
                        <p class="card-text text-muted">Indulge in our decadent cakes, tiramisu, and more sweet delights.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Us Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="text-muted small mb-2 d-block">Discover the FastFood difference.</span>
                <h2 class="display-5 fw-bold mb-4">FastFood: Premium Food Delivery, Every Time</h2>
                <p class="lead text-muted mb-4">FastFood is your trusted partner for premium food delivery. We combine technology and culinary expertise to bring you the best dishes from top restaurants, delivered quickly and reliably. Our mission is to make healthy, delicious food accessible to everyone, every day.</p>
                <button class="btn btn-outline-success btn-lg px-4 py-3 fw-semibold shadow">Learn More</button>
            </div>
            <div class="col-lg-6">
                <div class="rounded-4 shadow-lg overflow-hidden">
                    <img src="https://i.pinimg.com/1200x/be/f6/d9/bef6d97ab4f7b3166f8f46c03ab8ab18.jpg" class="img-fluid w-100 object-fit-cover" alt="FastFood Team" style="height: 450px;">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Latest Updates Section -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="fw-bold text-center mb-5">Latest Updates</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 card-hover overflow-hidden">
                    <div class="overflow-hidden" style="height: 200px;">
                        <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=400&q=80" class="card-img-top w-100 h-100 object-fit-cover" alt="Mobile App">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title fw-semibold">New Mobile App</h5>
                        <p class="card-text text-muted mb-3">Download our new mobile app for faster ordering and exclusive mobile-only deals.</p>
                        <a href="#" class="text-primary text-decoration-none fw-semibold">Learn More →</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 card-hover overflow-hidden">
                    <div class="overflow-hidden" style="height: 200px;">
                        <img src="https://i.pinimg.com/736x/ac/e1/d2/ace1d24106f90942abd7f24bc1fab715.jpg" class="card-img-top w-100 h-100 object-fit-cover" alt="Eco Packaging">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title fw-semibold">Eco-Friendly Packaging</h5>
                        <p class="card-text text-muted mb-3">We've switched to 100% biodegradable packaging to help protect our environment.</p>
                        <a href="#" class="text-success text-decoration-none fw-semibold">Read More →</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 card-hover overflow-hidden">
                    <div class="overflow-hidden" style="height: 200px;">
                        <img src="https://i.pinimg.com/1200x/37/70/8a/37708a07e91d2aad20b1a8f885ea393b.jpg" class="card-img-top w-100 h-100 object-fit-cover" alt="Loyalty Program">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title fw-semibold">Loyalty Program</h5>
                        <p class="card-text text-muted mb-3">Earn points with every order and unlock exclusive rewards and discounts.</p>
                        <a href="#" class="text-warning text-decoration-none fw-semibold">Join Now →</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- App Download CTA -->
<section class="py-5 text-white" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
    <div class="container text-center">
        <h2 class="fw-bold mb-4">Get the FastFood App</h2>
        <p class="lead mb-4 opacity-90">Download our app for exclusive deals and faster ordering</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <button class="btn btn-light text-success px-4 py-3 fw-semibold d-flex align-items-center">
                <i class="fab fa-apple fs-4 me-2"></i>
                App Store
            </button>
            <button class="btn btn-light text-success px-4 py-3 fw-semibold d-flex align-items-center">
                <i class="fab fa-google-play fs-4 me-2"></i>
                Google Play
            </button>
        </div>
    </div>
</section>

<style>
    .card-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

    .object-fit-cover {
        object-fit: cover;
    }
</style>
