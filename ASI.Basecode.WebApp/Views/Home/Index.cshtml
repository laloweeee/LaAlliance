@{
    ViewData["Title"] = "LaAlliancé";
}

<style>
    /* Custom animations and improvements */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes scaleIn {
        from {
            opacity: 0;
            transform: scale(0.9);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
    }

    .animate-fade-in {
        animation: fadeIn 1s ease-out forwards;
    }

    .animate-scale-in {
        animation: scaleIn 0.6s ease-out forwards;
    }

    .card-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .card-hover:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    }

    .feature-card {
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .feature-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    .hero-overlay {
        background: linear-gradient(135deg, rgba(0, 0, 0, 0.5), rgba(16, 185, 129, 0.3));
    }

    .slideshow-img {
        transition: opacity 700ms ease-in-out;
    }

    /* Responsive improvements */
    @@media (max-width: 768px) {
        .hero-text h1 {
            font-size: 2.5rem !important;
        }
        
        .feature-grid {
            grid-template-columns: 1fr !important;
        }
    }

    @@media (max-width: 640px) {
        .hero-text h1 {
            font-size: 2rem !important;
        }
        
        .hero-slideshow-container {
            height: 300px !important;
        }
    }

    /* Smooth scroll */
    html {
        scroll-behavior: smooth;
    }

    /* Image loading optimization */
    img {
        image-rendering: -webkit-optimize-contrast;
        image-rendering: crisp-edges;
    }
</style>

<main class="min-h-screen">
    <!-- Hero Section -->
    <div class="relative py-16 md:py-24 lg:py-32 overflow-hidden" 
         style="background-image: url('https://i.pinimg.com/1200x/90/1e/0e/901e0e2c5062a2f3d95cb276b6c404d3.jpg'); 
                background-position: center center; 
                background-size: cover; 
                background-repeat: no-repeat;
                background-attachment: fixed;">
        <!-- Enhanced Overlay -->
        <div class="absolute inset-0 hero-overlay"></div>
        
        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center gap-8 lg:gap-16">
            <!-- Hero Text -->
            <div class="flex-1 hero-text animate-fade-in-up text-center lg:text-left">
                <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold text-white mb-4 lg:mb-6 leading-tight drop-shadow-2xl">
                    Good Food For Good Health
                </h1>
                <p class="text-base sm:text-lg lg:text-xl text-gray-100 mb-6 lg:mb-8 max-w-2xl mx-auto lg:mx-0 drop-shadow-lg leading-relaxed">
                    Enjoy a curated menu from top chefs and restaurants. LaAlliancé delivers fresh, delicious meals to your door, every time. Experience healthy, chef-crafted meals with fast delivery and premium service.
                </p>
                
                <!-- Feature Cards Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6 mt-6 lg:mt-8 max-w-2xl mx-auto lg:mx-0">
                    <div class="bg-white/95 backdrop-blur-sm border border-gray-200 rounded-xl p-4 lg:p-5 flex items-center gap-3 lg:gap-4 feature-card animate-scale-in" style="animation-delay: 0.2s;">
                        <div class="bg-gradient-to-br from-green-400 to-green-600 rounded-full p-3 flex-shrink-0">
                            <i class="fas fa-shipping-fast text-white text-xl lg:text-2xl"></i>
                        </div>
                        <div class="text-left">
                            <div class="font-bold text-gray-800 text-base lg:text-lg">Fast Delivery</div>
                            <div class="text-xs lg:text-sm text-gray-600">Delivery within 30 minutes</div>
                        </div>
                    </div>
                    
                    <div class="bg-white/95 backdrop-blur-sm border border-gray-200 rounded-xl p-4 lg:p-5 flex items-center gap-3 lg:gap-4 feature-card animate-scale-in" style="animation-delay: 0.4s;">
                        <div class="bg-gradient-to-br from-green-400 to-green-600 rounded-full p-3 flex-shrink-0">
                            <i class="fas fa-utensils text-white text-xl lg:text-2xl"></i>
                        </div>
                        <div class="text-left">
                            <div class="font-bold text-gray-800 text-base lg:text-lg">Dine In</div>
                            <div class="text-xs lg:text-sm text-gray-600">Enjoy fresh food, crispy and hot</div>
                        </div>
                    </div>
                </div>
                
                <!-- Address Input with GPS -->
                <div class="mt-8 lg:mt-10">
                    <div class="bg-white/95 backdrop-blur-sm rounded-2xl p-4 lg:p-6 shadow-2xl max-w-2xl mx-auto lg:mx-0">
                        <label class="block text-sm font-semibold text-gray-700 mb-3">
                            <i class="fas fa-map-marker-alt text-green-600 mr-2"></i>
                            Enter Your Delivery Address
                        </label>
                        <div class="flex flex-col sm:flex-row gap-3">
                            <div class="flex-1 relative">
                                <input type="text" 
                                       id="deliveryAddress" 
                                       placeholder="Enter your street address, city..." 
                                       class="w-full px-4 py-3 pr-12 border-2 border-gray-300 rounded-xl focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-200 transition-all text-gray-800 placeholder-gray-400"
                                       aria-label="Delivery address">
                                <button type="button" 
                                        id="detectLocationBtn"
                                        class="absolute right-2 top-1/2 transform -translate-y-1/2 bg-green-100 hover:bg-green-200 text-green-700 p-2 rounded-lg transition-all duration-300 hover:scale-110"
                                        title="Detect my location"
                                        aria-label="Detect my location">
                                    <i class="fas fa-location-crosshairs text-lg"></i>
                                </button>
                            </div>
                            <button type="button" 
                                    id="findFoodBtn"
                                    class="bg-gradient-to-r from-green-500 to-green-600 text-white font-bold px-6 sm:px-8 py-3 rounded-xl hover:from-green-600 hover:to-green-700 transform hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-xl whitespace-nowrap">
                                Find Food
                                <i class="fas fa-search ml-2"></i>
                            </button>
                        </div>
                        <div id="locationStatus" class="mt-3 text-sm text-gray-600 hidden">
                            <i class="fas fa-spinner fa-spin mr-2"></i>
                            <span id="locationStatusText">Detecting your location...</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Hero Slideshow -->
            <div class="flex-1 flex items-center justify-center relative w-full max-w-lg lg:max-w-xl animate-fade-in" style="animation-delay: 0.3s;">
                <div class="relative w-full hero-slideshow-container aspect-square max-h-[400px] lg:max-h-[500px] bg-gray-200 rounded-2xl shadow-2xl overflow-hidden">
                    <div id="heroSlideshow" class="w-full h-full relative">
                        <img src="https://i.pinimg.com/1200x/fc/47/0d/fc470d4314244058317c663b74ede79b.jpg" 
                             alt="Healthy Food" 
                             class="slideshow-img object-cover w-full h-full absolute inset-0 opacity-100" 
                             loading="eager" />
                        <img src="https://i.pinimg.com/736x/d8/a6/ed/d8a6ed154ed3484e1373e46f58a45f8e.jpg" 
                             alt="Fresh Ingredients" 
                             class="slideshow-img object-cover w-full h-full absolute inset-0 opacity-0" 
                             loading="lazy" />
                        <img src="https://i.pinimg.com/1200x/68/81/d7/6881d79053c11639a8f9b31006fb68db.jpg" 
                             alt="Team" 
                             class="slideshow-img object-cover w-full h-full absolute inset-0 opacity-0" 
                             loading="lazy" />
                    </div>
                    
                    <!-- Slideshow Controls -->
                    <button id="prevSlide" 
                            class="absolute left-2 sm:left-4 top-1/2 transform -translate-y-1/2 bg-white/90 hover:bg-white rounded-full p-2 sm:p-3 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-110"
                            aria-label="Previous slide">
                        <i class="fas fa-chevron-left text-green-700 text-sm sm:text-base"></i>
                    </button>
                    <button id="nextSlide" 
                            class="absolute right-2 sm:right-4 top-1/2 transform -translate-y-1/2 bg-white/90 hover:bg-white rounded-full p-2 sm:p-3 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-110"
                            aria-label="Next slide">
                        <i class="fas fa-chevron-right text-green-700 text-sm sm:text-base"></i>
                    </button>
                    
                    <!-- Slide Indicators -->
                    <div class="absolute bottom-4 sm:bottom-6 left-1/2 transform -translate-x-1/2 flex gap-2">
                        <button class="slide-dot w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-green-500 transition-all duration-300" 
                                id="slideDot0" 
                                data-slide="0"
                                aria-label="Go to slide 1"></button>
                        <button class="slide-dot w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-white/60 hover:bg-white/80 transition-all duration-300" 
                                id="slideDot1" 
                                data-slide="1"
                                aria-label="Go to slide 2"></button>
                        <button class="slide-dot w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-white/60 hover:bg-white/80 transition-all duration-300" 
                                id="slideDot2" 
                                data-slide="2"
                                aria-label="Go to slide 3"></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

