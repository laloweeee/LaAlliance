<script>
    (function() {
        let currentSlide = 0;
        const slides = document.querySelectorAll('#heroSlideshow .slideshow-img');
        const dots = [
            document.getElementById('slideDot0'),
            document.getElementById('slideDot1'),
            document.getElementById('slideDot2')
        ];
        const prevBtn = document.getElementById('prevSlide');
        const nextBtn = document.getElementById('nextSlide');
        let autoplayInterval;

        function showSlide(index) {
            // Wrap around
            if (index >= slides.length) currentSlide = 0;
            else if (index < 0) currentSlide = slides.length - 1;
            else currentSlide = index;

            // Update slides
            slides.forEach((slide, i) => {
                slide.style.opacity = i === currentSlide ? '1' : '0';
            });

            // Update dots
            dots.forEach((dot, i) => {
                if (i === currentSlide) {
                    dot.classList.remove('bg-white/60');
                    dot.classList.add('bg-green-500');
                } else {
                    dot.classList.remove('bg-green-500');
                    dot.classList.add('bg-white/60');
                }
            });
        }

        function nextSlide() {
            showSlide(currentSlide + 1);
        }

        function prevSlide() {
            showSlide(currentSlide - 1);
        }

        function startAutoplay() {
            autoplayInterval = setInterval(nextSlide, 4000);
        }

        function stopAutoplay() {
            clearInterval(autoplayInterval);
        }

        // Event listeners
        nextBtn.addEventListener('click', () => {
            nextSlide();
            stopAutoplay();
            startAutoplay();
        });

        prevBtn.addEventListener('click', () => {
            prevSlide();
            stopAutoplay();
            startAutoplay();
        });

        dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
                showSlide(index);
                stopAutoplay();
                startAutoplay();
            });
        });

        // Initialize
        showSlide(0);
        startAutoplay();

        // Pause on hover
        const slideshowContainer = document.querySelector('.hero-slideshow-container');
        slideshowContainer.addEventListener('mouseenter', stopAutoplay);
        slideshowContainer.addEventListener('mouseleave', startAutoplay);
    })();

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        });
    });

    // Intersection Observer for fade-in animations
    const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, observerOptions);

    // Observe gallery cards
    document.querySelectorAll('.card-hover').forEach(card => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(30px)';
        card.style.transition = 'opacity 0.6s ease-out, transform 0.6s ease-out';
        observer.observe(card);
    });

    // GPS Location Detection and Address Input Functionality
    (function() {
        const addressInput = document.getElementById('deliveryAddress');
        const detectLocationBtn = document.getElementById('detectLocationBtn');
        const findFoodBtn = document.getElementById('findFoodBtn');

        // Detect Location using GPS
        detectLocationBtn.addEventListener('click', function() {
            if (!navigator.geolocation) {
                return;
            }

            setDetectingState(true);

            navigator.geolocation.getCurrentPosition(
                // Success callback
                function(position) {
                    const latitude = position.coords.latitude;
                    const longitude = position.coords.longitude;

                    // Store latitude and longitude as a single cookie in JSON format
                    const locationData = JSON.stringify({
                        lat: latitude,
                        lng: longitude,
                        timestamp: new Date().toISOString()
                    });
                    setCookie('deliveryLocation', locationData, 30);

                    // Use Google's reverse geocoding API
                    // Get API key from server-side configuration via ViewBag
                    const googleApiKey = '@ViewBag.GoogleApiKey';
                    
                    // Check if API key is configured
                    if (!googleApiKey || googleApiKey === '') {
                        console.error('Google Maps API key not configured');
                        addressInput.value = `Lat: ${latitude.toFixed(6)}, Lon: ${longitude.toFixed(6)}`;
                        showStatus('API key not configured. Coordinates saved.', 'warning');
                        setTimeout(() => hideStatus(), 3000);
                        setDetectingState(false);
                        return;
                    }
                    
                    fetch(`https://maps.googleapis.com/maps/api/geocode/json?latlng=${latitude},${longitude}&key=${googleApiKey}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.status === 'OK' && data.results.length > 0) {
                                // Get the most accurate address (usually the first result)
                                const address = data.results[0].formatted_address;
                                addressInput.value = address;
                                showStatus('Location detected successfully!', 'success');
                                setTimeout(() => hideStatus(), 3000);
                            } else {
                                showStatus('Could not determine address. Please enter manually.', 'error');
                                addressInput.value = `Lat: ${latitude.toFixed(6)}, Lon: ${longitude.toFixed(6)}`;
                            }
                            setDetectingState(false);
                        })
                        .catch(error => {
                            console.error('Google Geocoding error:', error);
                            addressInput.value = `Lat: ${latitude.toFixed(6)}, Lon: ${longitude.toFixed(6)}`;
                            showStatus('Location detected! (Address lookup failed)', 'warning');
                            setTimeout(() => hideStatus(), 3000);
                            setDetectingState(false);
                        });
                },
                // Error callback
                function(error) {
                    let errorMessage = 'Unable to detect location. ';
                    switch(error.code) {
                        case error.PERMISSION_DENIED:
                            errorMessage += 'Please enable location permissions.';
                            break;
                        case error.POSITION_UNAVAILABLE:
                            errorMessage += 'Location information unavailable.';
                            break;
                        case error.TIMEOUT:
                            errorMessage += 'Request timed out.';
                            break;
                        default:
                            errorMessage += 'Unknown error occurred.';
                            break;
                    }
                    setDetectingState(false);
                },
                // Options
                {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 0
                }
            );
        });

        // Find Food Button Action
        findFoodBtn.addEventListener('click', function() {
            const address = addressInput.value.trim();
            
            if (!address) {
                addressInput.focus();
                addressInput.classList.add('border-red-500');
                setTimeout(() => {
                    addressInput.classList.remove('border-red-500');
                }, 3000);
                return;
            }
            
            // Scroll to gallery section
            setTimeout(() => {
                const gallerySection = document.getElementById('gallery');
                if (gallerySection) {
                    gallerySection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }, 1000);
        });

        // Allow Enter key to submit
        addressInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                findFoodBtn.click();
            }
        });

        // Helper function to set detecting state
        function setDetectingState(isDetecting) {
            if (isDetecting) {
                // Disable both buttons
                detectLocationBtn.disabled = true;
                findFoodBtn.disabled = true;
                
                // Change detect button to loading spinner
                detectLocationBtn.innerHTML = '<i class="fas fa-spinner fa-spin text-lg"></i>';
                detectLocationBtn.classList.add('opacity-70', 'cursor-not-allowed');
                
                // Add disabled styling to Find Food button
                findFoodBtn.classList.add('opacity-50', 'cursor-not-allowed');
            } else {
                // Enable both buttons
                detectLocationBtn.disabled = false;
                findFoodBtn.disabled = false;
                
                // Restore detect button icon
                detectLocationBtn.innerHTML = '<i class="fas fa-location-crosshairs text-lg"></i>';
                detectLocationBtn.classList.remove('opacity-70', 'cursor-not-allowed');
                
                // Remove disabled styling from Find Food button
                findFoodBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
        }

        // Helper function to show status messages
        function showStatus(message, type) {
            const locationStatus = document.getElementById('locationStatus');
            const locationStatusText = document.getElementById('locationStatusText');
            
            locationStatusText.textContent = message;
            locationStatus.classList.remove('hidden');
            
            // Reset classes
            locationStatus.className = 'mt-3 text-sm flex items-center';
            
            // Apply styles based on type
            switch(type) {
                case 'loading':
                    locationStatus.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i><span>' + message + '</span>';
                    locationStatus.classList.add('text-blue-600');
                    break;
                case 'success':
                    locationStatus.innerHTML = '<i class="fas fa-check-circle mr-2"></i><span>' + message + '</span>';
                    locationStatus.classList.add('text-green-600');
                    break;
                case 'error':
                    locationStatus.innerHTML = '<i class="fas fa-exclamation-circle mr-2"></i><span>' + message + '</span>';
                    locationStatus.classList.add('text-red-600');
                    break;
                case 'warning':
                    locationStatus.innerHTML = '<i class="fas fa-exclamation-triangle mr-2"></i><span>' + message + '</span>';
                    locationStatus.classList.add('text-yellow-600');
                    break;
            }
        }

        // Helper function to hide status
        function hideStatus() {
            const locationStatus = document.getElementById('locationStatus');
            locationStatus.classList.add('hidden');
        }

        // Cookie helper functions
        function setCookie(name, value, days) {
            let expires = "";
            if (days) {
                const date = new Date();
                date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                expires = "; expires=" + date.toUTCString();
            }
            document.cookie = name + "=" + encodeURIComponent(value) + expires + "; path=/; SameSite=Lax";
        }

        function getCookie(name) {
            const nameEQ = name + "=";
            const ca = document.cookie.split(';');
            for (let i = 0; i < ca.length; i++) {
                let c = ca[i];
                while (c.charAt(0) === ' ') c = c.substring(1, c.length);
                if (c.indexOf(nameEQ) === 0) {
                    return decodeURIComponent(c.substring(nameEQ.length, c.length));
                }
            }
            return null;
        }

        function deleteCookie(name) {
            document.cookie = name + "=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
        }

        // Helper function to get location data from cookie
        function getLocationFromCookie() {
            const locationCookie = getCookie('deliveryLocation');
            if (locationCookie) {
                try {
                    return JSON.parse(locationCookie);
                } catch (error) {
                    console.error('Error parsing location cookie:', error);
                    return null;
                }
            }
            return null;
        }

        // Optionally display saved location info (for debugging)
        const savedLocation = getLocationFromCookie();
        if (savedLocation) {
            console.log('Saved location:', savedLocation);
        }
    })();
</script>

