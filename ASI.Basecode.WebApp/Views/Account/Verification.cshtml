@model EmailVerificationModel;
@{
    ViewData["Title"] = "Email Verification";
}

<div class="min-h-screen flex">
    <div class="flex-1 flex items-center justify-center bg-gradient-to-br from-green-300 to-green-800">
        <div class="w-full max-w-sm bg-white rounded-xl shadow p-8">
            <!-- Logo -->
            <div class="text-center mb-8">
                <div class="flex items-center justify-center mb-4">
                    <i class="fas fa-utensils text-4xl text-green-600 mr-2"></i>
                    <span class="text-3xl font-bold text-green-600">LaAlliancé</span>
                </div>
                <p class="text-gray-600">Email Verification</p>
                <p class="text-gray-600">Please enter the verification code sent to your email.</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm">
                    <i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm">
                    <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
                </div>
            }

            <div id="verificationScreen">
                <form method="post" action="/Account/VerifyOtp" class="flex flex-col gap-4">
                    <!-- Hidden email field -->
                    <input type="hidden" asp-for="Email" />

                    <div class="mb-4">
                        <p class="text-sm text-gray-600 mb-2">A verification code has been sent to:</p>
                        <p class="font-medium text-gray-800">@Model.Email</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Verification Code</label>
                        <input type="text" asp-for="OtpCode" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent" placeholder="Enter 6-digit code" required>
                        <span asp-validation-for="OtpCode" class="text-danger"></span>
                    </div>

                    <button type="submit" class="w-full bg-green-600 text-white py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors">
                        Verify Email
                    </button>
                </form>
                <div class="mt-6 text-center">
                    <p class="text-gray-600">Didn't receive the code? <a href="@Url.Action("ResendCode", "Account", new { email = Model.Email })" class="text-green-600 font-medium hover:text-green-700">Resend</a></p>
                </div>
            </div>
        </div>
    </div>
</div>