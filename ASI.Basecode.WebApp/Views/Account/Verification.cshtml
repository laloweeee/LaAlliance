@model EmailVerificationModel;
@{
    ViewData["Title"] = "Email Verification";
}

<style>
    @@keyframes float-gentle {
        0%, 100% { transform: translate(0, 0) rotate(0deg); }
        33% { transform: translate(30px, -30px) rotate(3deg); }
        66% { transform: translate(-20px, 20px) rotate(-3deg); }
    }
    
    @@keyframes fade-in {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    .animate-float-gentle { animation: float-gentle 20s ease-in-out infinite; }
    .animate-fade-in { animation: fade-in 0.6s ease-out; }
    
    .pattern-dots {
        background-image: radial-gradient(circle, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
        background-size: 30px 30px;
    }
</style>

<div class="relative min-h-screen w-full overflow-hidden bg-gradient-to-br from-gray-50 to-gray-100">
    <!-- Large background circle overlays -->
    <div class="absolute inset-0 overflow-hidden">
        <!-- Large green circles in background -->
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-green-800/20 rounded-full"></div>
        <div class="absolute -bottom-60 -left-40 w-96 h-96 bg-emerald-400/15 rounded-full"></div>
        <div class="absolute top-1/2 left-1/3 w-72 h-72 bg-teal-400/10 rounded-full"></div>
        <div class="absolute bottom-20 right-1/4 w-64 h-64 bg-green-300/15 rounded-full"></div>
        
        <!-- Additional smaller circles -->
        <div class="absolute top-1/4 left-20 w-40 h-40 bg-emerald-400/10 rounded-full"></div>
        <div class="absolute bottom-1/3 right-32 w-32 h-32 bg-teal-400/10 rounded-full"></div>
    </div>

    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 opacity-5" style="background-image: linear-gradient(90deg, #10b981 1px, transparent 1px), linear-gradient(0deg, #10b981 1px, transparent 1px); background-size: 50px 50px;"></div>

    <!-- Main container -->
    <div class="relative z-10 flex min-h-screen items-center justify-center px-4 py-6">
        <div class="w-full max-w-xl">
            <div class="bg-white rounded-2xl shadow-2xl overflow-hidden animate-fade-in">
                <div class="p-6 lg:p-8 flex flex-col justify-center">
                    <!-- Logo -->
                    <div class="flex justify-center mb-4">
                        <div class="text-center">
                            <img src="@Url.Content("~/img/laAllianceLogo.png")" alt="LaAlliance Logo" class="max-h-20 max-w-20 mx-auto" />
                        </div>
                    </div>

                    <!-- Header -->
                    <div class="mb-6 text-center">
                        <h2 class="text-2xl font-bold text-gray-800 mb-2">Email Verification</h2>
                        <p class="text-sm text-gray-600">
                            Please enter the verification code sent to your email
                        </p>
                    </div>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm">
                            <i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
                        </div>
                    }

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm">
                            <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
                        </div>
                    }

                    <!-- Form -->
                    <form method="post" action="/Account/VerifyOtp" id="verificationForm" class="space-y-4">
                        @Html.AntiForgeryToken()

                        <!-- Hidden email field -->
                        <input type="hidden" asp-for="Email" />

                        <!-- Email display -->
                        <div class="bg-gray-50 rounded-lg p-3 text-center border border-gray-200">
                            <p class="text-xs text-gray-600 mb-1">Verification code sent to:</p>
                            <p class="font-semibold text-gray-800 text-base">@Model.Email</p>
                        </div>

                        <!-- Verification Code input -->
                        <div>
                            <label for="OtpCode" class="block text-xs font-semibold text-gray-700 mb-1">VERIFICATION CODE</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                                    <i class="fas fa-shield-alt text-sm"></i>
                                </span>
                                <input type="text" asp-for="OtpCode" id="OtpCode" placeholder="Enter 6-digit code"
                                    class="w-full rounded-lg border-0 bg-gray-50 pl-10 pr-3 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:bg-whitetransition-all duration-200 text-center text-base font-mono tracking-widest"
                                    maxlength="6" required />
                            </div>
                            <span asp-validation-for="OtpCode" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <!-- Verify button -->
                        <button type="submit"
                                class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-5 rounded-lg
                                       transition-all duration-200 shadow-lg hover:shadow-xl
                                       focus:outline-none focus:ring-4 focus:ring-green-500/30">
                            VERIFY EMAIL
                        </button>

                        <!-- Resend code link -->
                        <div class="text-center pt-3">
                            <p class="text-sm text-gray-600">
                                Didn't receive the code?
                                <a href="@Url.Action("ResendCode", "Account", new { email = Model.Email })" 
                                   class="font-semibold text-green-600 hover:text-green-700 transition-colors ml-1">
                                    Resend Code
                                </a>
                            </p>
                        </div>
                    </form>

                    <!-- Footer links -->
                    <div class="mt-4 pt-4 border-t border-gray-200">
                        <p class="text-center text-xs text-gray-500">
                            Having trouble? Contact our 
                            <a href="#" class="text-green-600 hover:underline">support team</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Check for success/error messages and display Toastr notifications
        var successMessage = '@TempData["SuccessMessage"]';
        var errorMessage = '@TempData["ErrorMessage"]';
        
        if (successMessage) {
            toastr.success(successMessage);
        }
        
        if (errorMessage) {
            toastr.error(errorMessage);
        }

        // Enhanced form validation and auto-focus
        document.addEventListener('DOMContentLoaded', function() {
            const otpInput = document.getElementById('OtpCode');
            
            // Auto-focus on OTP input
            if (otpInput) {
                otpInput.focus();
                
                // Auto-tab functionality for OTP (if you want to implement multiple inputs)
                otpInput.addEventListener('input', function(e) {
                    if (this.value.length === 6) {
                        this.form.submit();
                    }
                });
            }

            // Enhanced form validation
            document.querySelectorAll('input').forEach(input => {
                input.addEventListener('focus', function() {
                    this.parentElement.classList.add('ring-2', 'ring-green-500/20', 'rounded-lg');
                });
                input.addEventListener('blur', function() {
                    this.parentElement.classList.remove('ring-2', 'ring-green-500/20', 'rounded-lg');
                });
            });
        });
    </script>
}
