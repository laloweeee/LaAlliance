@model LoginViewModel
@using static ASI.Basecode.Resources.Views.Screen

@{
    ViewBag.LoginView = true;
    ViewData["Title"] = "Login Page";
}
<div>
    @Html.AntiForgeryToken()
</div>
<div class="min-h-screen flex">
    <!-- LEFT PANEL -->
    <div class="flex-1 flex items-center justify-center bg-gradient-to-br from-green-300 to-green-800">
        <div class="w-full max-w-sm bg-white rounded-xl shadow p-8" >
            <!-- Logo -->
            <div class="text-center mb-8">
                <div class="flex items-center justify-center mb-4">
                    <i class="fas fa-utensils text-4xl text-green-600 mr-2"></i>
                    <span class="text-3xl font-bold text-green-600">LaAlliancé</span>
                </div>
                <p class="text-gray-600">Welcome to LaAlliancé</p>
                <p class="text-gray-600">Your favorite food at the tip of your finger.</p>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm">
                        <i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm">
                        <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
                    </div>
                }

            </div>
            <div id="loginScreen">
                <form method="post" action="/Account/Login" id="loginForm" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                        <input type="email" asp-for="Email" id="form2Example11" placeholder="Enter email" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent" required>
                        <span asp-validation-for="Email" class="text-red-700"></span>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                        <input type="password" id="form2Example22" asp-for="Password" placeholder="Enter password" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent" required>
                        <span asp-validation-for="Password" class="text-red-700"></span>
                    </div>
                    <div class="flex items-center justify-between">
                        <label class="flex items-center">
                            <input type="checkbox" class="rounded border-gray-300 text-green-600 focus:ring-green-500">
                            <span class="ml-2 text-sm text-gray-600">Remember me</span>
                        </label>
                        <button type="button" onclick="showForgotPassword()" class="text-green-600 font-medium text-sm hover:text-green-700">Forgot Password?</button>
                    </div>
                    <button type="submit" id="loginButton" class="w-full bg-green-600 text-white py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors disabled:bg-gray-400 disabled:cursor-not-allowed">
                        <span id="buttonText">Sign In</span>
                        <span id="buttonLoader" class="hidden">
                            <i class="fas fa-spinner fa-spin"></i> Loading...
                        </span>
                    </button>
                </form>
                <div class="mt-6 text-center">
                    <p class="text-gray-600">Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-green-600 font-medium hover:text-green-700">Sign up</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/form-loader.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            initFormLoader('loginForm', 'loginButton', 'buttonText', 'buttonLoader');
        });
    </script>
}