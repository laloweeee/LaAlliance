@using ASI.Basecode.Services.ServiceModels
@model UserViewModel
@{
    ViewBag.LoginView = true;
    ViewData["Title"] = "Register Page";
}

<style>
    @@keyframes float-gentle {
        0%, 100% { transform: translate(0, 0) rotate(0deg); }
        33% { transform: translate(30px, -30px) rotate(3deg); }
        66% { transform: translate(-20px, 20px) rotate(-3deg); }
    }
    
    @@keyframes fade-in {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    .animate-float-gentle { animation: float-gentle 20s ease-in-out infinite; }
    .animate-fade-in { animation: fade-in 0.6s ease-out; }
    
    .pattern-dots {
        background-image: radial-gradient(circle, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
        background-size: 30px 30px;
    }
</style>

<div class="relative min-h-screen w-full overflow-hidden bg-gradient-to-br from-gray-50 to-gray-100">
    <!-- Large background circle overlays -->
    <div class="absolute inset-0 overflow-hidden">
        <!-- Large green circles in background -->
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-green-800/20 rounded-full"></div>
        <div class="absolute -bottom-60 -left-40 w-96 h-96 bg-emerald-400/15 rounded-full"></div>
        <div class="absolute top-1/2 left-1/3 w-72 h-72 bg-teal-400/10 rounded-full"></div>
        <div class="absolute bottom-20 right-1/4 w-64 h-64 bg-green-300/15 rounded-full"></div>
        
        <!-- Additional smaller circles -->
        <div class="absolute top-1/4 left-20 w-40 h-40 bg-emerald-400/10 rounded-full"></div>
        <div class="absolute bottom-1/3 right-32 w-32 h-32 bg-teal-400/10 rounded-full"></div>
    </div>

    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 opacity-5" style="background-image: linear-gradient(90deg, #10b981 1px, transparent 1px), linear-gradient(0deg, #10b981 1px, transparent 1px); background-size: 50px 50px;"></div>

    <!-- Main container -->
    <div class="relative z-10 flex min-h-screen items-center justify-center px-4 py-8">
        <div class="w-full max-w-2xl">
            <div class="bg-white rounded-3xl shadow-2xl overflow-hidden animate-fade-in">
                <div class="p-12 lg:p-16 flex flex-col justify-center">
                    <!-- Logo above Create Account -->
                    <div class="flex justify-center mb-6">
                        <div class="text-center">
                            <img src="@Url.Content("~/img/laAllianceLogo.png")" alt="LaAlliance Logo" class="max-h-32 max-w-32 mx-auto" />
                        </div>
                    </div>

                    <!-- Header -->
                    <div class="mb-10 text-center">
                        <h2 class="text-4xl font-bold text-gray-800 mb-3">Create Account</h2>
                        <p class="text-gray-600">
                            Fill in your details to get started
                        </p>
                    </div>

                    <!-- Form -->
                    <form method="post" action="/Account/Register" id="registerForm" class="space-y-6">
                        @Html.AntiForgeryToken()

                        <!-- Email input -->
                        <div>
                            <label for="form2Example11" class="block text-sm font-semibold text-gray-700 mb-2">
                                EMAIL
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                                    <i class="fas fa-envelope"></i>
                                </span>
                                <input
                                    type="email"
                                    asp-for="Email"
                                    id="form2Example11"
                                    placeholder="you@example.com"
                                    class="w-full rounded-xl border-0 bg-gray-50 pl-12 pr-4 py-4 text-gray-900 placeholder-gray-400
                                           focus:outline-none focus:ring-2 focus:ring-green-500 focus:bg-white
                                           transition-all duration-200"
                                    required />
                            </div>
                            <span asp-validation-for="Email" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <!-- First Name input -->
                        <div>
                            <label for="form2Example12" class="block text-sm font-semibold text-gray-700 mb-2">
                                FIRST NAME
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                                    <i class="fas fa-user"></i>
                                </span>
                                <input
                                    type="text"
                                    asp-for="FirstName"
                                    id="form2Example12"
                                    placeholder="Enter your first name"
                                    class="w-full rounded-xl border-0 bg-gray-50 pl-12 pr-4 py-4 text-gray-900 placeholder-gray-400
                                           focus:outline-none focus:ring-2 focus:ring-green-500 focus:bg-white
                                           transition-all duration-200"
                                    required />
                            </div>
                            <span asp-validation-for="FirstName" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <!-- Last Name input -->
                        <div>
                            <label for="form2Example13" class="block text-sm font-semibold text-gray-700 mb-2">
                                LAST NAME
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                                    <i class="fas fa-user"></i>
                                </span>
                                <input
                                    type="text"
                                    asp-for="LastName"
                                    id="form2Example13"
                                    placeholder="Enter your last name"
                                    class="w-full rounded-xl border-0 bg-gray-50 pl-12 pr-4 py-4 text-gray-900 placeholder-gray-400
                                           focus:outline-none focus:ring-2 focus:ring-green-500 focus:bg-white
                                           transition-all duration-200"
                                    required />
                            </div>
                            <span asp-validation-for="LastName" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <!-- Contact Number input -->
                        <div>
                            <label for="form2Example24" class="block text-sm font-semibold text-gray-700 mb-2">
                                CONTACT NUMBER
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                                    <i class="fas fa-phone"></i>
                                </span>
                                <input
                                    type="tel"
                                    asp-for="ContactNumber"
                                    id="form2Example24"
                                    placeholder="Enter your contact number"
                                    class="w-full rounded-xl border-0 bg-gray-50 pl-12 pr-4 py-4 text-gray-900 placeholder-gray-400
                                           focus:outline-none focus:ring-2 focus:ring-green-500 focus:bg-white
                                           transition-all duration-200"
                                    required />
                            </div>
                            <span asp-validation-for="ContactNumber" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <!-- Password input -->
                        <div>
                            <label for="form2Example22" class="block text-sm font-semibold text-gray-700 mb-2">
                                PASSWORD
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                                    <i class="fas fa-lock"></i>
                                </span>
                                <input
                                    type="password"
                                    asp-for="Password"
                                    id="form2Example22"
                                    placeholder="••••••••••"
                                    class="w-full rounded-xl border-0 bg-gray-50 pl-12 pr-4 py-4 text-gray-900 placeholder-gray-400
                                           focus:outline-none focus:ring-2 focus:ring-green-500 focus:bg-white
                                           transition-all duration-200"
                                    required />
                            </div>
                            <span asp-validation-for="Password" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <!-- Confirm Password input -->
                        <div>
                            <label for="confirmpassword" class="block text-sm font-semibold text-gray-700 mb-2">
                                CONFIRM PASSWORD
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                                    <i class="fas fa-lock"></i>
                                </span>
                                <input
                                    type="password"
                                    asp-for="ConfirmPassword"
                                    id="confirmpassword"
                                    placeholder="••••••••••"
                                    class="w-full rounded-xl border-0 bg-gray-50 pl-12 pr-4 py-4 text-gray-900 placeholder-gray-400
                                           focus:outline-none focus:ring-2 focus:ring-green-500 focus:bg-white
                                           transition-all duration-200"
                                    required />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <!-- Register button -->
                        <button type="submit"
                                class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-4 px-6 rounded-xl
                                       transition-all duration-200 shadow-lg hover:shadow-xl
                                       focus:outline-none focus:ring-4 focus:ring-green-500/30">
                            REGISTER
                        </button>

                        <!-- Login link -->
                        <div class="text-center pt-4">
                            <p class="text-gray-600">
                                Already have an account?
                                <a asp-controller="Account" asp-action="Login" class="font-semibold text-green-600 hover:text-green-700 transition-colors ml-1">
                                    Sign In
                                </a>
                            </p>
                        </div>
                    </form>

                    <!-- Footer links -->
                    <div class="mt-8 pt-6 border-t border-gray-200">
                        <p class="text-center text-xs text-gray-500">
                            By creating an account, you agree to our
                            <a href="#" class="text-green-600 hover:underline">Terms of Service</a> and
                            <a href="#" class="text-green-600 hover:underline">Privacy Policy</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var errorMessage = '@TempData["ErrorMessage"]';
        if (errorMessage) { 
            toastr.error(errorMessage); 
        }

        // Enhanced form validation
        document.querySelectorAll('input').forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.classList.add('ring-2', 'ring-green-500/20', 'rounded-xl');
            });
            input.addEventListener('blur', function() {
                this.parentElement.classList.remove('ring-2', 'ring-green-500/20', 'rounded-xl');
            });
        });
    </script>
}