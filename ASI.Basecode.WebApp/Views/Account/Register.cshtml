@using ASI.Basecode.Services.ServiceModels
@model UserViewModel
@{
    ViewBag.LoginView = true;
    ViewData["Title"] = "Register Page";
}

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-green-300 to-green-800 py-8">
    <div class="w-full max-w-md bg-white rounded-xl shadow-2xl p-8 mx-4">
        <!-- Logo & Header -->
        <div class="text-center mb-6">
            <div class="flex items-center justify-center mb-3">
                <i class="fas fa-utensils text-4xl text-green-600 mr-2"></i>
                <span class="text-3xl font-bold text-green-600">LaAlliancé</span>
            </div>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">Create Account</h2>
            <p class="text-gray-600 text-sm">Join LaAlliancé today</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm">
                <i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm">
                <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
            </div>
        }

        <form method="post" action="/Account/Register" id="registerform" class="space-y-4">
            <!-- Email -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">
                    <i class="fas fa-envelope text-gray-400 mr-1"></i>Email Address
                </label>
                <input type="email" asp-for="Email" placeholder="you@example.com" 
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all" required>
                <span asp-validation-for="Email" class="text-red-600 text-xs mt-1 block"></span>
            </div>

            <!-- Name Fields (Side by Side) -->
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">
                        <i class="fas fa-user text-gray-400 mr-1"></i>First Name
                    </label>
                    <input type="text" asp-for="FirstName" placeholder="John" 
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all" required>
                    <span asp-validation-for="FirstName" class="text-red-600 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Last Name</label>
                    <input type="text" asp-for="LastName" placeholder="Doe" 
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all" required>
                    <span asp-validation-for="LastName" class="text-red-600 text-xs mt-1 block"></span>
                </div>
            </div>

            <!-- Contact Number -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">
                    <i class="fas fa-phone text-gray-400 mr-1"></i>Contact Number
                </label>
                <input type="tel" asp-for="ContactNumber" placeholder="+1 (555) 123-4567" 
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all" required>
                <span asp-validation-for="ContactNumber" class="text-red-600 text-xs mt-1 block"></span>
            </div>

            <!-- Password -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">
                    <i class="fas fa-lock text-gray-400 mr-1"></i>Password
                </label>
                <input type="password" asp-for="Password" placeholder="••••••••" 
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all" required>
                <span asp-validation-for="Password" class="text-red-600 text-xs mt-1 block"></span>
                <p class="text-xs text-gray-500 mt-1">Must be at least 8 characters</p>
            </div>

            <!-- Confirm Password -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">
                    <i class="fas fa-lock text-gray-400 mr-1"></i>Confirm Password
                </label>
                <input type="password" asp-for="ConfirmPassword" placeholder="••••••••" 
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all" required>
                <span asp-validation-for="ConfirmPassword" class="text-red-600 text-xs mt-1 block"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" id="registerButton" 
                    class="w-full bg-green-600 text-white py-3 rounded-lg font-semibold hover:bg-green-700 active:bg-green-800 transition-all duration-200 disabled:bg-gray-400 disabled:cursor-not-allowed shadow-lg hover:shadow-xl">
                <span id="buttonText">Create Account</span>
                <span id="buttonLoader" class="hidden">
                    <i class="fas fa-spinner fa-spin"></i> Creating Account...
                </span>
            </button>
        </form>

        <!-- Sign In Link -->
        <div class="mt-6 text-center">
            <p class="text-gray-600 text-sm">
                Already have an account? 
                <a asp-controller="Account" asp-action="Login" class="text-green-600 font-semibold hover:text-green-700 hover:underline">
                    Sign In
                </a>
            </p>
        </div>

        <!-- Terms & Privacy -->
        <div class="mt-4 text-center">
            <p class="text-xs text-gray-500">
                By signing up, you agree to our 
                <a href="#" class="text-green-600 hover:underline">Terms of Service</a> and 
                <a href="#" class="text-green-600 hover:underline">Privacy Policy</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/loader.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            initFormLoader('registerform', 'registerButton', 'buttonText', 'buttonLoader');
        });
    </script>
}