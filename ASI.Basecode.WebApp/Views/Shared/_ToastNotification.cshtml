@model ASI.Basecode.WebApp.Models.ToastNotificationViewModel;

@if (!string.IsNullOrEmpty(Model?.Message))
{
    <div class="fixed top-4 right-4 z-50 animate-fade-in">
        <div class="mb-6 p-4 @Model.BackgroundClass border @Model.BorderClass @Model.TextClass rounded-xl shadow-sm flex items-center gap-3">
            <div class="w-6 h-6 @Model.IconBackgroundClass rounded-full flex items-center justify-center flex-shrink-0">
                <i class="@Model.IconClass text-white text-xs"></i>
            </div>
            <span class="font-medium">@Model.Message</span>
        </div>
    </div>

    <style>
        @@keyframes fade-in {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-fade-in {
            animation: fade-in 0.3s ease-out;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toast = document.querySelector('.animate-fade-in');
            if (toast) {
                setTimeout(() => {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(-10px)';
                    setTimeout(() => toast.remove(), 300);
                }, 3000);
            }
        });
    </script>
}