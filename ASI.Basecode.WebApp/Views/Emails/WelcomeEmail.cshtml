@{
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to LaAlliance</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <div class="max-w-xl mx-auto bg-white rounded-xl shadow-md overflow-hidden my-10">
        <div class="text-center py-6">
            <img src="https://your-logo-url.com/logo.png" alt="LaAlliance Logo" class="mx-auto h-16">
        </div>
        <div class="px-8 pb-6 text-gray-700">
            <h2 class="text-2xl font-bold mb-4 text-gray-900">Welcome to LaAlliance, {{FirstName}}!</h2>
            <p class="mb-4">
                We’re thrilled to have you join our community. At <span class="font-semibold">LaAlliance</span>,
                we’re dedicated to providing you with exceptional services and opportunities to connect
                with like-minded individuals.
            </p>
            <p class="mb-6">
                Get started by exploring your dashboard and personalizing your profile.
            </p>
            <div class="text-center">
                <a href="{{ActivationLink}}"
                   class="inline-block px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700">
                    Activate Your Account
                </a>
            </div>
            <p class="mt-6">
                If you have any questions, feel free to reach out to our support team.
            </p>
            <p class="mt-4">Welcome aboard,<br>— The LaAlliance Team</p>
        </div>
        <div class="bg-gray-50 py-4 text-center text-xs text-gray-500">
            &copy; 2025 LaAlliance. All rights reserved. <br>
            <a href="{{UnsubscribeLink}}" class="text-blue-500 underline">Unsubscribe</a>
        </div>
    </div>
</body>
</html>
