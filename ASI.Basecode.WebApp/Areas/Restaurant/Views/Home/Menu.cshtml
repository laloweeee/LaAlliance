@{
    Layout = "~/Areas/Restaurant/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Menu Management";
}

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
    <h2 class="text-2xl font-bold text-gray-800">Menu Management</h2>

    <div class="flex items-center gap-2">
        <button type="button" onclick="showAddCategory()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition-colors">
            <i class="fas fa-plus mr-2"></i>Add Category
        </button>

        <button type="button" onclick="showAddItem()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors">
            <i class="fas fa-plus mr-2"></i>Add Item
        </button>

        <!-- Category Filter -->
        <label for="categoryFilter" class="sr-only">Filter by Category</label>
        <select id="categoryFilter"
                class="px-3 py-2 rounded-lg border border-gray-300 bg-white focus:outline-none"
                onchange="applyCategoryFilter(this.value)">
            <option value="ALL">All Categories</option>
            <!-- options will be rendered by JS -->
        </select>
    </div>
</div>

<!-- Items Table -->
<div class="bg-white rounded-lg shadow overflow-hidden mb-8">
    <div class="px-4 py-3 border-b">
        <h3 class="text-lg font-semibold text-gray-800">Menu Items</h3>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
            <thead class="bg-gray-50 text-gray-700">
                <tr class="text-left">
                    <th class="px-4 py-3 font-semibold">Item</th>
                    <th class="px-4 py-3 font-semibold">Category</th>
                    <th class="px-4 py-3 font-semibold">Price</th>
                    <th class="px-4 py-3 font-semibold">Available</th>
                    <th class="px-4 py-3 font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody id="itemsTbody" class="divide-y">
                <!-- rows rendered by JS -->
            </tbody>
        </table>
    </div>
</div>

<!-- Categories Table -->
<div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="px-4 py-3 border-b">
        <h3 class="text-lg font-semibold text-gray-800">Categories</h3>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
            <thead class="bg-gray-50 text-gray-700">
                <tr class="text-left">
                    <th class="px-4 py-3 font-semibold">Category</th>
                    <th class="px-4 py-3 font-semibold">Items</th>
                    <th class="px-4 py-3 font-semibold">Default Visible</th>
                    <th class="px-4 py-3 font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody id="categoriesTbody" class="divide-y">
                <!-- rows rendered by JS -->
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_MenuModals")
