<div id="addItemModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-3xl rounded-lg shadow-lg overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b">
            <h3 id="addItemTitle" class="text-lg font-semibold">Add Menu Item</h3>
            <button type="button" class="text-gray-500 hover:text-gray-700" onclick="closeModal('addItemModal')">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="p-6">
            <form id="addItemForm" class="space-y-6">
                <input type="hidden" id="editItemId" />
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Item Name</label>
                            <input id="itemNameInput" type="text" class="w-full px-4 py-2 border rounded-lg" placeholder="e.g., Classic Burger" required>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                            <select id="itemCategoryInput" class="w-full px-3 py-2 border rounded-lg" required>
                                <!-- options rendered by JS -->
                            </select>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Price (₱)</label>
                                <input id="itemPriceInput" type="number" step="0.01" class="w-full px-4 py-2 border rounded-lg" required>
                            </div>
                            <div class="flex items-end">
                                <label class="inline-flex items-center">
                                    <input id="itemAvailableInput" type="checkbox" class="mr-2"> Available
                                </label>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                            <textarea id="itemDescInput" rows="3" class="w-full px-4 py-2 border rounded-lg" placeholder="Short description..."></textarea>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Image</label>
                        <div class="border rounded-lg p-4 flex items-center justify-center h-48 bg-gray-50">
                            <img id="itemImagePreview" src="" alt="Preview" class="max-h-40 hidden">
                            <span id="itemImagePlaceholder" class="text-gray-400">No image selected</span>
                        </div>
                        <input id="itemImageInput" type="file" accept="image/*" class="w-full">
                    </div>
                </div>

                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" class="px-4 py-2 rounded border" onclick="closeModal('addItemModal')">Cancel</button>
                    <button id="addItemSubmitBtn" type="submit" class="px-4 py-2 rounded bg-blue-600 text-white hover:bg-blue-700">Save Item</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* DELETE ITEM *@
<div id="deleteConfirmModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-md rounded-lg shadow-lg overflow-hidden">
        <div class="px-6 py-5">
            <h3 class="text-lg font-semibold mb-2">Delete this item?</h3>
            <p class="text-gray-600">This action cannot be undone.</p>
            <input type="hidden" id="deleteItemId" />
            <div class="mt-6 flex justify-end gap-2">
                <button type="button" class="px-4 py-2 rounded border" onclick="closeModal('deleteConfirmModal')">Cancel</button>
                <button id="confirmDeleteBtn" type="button" class="px-4 py-2 rounded bg-red-600 text-white hover:bg-red-700">Delete</button>
            </div>
        </div>
    </div>
</div>

@* ADD CATEGORY *@
<div id="addCategoryModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-md rounded-lg shadow-lg overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b">
            <h3 class="text-lg font-semibold">Add Category</h3>
            <button type="button" class="text-gray-500 hover:text-gray-700" onclick="closeModal('addCategoryModal')"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6">
            <form id="addCategoryForm" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Category Name</label>
                    <input id="categoryNameInput" type="text" class="w-full px-4 py-2 border rounded-lg" placeholder="e.g., Burgers" required>
                </div>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" class="px-4 py-2 rounded border" onclick="closeModal('addCategoryModal')">Cancel</button>
                    <button type="submit" class="px-4 py-2 rounded bg-green-600 text-white hover:bg-green-700">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* EDIT CATEGORY *@
<div id="editCategoryModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-md rounded-lg shadow-lg overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b">
            <h3 class="text-lg font-semibold">Edit Category</h3>
            <button type="button" class="text-gray-500 hover:text-gray-700" onclick="closeModal('editCategoryModal')"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6">
            <form id="editCategoryForm" class="space-y-4">
                <input type="hidden" id="editCategoryId">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Category Name</label>
                    <input id="editCategoryName" type="text" class="w-full px-4 py-2 border rounded-lg" required>
                </div>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" class="px-4 py-2 rounded border" onclick="closeModal('editCategoryModal')">Cancel</button>
                    <button type="submit" class="px-4 py-2 rounded bg-blue-600 text-white hover:bg-blue-700">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* DELETE CATEGORY *@
<div id="deleteCategoryModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-md rounded-lg shadow-lg overflow-hidden">
        <div class="px-6 py-5">
            <h3 class="text-lg font-semibold mb-2">Delete this category?</h3>
            <p class="text-gray-600">Items under this category may be affected.</p>
            <input type="hidden" id="deleteCategoryId" />
            <div class="mt-6 flex justify-end gap-2">
                <button type="button" class="px-4 py-2 rounded border" onclick="closeModal('deleteCategoryModal')">Cancel</button>
                <button id="confirmDeleteCategoryBtn" type="button" class="px-4 py-2 rounded bg-red-600 text-white hover:bg-red-700">Delete</button>
            </div>
        </div>
    </div>
</div>
