<!-- Promotions -->
<div id="tab-promotions" class="promo-tab section">
    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            @foreach (var promotion in Model)
            {
                <div class="bg-white rounded-lg shadow overflow-hidden">
                    @if (!string.IsNullOrEmpty(promotion.PromotionBanner))
                    {
                        <img src="@promotion.PromotionBanner" alt="@promotion.PromotionName" class="w-full h-40 object-cover">
                    }
                    else
                    {
                        <div class="w-full h-40 bg-gray-200 flex items-center justify-center">
                            <span class="text-gray-500">No Image</span>
                        </div>
                    }
                    <div class="p-6">
                        <div class="flex items-start justify-between">
                            <div>
                                <h3 class="text-lg font-semibold">@promotion.PromotionName</h3>
                                <p class="text-sm text-gray-500">
                                    Discount: 
                                    <span class="font-medium text-emerald-600">
                                        @if (promotion.DiscountType == ASI.Basecode.Resources.Constants.Enums.DiscountType.Percentage)
                                        {
                                            @promotion.DiscountValue.ToString("0")@("%")
                                        }
                                        else
                                        {
                                            @promotion.DiscountValue.ToString("C")
                                        }
                                    </span>
                                </p>
                            </div>
                            @{
                                var currentDate = DateTime.Now;
                                var statusClass = "";
                                var statusText = "";
                                
                                if (!promotion.IsActive)
                                {
                                    statusClass = "bg-gray-100 text-gray-700";
                                    statusText = "Inactive";
                                }
                                else if (promotion.StartDate > currentDate)
                                {
                                    statusClass = "bg-blue-100 text-blue-700";
                                    statusText = "Upcoming";
                                }
                                else if (promotion.EndDate < currentDate)
                                {
                                    statusClass = "bg-red-100 text-red-700";
                                    statusText = "Expired";
                                }
                                else
                                {
                                    statusClass = "bg-green-100 text-green-700";
                                    statusText = "Active";
                                }
                            }
                            <span class="text-xs px-2 py-1 rounded-full @statusClass">@statusText</span>
                        </div>
                        <div class="mt-4 grid grid-cols-2 gap-4 text-sm text-gray-600">
                            <div><span class="font-medium">Start:</span> @promotion.StartDate.ToString("MMM dd, yyyy")</div>
                            <div><span class="font-medium">End:</span> @promotion.EndDate.ToString("MMM dd, yyyy")</div>
                        </div>
                        @if (!string.IsNullOrEmpty(promotion.PromotionDescription))
                        {
                            <p class="mt-2 text-sm text-gray-600">@promotion.PromotionDescription</p>
                        }
                        <div class="mt-4 flex gap-2">
                            <a asp-action="Edit" asp-route-id="@promotion.PromotionID" class="px-3 py-1 rounded border hover:bg-gray-50">Edit</a>
                            <form asp-action="Delete" asp-route-id="@promotion.PromotionID" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this promotion?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="px-3 py-1 rounded border text-red-600 hover:bg-red-50">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-12">
            <div class="text-gray-500 mb-4">
                <i class="fas fa-tags text-4xl"></i>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No promotions yet</h3>
            <p class="text-gray-500 mb-4">Create your first promotion to start attracting customers.</p>
            <a asp-action="Create" class="px-4 py-2 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700">
                <i class="fas fa-calendar-plus mr-2"></i>Create Promotion
            </a>
        </div>
    }
</div>

