<!-- Analytics -->
<div id="tab-analytics" class="promo-tab section hidden">
    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold">Campaign Performance</h3>
            <button class="text-sm px-3 py-1 rounded border hover:bg-gray-50">Export CSV</button>
        </div>
        <div class="h-64">
            <canvas id="promoPerfChart"></canvas>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // --- Modal functions
        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('hidden');
            }
        }
        
        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('hidden');
            }
        }

        // --- Tabs
        (function initPromoTabs(){
          const buttons = document.querySelectorAll('.promo-tab-btn');
          const sections = {
            campaigns: document.getElementById('tab-campaigns'),
            promotions:    document.getElementById('tab-promotions'),
            discounts: document.getElementById('tab-discounts'),
            trending:  document.getElementById('tab-trending'),
            analytics: document.getElementById('tab-analytics')
          };
          let active = 'promotions';
          function activate(name){
            active = name;
            Object.entries(sections).forEach(([k, el]) => {
              if (!el) return;
              el.classList.toggle('hidden', k !== name);
              el.classList.toggle('active', k === name);
            });
            buttons.forEach(b=>{
              const on = b.dataset.tab === name;
              b.classList.toggle('border-emerald-600', on);
              b.classList.toggle('text-emerald-700', on);
              b.classList.toggle('border-b-2', on);
            });
            if (name === 'analytics') initPromoAnalytics();
          }
          buttons.forEach(b=> b.addEventListener('click', ()=> activate(b.dataset.tab)));
          activate(active);
        })();

        // --- Chart
        function initPromoAnalytics(){
          const ctx = document.getElementById('promoPerfChart');
          if (!ctx || ctx.dataset.init) return;
          ctx.dataset.init = '1';
          new Chart(ctx, {
            type: 'line',
            data: {
              labels: ['Week 1','Week 2','Week 3','Week 4'],
              datasets: [
                { label: 'Clicks', data: [120, 180, 160, 240], borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,0.15)', fill: true, tension: 0.35 },
                { label: 'Orders', data: [40,  65,  58,  92 ], borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.15)',  fill: true, tension: 0.35 }
              ]
            },
            options: { responsive: true, maintainAspectRatio: false }
          });
        }
    </script>
}
