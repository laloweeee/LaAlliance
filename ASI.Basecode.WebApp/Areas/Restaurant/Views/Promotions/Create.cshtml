@model ASI.Basecode.Services.ServiceModels.PromotionViewModel

@{
    ViewData["Title"] = "Create Promotion";
}

<div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <div class="px-6 py-4 border-b">
            <h2 class="text-2xl font-bold text-gray-800">Create Promotion</h2>
        </div>
        <div class="p-6">
            <form asp-action="Create" asp-controller="Promotions" asp-area="Restaurant" method="post" enctype="multipart/form-data" class="space-y-6">
                @Html.AntiForgeryToken()
                
                <!-- Promotion Basic Info -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="PromotionName" class="block text-sm font-medium text-gray-700 mb-2">Promotion Name</label>
                        <input asp-for="PromotionName" type="text" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="e.g., Summer Sale">
                        <span asp-validation-for="PromotionName" class="text-red-500 text-sm"></span>
                    </div>
                    <div>
                        <label asp-for="PromotionalBannerFile" class="block text-sm font-medium text-gray-700 mb-2">Promotion Image</label>
                        <input asp-for="PromotionalBannerFile" type="file" accept="image/*" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
                        <span asp-validation-for="PromotionalBannerFile" class="text-red-500 text-sm"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="PromotionDescription" class="block text-sm font-medium text-gray-700 mb-2">Promotion Description</label>
                    <textarea asp-for="PromotionDescription" rows="4" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="Describe the promotion details"></textarea>
                    <span asp-validation-for="PromotionDescription" class="text-red-500 text-sm"></span>
                </div>

                <!-- Discount Settings -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label asp-for="DiscountType" class="block text-sm font-medium text-gray-700 mb-2">Discount Type</label>
                        <select asp-for="DiscountType" asp-items="Html.GetEnumSelectList<ASI.Basecode.Resources.Constants.Enums.DiscountType>()" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
                            <option value="">Select Type</option>
                        </select>
                        <span asp-validation-for="DiscountType" class="text-red-500 text-sm"></span>
                    </div>
                    <div>
                        <label asp-for="DiscountValue" class="block text-sm font-medium text-gray-700 mb-2">Discount Value</label>
                        <input asp-for="DiscountValue" type="number" step="0.01" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="e.g., 20 or 5.00">
                        <span asp-validation-for="DiscountValue" class="text-red-500 text-sm"></span>
                    </div>
                    <div>
                        <label asp-for="MinimumOrderAmount" class="block text-sm font-medium text-gray-700 mb-2">Minimum Order Amount</label>
                        <input asp-for="MinimumOrderAmount" type="number" step="0.01" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="₱0.00">
                        <span asp-validation-for="MinimumOrderAmount" class="text-red-500 text-sm"></span>
                    </div>
                </div>

                <!-- Date Range -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="StartDate" class="block text-sm font-medium text-gray-700 mb-2">Start Date</label>
                        <input asp-for="StartDate" type="datetime-local" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm:ss")">
                        <span asp-validation-for="StartDate" class="text-red-500 text-sm"></span>
                    </div>
                    <div>
                        <label asp-for="EndDate" class="block text-sm font-medium text-gray-700 mb-2">End Date</label>
                        <input asp-for="EndDate" type="datetime-local" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")">
                        <span asp-validation-for="EndDate" class="text-red-500 text-sm"></span>
                    </div>
                </div>

                <!-- Promotion Code Settings -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label asp-for="Code" class="block text-sm font-medium text-gray-700 mb-2">Promotion Code</label>
                        <input asp-for="Code" type="text" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="e.g., SAVE20">
                        <span asp-validation-for="Code" class="text-red-500 text-sm"></span>
                    </div>
                    <div>
                        <label asp-for="UsageLimit" class="block text-sm font-medium text-gray-700 mb-2">Usage Limit</label>
                        <input asp-for="UsageLimit" type="number" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" placeholder="e.g., 100" value="@Model.UsageLimit">
                        <span asp-validation-for="UsageLimit" class="text-red-500 text-sm"></span>
                    </div>
                    <div>
                        <label asp-for="ExpirationDate" class="block text-sm font-medium text-gray-700 mb-2">Code Expiration Date</label>
                        <input asp-for="ExpirationDate" type="datetime-local" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" value="@Model.ExpirationDate.ToString("yyyy-MM-ddTHH:mm:ss")">
                        <span asp-validation-for="ExpirationDate" class="text-red-500 text-sm"></span>
                    </div>
                </div>

                <!-- Product Selection -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Applicable Products</label>
                    <div class="border rounded-lg p-4 max-h-40 overflow-y-auto bg-gray-50">
                        <div class="space-y-2">
                            @if (ViewBag.Products != null)
                            {
                                @foreach (var product in ViewBag.Products)
                                {
                                    <label class="flex items-center">
                                        <input type="checkbox" name="ProductIDs" value="@product.ProductID" class="mr-3 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500">
                                        <span class="text-sm">@product.ProductName</span>
                                    </label>
                                }
                            }
                            else
                            {
                                <p class="text-gray-500 text-sm">No products available</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Active Status -->
                <div>
                    <label class="flex items-center">
                        <input asp-for="IsActive" type="checkbox" class="mr-3 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500">
                        <span class="text-sm font-medium text-gray-700">Active Promotion</span>
                    </label>
                </div>

                <div class="flex justify-end gap-4 pt-6 border-t">
                    <a asp-action="Index" class="px-6 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50">Cancel</a>
                    <button type="submit" class="px-6 py-2 rounded bg-emerald-600 text-white hover:bg-emerald-700 focus:ring-2 focus:ring-emerald-500">Create Promotion</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Additional scripts for promotion creation can go here
    </script>
}
