<!-- CREATE CAMPAIGN -->
<div id="createCampaignModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-2xl rounded-lg shadow-lg overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b">
            <h3 class="text-lg font-semibold">Create Campaign</h3>
            <button type="button" class="text-gray-500 hover:text-gray-700" onclick="closeModal('createCampaignModal')"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6">
            <form id="createCampaignForm" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                        <input type="text" class="w-full px-4 py-2 border rounded-lg" placeholder="e.g., Grand Opening">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Budget (₱)</label>
                        <input type="number" class="w-full px-4 py-2 border rounded-lg" step="0.01">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Start</label>
                        <input type="date" class="w-full px-4 py-2 border rounded-lg">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">End</label>
                        <input type="date" class="w-full px-4 py-2 border rounded-lg">
                    </div>
                </div>

                <div>
                    <span class="block text-sm font-medium text-gray-700 mb-1">Channels</span>
                    <label class="inline-flex items-center mr-4"><input type="checkbox" class="mr-2">Facebook</label>
                    <label class="inline-flex items-center mr-4"><input type="checkbox" class="mr-2">Instagram</label>
                    <label class="inline-flex items-center"><input type="checkbox" class="mr-2">Email</label>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <textarea rows="3" class="w-full px-4 py-2 border rounded-lg" placeholder="What is this campaign about?"></textarea>
                </div>

                <div class="flex justify-end gap-2">
                    <button type="button" class="px-4 py-2 rounded border" onclick="closeModal('createCampaignModal')">Cancel</button>
                    <button type="submit" class="px-4 py-2 rounded bg-blue-600 text-white hover:bg-blue-700">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CREATE EVENT -->
<div id="createEventModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-2xl rounded-lg shadow-lg overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b">
            <h3 class="text-lg font-semibold">Create Event</h3>
            <button type="button" class="text-gray-500 hover:text-gray-700" onclick="closeModal('createEventModal')"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6">
            <form id="createEventForm" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
                        <input type="text" class="w-full px-4 py-2 border rounded-lg" placeholder="e.g., Burger Festival">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Date</label>
                        <input type="date" class="w-full px-4 py-2 border rounded-lg">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Time</label>
                        <input type="time" class="w-full px-4 py-2 border rounded-lg">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Location</label>
                        <input type="text" class="w-full px-4 py-2 border rounded-lg" placeholder="Restaurant Branch / Address">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Details</label>
                    <textarea rows="3" class="w-full px-4 py-2 border rounded-lg"></textarea>
                </div>

                <div class="flex justify-end gap-2">
                    <button type="button" class="px-4 py-2 rounded border" onclick="closeModal('createEventModal')">Cancel</button>
                    <button type="submit" class="px-4 py-2 rounded bg-emerald-600 text-white hover:bg-emerald-700">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CREATE DISCOUNT -->
<div id="createDiscountModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-md rounded-lg shadow-lg overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b">
            <h3 class="text-lg font-semibold">Create Discount</h3>
            <button type="button" class="text-gray-500 hover:text-gray-700" onclick="closeModal('createDiscountModal')"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6">
            <form id="createDiscountForm" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Code</label>
                    <input type="text" class="w-full px-4 py-2 border rounded-lg" placeholder="e.g., OPEN20">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
                        <select class="w-full px-3 py-2 border rounded-lg">
                            <option>Percent</option>
                            <option>Fixed Amount</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Value</label>
                        <input type="number" step="0.01" class="w-full px-4 py-2 border rounded-lg">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Start</label>
                        <input type="date" class="w-full px-4 py-2 border rounded-lg">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">End</label>
                        <input type="date" class="w-full px-4 py-2 border rounded-lg">
                    </div>
                </div>
                <div class="flex justify-end gap-2">
                    <button type="button" class="px-4 py-2 rounded border" onclick="closeModal('createDiscountModal')">Cancel</button>
                    <button type="submit" class="px-4 py-2 rounded bg-amber-600 text-white hover:bg-amber-700">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MANAGE TRENDING -->
<div id="manageTrendingModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-xl rounded-lg shadow-lg overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b">
            <h3 class="text-lg font-semibold">Manage Trending Items</h3>
            <button type="button" class="text-gray-500 hover:text-gray-700" onclick="closeModal('manageTrendingModal')"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6">
            <form id="manageTrendingForm" class="space-y-4">
                <p class="text-gray-600">Select items to feature as “Trending”.</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <label class="inline-flex items-center"><input type="checkbox" class="mr-2">Classic Burger</label>
                    <label class="inline-flex items-center"><input type="checkbox" class="mr-2">Spicy Chicken</label>
                    <label class="inline-flex items-center"><input type="checkbox" class="mr-2">Iced Tea</label>
                    <label class="inline-flex items-center"><input type="checkbox" class="mr-2">Fries</label>
                </div>
                <div class="flex justify-end gap-2">
                    <button type="button" class="px-4 py-2 rounded border" onclick="closeModal('manageTrendingModal')">Close</button>
                    <button type="submit" class="px-4 py-2 rounded bg-gray-800 text-white hover:bg-black">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT PROMOTION -->
<div id="editPromotionModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-3xl rounded-lg shadow-lg overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b">
            <h3 class="text-lg font-semibold">Edit Promotion</h3>
            <button type="button" class="text-gray-500 hover:text-gray-700" onclick="closeModal('editPromotionModal')"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6">
            <form id="editPromotionForm" class="space-y-5">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Promotion Name</label>
                        <input type="text" class="w-full px-4 py-2 border rounded-lg" placeholder="Promo Name">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Promotion Image</label>
                        <input type="file" class="w-full px-4 py-2 border rounded-lg">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Promotion Description</label>
                    <textarea rows="3" class="w-full px-4 py-2 border rounded-lg" placeholder="Describe the promotion"></textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Discount Type</label>
                        <select class="w-full px-3 py-2 border rounded-lg">
                            <option>Percent</option>
                            <option>Fixed Amount</option>
                            <option>BOGO</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Discount Value</label>
                        <input type="number" step="0.01" class="w-full px-4 py-2 border rounded-lg" placeholder="e.g., 20 or 100">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Minimum Order Amount</label>
                        <input type="number" step="0.01" class="w-full px-4 py-2 border rounded-lg" placeholder="₱0.00">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Start Date</label>
                        <input type="date" class="w-full px-4 py-2 border rounded-lg">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">End Date</label>
                        <input type="date" class="w-full px-4 py-2 border rounded-lg">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Promotion Code</label>
                        <input type="text" class="w-full px-4 py-2 border rounded-lg" placeholder="e.g., SAVE20">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Usage Limit</label>
                        <input type="number" class="w-full px-4 py-2 border rounded-lg" placeholder="e.g., 100">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Used Count</label>
                        <input type="number" class="w-full px-4 py-2 border rounded-lg" placeholder="0">
                    </div>
                </div>

                <div class="flex justify-end gap-2">
                    <button type="button" class="px-4 py-2 rounded border" onclick="closeModal('editPromotionModal')">Cancel</button>
                    <button type="submit" class="px-4 py-2 rounded bg-blue-600 text-white hover:bg-blue-700">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>