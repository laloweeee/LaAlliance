@{
    ViewData["Title"] = "My Profile";
}

<div class="max-w-3xl">
    <h1 class="text-2xl font-bold mb-4">My Profile</h1>

    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm space-y-4">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-full bg-green-100 flex items-center justify-center">
                <i class="fas fa-user text-green-600 text-xl"></i>
            </div>
            <div>
                <div class="text-lg font-semibold text-gray-900">@User.Identity?.Name</div>
                <div class="text-sm text-gray-500">Authenticated: @(User.Identity?.IsAuthenticated == true ? "Yes" : "No")</div>
            </div>
        </div>

        <hr class="my-2" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div>
                <div class="text-gray-500">Name Identifier</div>
                <div class="font-medium">
                    @User.FindFirst("nameidentifier")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                </div>
            </div>
            <div>
                <div class="text-gray-500">Email</div>
                <div class="font-medium">
                    @User.FindFirst("email")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                </div>
            </div>
        </div>
    </div>
</div>
