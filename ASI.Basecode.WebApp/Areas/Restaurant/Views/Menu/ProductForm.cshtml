@{
    ViewData["Title"] = "Product Form";

    var returnTab = ViewBag.ReturnTab;
}

@model ASI.Basecode.Services.ServiceModels.ProductViewModel

<div class="min-h-screen py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header Section -->
        <div class="mb-8">
            <a asp-controller="Menu" asp-action="Index" asp-area="Restaurant" asp-route-activeTab="@ViewBag.ReturnTab"
                class="inline-flex items-center text-emerald-600 hover:text-emerald-700 transition-all duration-200 mb-6 group">
                <i class="fas fa-arrow-left mr-2 transform group-hover:-translate-x-1 transition-transform"></i>
                <span class="font-medium">Back to Menu Book</span>
            </a>
            <div class="flex items-center space-x-4">
                <div class="flex-shrink-0">
                    <div class="w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center">
                        <i class="fas fa-utensils text-emerald-600 text-xl"></i>
                    </div>
                </div>
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">
                        @(Model.ProductID == 0 ? "Add New Product" : "Edit Product")
                    </h1>
                    <p class="text-gray-600 mt-1">@(Model.ProductID == 0 ? "Create a new menu item" : "Update product details")</p>
                </div>
            </div>
        </div>

        <!-- Form Card -->
        <form asp-action="@(Model.ProductID == 0 ? "AddProduct" : "UpdateProduct")" method="post" id="productForm" enctype="multipart/form-data" class="space-y-8">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductID" />
            <input type="hidden" name="returnTab" value="@returnTab" />

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Left Column - Product Information -->
                <div class="lg:col-span-2 space-y-6">
                    <!-- Product Information Card -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                        <div class="bg-gradient-to-r from-emerald-50 to-emerald-100 px-6 py-4 border-b border-emerald-200">
                            <h2 class="text-lg font-semibold text-gray-900 flex items-center">
                                <i class="fas fa-info-circle text-emerald-600 mr-2"></i>
                                Product Information
                            </h2>
                        </div>
                        <div class="p-6 space-y-6">
                            <div>
                                <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-2">
                                    Product Name <span class="text-red-500">*</span>
                                </label>
                                <input asp-for="Name" id="productName"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all duration-200 hover:border-gray-400"
                                    placeholder="e.g., Grilled Chicken Sandwich" required />
                                <span asp-validation-for="Name" class="text-red-500 text-sm mt-1 block"></span>
                            </div>
                            <div>
                                <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-2">
                                    Description
                                </label>
                                <textarea asp-for="Description"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all duration-200 hover:border-gray-400 resize-none"
                                    placeholder="Describe your product..." rows="5"></textarea>
                                <span asp-validation-for="Description" class="text-red-500 text-sm mt-1 block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Category Card -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                        <div class="bg-gradient-to-r from-blue-50 to-blue-100 px-6 py-4 border-b border-blue-200">
                            <h2 class="text-lg font-semibold text-gray-900 flex items-center">
                                <i class="fas fa-tag text-blue-600 mr-2"></i>
                                Category
                            </h2>
                        </div>
                        <div class="p-6">
                            <label for="categorySelect" class="block text-sm font-semibold text-gray-700 mb-2">
                                Select Category <span class="text-red-500">*</span>
                            </label>
                            <select asp-for="CategoryID" id="categorySelect"
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all duration-200 hover:border-gray-400 appearance-none bg-white cursor-pointer"
                                asp-items="@(new SelectList(ViewBag.Categories, "CategoryID", "Name"))"
                                required>
                                <option value="" disabled selected>Choose a category...</option>
                            </select>
                            <span asp-validation-for="CategoryID" class="text-red-500 text-sm mt-1 block"></span>
                        </div>
                    </div>

                    <!-- Pricing Card -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                        <div class="bg-gradient-to-r from-purple-50 to-purple-100 px-6 py-4 border-b border-purple-200">
                            <h2 class="text-lg font-semibold text-gray-900 flex items-center">
                                <i class="fas fa-dollar-sign text-purple-600 mr-2"></i>
                                Pricing
                            </h2>
                        </div>
                        <div class="p-6">
                            <label asp-for="Price" class="block text-sm font-semibold text-gray-700 mb-2">
                                Price (₱) <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500 font-medium">₱</span>
                                <input asp-for="Price" id="productPrice" type="number" step="0.01" min="0"
                                    class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all duration-200 hover:border-gray-400"
                                    placeholder="0.00" required />
                            </div>
                            <span asp-validation-for="Price" class="text-red-500 text-sm mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <!-- Right Column - Image and Availability -->
                <div class="space-y-6">
                    <!-- Product Image Card -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden sticky top-6">
                        <div class="bg-gradient-to-r from-orange-50 to-orange-100 px-6 py-4 border-b border-orange-200">
                            <h2 class="text-lg font-semibold text-gray-900 flex items-center">
                                <i class="fas fa-image text-orange-600 mr-2"></i>
                                Product Image
                            </h2>
                        </div>
                        <div class="p-6">
                            <label asp-for="ImageFile" class="block text-sm font-semibold text-gray-700 mb-3">
                                Upload Image <span class="text-red-500">*</span>
                            </label>
                            <div class="flex flex-col items-center justify-center w-full">
                                <label for="productImage" class="relative flex flex-col items-center justify-center w-full h-80 border-2 border-gray-300 border-dashed rounded-xl cursor-pointer bg-gray-50 hover:bg-gray-100 transition-all duration-200 group overflow-hidden">
                                    <div id="imagePreview" class="hidden w-full h-full relative">
                                        <img id="previewImg" src="" alt="Preview" class="w-full h-full object-cover" />
                                        <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 transition-all duration-200 flex items-center justify-center">
                                            <span class="text-white font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                                <i class="fas fa-sync-alt mr-2"></i>Change Image
                                            </span>
                                        </div>
                                    </div>
                                    <div id="uploadPlaceholder" class="flex flex-col items-center justify-center pt-5 pb-6 px-4">
                                        <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-200">
                                            <i class="fas fa-cloud-upload-alt text-3xl text-emerald-600"></i>
                                        </div>
                                        <p class="mb-2 text-sm text-gray-600 text-center">
                                            <span class="font-semibold text-emerald-600">Click to upload</span> or drag and drop
                                        </p>
                                        <p class="text-xs text-gray-500">PNG, JPG, JPEG (MAX. 5MB)</p>
                                        <p class="text-xs text-gray-400 mt-2">Recommended: 800x800px</p>
                                    </div>
                                    <input asp-for="ImageFile" id="productImage" type="file" class="hidden" accept="image/png,image/jpeg,image/jpg" />
                                </label>
                            </div>
                            <span asp-validation-for="ImageFile" class="text-red-500 text-sm mt-2 block"></span>
                        </div>
                    </div>

                    <!-- Product Availability Card -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                        <div class="bg-gradient-to-r from-green-50 to-green-100 px-6 py-4 border-b border-green-200">
                            <h2 class="text-lg font-semibold text-gray-900 flex items-center">
                                <i class="fas fa-toggle-on text-green-600 mr-2"></i>
                                Availability
                            </h2>
                        </div>
                        <div class="p-6">
                            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-200">
                                <div class="flex items-start space-x-3">
                                    <div class="flex-shrink-0">
                                        <i class="fas fa-shopping-cart text-gray-600 mt-1"></i>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">Available for Order</p>
                                        <p class="text-xs text-gray-500 mt-1">Customers can order this product</p>
                                    </div>
                                </div>
                                <label for="productAvailability" class="relative inline-flex items-center cursor-pointer">
                                    <input asp-for="IsActive" id="productAvailability" type="checkbox" class="sr-only peer" />
                                    <div class="w-14 h-7 bg-gray-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-emerald-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-emerald-600 shadow-inner"></div>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Customization Card -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="bg-gradient-to-r from-indigo-50 to-indigo-100 px-6 py-4 border-b border-indigo-200">
                    <div class="flex items-center justify-between">
                        <h2 class="text-lg font-semibold text-gray-900 flex items-center">
                            <i class="fas fa-sliders-h text-indigo-600 mr-2"></i>
                            Customization Options
                        </h2>
                        <button type="button" id="addCustomizationGroup" 
                            class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm rounded-lg font-medium transition-all duration-200 shadow-sm hover:shadow-md flex items-center">
                            <i class="fas fa-plus mr-2"></i>Add Group
                        </button>
                    </div>
                </div>
                <div class="p-6">
                    <div id="customizationGroupsContainer" class="space-y-6">
                        <!-- Customization groups will be added here dynamically -->
                    </div>
                    <div id="noCustomizationsMessage" class="text-center py-12 text-gray-500 bg-gray-50 rounded-xl border border-dashed border-gray-300">
                        <div class="flex flex-col items-center">
                            <div class="w-16 h-16 bg-indigo-100 rounded-full flex items-center justify-center mb-4">
                                <i class="fas fa-puzzle-piece text-indigo-500 text-xl"></i>
                            </div>
                            <p class="font-medium text-gray-700 mb-1">No customization groups added yet</p>
                            <p class="text-sm">Click "Add Group" to create customization options for this product</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-8 flex flex-col sm:flex-row gap-4 items-center justify-end bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
                <a asp-controller="Menu" asp-action="Index" asp-area="Restaurant" asp-route-activeTab="@ViewBag.ReturnTab"
                    class="w-full sm:w-auto px-6 py-3 border-2 border-gray-300 text-gray-700 rounded-xl hover:bg-gray-50 font-medium transition-all duration-200 text-center">
                    <i class="fas fa-times mr-2"></i>Cancel
                </a>
                <button type="submit" 
                    class="w-full sm:w-auto px-8 py-3 bg-gradient-to-r from-emerald-600 to-emerald-700 text-white rounded-xl hover:from-emerald-700 hover:to-emerald-800 font-medium shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200">
                    <i class="fas fa-save mr-2"></i>@(Model.ProductID == 0 ? "Create Product" : "Update Product")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let customizationGroupIndex = 0;
        let optionIndexes = {};
        
        // Image upload handler
        document.getElementById('productImage').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size must be less than 5MB');
                    this.value = '';
                    return;
                }
                
                if (!['image/png', 'image/jpeg', 'image/jpg'].includes(file.type)) {
                    alert('Please upload a valid image file (PNG, JPG, JPEG)');
                    this.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(event) {
                    document.getElementById('previewImg').src = event.target.result;
                    document.getElementById('imagePreview').classList.remove('hidden');
                    document.getElementById('uploadPlaceholder').classList.add('hidden');
                };
                reader.readAsDataURL(file);
            }
        });

        // Load existing image if editing
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                document.getElementById('previewImg').src = '@Model.ImageUrl';
                document.getElementById('imagePreview').classList.remove('hidden');
                document.getElementById('uploadPlaceholder').classList.add('hidden');
            });
            </text>
        }

        // Function to create option HTML
        function createOptionHTML(groupIndex, optionIndex, optionName = '', additionalPrice = 0, optionID = 0) {
            return `
                <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center option-item bg-white p-3 rounded-lg border border-gray-200 hover:border-indigo-300 transition-all duration-200 shadow-sm">
                    <div class="hidden sm:block flex-shrink-0 text-gray-400 cursor-move">
                        <i class="fas fa-grip-vertical"></i>
                    </div>
                    <div class="flex-1 w-full sm:w-auto">
                        <input type="text" 
                            name="CustomizationGroups[${groupIndex}].CustomizationOptions[${optionIndex}].OptionName"
                            value="${optionName}"
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
                            placeholder="Option name" required />
                        <input type="hidden" 
                            name="CustomizationGroups[${groupIndex}].CustomizationOptions[${optionIndex}].CustomizationOptionID" 
                            value="${optionID}" />
                    </div>
                    <div class="w-full sm:w-36 flex items-center gap-3">
                        <div class="relative flex-1 sm:flex-none sm:w-3/4">
                            <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-500 text-sm">₱</span>
                            <input type="number" step="0.01" min="0"
                                name="CustomizationGroups[${groupIndex}].CustomizationOptions[${optionIndex}].AdditionalPrice"
                                value="${additionalPrice}"
                                class="w-full pl-7 pr-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
                                placeholder="0.00" />
                        </div>
                        <button type="button" class="remove-option flex-shrink-0 text-gray-400 hover:text-red-600 p-2 rounded-full hover:bg-red-50 transition-colors sm:p-1.5">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                </div>
            `;
        }

        // Function to create group HTML
        function createGroupHTML(groupIndex, groupName = '', isRequired = false, numberOfChoice = 1, groupID = 0) {
            return `
                <div class="customization-group border border-gray-200 rounded-xl shadow-sm overflow-hidden" data-group-index="${groupIndex}">
                    <div class="bg-gradient-to-r from-gray-50 to-gray-100 px-4 sm:px-5 py-4 border-b border-gray-200 cursor-pointer group-header flex items-start sm:items-center justify-between gap-3">
                        <div class="flex items-start sm:items-center flex-1 min-w-0">
                            <div class="mr-2 sm:mr-3 text-indigo-600 flex-shrink-0">
                                <i class="fas fa-layer-group"></i>
                            </div>
                            <div class="flex flex-col sm:flex-row sm:items-center gap-2 min-w-0 flex-1">
                                <h3 class="text-sm sm:text-md font-semibold text-gray-900 group-title truncate">Customization Group #${groupIndex + 1}</h3>
                                <div class="text-xs px-2 py-1 bg-indigo-100 text-indigo-700 rounded-full font-medium group-status inline-flex items-center w-fit">
                                    ${isRequired ? 'Required' : 'Optional'}
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2 flex-shrink-0">
                            <button type="button" class="toggle-group-collapse text-gray-500 hover:text-gray-700 p-1">
                                <i class="fas fa-chevron-down"></i>
                            </button>
                            <button type="button" class="remove-group text-gray-500 hover:text-red-600 p-1 hover:bg-red-50 rounded">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="group-content bg-gray-50 p-4 sm:p-5">
                        <div class="space-y-5">
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        Group Name <span class="text-red-500">*</span>
                                    </label>
                                    <input type="text" name="CustomizationGroups[${groupIndex}].CustomizationName" 
                                        value="${groupName}"
                                        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                        placeholder="e.g., Size, Toppings" required />
                                    <input type="hidden" name="CustomizationGroups[${groupIndex}].CustomizationGroupID" value="${groupID}" />
                                </div>
                                <div>
                                    <div class="flex flex-col space-y-4">
                                        <label class="block text-sm font-medium text-gray-700">Selection Options</label>
                                        <div class="flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center gap-4 sm:gap-6">
                                            <label class="inline-flex items-center cursor-pointer w-full sm:w-auto">
                                                <div class="relative flex-shrink-0">
                                                    <input type="checkbox" name="CustomizationGroups[${groupIndex}].IsRequired" 
                                                        value="true" class="sr-only peer" 
                                                        ${isRequired ? 'checked' : ''} />
                                                    <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-indigo-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-500"></div>
                                                </div>
                                                <span class="ml-2 text-sm text-gray-700">Required Selection</span>
                                            </label>
                                            <div class="flex items-center w-full sm:w-auto">
                                                <label class="text-sm text-gray-700 mr-2 whitespace-nowrap flex-shrink-0">Max Selections:</label>
                                                <div class="w-20 sm:w-16 flex rounded-lg border border-gray-300 flex-shrink-0">
                                                    <input type="number" name="CustomizationGroups[${groupIndex}].NumberOfChoice" 
                                                        value="${numberOfChoice}" min="1"
                                                        class="w-full px-2 py-1 text-center border-0 focus:ring-0 text-sm flex-shrink-0" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div>
                                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-3 gap-3">
                                    <label class="block text-sm font-medium text-gray-700">Customization Options</label>
                                    <button type="button" class="add-option inline-flex items-center px-3 py-1.5 bg-indigo-100 hover:bg-indigo-200 text-indigo-700 text-sm rounded-lg font-medium transition-all duration-200 w-full sm:w-auto justify-center">
                                        <i class="fas fa-plus mr-1.5"></i>Add Option
                                    </button>
                                </div>
                                <div class="options-container space-y-2.5 max-h-80 overflow-y-auto pr-1">
                                    <!-- Options will be added here -->
                                </div>
                                <div class="options-empty-state py-8 text-center hidden">
                                    <div class="flex flex-col items-center px-4">
                                        <i class="fas fa-list-ul text-gray-300 text-3xl mb-2"></i>
                                        <p class="text-sm text-gray-500">Add at least one option for this customization group</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        // Load existing customization groups if editing
        @if (Model.CustomizationGroups != null && Model.CustomizationGroups.Count > 0)
        {
            <text>
                document.addEventListener('DOMContentLoaded', function() {
                    const container = document.getElementById('customizationGroupsContainer');
                    const noMessage = document.getElementById('noCustomizationsMessage');
                    noMessage.classList.add('hidden');

                    @foreach (var group in Model.CustomizationGroups)
                    {
                        <text>
                            (function() {
                                // Initialize option index for this group based on existing options count
                                optionIndexes[customizationGroupIndex] = @(group.CustomizationOptions?.Count ?? 0);

                                // Create group
                                const groupHTML = createGroupHTML(
                                customizationGroupIndex,
                                '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(group.CustomizationName))',
                                                    @group.IsRequired.ToString().ToLower(),
                                                    @group.NumberOfChoice,
                                @group.CustomizationGroupID
                                );

                                container.insertAdjacentHTML('beforeend', groupHTML);

                                // Add options for this group
                                const optionsContainer = container.querySelector(`[data-group-index="${customizationGroupIndex}"] .options-container`);

                                @if (group.CustomizationOptions != null && group.CustomizationOptions.Any())
                                {
                                    var optionIndex = 0;
                                    foreach (var option in group.CustomizationOptions)
                                    {
                                        <text>
                                            (function() {
                                                const optionHTML = createOptionHTML(
                                                    customizationGroupIndex,
                                                    @optionIndex,
                                                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(option.OptionName))',
                                                    @option.AdditionalPrice,
                                                    @option.CustomizationOptionID
                                                );
                                                optionsContainer.insertAdjacentHTML('beforeend', optionHTML);
                                            })();
                                        </text>
                                        optionIndex++;
                                    }
                                }

                                customizationGroupIndex++;
                            })();
                        </text>
                    }
                });
            </text>
        }

        // Add Customization Group
        document.getElementById('addCustomizationGroup').addEventListener('click', function() {
            const container = document.getElementById('customizationGroupsContainer');
            const noMessage = document.getElementById('noCustomizationsMessage');
            
            noMessage.classList.add('hidden');
            
            // Initialize option index for this group
            optionIndexes[customizationGroupIndex] = 0;
            
            const groupHTML = createGroupHTML(customizationGroupIndex);
            container.insertAdjacentHTML('beforeend', groupHTML);
            customizationGroupIndex++;
        });

        // Function to reindex all groups
        function reindexGroups() {
            const container = document.getElementById('customizationGroupsContainer');
            const groups = container.querySelectorAll('.customization-group');
            
            groups.forEach((group, newIndex) => {
                const oldIndex = group.dataset.groupIndex;
                
                // Update group data attribute
                group.dataset.groupIndex = newIndex;
                
                // Update group title
                const title = group.querySelector('h3');
                title.textContent = `Customization Group #${newIndex + 1}`;
                
                // Update all input names in the group
                const inputs = group.querySelectorAll('input, select, textarea');
                inputs.forEach(input => {
                    if (input.name) {
                        input.name = input.name.replace(/CustomizationGroups\[\d+\]/, `CustomizationGroups[${newIndex}]`);
                    }
                });
                
                // Move option indexes if they exist
                if (optionIndexes[oldIndex] !== undefined) {
                    optionIndexes[newIndex] = optionIndexes[oldIndex];
                    delete optionIndexes[oldIndex];
                }
            });
            
            // Update global group index
            customizationGroupIndex = groups.length;
        }

        // Delegate event for removing groups
        document.getElementById('customizationGroupsContainer').addEventListener('click', function(e) {
            if (e.target.closest('.remove-group')) {
                const group = e.target.closest('.customization-group');
                const groupIndex = group.dataset.groupIndex;
                
                // Clean up option index for removed group
                delete optionIndexes[groupIndex];
                
                group.remove();
                
                // Reindex all remaining groups
                reindexGroups();
                
                const container = document.getElementById('customizationGroupsContainer');
                if (container.children.length === 0) {
                    document.getElementById('noCustomizationsMessage').classList.remove('hidden');
                }
            }
        });

        // Delegate event for adding options
        document.getElementById('customizationGroupsContainer').addEventListener('click', function(e) {
            if (e.target.closest('.add-option')) {
                const group = e.target.closest('.customization-group');
                const groupIndex = group.dataset.groupIndex;
                const optionsContainer = group.querySelector('.options-container');
                
                // Get current option index for this group
                const optionIndex = optionIndexes[groupIndex] || 0;
                
                const optionHTML = createOptionHTML(groupIndex, optionIndex);
                optionsContainer.insertAdjacentHTML('beforeend', optionHTML);
                optionIndexes[groupIndex]++;
            }
        });

        // Function to reindex options within a group
        function reindexOptions(groupIndex) {
            const group = document.querySelector(`[data-group-index="${groupIndex}"]`);
            if (!group) return;
            
            const optionsContainer = group.querySelector('.options-container');
            const options = optionsContainer.querySelectorAll('.option-item');
            
            options.forEach((option, newIndex) => {
                const inputs = option.querySelectorAll('input');
                inputs.forEach(input => {
                    if (input.name) {
                        input.name = input.name.replace(/CustomizationOptions\[\d+\]/, `CustomizationOptions[${newIndex}]`);
                    }
                });
            });
            
            // Update option index for this group
            optionIndexes[groupIndex] = options.length;
        }

        // Delegate event for removing options
        document.getElementById('customizationGroupsContainer').addEventListener('click', function(e) {
            if (e.target.closest('.remove-option')) {
                const optionItem = e.target.closest('.option-item');
                const group = optionItem.closest('.customization-group');
                const groupIndex = group.dataset.groupIndex;
                
                optionItem.remove();
                
                // Reindex options in this group
                reindexOptions(groupIndex);
            }
        });

        // Form validation
        document.getElementById('productForm').addEventListener('submit', function(e) {
            const price = document.getElementById('productPrice').value;
            if (price <= 0) {
                e.preventDefault();
                alert('Price must be greater than zero');
                return false;
            }

            // Validate customization groups have at least one option
            const groups = document.querySelectorAll('.customization-group');
            for (let group of groups) {
                const options = group.querySelectorAll('.option-item');
                if (options.length === 0) {
                    e.preventDefault();
                    alert('Each customization group must have at least one option');
                    return false;
                }
                
                // Validate NumberOfChoice is valid
                const numberOfChoiceInput = group.querySelector('input[name*=".NumberOfChoice"]');
                if (numberOfChoiceInput) {
                    const numberOfChoice = parseInt(numberOfChoiceInput.value) || 1;
                    const optionsCount = options.length;
                    
                    if (numberOfChoice <= 0) {
                        e.preventDefault();
                        alert('Maximum selections must be at least 1');
                        return false;
                    }
                    
                    if (numberOfChoice > optionsCount) {
                        e.preventDefault();
                        alert(`Maximum selections (${numberOfChoice}) cannot be greater than the number of available options (${optionsCount})`);
                        return false;
                    }
                }
                
                // Validate that all options have names
                const optionInputs = group.querySelectorAll('input[name*=".OptionName"]');
                for (let input of optionInputs) {
                    if (!input.value.trim()) {
                        e.preventDefault();
                        alert('All customization options must have a name');
                        return false;
                    }
                }
            }
        });
    </script>
}