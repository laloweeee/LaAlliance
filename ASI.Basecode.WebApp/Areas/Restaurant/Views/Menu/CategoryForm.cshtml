@using ASI.Basecode.WebApp.Models
@model ASI.Basecode.Services.ServiceModels.CategoryViewModel
@{
    ViewData["Title"] = "Category Form";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<div class="py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header Section -->
        <div class="mb-8">
            <a asp-controller="Menu" asp-action="Index" asp-area="Restaurant" asp-route-activeTab="@ViewBag.ReturnTab"
                class="inline-flex items-center text-emerald-600 hover:text-emerald-700 transition-all duration-200 mb-6 group">
                <i class="fas fa-arrow-left mr-2 transform group-hover:-translate-x-1 transition-transform"></i>
                <span class="font-medium">Back to Menu Book</span>
            </a>
            <div class="flex items-center space-x-4">
                <div class="flex-shrink-0">
                    <div class="w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center">
                        <i class="fas fa-tag text-emerald-600 text-xl"></i>
                    </div>
                </div>
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">
                        @(Model.CategoryID == 0 ? "Add New Category" : "Edit Category")
                    </h1>
                    <p class="text-gray-600 mt-1">@(Model.CategoryID == 0 ? "Create a new menu category" : "Update category details")</p>
                </div>
            </div>
        </div>
        <!-- Form Card -->
        <form asp-action="@(Model.CategoryID == 0 ? "AddCategory" : "UpdateCategory")" method="post" id="categoryForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CategoryID" />
            <input type="hidden" name="returnTab" value="@ViewBag.ReturnTab" />
            
            <div class="space-y-6">
                <!-- Category Information Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="bg-gradient-to-r from-emerald-50 to-emerald-100 px-6 py-4 border-b border-emerald-200">
                        <h2 class="text-lg font-semibold text-gray-900 flex items-center">
                            <i class="fas fa-info-circle text-emerald-600 mr-2"></i>
                            Category Information
                        </h2>
                    </div>
                    <div class="p-6">
                        <label asp-for="CategoryName" class="block text-sm font-semibold text-gray-700 mb-2">
                            Category Name <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="CategoryName" id="categoryName"
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all duration-200 hover:border-gray-400"
                            placeholder="e.g., Appetizers, Main Course, Desserts" required />
                        <span asp-validation-for="CategoryName" class="text-red-500 text-sm mt-1 block"></span>
                    </div>
                </div>

                <!-- Availability Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="bg-gradient-to-r from-green-50 to-green-100 px-6 py-4 border-b border-green-200">
                        <h2 class="text-lg font-semibold text-gray-900 flex items-center">
                            <i class="fas fa-toggle-on text-green-600 mr-2"></i>
                            Availability
                        </h2>
                    </div>
                    <div class="p-6">
                        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-200">
                            <div class="flex items-start space-x-3">
                                <div class="flex-shrink-0">
                                    <i class="fas fa-eye text-gray-600 mt-1"></i>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-gray-900">Category Visibility</p>
                                    <p class="text-xs text-gray-500 mt-1">Make this category visible in the menu</p>
                                </div>
                            </div>
                            <label for="isActiveCheckbox" class="relative inline-flex items-center cursor-pointer">
                                <input asp-for="IsActive" id="isActiveCheckbox" type="checkbox" class="sr-only peer" />
                                <div class="w-14 h-7 bg-gray-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-emerald-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-emerald-600 shadow-inner"></div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-8 flex flex-col sm:flex-row gap-4 items-center justify-end bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
                <a asp-controller="Menu" asp-action="Index" asp-area="Restaurant" asp-route-activeTab="@ViewBag.ReturnTab"
                    class="w-full sm:w-auto px-6 py-3 border-2 border-gray-300 text-gray-700 rounded-xl hover:bg-gray-50 font-medium transition-all duration-200 text-center">
                    <i class="fas fa-times mr-2"></i>Cancel
                </a>
                <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-gradient-to-r from-emerald-600 to-emerald-700 text-white rounded-xl hover:from-emerald-700 hover:to-emerald-800 font-medium shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200">
                    <span class="btn-text">
                        <i class="fas fa-save mr-2"></i>@(Model.CategoryID == 0 ? "Create Category" : "Update Category")
                    </span>
                    <span class="btn-loading hidden">
                        <i class="fas fa-spinner fa-spin mr-2"></i>
                        @(Model.CategoryID == 0 ? "Creating..." : "Updating...")
                    </span>
                </button>
            </div>
        </form>

        <!-- Delete Button (Only for existing categories) -->
        @if (Model.CategoryID != 0)
        {
            <div class="bg-white rounded-2xl shadow-sm border border-red-200 overflow-hidden">
                <div class="bg-gradient-to-r from-red-50 to-red-100 px-6 py-4 border-b border-red-200">
                    <h2 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fas fa-exclamation-triangle text-red-600 mr-2"></i>
                        Danger Zone
                    </h2>
                </div>
                <div class="p-6">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                        <div>
                            <h3 class="text-sm font-semibold text-gray-900">Delete this category</h3>
                            <p class="text-xs text-gray-500 mt-1">If you accidentally deleted this category, you can still recover it.</p>
                        </div>
                        <button type="button"
                                data-confirm-delete 
                                data-item-id="@Model.CategoryID"
                                data-item-name="@Model.CategoryName"
                                data-url="@Url.Action("DeleteCategory", "Menu", new { area = "Restaurant" })"
                                class="px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-xl font-medium shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200">
                                <i class="fas fa-trash-alt mr-2"></i>Delete Category
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>