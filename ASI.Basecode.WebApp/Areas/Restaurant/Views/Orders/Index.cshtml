@model List<ASI.Basecode.Services.ServiceModels.OrderViewModel>
@using ASI.Basecode.Resources.Constants

@{
    ViewData["Title"] = "Order List";

    // Small helpers for initial render (server-side)
    string StatusLabel(Enums.OrderStatus s) => s switch
    {
        Enums.OrderStatus.Pending           => "New Order",
        Enums.OrderStatus.Processing        => "Processing",
        Enums.OrderStatus.ReadyForPickup    => "Ready for Pickup",
        Enums.OrderStatus.ReadyForDelivery  => "Ready for Delivery",
        Enums.OrderStatus.Completed         => "Completed",
        _                                   => s.ToString()
    };

    string StatusBadgeClass(Enums.OrderStatus s) => s switch
    {
        Enums.OrderStatus.Pending           => "bg-purple-100 text-purple-700",
        Enums.OrderStatus.Processing        => "bg-amber-100 text-amber-700",
        Enums.OrderStatus.ReadyForPickup    => "bg-blue-100 text-blue-700",
        Enums.OrderStatus.ReadyForDelivery  => "bg-indigo-100 text-indigo-700",
        Enums.OrderStatus.Completed         => "bg-emerald-100 text-emerald-700",
        _                                   => "bg-gray-100 text-gray-700"
    };
}

@Html.AntiForgeryToken()

<div id="orders" class="section active">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
        <div class="flex flex-col md:flex-row gap-4">
            <div class="relative">
                <input id="searchInput" type="text" placeholder="Search orders..."
                       class="pl-10 pr-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 w-full md:w-64">
                <i class="fas fa-search absolute left-3 top-3.5 text-gray-400"></i>
            </div>
            <button onclick="refreshOrders()" class="bg-emerald-600 text-white px-4 py-2 rounded-xl hover:bg-emerald-700 transition-colors">
                <i class="fas fa-sync-alt mr-2"></i>Refresh
            </button>
        </div>

        <!-- Connection -->
        <div class="flex items-center gap-2 mt-4 md:mt-0">
            <span id="connectionStatus" class="text-sm">
                <i class="fas fa-circle text-gray-400"></i> Connecting...
            </span>
        </div>
    </div>

    <!-- Tabs -->
    <div class="mb-6">
        <div class="border-b border-gray-200">
            <nav class="-mb-px flex space-x-8 overflow-x-auto">
                <button onclick="filterOrders('all')" class="order-filter-tab active border-b-2 border-emerald-500 py-2 px-1 text-sm font-medium text-emerald-600 whitespace-nowrap">
                    All Orders <span id="count-all" class="ml-1 text-xs bg-emerald-100 px-2 py-0.5 rounded-full">0</span>
                </button>
                <button onclick="filterOrders('Pending')" class="order-filter-tab border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap">
                    New <span id="count-pending" class="ml-1 text-xs bg-gray-100 px-2 py-0.5 rounded-full">0</span>
                </button>
                <button onclick="filterOrders('Processing')" class="order-filter-tab border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap">
                    Preparing <span id="count-processing" class="ml-1 text-xs bg-gray-100 px-2 py-0.5 rounded-full">0</span>
                </button>
                <button onclick="filterOrders('ReadyForPickup')" class="order-filter-tab border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap">
                    For Pickup <span id="count-ready-pickup" class="ml-1 text-xs bg-gray-100 px-2 py-0.5 rounded-full">0</span>
                </button>
                <button onclick="filterOrders('ReadyForDelivery')" class="order-filter-tab border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap">
                    For Delivery <span id="count-ready-delivery" class="ml-1 text-xs bg-gray-100 px-2 py-0.5 rounded-full">0</span>
                </button>
                <button onclick="filterOrders('Completed')" class="order-filter-tab border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap">
                    Completed <span id="count-completed" class="ml-1 text-xs bg-gray-100 px-2 py-0.5 rounded-full">0</span>
                </button>
            </nav>
        </div>
    </div>

    <!-- Grid -->
    <div class="mb-2">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">ACTIVE ORDERS</h3>

        <div id="ordersGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            @if (Model != null && Model.Any())
            {
                @foreach (var order in Model)
                {
                    <div id="order-@order.OrderID"
                         data-status="@order.OrderStatus"
                         data-order-id="@order.OrderID"
                         class="order-card rounded-2xl bg-white shadow-sm ring-1 ring-gray-100 hover:shadow-md transition-all duration-200">

                        <!-- Top header row -->
                        <div class="p-4 pb-0">
                            <div class="flex items-start justify-between">
                                <div class="min-w-0">
                                    <div class="text-gray-900 font-semibold truncate">@order.FirstName @order.LastName</div>
                                    <div class="mt-1 text-xs text-gray-500 flex items-center gap-3">
                                        <span title="Contact"><i class="fas fa-phone mr-1"></i>@order.ContactNumber</span>
                                        <span class="hidden sm:inline">•</span>
                                        <span><i class="far fa-clock mr-1"></i>@order.OrderDate.ToString("MMM dd, yyyy h:mm tt")</span>
                                        <span class="hidden sm:inline">•</span>
                                        <span><i class="fas fa-@(order.OrderType.ToString() == "Delivery" ? "motorcycle" : "shopping-bag") mr-1"></i>@order.OrderType</span>
                                    </div>
                                </div>

                                <div class="flex items-center gap-2">
                                    <!-- status badge -->
                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-[11px] font-medium @StatusBadgeClass(order.OrderStatus)">
                                        <i class="fas fa-circle text-current text-[7px] mr-1.5"></i>@StatusLabel(order.OrderStatus)
                                    </span>
                                    <!-- order number pill -->
                                    <span class="shrink-0 inline-flex items-center px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 text-xs font-semibold">#@order.OrderID</span>
                                </div>
                            </div>
                        </div>

                        <!-- Items -->
                        <div class="px-4 pt-3 pb-2">
                            <div class="space-y-1.5 max-h-24 overflow-y-auto pr-1">
                                @if (order.OrderItems != null && order.OrderItems.Any())
                                {
                                    foreach (var item in order.OrderItems)
                                    {
                                        <div class="text-sm text-gray-700 flex justify-between">
                                            <span class="truncate">
                                                <span class="font-medium">@item.Quantity x @item.ProductName</span>
                                                @if (item.OrderItemOptions != null && item.OrderItemOptions.Any())
                                                {
                                                    <span class="text-xs text-gray-500 ml-1">(
                                                        @string.Join(", ", item.OrderItemOptions.Select(o => o.OptionName))
                                                        )</span>
                                                }
                                            </span>
                                            <span class="font-semibold">₱@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-sm text-gray-500">No products</div>
                                }
                            </div>
                        </div>

                        <!-- Footer with totals + actions -->
                        <div class="px-4 pt-2 pb-4">
                            <div class="border-t border-gray-100 pt-3">
                                <div class="flex items-end justify-between">
                                    <div class="text-xs text-gray-500">
                                        <div class="flex justify-between"><span>Subtotal</span><span class="ml-3 font-medium text-gray-700">₱@order.SubTotal.ToString("N2")</span></div>
                                        @if (order.DeliveryFee > 0)
                                        {
                                            <div class="flex justify-between"><span>Delivery fee</span><span class="ml-3 font-medium text-gray-700">₱@order.DeliveryFee.ToString("N2")</span></div>
                                        }
                                        <div class="mt-1 text-gray-900 text-sm font-bold flex justify-between">
                                            <span>Total</span><span class="ml-3 text-lime-600 font-extrabold">₱@order.TotalAmount.ToString("N2")</span>
                                        </div>
                                    </div>

                                    <div class="flex-1"></div>

                                    <div class="w-36">
                                        <div class="flex gap-2">
                                            @if (order.OrderStatus.ToString() == "Pending")
                                            {
                                                <button onclick="acceptOrder(@order.OrderID)" class="flex-1 bg-emerald-600 text-white py-2 rounded-xl text-sm font-medium hover:bg-emerald-700 transition-colors">Accept</button>
                                                <button onclick="rejectOrder(@order.OrderID)" class="flex-1 bg-red-50 text-red-700 py-2 rounded-xl text-sm font-medium hover:bg-red-100 transition-colors">Reject</button>
                                            }
                                            else if (order.OrderStatus.ToString() == "Processing")
                                            {
                                                <button onclick="markOrderReady(@order.OrderID)" class="flex-1 bg-blue-600 text-white py-2 rounded-xl text-sm font-medium hover:bg-blue-700 transition-colors">Mark Ready</button>
                                            }
                                            else if (order.OrderStatus.ToString() == "ReadyForPickup" || order.OrderStatus.ToString() == "ReadyForDelivery")
                                            {
                                                <button onclick="completeOrder(@order.OrderID)" class="flex-1 bg-emerald-600 text-white py-2 rounded-xl text-sm font-medium hover:bg-emerald-700 transition-colors">Complete</button>
                                            }
                                        </div>
                                        <a href="/Restaurant/Orders/ViewOrder/@order.OrderID"
                                           class="mt-2 inline-flex w-full items-center justify-center bg-gray-100 text-gray-800 py-2 rounded-xl text-sm font-medium hover:bg-gray-200 transition-colors">
                                            View
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-gray-500 col-span-full text-center py-8">No orders found.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        let currentFilter = 'all';

        // ===== Helpers to keep badge label & color consistent =====
        function labelForStatus(s) {
            switch (s) {
                case 'Pending':          return 'New Order';
                case 'Processing':       return 'Processing';
                case 'ReadyForPickup':   return 'Ready for Pickup';
                case 'ReadyForDelivery': return 'Ready for Delivery';
                case 'Completed':        return 'Completed';
                default:                return s;
            }
        }
        function badgeClassFor(s) {
            switch (s) {
                case 'Pending':          return 'bg-purple-100 text-purple-700';
                case 'Processing':       return 'bg-amber-100 text-amber-700';
                case 'ReadyForPickup':   return 'bg-blue-100 text-blue-700';
                case 'ReadyForDelivery': return 'bg-indigo-100 text-indigo-700';
                case 'Completed':        return 'bg-emerald-100 text-emerald-700';
                default:                return 'bg-gray-100 text-gray-700';
            }
        }

        // ===== SignalR =====
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .withAutomaticReconnect()
            .configureLogging(signalR.LogLevel.Information)
            .build();

        connection.onreconnecting(() => updateConnectionStatus("Reconnecting...", "warning"));
        connection.onreconnected(() => { updateConnectionStatus("Connected", "success"); connection.invoke("JoinRestaurantGroup"); });
        connection.onclose(() => updateConnectionStatus("Disconnected", "error"));

        // New order arrives: render ON TOP
        connection.on("NewOrderReceived", (order) => {
            addOrderToUI(order);
            showNotification(`New Order #${order.orderId} from ${order.customerName}`);
            playNotificationSound();
            updateOrderCounts();
        });

        // Status changed for other connecting functions
        connection.on("OrderStatusChanged", (data) => {
            const orderCard = document.getElementById(`order-${data.orderId}`);
            if (!orderCard) return;

            orderCard.setAttribute('data-status', data.newStatus);

            // Update badge
            const badge = orderCard.querySelector('span.inline-flex.rounded-full');
            if (badge) {
                badge.className = 'inline-flex items-center px-2 py-1 rounded-full text-[11px] font-medium ' + badgeClassFor(data.newStatus);
                badge.innerHTML = `<i class="fas fa-circle text-current text-[7px] mr-1.5"></i>${labelForStatus(data.newStatus)}`;
            }

            // Remove action buttons if order is completed
            if (data.newStatus === 'Completed') {
                const buttonsDiv = orderCard.querySelector('.w-36 > .flex.gap-2');
                if (buttonsDiv) buttonsDiv.innerHTML = '';
            }

            updateOrderCounts();
            if (currentFilter !== 'all' && currentFilter !== data.newStatus) {
                orderCard.style.display = 'none';
            }
        });

        connection.start()
            .then(() => { updateConnectionStatus("Connected", "success"); return connection.invoke("JoinRestaurantGroup"); })
            .then(() => updateOrderCounts())
            .catch(err => { console.error("Connection error:", err); updateConnectionStatus("Connection failed", "error"); });

        function updateConnectionStatus(message, type) {
            const statusEl = document.getElementById("connectionStatus");
            const iconClass = type === "success" ? "text-emerald-500" : type === "warning" ? "text-amber-500" : "text-red-500";
            statusEl.innerHTML = `<i class="fas fa-circle ${iconClass}"></i> ${message}`;
        }

        // ===== Create a new card for SignalR push =====
        function addOrderToUI(order) {
            const ordersGrid = document.getElementById("ordersGrid");
            if (document.getElementById(`order-${order.orderId}`)) return;

            const itemsList = order.items.map(item => {
                let optionsHtml = '';
                if (item.options && item.options.length > 0) {
                    optionsHtml = '<span class="text-xs text-gray-500 ml-1">(' + item.options.map(o => o.optionName).join(', ') + ')</span>';
                }
                return `
                    <div class="text-sm text-gray-700 flex justify-between">
                        <span class="truncate"><span class="font-medium">${item.quantity} x ${item.name}</span>${optionsHtml}</span>
                        <span class="font-semibold">₱${(item.price * item.quantity).toFixed(2)}</span>
                    </div>`;
            }).join('');

            const deliveryInfo = order.orderType === 'Delivery' ? `<i class="fas fa-motorcycle mr-1"></i>Delivery` : `<i class="fas fa-shopping-bag mr-1"></i>Pickup`;

            const orderCard = `
                <div id="order-${order.orderId}" data-status="Pending" data-order-id="${order.orderId}"
                     class="order-card rounded-2xl bg-white shadow-sm ring-1 ring-gray-100 hover:shadow-md transition-all duration-200 animate-slide-in">
                    <div class="p-4 pb-0">
                        <div class="flex items-start justify-between">
                            <div class="min-w-0">
                                <div class="text-gray-900 font-semibold truncate">${order.customerName}</div>
                                <div class="mt-1 text-xs text-gray-500 flex items-center gap-3">
                                    <span title="Contact"><i class="fas fa-phone mr-1"></i>${order.contactNumber || ''}</span>
                                    <span class="hidden sm:inline">•</span>
                                    <span><i class="far fa-clock mr-1"></i>${new Date(order.timestamp).toLocaleString()}</span>
                                    <span class="hidden sm:inline">•</span>
                                    <span>${deliveryInfo}</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-[11px] font-medium ${badgeClassFor('Pending')}">
                                    <i class="fas fa-circle text-current text-[7px] mr-1.5"></i>${labelForStatus('Pending')}
                                </span>
                                <span class="shrink-0 inline-flex items-center px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 text-xs font-semibold">#${order.orderId}</span>
                            </div>
                        </div>
                    </div>

                    <div class="px-4 pt-3 pb-2">
                        <div class="space-y-1.5 max-h-24 overflow-y-auto pr-1">${itemsList}</div>
                    </div>

                    <div class="px-4 pt-2 pb-4">
                        <div class="border-t border-gray-100 pt-3">
                            <div class="flex items-end justify-between">
                                <div class="text-xs text-gray-500">
                                    <div class="flex justify-between"><span>Subtotal</span><span class="ml-3 font-medium text-gray-700">₱${order.subtotal.toFixed(2)}</span></div>
                                    ${order.deliveryFee > 0 ? `<div class="flex justify-between"><span>Delivery fee</span><span class="ml-3 font-medium text-gray-700">₱${order.deliveryFee.toFixed(2)}</span></div>` : ''}
                                    <div class="mt-1 text-gray-900 text-sm font-bold flex justify-between">
                                        <span>Total</span><span class="ml-3 text-lime-600 font-extrabold">₱${order.totalAmount.toFixed(2)}</span>
                                    </div>
                                </div>
                                <div class="w-36">
                                    <div class="flex gap-2">
                                        <button onclick="acceptOrder(${order.orderId})" class="flex-1 bg-emerald-600 text-white py-2 rounded-xl text-sm font-medium hover:bg-emerald-700 transition-colors">Accept</button>
                                        <button onclick="rejectOrder(${order.orderId})" class="flex-1 bg-red-50 text-red-700 py-2 rounded-xl text-sm font-medium hover:bg-red-100 transition-colors">Reject</button>
                                    </div>
                                    <a href="/Restaurant/Orders/ViewOrder/${order.orderId}" class="mt-2 inline-flex w-full items-center justify-center bg-gray-100 text-gray-800 py-2 rounded-xl text-sm font-medium hover:bg-gray-200 transition-colors">View</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>`;

            ordersGrid.insertAdjacentHTML('afterbegin', orderCard);
        }

        // ===== Accept / Reject =====
        async function acceptOrder(orderId) {
            if (!confirm('Accept this order?')) return;
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch(`/Restaurant/Orders/AcceptOrder?orderId=${orderId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }
                });
                if (!response.ok) throw new Error('Network error');
                await response.json();

                const card = document.getElementById(`order-${orderId}`);
                if (card) {
                    card.setAttribute('data-status', 'Processing');
                    const badge = card.querySelector('span.inline-flex.rounded-full');
                    if (badge) {
                        badge.className = 'inline-flex items-center px-2 py-1 rounded-full text-[11px] font-medium ' + badgeClassFor('Processing');
                        badge.innerHTML = `<i class="fas fa-circle text-current text-[7px] mr-1.5"></i>${labelForStatus('Processing')}`;
                    }
                    const buttonsDiv = card.querySelector('.w-36 > .flex.gap-2');
                    if (buttonsDiv) buttonsDiv.innerHTML = '<button onclick="markOrderReady(' + orderId + ')" class="flex-1 bg-blue-600 text-white py-2 rounded-xl text-sm font-medium hover:bg-blue-700 transition-colors">Mark Ready</button>';
                    updateOrderCounts();
                    if (currentFilter === 'Pending') card.style.display = 'none';
                    showSuccessNotification('Order accepted successfully!');
                }
            } catch (e) {
                console.error(e); setTimeout(() => location.reload(), 1000);
            }
        }

        async function markOrderReady(orderId) {
            if (!confirm('Mark this order as ready?')) return;
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch(`/Restaurant/Orders/MarkOrderReady?orderId=${orderId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }
                });
                
                if (!response.ok) throw new Error('Network error');
                const result = await response.json();
                
                if (result.success) {
                    // Refresh the page to show the order in the correct ready tab
                    location.reload();
                }
            } catch (e) {
                console.error(e);
                alert('Error marking order as ready');
            }
        }

        async function completeOrder(orderId) {
        if (!confirm('Complete this order?')) return;
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const response = await fetch(`/Restaurant/Orders/CompleteOrder?orderId=${orderId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }
            });
            
            if (!response.ok) throw new Error('Network error');
            const result = await response.json();
            
            if (result.success) {
                const card = document.getElementById(`order-${orderId}`);
                if (card) {
                    // Update the order status to Completed in the DOM
                    card.setAttribute('data-status', 'Completed');
                    
                    // Update the badge to show "Completed"
                    const badge = card.querySelector('span.inline-flex.rounded-full');
                    if (badge) {
                        badge.className = 'inline-flex items-center px-2 py-1 rounded-full text-[11px] font-medium ' + badgeClassFor('Completed');
                        badge.innerHTML = `<i class="fas fa-circle text-current text-[7px] mr-1.5"></i>${labelForStatus('Completed')}`;
                    }
                    
                    // Remove the action buttons since order is completed
                    const buttonsDiv = card.querySelector('.w-36 > .flex.gap-2');
                    if (buttonsDiv) buttonsDiv.innerHTML = '';
                    
                    // If we're viewing a specific tab (not "all"), hide the card
                    if (currentFilter !== 'all' && currentFilter !== 'Completed') {
                        card.style.display = 'none';
                    }
                    
                    // Update the tab counts
                    updateOrderCounts();
                    
                    showSuccessNotification('Order completed successfully!');
                }
            }
        } catch (e) {
            console.error(e);
            alert('Error completing order');
        }
    }

        async function rejectOrder(orderId) {
            if (!confirm('Are you sure you want to reject this order?')) return;
            try {
                const response = await fetch(`/Restaurant/Orders/RejectOrder?orderId=${orderId}`, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                const result = await response.json();
                if (result.success) {
                    const card = document.getElementById(`order-${orderId}`);
                    card.style.opacity = '0'; card.style.transform = 'scale(0.96)'; setTimeout(() => card.remove(), 250);
                    updateOrderCounts();
                    alert('Order rejected successfully!');
                } else {
                    alert('Error: ' + result.message);
                }
            } catch (e) {
                console.error(e); alert('Error rejecting order');
            }
        }

        function filterOrders(status) {
            currentFilter = status;
            document.querySelectorAll('.order-filter-tab').forEach(tab => {
                tab.classList.remove('active', 'border-emerald-500', 'text-emerald-600');
                tab.classList.add('border-transparent', 'text-gray-500');
            });
            event.target.classList.add('active', 'border-emerald-500', 'text-emerald-600');
            event.target.classList.remove('border-transparent', 'text-gray-500');

            document.querySelectorAll('.order-card').forEach(card => {
                const cardStatus = card.getAttribute('data-status');
                card.style.display = (status === 'all' || cardStatus === status) ? 'block' : 'none';
            });
        }

        function updateOrderCounts() {
        const allOrders = document.querySelectorAll('.order-card');
        const pending    = document.querySelectorAll('[data-status="Pending"]').length;
        const processing = document.querySelectorAll('[data-status="Processing"]').length;
        const readyPickup = document.querySelectorAll('[data-status="ReadyForPickup"]').length;
        const readyDelivery = document.querySelectorAll('[data-status="ReadyForDelivery"]').length;
        const completed  = document.querySelectorAll('[data-status="Completed"]').length;

        document.getElementById('count-all').textContent = allOrders.length;
        document.getElementById('count-pending').textContent = pending;
        document.getElementById('count-processing').textContent = processing;
        document.getElementById('count-ready-pickup').textContent = readyPickup;
        document.getElementById('count-ready-delivery').textContent = readyDelivery;
        document.getElementById('count-completed').textContent = completed;
    }

        function showSuccessNotification(message) {
            const n = document.createElement('div');
            n.className = 'fixed top-4 right-4 bg-emerald-500 text-white px-6 py-3 rounded-xl shadow-lg z-50 animate-slide-in';
            n.innerHTML = `<div class="flex items-center gap-2"><i class="fas fa-check-circle"></i><span>${message}</span></div>`;
            document.body.appendChild(n);
            setTimeout(() => { n.style.opacity = '0'; n.style.transform = 'translateX(100%)'; setTimeout(() => n.remove(), 300); }, 3000);
        }

        function showNotification(message) {
            if (Notification.permission === "granted") new Notification("New Order! 🔔", { body: message, icon: "/images/order-icon.png" });
        }
        function playNotificationSound() {
            const audio = new Audio('/sounds/notification.mp3'); audio.play().catch(() => {});
        }
        function refreshOrders() { location.reload(); }

        document.getElementById('searchInput').addEventListener('input', e => {
            const q = e.target.value.toLowerCase();
            document.querySelectorAll('.order-card').forEach(card => {
                card.style.display = card.textContent.toLowerCase().includes(q) ? 'block' : 'none';
            });
        });

        if (Notification.permission === "default") Notification.requestPermission();
        updateOrderCounts();
    </script>

    <style>
        .animate-slide-in { animation: slideIn 0.25s ease-out; }
        @@keyframes slideIn { from { transform: translateY(-6px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .order-card { transition: box-shadow .2s, transform .2s; }
        .order-card:hover { transform: translateY(-2px); box-shadow: 0 10px 18px rgba(0,0,0,.06); }
    </style>
}