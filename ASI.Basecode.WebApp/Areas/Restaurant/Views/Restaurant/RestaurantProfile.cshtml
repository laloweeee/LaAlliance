@model ASI.Basecode.WebApp.Areas.Restaurant.Models.RestaurantProfileViewModel
@{
    Layout = "~/Areas/Restaurant/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Restaurant Profile";
}

<h2 class="text-2xl font-bold text-gray-800 mb-6">Restaurant Profile</h2>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Restaurant Information -->
    <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold mb-4">Restaurant Information</h3>
        <form class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Restaurant Name</label>
                <input type="text" class="w-full px-4 py-2 border rounded-lg" placeholder="e.g., La Alliance Restaurant">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Address</label>
                <textarea rows="2" class="w-full px-4 py-2 border rounded-lg" placeholder="123 Main St, City, State"></textarea>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
                <input type="tel" class="w-full px-4 py-2 border rounded-lg" placeholder="(555) 123-4567">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                <input type="email" class="w-full px-4 py-2 border rounded-lg" placeholder="info@laalliance.com">
            </div>
            <div class="flex justify-end">
                <button type="submit" class="px-4 py-2 rounded bg-emerald-600 text-white hover:bg-emerald-700">
                    Save Information
                </button>
            </div>
        </form>
    </div>

    <!-- Delivery & Operations -->
    <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold mb-4">Delivery & Operations</h3>
        <form class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Delivery Radius (miles)</label>
                    <input type="number" class="w-full px-4 py-2 border rounded-lg" value="5">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Delivery Fee (₱)</label>
                    <input type="number" step="0.01" class="w-full px-4 py-2 border rounded-lg" value="3.99">
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Minimum Order Amount (₱)</label>
                <input type="number" step="0.01" class="w-full px-4 py-2 border rounded-lg" value="15.00">
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Opening Time</label>
                    <input type="time" class="w-full px-4 py-2 border rounded-lg" value="09:00">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Closing Time</label>
                    <input type="time" class="w-full px-4 py-2 border rounded-lg" value="21:00">
                </div>
            </div>
            <div class="flex items-center">
                <input type="checkbox" id="openAllDay" class="mr-2">
                <label for="openAllDay" class="text-sm text-gray-700">Open 24/7</label>
            </div>
            <div class="flex justify-end">
                <button type="submit" class="px-4 py-2 rounded bg-emerald-600 text-white hover:bg-emerald-700">
                    Save Operations
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
