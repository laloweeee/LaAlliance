@{
    Layout = "~/Areas/Restaurant/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Promotions";
}

<!-- Header actions -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
    <h2 class="text-2xl font-bold text-gray-800">Promotions</h2>
    <div class="flex items-center gap-2">
        <button type="button" class="px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700" onclick="openModal('createCampaignModal')">
            <i class="fas fa-bullhorn mr-2"></i>Create Campaign
        </button>
        <button type="button" class="px-4 py-2 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700" onclick="openModal('createEventModal')">
            <i class="fas fa-calendar-plus mr-2"></i>Create Event
        </button>
        <button type="button" class="px-4 py-2 rounded-lg bg-amber-600 text-white hover:bg-amber-700" onclick="openModal('createDiscountModal')">
            <i class="fas fa-tags mr-2"></i>Create Discount
        </button>
        <button type="button" class="px-4 py-2 rounded-lg bg-gray-800 text-white hover:bg-black" onclick="openModal('manageTrendingModal')">
            <i class="fas fa-fire mr-2"></i>Manage Trending
        </button>
    </div>
</div>

<!-- Tabs -->
<div class="border-b mb-6">
    <nav class="flex flex-wrap gap-2" id="promoTabs">
        <button class="promo-tab-btn px-4 py-2 rounded-t border-b-2 border-transparent text-gray-600 hover:text-gray-800" data-tab="campaigns">Campaigns</button>
        <button class="promo-tab-btn px-4 py-2 rounded-t border-b-2 border-transparent text-gray-600 hover:text-gray-800" data-tab="events">Events</button>
        <button class="promo-tab-btn px-4 py-2 rounded-t border-b-2 border-transparent text-gray-600 hover:text-gray-800" data-tab="discounts">Discounts</button>
        <button class="promo-tab-btn px-4 py-2 rounded-t border-b-2 border-transparent text-gray-600 hover:text-gray-800" data-tab="trending">Trending</button>
        <button class="promo-tab-btn px-4 py-2 rounded-t border-b-2 border-transparent text-gray-600 hover:text-gray-800" data-tab="analytics">Analytics</button>
    </nav>
</div>

<!-- Campaigns -->
<div id="tab-campaigns" class="promo-tab section">
    <div id="campaignGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        <!-- Card -->
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
                <h3 class="font-semibold">Grand Opening Blast</h3>
                <span class="text-xs px-2 py-1 rounded-full bg-green-100 text-green-700">Active</span>
            </div>
            <p class="text-gray-600 mt-2">Facebook + IG ads, 20% launch discount</p>
            <div class="mt-4 text-sm text-gray-500">Runs: 2025-10-01 → 2025-10-15</div>
            <div class="mt-4 flex gap-2">
                <button class="px-3 py-1 rounded border hover:bg-gray-50">Edit</button>
                <button class="px-3 py-1 rounded border text-red-600 hover:bg-red-50">Stop</button>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
                <h3 class="font-semibold">Double Points Week</h3>
                <span class="text-xs px-2 py-1 rounded-full bg-blue-100 text-blue-700">Scheduled</span>
            </div>
            <p class="text-gray-600 mt-2">Loyalty members earn x2 points on all orders</p>
            <div class="mt-4 text-sm text-gray-500">Runs: 2025-11-05 → 2025-11-12</div>
            <div class="mt-4 flex gap-2">
                <button class="px-3 py-1 rounded border hover:bg-gray-50">Edit</button>
                <button class="px-3 py-1 rounded border text-red-600 hover:bg-red-50">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Events -->
<div id="tab-events" class="promo-tab section hidden">
    <div id="eventsGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
                <h3 class="font-semibold">Burger Festival Weekend</h3>
                <span class="text-xs px-2 py-1 rounded-full bg-blue-100 text-blue-700">Upcoming</span>
            </div>
            <p class="text-gray-600 mt-2">Live music, freebies for the first 50 guests</p>
            <div class="mt-4 text-sm text-gray-500">Oct 20, 2025 — 2:00 PM</div>
            <div class="mt-4 flex gap-2">
                <button class="px-3 py-1 rounded border hover:bg-gray-50">Edit</button>
                <button class="px-3 py-1 rounded border text-red-600 hover:bg-red-50">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Discounts -->
<div id="tab-discounts" class="promo-tab section hidden">
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="px-4 py-3 border-b"><h3 class="font-semibold">Active Discount Codes</h3></div>
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-50">
                    <tr class="text-left">
                        <th class="px-4 py-3">Code</th>
                        <th class="px-4 py-3">Type</th>
                        <th class="px-4 py-3">Value</th>
                        <th class="px-4 py-3">Valid Until</th>
                        <th class="px-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody id="discountsTableBody" class="divide-y">
                    <tr>
                        <td class="px-4 py-3 font-medium">OPEN20</td>
                        <td class="px-4 py-3">Percent</td>
                        <td class="px-4 py-3">20%</td>
                        <td class="px-4 py-3">2025-10-15</td>
                        <td class="px-4 py-3">
                            <button class="px-3 py-1 rounded border hover:bg-gray-50">Edit</button>
                            <button class="px-3 py-1 rounded border text-red-600 hover:bg-red-50">Disable</button>
                        </td>
                    </tr>
                    <tr>
                        <td class="px-4 py-3 font-medium">FREEDRINK</td>
                        <td class="px-4 py-3">Fixed</td>
                        <td class="px-4 py-3">₱59</td>
                        <td class="px-4 py-3">2025-12-31</td>
                        <td class="px-4 py-3">
                            <button class="px-3 py-1 rounded border hover:bg-gray-50">Edit</button>
                            <button class="px-3 py-1 rounded border text-red-600 hover:bg-red-50">Disable</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Trending -->
<div id="tab-trending" class="promo-tab section hidden">
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="font-semibold">Top Sellers (This Week)</h3>
            <ul class="mt-3 space-y-2 text-sm text-gray-700 list-disc ml-4">
                <li>Classic Burger</li>
                <li>Spicy Chicken Sandwich</li>
                <li>Iced Tea</li>
            </ul>
            <button class="mt-4 px-3 py-1 rounded border hover:bg-gray-50" onclick="openModal('manageTrendingModal')">Adjust</button>
        </div>
    </div>
</div>

<!-- Analytics -->
<div id="tab-analytics" class="promo-tab section hidden">
    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold">Campaign Performance</h3>
            <button class="text-sm px-3 py-1 rounded border hover:bg-gray-50">Export CSV</button>
        </div>
        <div class="h-64">
            <canvas id="promoPerfChart"></canvas>
        </div>
    </div>
</div>

@await Html.PartialAsync("_PromotionModals")

@section Scripts {
    <script>
        // --- Tabs
        (function initPromoTabs(){
          const buttons = document.querySelectorAll('.promo-tab-btn');
          const sections = {
            campaigns: document.getElementById('tab-campaigns'),
            events:    document.getElementById('tab-events'),
            discounts: document.getElementById('tab-discounts'),
            trending:  document.getElementById('tab-trending'),
            analytics: document.getElementById('tab-analytics')
          };
          let active = 'campaigns';
          function activate(name){
            active = name;
            Object.entries(sections).forEach(([k, el]) => {
              if (!el) return;
              el.classList.toggle('hidden', k !== name);
              el.classList.toggle('active', k === name);
            });
            buttons.forEach(b=>{
              const on = b.dataset.tab === name;
              b.classList.toggle('border-emerald-600', on);
              b.classList.toggle('text-emerald-700', on);
              b.classList.toggle('border-b-2', on);
            });
            if (name === 'analytics') initPromoAnalytics();
          }
          buttons.forEach(b=> b.addEventListener('click', ()=> activate(b.dataset.tab)));
          activate(active);
        })();

        // --- Chart
        function initPromoAnalytics(){
          const ctx = document.getElementById('promoPerfChart');
          if (!ctx || ctx.dataset.init) return;
          ctx.dataset.init = '1';
          new Chart(ctx, {
            type: 'line',
            data: {
              labels: ['Week 1','Week 2','Week 3','Week 4'],
              datasets: [
                { label: 'Clicks', data: [120, 180, 160, 240], borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,0.15)', fill: true, tension: 0.35 },
                { label: 'Orders', data: [40,  65,  58,  92 ], borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.15)',  fill: true, tension: 0.35 }
              ]
            },
            options: { responsive: true, maintainAspectRatio: false }
          });
        }

        // --- Create Campaign → append card
        (function initCreateCampaign(){
          const form = document.getElementById('createCampaignForm');
          const grid = document.getElementById('campaignGrid');
          if (!form || !grid) return;
          form.addEventListener('submit', function(e){
            e.preventDefault();
            const name = form.querySelector('input[type="text"]')?.value?.trim() || 'New Campaign';
            const desc = form.querySelector('textarea')?.value?.trim() || '';
            const start = form.querySelector('input[type="date"]')?.value || '';
            const end   = form.querySelectorAll('input[type="date"]')[1]?.value || '';

            const card = document.createElement('div');
            card.className = 'bg-white rounded-lg shadow p-6';
            card.innerHTML = `
              <div class="flex items-center justify-between">
                <h3 class="font-semibold"></h3>
                <span class="text-xs px-2 py-1 rounded-full bg-green-100 text-green-700">Active</span>
              </div>
              <p class="text-gray-600 mt-2"></p>
              <div class="mt-4 text-sm text-gray-500"></div>
              <div class="mt-4 flex gap-2">
                <button class="px-3 py-1 rounded border hover:bg-gray-50">Edit</button>
                <button class="px-3 py-1 rounded border text-red-600 hover:bg-red-50">Stop</button>
              </div>
            `;
            card.querySelector('h3').textContent = name;
            card.querySelector('p').textContent = desc || 'No description provided';
            const runs = (start && end) ? `Runs: ${start} → ${end}` : '';
            card.querySelector('.text-sm.text-gray-500').textContent = runs;

            grid.appendChild(card);
            if (typeof closeModal === 'function') closeModal('createCampaignModal');
            form.reset();
            // Scroll to the new card
            card.scrollIntoView({ behavior: 'smooth', block: 'end' });
          });
        })();

        // --- Campaign card: Stop ↔ Continue and Active ↔ Inactive
        (function initCampaignToggle(){
          const grid = document.getElementById('campaignGrid');
          if (!grid) return;

          function setStatus(card, isActive){
            const badge = card.querySelector('span.rounded-full');
            const toggleBtn = Array.from(card.querySelectorAll('button')).find(b=>/Stop|Continue/i.test(b.textContent || ''));
            if (!badge || !toggleBtn) return;
            if (isActive){
              badge.textContent = 'Active';
              badge.className = 'text-xs px-2 py-1 rounded-full bg-green-100 text-green-700';
              toggleBtn.textContent = 'Stop';
              toggleBtn.className = 'px-3 py-1 rounded border text-red-600 hover:bg-red-50';
            } else {
              badge.textContent = 'Inactive';
              badge.className = 'text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-700';
              toggleBtn.textContent = 'Continue';
              toggleBtn.className = 'px-3 py-1 rounded border text-emerald-600 hover:bg-emerald-50';
            }
          }

          grid.addEventListener('click', function(e){
            const btn = e.target.closest('button');
            if (!btn) return;
            const label = (btn.textContent || '').trim();
            if (!/^(Stop|Continue)$/i.test(label)) return;
            const card = btn.closest('.bg-white.rounded-lg.shadow.p-6') || btn.closest('.bg-white');
            if (!card) return;
            e.preventDefault();
            const toInactive = /^Stop$/i.test(label);
            setStatus(card, !toInactive);
          });
        })();

        // --- Create Event → append card
        (function initCreateEvent(){
          const form = document.getElementById('createEventForm');
          const grid = document.getElementById('eventsGrid');
          if (!form || !grid) return;
          form.addEventListener('submit', function(e){
            e.preventDefault();
            const title = form.querySelector('input[type="text"]')?.value?.trim() || 'New Event';
            const date  = form.querySelector('input[type="date"]')?.value || '';
            const time  = form.querySelector('input[type="time"]')?.value || '';
            const details = form.querySelector('textarea')?.value?.trim() || '';

            const card = document.createElement('div');
            card.className = 'bg-white rounded-lg shadow p-6';
            card.innerHTML = `
              <div class="flex items-center justify-between">
                <h3 class="font-semibold"></h3>
                <span class="text-xs px-2 py-1 rounded-full bg-blue-100 text-blue-700">Upcoming</span>
              </div>
              <p class="text-gray-600 mt-2"></p>
              <div class="mt-4 text-sm text-gray-500"></div>
              <div class="mt-4 flex gap-2">
                <button class="px-3 py-1 rounded border hover:bg-gray-50">Edit</button>
                <button class="px-3 py-1 rounded border text-red-600 hover:bg-red-50">Cancel</button>
              </div>
            `;
            card.querySelector('h3').textContent = title;
            card.querySelector('p').textContent = details || 'No details provided';
            const when = (date || time) ? `${date}${date && time ? ' — ' : ''}${time}` : '';
            card.querySelector('.text-sm.text-gray-500').textContent = when;

            grid.appendChild(card);
            if (typeof closeModal === 'function') closeModal('createEventModal');
            form.reset();
            card.scrollIntoView({ behavior: 'smooth', block: 'end' });
          });
        })();

        // --- Create Discount → append row
        (function initCreateDiscount(){
          const form = document.getElementById('createDiscountForm');
          const tbody = document.getElementById('discountsTableBody');
          if (!form || !tbody) return;
          form.addEventListener('submit', function(e){
            e.preventDefault();
            const code  = form.querySelector('input[type="text"]')?.value?.trim() || 'NEWCODE';
            const type  = form.querySelector('select')?.value || 'Percent';
            const value = form.querySelector('input[type="number"]')?.value || '';
            const dates = form.querySelectorAll('input[type="date"]');
            const validUntil = dates[1]?.value || '';

            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td class="px-4 py-3 font-medium"></td>
              <td class="px-4 py-3"></td>
              <td class="px-4 py-3"></td>
              <td class="px-4 py-3"></td>
              <td class="px-4 py-3">
                <button class="px-3 py-1 rounded border hover:bg-gray-50">Edit</button>
                <button class="px-3 py-1 rounded border text-red-600 hover:bg-red-50">Disable</button>
              </td>
            `;
            tr.children[0].textContent = code;
            tr.children[1].textContent = type;
            tr.children[2].textContent = value ? (type === 'Percent' ? `${value}%` : `₱${value}`) : '';
            tr.children[3].textContent = validUntil;

            tbody.appendChild(tr);
            if (typeof closeModal === 'function') closeModal('createDiscountModal');
            form.reset();
            tr.scrollIntoView({ behavior: 'smooth', block: 'end' });
          });
        })();

        // --- Cancel button: confirm and remove card
        (function initCancelRemoval(){
          function handler(e){
            const btn = e.target.closest('button');
            if (!btn) return;
            const label = (btn.textContent || '').trim();
            if (!/^Cancel$/i.test(label)) return;
            const card = btn.closest('.bg-white.rounded-lg.shadow.p-6') || btn.closest('.bg-white');
            if (!card) return;
            e.preventDefault();
            const ok = window.confirm('Are you sure you want to cancel this item?');
            if (ok) card.remove();
          }
          document.getElementById('tab-campaigns')?.addEventListener('click', handler);
          document.getElementById('tab-events')?.addEventListener('click', handler);
        })();
    </script>
}
