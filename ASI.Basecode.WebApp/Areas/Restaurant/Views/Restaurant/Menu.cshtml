@{
    Layout = "~/Areas/Restaurant/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Menu Management";
}

<div id="menu" class="section">
    <!-- Header + Actions + Filter -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <h2 class="text-2xl font-bold text-gray-800">Menu Management</h2>
        <div class="flex items-center gap-2">
            <button onclick="showAddCategory()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition-colors">
                <i class="fas fa-plus mr-2"></i>Add Category
            </button>
            <button onclick="showAddItem()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors">
                <i class="fas fa-plus mr-2"></i>Add Item
            </button>

            <!-- Category Filter -->
            <label for="categoryFilter" class="sr-only">Filter by Category</label>
            <select id="categoryFilter" class="px-3 py-2 rounded-lg border border-gray-300 bg-white focus:outline-none"
                    onchange="applyCategoryFilter && applyCategoryFilter(this.value)">
                <option value="ALL">All Categories</option>
                <!-- More options can be injected by JS -->
            </select>
        </div>
    </div>

    <!-- Items Table -->
    <div class="bg-white rounded-lg shadow overflow-hidden mb-8">
        <div class="px-4 py-3 border-b">
            <h3 class="text-lg font-semibold text-gray-800">Menu Items</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-50 text-gray-700">
                    <tr class="text-left">
                        <th class="px-4 py-3 font-semibold">Item</th>
                        <th class="px-4 py-3 font-semibold">Category</th>
                        <th class="px-4 py-3 font-semibold">Price</th>
                        <th class="px-4 py-3 font-semibold">Stock Qty</th>
                        <th class="px-4 py-3 font-semibold">Status</th>
                        <th class="px-4 py-3 font-semibold">Last Updated</th>
                        <th class="px-4 py-3 font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody id="itemsTableBody" class="divide-y">
                    <!-- Example static rows (replace with JS-rendered rows if you prefer) -->
                    <tr data-item-id="1">
                        <td class="px-4 py-3 font-medium">Classic Burger</td>
                        <td class="px-4 py-3">Burgers</td>
                        <td class="px-4 py-3">$12.99</td>
                        <td class="px-4 py-3">25</td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-700">Available</span>
                        </td>
                        <td class="px-4 py-3 text-gray-500">—</td>
                        <td class="px-4 py-3">
                            <div class="flex gap-2">
                                <button onclick="editMenuItem(1)" class="px-2 py-1 rounded border hover:bg-gray-50" title="Edit Item">
                                    Edit
                                </button>
                                <button onclick="deleteMenuItem(1)" class="px-2 py-1 rounded border hover:bg-red-50 text-red-600" title="Delete Item">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr data-item-id="2">
                        <td class="px-4 py-3 font-medium">Margherita Pizza</td>
                        <td class="px-4 py-3">Pizza</td>
                        <td class="px-4 py-3">$18.99</td>
                        <td class="px-4 py-3">3</td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-1 text-xs rounded-full bg-yellow-100 text-yellow-700">Low Stock</span>
                        </td>
                        <td class="px-4 py-3 text-gray-500">—</td>
                        <td class="px-4 py-3">
                            <div class="flex gap-2">
                                <button onclick="editMenuItem(2)" class="px-2 py-1 rounded border hover:bg-gray-50" title="Edit Item">
                                    Edit
                                </button>
                                <button onclick="deleteMenuItem(2)" class="px-2 py-1 rounded border hover:bg-red-50 text-red-600" title="Delete Item">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr data-item-id="3">
                        <td class="px-4 py-3 font-medium">Coca Cola</td>
                        <td class="px-4 py-3">Beverages</td>
                        <td class="px-4 py-3">$2.99</td>
                        <td class="px-4 py-3">50</td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-700">Available</span>
                        </td>
                        <td class="px-4 py-3 text-gray-500">—</td>
                        <td class="px-4 py-3">
                            <div class="flex gap-2">
                                <button onclick="editMenuItem(3)" class="px-2 py-1 rounded border hover:bg-gray-50" title="Edit Item">
                                    Edit
                                </button>
                                <button onclick="deleteMenuItem(3)" class="px-2 py-1 rounded border hover:bg-red-50 text-red-600" title="Delete Item">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Categories Table -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="px-4 py-3 border-b flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-800">Categories</h3>
            <button onclick="showAddCategory()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition-colors">
                <i class="fas fa-plus mr-2"></i>Add Category
            </button>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-50 text-gray-700">
                    <tr class="text-left">
                        <th class="px-4 py-3 font-semibold">Category</th>
                        <th class="px-4 py-3 font-semibold">Items</th>
                        <th class="px-4 py-3 font-semibold">Visible</th>
                        <th class="px-4 py-3 font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody id="categoriesTableBody" class="divide-y">
                    <tr data-category-id="burgers">
                        <td class="px-4 py-3 font-medium">Burgers</td>
                        <td class="px-4 py-3">—</td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-700">Yes</span>
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex gap-2">
                                <button onclick="editCategory('burgers')" class="px-2 py-1 rounded border hover:bg-gray-50">Edit</button>
                                <button onclick="deleteCategory('burgers')" class="px-2 py-1 rounded border hover:bg-red-50 text-red-600">Delete</button>
                            </div>
                        </td>
                    </tr>
                    <tr data-category-id="pizza">
                        <td class="px-4 py-3 font-medium">Pizza</td>
                        <td class="px-4 py-3">—</td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-700">Yes</span>
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex gap-2">
                                <button onclick="editCategory('pizza')" class="px-2 py-1 rounded border hover:bg-gray-50">Edit</button>
                                <button onclick="deleteCategory('pizza')" class="px-2 py-1 rounded border hover:bg-red-50 text-red-600">Delete</button>
                            </div>
                        </td>
                    </tr>
                    <tr data-category-id="beverages">
                        <td class="px-4 py-3 font-medium">Beverages</td>
                        <td class="px-4 py-3">—</td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-700">Yes</span>
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex gap-2">
                                <button onclick="editCategory('beverages')" class="px-2 py-1 rounded border hover:bg-gray-50">Edit</button>
                                <button onclick="deleteCategory('beverages')" class="px-2 py-1 rounded border hover:bg-red-50 text-red-600">Delete</button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

@await Html.PartialAsync("_MenuModals")

@section Scripts {
    <script>
        window.applyCategoryFilter = function (value) {
          const rows = document.querySelectorAll('#itemsTbody tr');
          rows.forEach(r => {
            const cat = r.getAttribute('data-category');
            r.style.display = (value === 'ALL' || value === cat) ? '' : 'none';
          });
        };
    </script>
    <script>window.wireMenu && window.wireMenu();</script>
}

