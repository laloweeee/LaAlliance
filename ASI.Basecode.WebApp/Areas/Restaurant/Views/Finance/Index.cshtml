@{
    ViewData["Title"] = "Finance Management";
}

<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold text-gray-800">Finance Management</h2>
</div>

<!-- Finance Tabs -->
<div class="mb-6">
    <div class="border-b border-gray-200">
        <nav class="-mb-px flex space-x-8 overflow-x-auto">
            <button onclick="showFinanceTab('overview')" class="finance-tab active border-b-2 border-green-500 py-2 px-1 text-sm font-medium text-green-600 whitespace-nowrap">
                <i class="fas fa-chart-pie mr-2"></i>Overview
            </button>
            <button onclick="showFinanceTab('revenue-dashboard')" class="finance-tab border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap">
                <i class="fas fa-chart-bar mr-2"></i>Revenue Dashboard
            </button>
            <button onclick="showFinanceTab('transactions')" class="finance-tab border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap">
                <i class="fas fa-exchange-alt mr-2"></i>Transactions
            </button>
            <button onclick="showFinanceTab('commissions')" class="finance-tab border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap">
                <i class="fas fa-percentage mr-2"></i>Commissions
            </button>
            <button onclick="showFinanceTab('refunds')" class="finance-tab border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap">
                <i class="fas fa-undo mr-2"></i>Refunds
            </button>
            <button onclick="showFinanceTab('promotions')" class="finance-tab border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap">
                <i class="fas fa-tags mr-2"></i>Promotions
            </button>
            <button onclick="showFinanceTab('wallet')" class="finance-tab border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap">
                <i class="fas fa-wallet mr-2"></i>Wallet System
            </button>
            <button onclick="showFinanceTab('reports')" class="finance-tab border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap">
                <i class="fas fa-download mr-2"></i>Reports
            </button>
        </nav>
    </div>
</div>

<!-- Overview Tab -->
<div id="overview-tab" class="finance-tab-content">
    <!-- Financial Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-6 rounded-lg shadow">
