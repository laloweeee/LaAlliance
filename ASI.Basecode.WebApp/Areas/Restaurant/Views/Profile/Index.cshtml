@model ASI.Basecode.Services.ServiceModels.RestaurantProfileViewModel
@{
    ViewData["Title"] = "Restaurant Profile";
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <!-- Header Section -->
    <div class="bg-gradient-to-r from-emerald-600 to-teal-600 rounded-2xl shadow-xl p-8 mb-8 text-white">
        <div class="flex justify-between items-start">
            <div>
                <h1 class="text-4xl font-bold mb-2">@Model.Name</h1>
                <p class="text-emerald-100 text-lg">@(string.IsNullOrEmpty(Model.Description) ? "Welcome to our restaurant" : Model.Description)</p>
            </div>
            <a asp-action="RestaurantProfileForm" asp-controller="Profile" asp-area="Restaurant" class="px-6 py-3 bg-white text-emerald-600 rounded-lg hover:bg-gray-100 font-semibold shadow-lg transition-all duration-200 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
                Edit Profile
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <!-- Contact Information Card -->
        <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-100 hover:shadow-xl transition-shadow duration-200">
            <div class="flex items-center gap-3 mb-5">
                <div class="p-3 bg-emerald-100 rounded-lg">
                    <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-800">Contact</h3>
            </div>
            <div class="space-y-4">
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Phone Number</p>
                    <p class="text-gray-900 font-medium">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</p>
                </div>
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Email Address</p>
                    <p class="text-gray-900 font-medium">@(string.IsNullOrEmpty(Model.Email) ? "Not provided" : Model.Email)</p>
                </div>
            </div>
        </div>

        <!-- Operating Hours Card -->
        <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-100 hover:shadow-xl transition-shadow duration-200">
            <div class="flex items-center gap-3 mb-5">
                <div class="p-3 bg-blue-100 rounded-lg">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-800">Operating Hours</h3>
            </div>
            <div class="space-y-4">
                <div class="flex justify-between items-center p-4 bg-gradient-to-r from-green-50 to-emerald-50 rounded-lg">
                    <div>
                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Opens</p>
                        <p class="text-2xl font-bold text-emerald-600">@(Model.OpeningTime.ToString("hh\\:mm tt") ?? "Not set")</p>
                    </div>
                    <div class="h-12 w-px bg-gray-300"></div>
                    <div>
                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Closes</p>
                        <p class="text-2xl font-bold text-red-600">@(Model.ClosingTime.ToString("hh\\:mm tt") ?? "Not set")</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Stats Card -->
        <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-100 hover:shadow-xl transition-shadow duration-200">
            <div class="flex items-center gap-3 mb-5">
                <div class="p-3 bg-purple-100 rounded-lg">
                    <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-800">Status</h3>
            </div>
            <div class="space-y-4">
                <div class="p-4 bg-gradient-to-r from-green-50 to-emerald-50 rounded-lg">
                    <div class="flex items-center gap-2 mb-2">
                        <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
                        <p class="text-sm font-semibold text-gray-700">Currently Open</p>
                    </div>
                    <p class="text-xs text-gray-500">Profile is active and visible</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Location Section -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden">
        <div class="bg-gradient-to-r from-gray-50 to-gray-100 px-6 py-4 border-b border-gray-200">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-red-100 rounded-lg">
                    <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-800">Location & Address</h3>
            </div>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 p-6">
            <!-- Address Details -->
            <div class="space-y-4">
                <div class="p-4 bg-gray-50 rounded-lg">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Street Address</p>
                    <p class="text-gray-900 font-medium text-lg">@(string.IsNullOrEmpty(Model.Address?.StreetAddress) ? "Not provided" : Model.Address.StreetAddress)</p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="p-4 bg-gray-50 rounded-lg">
                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Barangay</p>
                        <p class="text-gray-900 font-medium">@(string.IsNullOrEmpty(Model.Address?.Barangay) ? "Not provided" : Model.Address.Barangay)</p>
                    </div>
                    <div class="p-4 bg-gray-50 rounded-lg">
                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">City</p>
                        <p class="text-gray-900 font-medium">@(string.IsNullOrEmpty(Model.Address?.City) ? "Not provided" : Model.Address.City)</p>
                    </div>
                </div>
                <div class="grid grid-cols-3 gap-4">
                    <div class="p-4 bg-gray-50 rounded-lg">
                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Province</p>
                        <p class="text-gray-900 font-medium">@(string.IsNullOrEmpty(Model.Address?.Province) ? "Not provided" : Model.Address.Province)</p>
                    </div>
                    <div class="p-4 bg-gray-50 rounded-lg">
                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Zip Code</p>
                        <p class="text-gray-900 font-medium">@(string.IsNullOrEmpty(Model.Address?.ZipCode) ? "Not provided" : Model.Address.ZipCode)</p>
                    </div>
                    <div class="p-4 bg-gray-50 rounded-lg">
                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Country</p>
                        <p class="text-gray-900 font-medium">@(string.IsNullOrEmpty(Model.Address?.Country) ? "Philippines" : Model.Address.Country)</p>
                    </div>
                </div>
            </div>

            <!-- Map Preview -->
            @if (Model.Address?.Latitude != 0 && Model.Address?.Longitude != 0)
            {
                <div class="space-y-4">
                    <div id="map" 
                         data-lat="@Model.Address.Latitude" 
                         data-lng="@Model.Address.Longitude" 
                         data-title="@Model.Name"
                         data-address="@Model.Address.StreetAddress"
                         class="w-full h-80 rounded-xl border-2 border-gray-200 shadow-inner"></div>
                    <div class="flex items-center gap-2 text-sm text-gray-600">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span>Coordinates: @Model.Address.Latitude.ToString("F6"), @Model.Address.Longitude.ToString("F6")</span>
                    </div>
                </div>
            }
            else
            {
                <div class="flex items-center justify-center h-80 bg-gray-100 rounded-xl border-2 border-dashed border-gray-300">
                    <div class="text-center">
                        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                        </svg>
                        <p class="text-gray-500 font-medium">Location not set</p>
                        <p class="text-sm text-gray-400 mt-1">Update your address to see the map</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.Address?.Latitude != 0 && Model.Address?.Longitude != 0)
    {
        <script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey"></script>
        <script src="~/js/maps.js"></script>
    }
}
