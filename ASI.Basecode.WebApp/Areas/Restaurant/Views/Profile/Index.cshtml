@model ASI.Basecode.WebApp.Models.OrderTrackingViewModel  
@{
    ViewData["Title"] = "Order Tracking";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Orders Section -->
<section id="ordersSection">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <h2 class="text-3xl font-bold mb-8 text-gray-800">Order Tracking</h2>
        
        <!-- Current Order -->
        <div id="currentOrder" class="bg-white rounded-xl shadow-sm p-6 mb-8">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-semibold">Order #FF2024001</h3>
                <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium">In Progress</span>
            </div>
            
            <!-- Order Progress -->
            <div class="mb-6">
                <div class="flex justify-between items-center mb-2">
                    <span class="text-sm font-medium text-gray-700">Order Progress</span>
                    <span class="text-sm text-gray-500">ETA: 18 mins</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                    <div id="orderProgress" class="bg-green-600 h-2 rounded-full" style="width: 60%"></div>
                </div>
            </div>
            
            <!-- Order Steps -->
            <div class="space-y-4">
                <div id="step1" class="flex items-center space-x-3">
                    <div class="w-8 h-8 bg-green-600 rounded-full flex items-center justify-center">
                        <i class="fas fa-check text-white text-sm"></i>
                    </div>
                    <div>
                        <p class="font-medium">Order Confirmed</p>
                        <p class="text-sm text-gray-500">2:30 PM</p>
                    </div>
                </div>
                <div id="step2" class="flex items-center space-x-3">
                    <div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center">
                        <i class="fas fa-utensils text-gray-500 text-sm"></i>
                    </div>
                    <div>
                        <p class="font-medium text-gray-500">Preparing Your Order</p>
                        <p class="text-sm text-gray-400">Pending</p>
                    </div>
                </div>
                <div id="step3" class="flex items-center space-x-3">
                    <div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center">
                        <i class="fas fa-motorcycle text-gray-500 text-sm"></i>
                    </div>
                    <div>
                        <p class="font-medium text-gray-500">Out for Delivery</p>
                        <p class="text-sm text-gray-400">Pending</p>
                    </div>
                </div>
                <div id="step4" class="flex items-center space-x-3">
                    <div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center">
                        <i class="fas fa-home text-gray-500 text-sm"></i>
                    </div>
                    <div>
                        <p class="font-medium text-gray-500">Delivered</p>
                        <p class="text-sm text-gray-400">Pending</p>
                    </div>
                </div>
            </div>
            
            <!-- Live Map Display -->
            <div class="mt-6 bg-gray-100 rounded-lg h-48 flex items-center justify-center">
                <!-- Map will be displayed here -->
                <div id="map" class="w-full h-full rounded-lg"></div>
            </div>
        </div>
        
        <!-- Order History -->
        <div class="bg-white rounded-xl shadow-sm p-6">
            <h3 class="text-xl font-semibold mb-4">Recent Orders</h3>
            <div class="space-y-4">
                <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                    <div>
                        <p class="font-medium">Margherita Pizza + Coke</p>
                        <p class="text-sm text-gray-500">Yesterday, 7:30 PM</p>
                    </div>
                    <div class="text-right">
                        <p class="font-semibold">$24.99</p>
                        <span class="text-sm text-green-600">Delivered</span>
                    </div>
                </div>
                <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                    <div>
                        <p class="font-medium">Chicken Burger Combo</p>
                        <p class="text-sm text-gray-500">Dec 15, 1:15 PM</p>
                    </div>
                    <div class="text-right">
                        <p class="font-semibold">$18.50</p>
                        <span class="text-sm text-green-600">Delivered</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://maps.googleapis.com/maps/api/js?key=YOUR_GOOGLE_MAPS_API_KEY&callback=initMap" async defer></script>
    <script>
        function initMap() {
            // Default coordinates (Manila)
            const defaultLocation = { lat: 14.5995, lng: 120.9842 };
            
            // Create map
            const map = new google.maps.Map(document.getElementById("map"), {
                zoom: 15,
                center: defaultLocation,
                mapTypeId: google.maps.MapTypeId.ROADMAP,
                styles: [
                    {
                        "featureType": "all",
                        "elementType": "labels.text.fill",
                        "stylers": [{"saturation": 36}, {"color": "#000000"}, {"lightness": 40}]
                    },
                    {
                        "featureType": "all",
                        "elementType": "labels.text.stroke",
                        "stylers": [{"visibility": "on"}, {"color": "#000000"}, {"lightness": 16}]
                    },
                    {
                        "featureType": "all",
                        "elementType": "labels.icon",
                        "stylers": [{"visibility": "off"}]
                    },
                    {
                        "featureType": "administrative",
                        "elementType": "geometry.fill",
                        "stylers": [{"color": "#000000"}, {"lightness": 20}]
                    },
                    {
                        "featureType": "administrative",
                        "elementType": "geometry.stroke",
                        "stylers": [{"color": "#000000"}, {"lightness": 17}, {"weight": 1.2}]
                    },
                    {
                        "featureType": "landscape",
                        "elementType": "geometry",
                        "stylers": [{"color": "#000000"}, {"lightness": 20}]
                    },
                    {
                        "featureType": "poi",
                        "elementType": "geometry",
                        "stylers": [{"color": "#000000"}, {"lightness": 21}]
                    },
                    {
                        "featureType": "road.highway",
                        "elementType": "geometry.fill",
                        "stylers": [{"color": "#000000"}, {"lightness": 17}]
                    },
                    {
                        "featureType": "road.highway",
                        "elementType": "geometry.stroke",
                        "stylers": [{"color": "#000000"}, {"lightness": 29}, {"weight": 0.2}]
                    },
                    {
                        "featureType": "road.arterial",
                        "elementType": "geometry",
                        "stylers": [{"color": "#000000"}, {"lightness": 18}]
                    },
                    {
                        "featureType": "road.local",
                        "elementType": "geometry",
                        "stylers": [{"color": "#000000"}, {"lightness": 16}]
                    },
                    {
                        "featureType": "transit",
                        "elementType": "geometry",
                        "stylers": [{"color": "#000000"}, {"lightness": 19}]
                    },
                    {
                        "featureType": "water",
                        "elementType": "geometry",
                        "stylers": [{"color": "#000000"}, {"lightness": 17}]
                    }
                ]
            });

            // Add marker for delivery location
            const marker = new google.maps.Marker({
                position: defaultLocation,
                map: map,
                title: "Delivery Location",
                icon: {
                    url: "data:image/svg+xml;base64," + btoa(`
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2Z" fill="#DC2626"/>
                            <path d="M12 12C13.1046 12 14 11.1046 14 10C14 8.89543 13.1046 8 12 8C10.8954 8 10 8.89543 10 10C10 11.1046 10.8954 12 12 12Z" fill="white"/>
                        </svg>
                    `),
                    scaledSize: new google.maps.Size(40, 40),
                    anchor: new google.maps.Point(20, 40)
                }
            });

            // Add info window
            const infoWindow = new google.maps.InfoWindow({
                content: `
                    <div class="p-2">
                        <h3 class="font-bold text-gray-800">Delivery Location</h3>
                        <p class="text-sm text-gray-600">Your order is on the way!</p>
                        <p class="text-xs text-gray-500">ETA: 18 mins</p>
                    </div>
                `
            });

            marker.addListener("click", () => {
                infoWindow.open(map, marker);
            });
        }

        // Handle Google Maps API errors
        window.gm_authFailure = function() {
            const mapElement = document.getElementById('map');
            mapElement.innerHTML = `
                <div class="text-center p-4">
                    <i class="fas fa-map-marked-alt text-4xl text-gray-400 mb-2"></i>
                    <p class="text-gray-500">Live tracking map would appear here</p>
                </div>
            `;
        };
    </script>
}