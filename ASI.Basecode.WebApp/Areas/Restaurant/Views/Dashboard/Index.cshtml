@model ASI.Basecode.Services.ServiceModels.DashboardDataViewModel
@{
    ViewData["Title"] = "Dashboard Overview";
}

<div id="dashboard" class="section active">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Dashboard Overview</h2>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <!-- Orders Panel -->
        <div class="bg-white p-6 rounded-lg shadow border-l-4 border-blue-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600 font-medium">Orders</p>
                    <p class="text-2xl font-bold text-gray-800" data-stat="todays-orders">@(Model?.Stats?.TodaysOrders ?? 0)</p>
                    <p class="text-xs text-gray-500">Today</p>
                    <p class="text-lg font-semibold text-gray-700 mt-1" data-stat="total-orders">@(Model?.Stats?.TotalOrders ?? 0) Total</p>
                </div>
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-shopping-cart text-blue-600 text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Customers Panel -->
        <div class="bg-white p-6 rounded-lg shadow border-l-4 border-green-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600 font-medium">Customers</p>
                    <p class="text-2xl font-bold text-gray-800" data-stat="todays-customers">@(Model?.Stats?.TodaysCustomers ?? 0)</p>
                    <p class="text-xs text-gray-500">Today</p>
                    <p class="text-lg font-semibold text-gray-700 mt-1" data-stat="total-customers">@(Model?.Stats?.TotalCustomers ?? 0) Total</p>
                </div>
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-users text-green-600 text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Total Sales -->
        <div class="bg-white p-6 rounded-lg shadow border-l-4 border-purple-500">
            <div class="flex items-center">
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-dollar-sign text-purple-600 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-600">Total Sales</p>
                    <p class="text-2xl font-bold text-gray-800" data-stat="total-sales">₱@((Model?.Stats?.TotalSales ?? 0).ToString("N2"))</p>
                </div>
            </div>
        </div>

        <!-- Average Sale Per Day -->
        <div class="bg-white p-6 rounded-lg shadow border-l-4 border-orange-500">
            <div class="flex items-center">
                <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-chart-line text-orange-600 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-gray-600">Avg Sale/Day</p>
                    <p class="text-2xl font-bold text-gray-800" data-stat="avg-sales">₱@((Model?.Stats?.AverageSalePerDay ?? 0).ToString("N2"))</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Average Processing Time Panel -->
    <div class="bg-white p-6 rounded-lg shadow border-l-4 border-indigo-500">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-clock text-indigo-600 text-xl"></i>
            </div>
            <div class="ml-4">
                <p class="text-sm text-gray-600">Avg Processing Time</p>
                <p class="text-2xl font-bold text-gray-800" data-stat="avg-processing-time">@(Model?.Stats?.AverageProcessingTime ?? "00:00:00")</p>
            </div>
        </div>
    </div>

    <!-- Charts and Additional Data -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <!-- Order Summary Chart -->
        <div class="bg-white p-6 rounded-lg shadow">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Orders Summary</h3>
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">Pending</span>
                    <span class="font-semibold" data-stat="pending">@(Model?.OrderSummary?.Pending ?? 0)</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">Processing</span>
                    <span class="font-semibold" data-stat="processing">@(Model?.OrderSummary?.Processing ?? 0)</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">Ready for Delivery/Pickup</span>
                    <span class="font-semibold" data-stat="ready">@(Model?.OrderSummary?.ReadyForDeliveryPickup ?? 0)</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">Completed</span>
                    <span class="font-semibold" data-stat="completed">@(Model?.OrderSummary?.Completed ?? 0)</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">Cancelled</span>
                    <span class="font-semibold" data-stat="cancelled">@(Model?.OrderSummary?.Cancelled ?? 0)</span>
                </div>
            </div>
            
            <!-- Progress bars for visual representation -->
            <div class="mt-6 space-y-2">
                <div class="flex justify-between text-xs text-gray-600">
                    <span>On Delivery (@(Model?.OrderSummary?.Processing ?? 0))</span>
                    <span>Delivered (@(Model?.OrderSummary?.Completed ?? 0))</span>
                    <span>Cancelled (@(Model?.OrderSummary?.Cancelled ?? 0))</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                    <div class="flex h-2 rounded-full">
                        <div class="bg-blue-500" style="width: @(GetPercentage(Model?.OrderSummary?.Processing ?? 0, TotalOrders(Model?.OrderSummary)))%"></div>
                        <div class="bg-green-500" style="width: @(GetPercentage(Model?.OrderSummary?.Completed ?? 0, TotalOrders(Model?.OrderSummary)))%"></div>
                        <div class="bg-red-500" style="width: @(GetPercentage(Model?.OrderSummary?.Cancelled ?? 0, TotalOrders(Model?.OrderSummary)))%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Most Selling Items -->
        <div class="bg-white p-6 rounded-lg shadow">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Most Selling Items</h3>
            <div class="space-y-4">
                @if (Model?.MostSellingItems?.Any() == true)
                {
                    @foreach (var item in Model.MostSellingItems)
                    {
                        <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                            <div class="flex items-center">
                                @if (!string.IsNullOrEmpty(item.ProductImage))
                                {
                                    <img src="@item.ProductImage" alt="@item.ProductName" class="w-10 h-10 rounded object-cover mr-3">
                                }
                                else
                                {
                                    <div class="w-10 h-10 bg-gray-200 rounded flex items-center justify-center mr-3">
                                        <i class="fas fa-image text-gray-400"></i>
                                    </div>
                                }
                                <div>
                                    <p class="font-medium text-gray-800">@item.ProductName</p>
                                    <p class="text-sm text-gray-600">Quantity: @item.TotalQuantity</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="font-semibold text-gray-800">₱@item.Price.ToString("N2")</p>
                                <p class="text-sm text-gray-600">₱@item.TotalRevenue.ToString("N2")</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 text-gray-500">
                        <i class="fas fa-chart-bar text-2xl mb-2"></i>
                        <p>No sales data available</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Most Favorites Items -->
    <div class="bg-white p-6 rounded-lg shadow">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Most Favorites Items</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @if (Model?.MostFavoriteItems?.Any() == true)
            {
                @foreach (var item in Model.MostFavoriteItems)
                {
                    <div class="border rounded-lg p-4">
                        <div class="flex items-center mb-3">
                            @if (!string.IsNullOrEmpty(item.ProductImage))
                            {
                                <img src="@item.ProductImage" alt="@item.ProductName" class="w-12 h-12 rounded object-cover mr-3">
                            }
                            else
                            {
                                <div class="w-12 h-12 bg-gray-200 rounded flex items-center justify-center mr-3">
                                    <i class="fas fa-image text-gray-400"></i>
                                </div>
                            }
                            <div>
                                <p class="font-medium text-gray-800">@item.ProductName</p>
                                <p class="text-sm text-gray-600">@item.FavoriteCount favorites</p>
                            </div>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="font-semibold text-gray-800">₱@item.Price.ToString("N2")</span>
                            <div class="flex text-yellow-400">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-3 text-center py-8 text-gray-500">
                    <i class="fas fa-heart text-2xl mb-2"></i>
                    <p>No favorite items yet</p>
                </div>
            }
        </div>
    </div>

    <!-- Staff Activity Table -->
    <div class="bg-white p-6 rounded-lg shadow">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Recent Staff Activities</h3>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Staff</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Elapsed Time</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Processed At</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @if (Model?.StaffActivities?.Any() == true)
                    {
                        @foreach (var activity in Model.StaffActivities)
                        {
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">#@activity.OrderID</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@activity.StaffName</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@activity.CustomerName</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                                        @(activity.OrderType == "Delivery" ? "bg-blue-100 text-blue-800" : "bg-green-100 text-green-800")">
                                        @activity.OrderType
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@activity.ElapsedTime</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@activity.ProcessedAt.ToString("MMM dd, yyyy hh:mm tt")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-4 text-center text-sm text-gray-500">
                                No staff activities recorded yet
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        // SignalR connection for real-time updates
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .withAutomaticReconnect()
            .build();

        connection.start().then(function () {
            console.log("SignalR Connected to OrderHub");
            return connection.invoke("JoinDashboardGroup");
        }).then(function () {
            console.log("Joined Dashboard group");
        }).catch(function (err) {
            console.error("SignalR Connection Error: ", err.toString());
        });

        // Listen for dashboard updates
        connection.on("DashboardUpdated", function (data) {
            console.log("Dashboard update received", data);
            updateDashboardUI(data);
        });

        // Handle reconnection
        connection.onreconnected(function(connectionId) {
            console.log("SignalR Reconnected");
            connection.invoke("JoinDashboardGroup");
        });

        function updateDashboardUI(data) {
            // Update stats cards
            updateElementText('[data-stat="todays-orders"]', data.stats.todaysOrders);
            updateElementText('[data-stat="total-orders"]', data.stats.totalOrders);
            updateElementText('[data-stat="todays-customers"]', data.stats.todaysCustomers);
            updateElementText('[data-stat="total-customers"]', data.stats.totalCustomers);
            updateElementText('[data-stat="total-sales"]', '₱' + formatCurrency(data.stats.totalSales));
            updateElementText('[data-stat="avg-sales"]', '₱' + formatCurrency(data.stats.averageSalePerDay));
            updateElementText('[data-stat="avg-processing-time"]', data.stats.averageProcessingTime); // Add this

            // Update order summary
            updateElementText('[data-stat="pending"]', data.orderSummary.pending);
            updateElementText('[data-stat="processing"]', data.orderSummary.processing);
            updateElementText('[data-stat="ready"]', data.orderSummary.readyForDeliveryPickup);
            updateElementText('[data-stat="completed"]', data.orderSummary.completed);
            updateElementText('[data-stat="cancelled"]', data.orderSummary.cancelled);

            // Show update notification
            showUpdateNotification();
        }

        function updateElementText(selector, value) {
            const element = document.querySelector(selector);
            if (element) {
                element.textContent = value;
            }
        }

        function formatCurrency(value) {
            return parseFloat(value).toLocaleString('en-PH', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function showUpdateNotification() {
            // Create or show a subtle update notification
            let notification = document.getElementById('dashboard-update-notification');
            if (!notification) {
                notification = document.createElement('div');
                notification.id = 'dashboard-update-notification';
                notification.className = 'fixed top-4 right-4 bg-green-500 text-white px-4 py-2 rounded-lg shadow-lg z-50';
                notification.textContent = 'Dashboard updated';
                document.body.appendChild(notification);
                
                setTimeout(() => {
                    notification.remove();
                }, 3000);
            }
        }

        // Fallback: AJAX updates every 30 seconds if SignalR fails
        function updateDashboardViaAjax() {
            fetch('@Url.Action("GetDashboardData", "Dashboard", new { area = "Restaurant" })')
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    updateDashboardUI(data);
                })
                .catch(error => console.error('Error updating dashboard via AJAX:', error));
        }

        // Update every 30 seconds as fallback
        setInterval(updateDashboardViaAjax, 30000);
    </script>
}

@functions {
    private int GetPercentage(int value, int total)
    {
        if (total == 0) return 0;
        return (int)Math.Round((value * 100.0) / total);
    }

    private int TotalOrders(ASI.Basecode.Services.ServiceModels.OrderSummaryViewModel summary)
    {
        if (summary == null) return 0;
        return summary.Pending + summary.Processing + summary.ReadyForDeliveryPickup + summary.Completed + summary.Cancelled;
    }
}