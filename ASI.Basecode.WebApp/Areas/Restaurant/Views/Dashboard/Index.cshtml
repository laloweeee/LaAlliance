@model ASI.Basecode.Services.ServiceModels.DashboardDataViewModel
@{
    ViewData["Title"] = "Dashboard Overview";
}

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div id="dashboard" class="section active">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Dashboard Overview</h2>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <!-- Orders Panel -->
        <div class="bg-gradient-to-r from-blue-500 to-blue-600 p-6 rounded-2xl shadow-lg text-white">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium opacity-90">Today's Orders</p>
                    <p class="text-3xl font-bold" data-stat="todays-orders">@(Model?.Stats?.TodaysOrders ?? 0)</p>
                    <p class="text-xs opacity-80 mt-1">@(Model?.Stats?.TotalOrders ?? 0) Total Orders</p>
                </div>
                <div class="w-14 h-14 bg-white bg-opacity-20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-shopping-cart text-2xl"></i>
                </div>
            </div>
        </div>

        <!-- Customers Panel -->
        <div class="bg-gradient-to-r from-green-500 to-green-600 p-6 rounded-2xl shadow-lg text-white">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium opacity-90">Today's Customers</p>
                    <p class="text-3xl font-bold" data-stat="todays-customers">@(Model?.Stats?.TodaysCustomers ?? 0)</p>
                    <p class="text-xs opacity-80 mt-1">@(Model?.Stats?.TotalCustomers ?? 0) Total Customers</p>
                </div>
                <div class="w-14 h-14 bg-white bg-opacity-20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-users text-2xl"></i>
                </div>
            </div>
        </div>

        <!-- Total Sales -->
        <div class="bg-gradient-to-r from-purple-500 to-purple-600 p-6 rounded-2xl shadow-lg text-white">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium opacity-90">Total Sales</p>
                    <p class="text-3xl font-bold" data-stat="total-sales">₱@((Model?.Stats?.TotalSales ?? 0).ToString("N2"))</p>
                    <p class="text-xs opacity-80 mt-1">Lifetime Revenue</p>
                </div>
                <div class="w-14 h-14 bg-white bg-opacity-20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-dollar-sign text-2xl"></i>
                </div>
            </div>
        </div>

        <!-- Average Processing Time -->
        <div class="bg-gradient-to-r from-orange-500 to-orange-600 p-6 rounded-2xl shadow-lg text-white">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium opacity-90">Avg Process Time</p>
                    <p class="text-3xl font-bold" data-stat="avg-processing-time">@(Model?.Stats?.AverageProcessingTime ?? "00:00:00")</p>
                    <p class="text-xs opacity-80 mt-1">Order to Completion</p>
                </div>
                <div class="w-14 h-14 bg-white bg-opacity-20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-clock text-2xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-8 mb-8">
        <!-- Order Summary -->
        <div class="bg-white rounded-2xl shadow-lg p-6">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-xl font-bold text-gray-800">Orders Summary</h3>
                <span class="text-sm text-gray-500">Real-time Updates</span>
            </div>
            
            <div class="grid grid-cols-2 gap-6">
                <!-- Pie Chart -->
                <div class="flex justify-center items-center">
                    <canvas id="orderSummaryChart" width="200" height="200"></canvas>
                </div>
                
                <!-- Order Stats -->
                <div class="space-y-4">
                    <div class="flex items-center justify-between p-3 bg-blue-50 rounded-lg">
                        <div class="flex items-center">
                            <div class="w-3 h-3 bg-blue-500 rounded-full mr-3"></div>
                            <span class="text-sm font-medium text-gray-700">New Orders</span>
                        </div>
                        <span class="text-lg font-bold text-blue-600" data-stat="pending">@(Model?.OrderSummary?.Pending ?? 0)</span>
                    </div>
                    
                    <div class="flex items-center justify-between p-3 bg-purple-50 rounded-lg">
                        <div class="flex items-center">
                            <div class="w-3 h-3 bg-purple-500 rounded-full mr-3"></div>
                            <span class="text-sm font-medium text-gray-700">On Delivery</span>
                        </div>
                        <span class="text-lg font-bold text-purple-600" data-stat="processing">@(Model?.OrderSummary?.Processing ?? 0)</span>
                    </div>
                    
                    <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg">
                        <div class="flex items-center">
                            <div class="w-3 h-3 bg-green-500 rounded-full mr-3"></div>
                            <span class="text-sm font-medium text-gray-700">Delivered</span>
                        </div>
                        <span class="text-lg font-bold text-green-600" data-stat="completed">@(Model?.OrderSummary?.Completed ?? 0)</span>
                    </div>
                    
                    <div class="flex items-center justify-between p-3 bg-red-50 rounded-lg">
                        <div class="flex items-center">
                            <div class="w-3 h-3 bg-red-500 rounded-full mr-3"></div>
                            <span class="text-sm font-medium text-gray-700">Cancelled</span>
                        </div>
                        <span class="text-lg font-bold text-red-600" data-stat="cancelled">@(Model?.OrderSummary?.Cancelled ?? 0)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Revenue Panel -->
        <div class="bg-white rounded-2xl shadow-lg p-6">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-xl font-bold text-gray-800">Revenue</h3>
                <span class="text-sm text-green-500 font-medium">+@(Model?.RevenueData?.MonthlyGrowth ?? 0)% this month</span>
            </div>
            
            <!-- Revenue Stats -->
            <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="text-center p-4 bg-gray-50 rounded-lg">
                    <p class="text-sm text-gray-600 mb-1">Income</p>
                    <p class="text-2xl font-bold text-gray-800">₱@((Model?.RevenueData?.TotalRevenue ?? 0).ToString("N2"))</p>
                </div>
                <div class="text-center p-4 bg-gray-50 rounded-lg">
                    <p class="text-sm text-gray-600 mb-1">Expense</p>
                    <p class="text-2xl font-bold text-gray-800">₱@((Model?.RevenueData?.TotalExpenses ?? 0).ToString("N2"))</p>
                </div>
            </div>
            
            <!-- Line Chart -->
            <div class="h-64">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Bottom Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Most Selling Items -->
        <div class="bg-white rounded-2xl shadow-lg p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-4">Most Selling Items</h3>
            <div class="space-y-4">
                @if (Model?.MostSellingItems?.Any() == true)
                {
                    @foreach (var item in Model.MostSellingItems.Take(5))
                    {
                        <div class="flex items-center justify-between p-3 hover:bg-gray-50 rounded-lg transition-colors">
                            <div class="flex items-center">
                                @if (!string.IsNullOrEmpty(item.ProductImage))
                                {
                                    <img src="@item.ProductImage" alt="@item.ProductName" class="w-12 h-12 rounded-lg object-cover mr-3">
                                }
                                else
                                {
                                    <div class="w-12 h-12 bg-gray-200 rounded-lg flex items-center justify-center mr-3">
                                        <i class="fas fa-image text-gray-400"></i>
                                    </div>
                                }
                                <div>
                                    <p class="font-medium text-gray-800">@item.ProductName</p>
                                    <p class="text-sm text-gray-600">@item.TotalQuantity sold</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="font-semibold text-gray-800">₱@item.TotalRevenue.ToString("N2")</p>
                                <p class="text-sm text-gray-600">₱@item.Price.ToString("N2") each</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-8 text-gray-500">
                        <i class="fas fa-chart-bar text-3xl mb-3"></i>
                        <p>No sales data available</p>
                    </div>
                }
            </div>
        </div>

        <!-- Most Favorites Items -->
        <div class="bg-white rounded-2xl shadow-lg p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-4">Most Favorites Items</h3>
            <div class="space-y-4">
                @if (Model?.MostFavoriteItems?.Any() == true)
                {
                    @foreach (var item in Model.MostFavoriteItems.Take(5))
                    {
                        <div class="flex items-center justify-between p-3 hover:bg-gray-50 rounded-lg transition-colors">
                            <div class="flex items-center">
                                @if (!string.IsNullOrEmpty(item.ProductImage))
                                {
                                    <img src="@item.ProductImage" alt="@item.ProductName" class="w-12 h-12 rounded-lg object-cover mr-3">
                                }
                                else
                                {
                                    <div class="w-12 h-12 bg-gray-200 rounded-lg flex items-center justify-center mr-3">
                                        <i class="fas fa-image text-gray-400"></i>
                                    </div>
                                }
                                <div>
                                    <p class="font-medium text-gray-800">@item.ProductName</p>
                                    <p class="text-sm text-gray-600">@item.FavoriteCount favorites</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <span class="font-semibold text-gray-800">₱@item.Price.ToString("N2")</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-8 text-gray-500">
                        <i class="fas fa-heart text-3xl mb-3"></i>
                        <p>No favorite items yet</p>
                    </div>
                }
            </div>
        </div>

        <!-- Staff Activities -->
        <div class="bg-white rounded-2xl shadow-lg p-6 lg:col-span-2">
            <h3 class="text-xl font-bold text-gray-800 mb-4">Recent Staff Activities</h3>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order ID</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Staff</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order Type</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Processed At</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @if (Model?.StaffActivities?.Any() == true)
                        {
                            @foreach (var activity in Model.StaffActivities.Take(6))
                            {
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-900">#@activity.OrderID</td>
                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">@activity.StaffName</td>
                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">@activity.CustomerName</td>
                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                                            @(activity.OrderType == "Delivery" ? "bg-blue-100 text-blue-800" : "bg-green-100 text-green-800")">
                                            @activity.OrderType
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">@activity.ProcessedAt.ToString("MMM dd, yyyy hh:mm tt")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="px-4 py-8 text-center text-sm text-gray-500">
                                    <i class="fas fa-clipboard-list text-2xl mb-2"></i>
                                    <p>No staff activities recorded yet</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Use CDN instead of local SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    
    <script>
        // Initialize Charts
        let orderSummaryChart, revenueChart;

        function initializeCharts() {
            console.log('Initializing charts...');
            
            // Check if canvas elements exist
            const orderCanvas = document.getElementById('orderSummaryChart');
            const revenueCanvas = document.getElementById('revenueChart');
            
            console.log('Order canvas found:', !!orderCanvas);
            console.log('Revenue canvas found:', !!revenueCanvas);
            
            if (!orderCanvas || !revenueCanvas) {
                console.error('Canvas elements not found!');
                return;
            }

            // Order Summary Pie Chart
            try {
                const orderCtx = orderCanvas.getContext('2d');
                orderSummaryChart = new Chart(orderCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['New Orders', 'On Delivery', 'Delivered', 'Cancelled'],
                        datasets: [{
                            data: [
                                @(Model?.OrderSummary?.Pending ?? 0),
                                @(Model?.OrderSummary?.Processing ?? 0),
                                @(Model?.OrderSummary?.Completed ?? 0),
                                @(Model?.OrderSummary?.Cancelled ?? 0)
                            ],
                            backgroundColor: [
                                '#3b82f6', // blue
                                '#8b5cf6', // purple
                                '#10b981', // green
                                '#ef4444'  // red
                            ],
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: {
                                display: false
                            }
                        },
                        cutout: '70%'
                    }
                });
                console.log('Order summary chart initialized');
            } catch (error) {
                console.error('Error initializing order summary chart:', error);
            }

            // Revenue Line Chart
            try {
                const revenueCtx = revenueCanvas.getContext('2d');
                const monthlyRevenue = @Html.Raw(Json.Serialize(Model?.MonthlyRevenue ?? new List<MonthlyRevenueViewModel>()));
                
                revenueChart = new Chart(revenueCtx, {
                    type: 'line',
                    data: {
                        labels: monthlyRevenue.map(m => m.monthName) || [],
                        datasets: [{
                            label: 'Monthly Revenue',
                            data: monthlyRevenue.map(m => m.revenue) || [],
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: {
                                    drawBorder: false
                                },
                                ticks: {
                                    callback: function(value) {
                                        return '₱' + value.toLocaleString();
                                    }
                                }
                            },
                            x: {
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                });
                console.log('Revenue chart initialized');
            } catch (error) {
                console.error('Error initializing revenue chart:', error);
            }
        }

        // SignalR Connection with error handling
        function initializeSignalR() {
            if (typeof signalR === 'undefined') {
                console.error('SignalR not loaded');
                return;
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/orderHub")
                .withAutomaticReconnect()
                .build();

            connection.start().then(function () {
                console.log("SignalR Connected to OrderHub");
                return connection.invoke("JoinDashboardGroup");
            }).then(function () {
                console.log("Joined Dashboard group");
            }).catch(function (err) {
                console.error("SignalR Connection Error: ", err.toString());
            });

            // Listen for dashboard updates
            connection.on("DashboardUpdated", function (data) {
                console.log("Dashboard update received", data);
                updateDashboardUI(data);
                updateCharts(data);
            });

            return connection;
        }

        function updateDashboardUI(data) {
            // Update stats cards
            updateElementText('[data-stat="todays-orders"]', data.stats.todaysOrders);
            updateElementText('[data-stat="todays-customers"]', data.stats.todaysCustomers);
            updateElementText('[data-stat="total-sales"]', '₱' + formatCurrency(data.stats.totalSales));
            updateElementText('[data-stat="avg-processing-time"]', data.stats.averageProcessingTime);

            // Update order summary
            updateElementText('[data-stat="pending"]', data.orderSummary.pending);
            updateElementText('[data-stat="processing"]', data.orderSummary.processing);
            updateElementText('[data-stat="completed"]', data.orderSummary.completed);
            updateElementText('[data-stat="cancelled"]', data.orderSummary.cancelled);

            // Update revenue growth indicator if available
            if (data.revenueData) {
                const growthElement = document.querySelector('.text-green-500.font-medium');
                if (growthElement) {
                    growthElement.textContent = `+${data.revenueData.monthlyGrowth}% this month`;
                }
            }
        }

        function updateCharts(data) {
            // Update order summary chart
            if (orderSummaryChart) {
                orderSummaryChart.data.datasets[0].data = [
                    data.orderSummary.pending,
                    data.orderSummary.processing,
                    data.orderSummary.completed,
                    data.orderSummary.cancelled
                ];
                orderSummaryChart.update('active');
            }

            // Update revenue chart if monthly revenue data is available
            if (revenueChart && data.monthlyRevenue) {
                revenueChart.data.labels = data.monthlyRevenue.map(m => m.monthName);
                revenueChart.data.datasets[0].data = data.monthlyRevenue.map(m => m.revenue);
                revenueChart.update('active');
            }
        }

        function updateElementText(selector, value) {
            const element = document.querySelector(selector);
            if (element) {
                element.textContent = value;
            }
        }

        function formatCurrency(value) {
            return parseFloat(value).toLocaleString('en-PH', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        // Initialize everything when page loads
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM loaded, initializing charts and SignalR');
            initializeCharts();
            initializeSignalR();
        });
    </script>
}