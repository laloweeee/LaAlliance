@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    // figure out which action is active
    var current = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLower();

    string ItemClass(string action)
        => $"nav-item w-full flex items-center gap-3 px-4 py-2 rounded-lg transition-colors " +
           (current == action.ToLower()
                ? "bg-emerald-500 text-white hover:bg-emerald-600"
                : "text-gray-900 hover:bg-gray-100");

    string IconClass(string action)
        => "w-5 " + (current == action.ToLower() ? "text-white" : "text-black");
}
<div class="w-64 bg-white h-screen overflow-y-auto">
    <nav class="space-y-2 p-4">
        <a asp-area="Restaurant" asp-controller="Restaurant" asp-action="Dashboard"
           class="@ItemClass("Dashboard")">
            <i class="fas fa-tachometer-alt @IconClass("Dashboard")"></i>
            <span>Dashboard</span>
        </a>

        <a asp-area="Restaurant" asp-controller="Restaurant" asp-action="RestaurantProfile"
           class="@ItemClass("RestaurantProfile")">
            <i class="fas fa-store @IconClass("RestaurantProfile")"></i>
            <span>Restaurant Profile</span>
        </a>

        <a asp-area="Restaurant" asp-controller="Restaurant" asp-action="Menu"
           class="@ItemClass("Menu")">
            <i class="fas fa-utensils @IconClass("Menu")"></i>
            <span>Menu Management</span>
        </a>

        <a asp-area="Restaurant" asp-controller="Restaurant" asp-action="Promotions"
           class="@ItemClass("Promotions")">
            <i class="fas fa-bullhorn @IconClass("Promotions")"></i>
            <span>Promotions</span>
        </a>

        <a asp-area="Restaurant" asp-controller="Restaurant" asp-action="Reports"
           class="@ItemClass("Reports")">
            <i class="fas fa-chart-line @IconClass("Reports")"></i>
            <span>Reports &amp; Analytics</span>
        </a>

        <a asp-area="Restaurant" asp-controller="Restaurant" asp-action="Staff"
           class="@ItemClass("Staff")">
            <i class="fas fa-users @IconClass("Staff")"></i>
            <span>Staff Management</span>
        </a>

        <a asp-controller="Account" asp-action="Logout"
           class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700">
            <i class="fas fa-sign-out-alt"></i>
            <span>Logout</span>
        </a>
    </nav>
</div>
