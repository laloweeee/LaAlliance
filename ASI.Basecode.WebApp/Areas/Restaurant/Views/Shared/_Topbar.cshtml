@using Microsoft.AspNetCore.Http

<div id="topbar" class="border-b border-gray-200 bg-white px-6 py-4 shadow-sm">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3 px-1">
            <img src="~/img/LaAlliance-logo.png" alt="logo" class="h-12 w-auto" />
            <div class="flex flex-col leading-tight">
                <span class="text-xl font-bold text-gray-900">LaAlliancé</span>
                <span class="text-sm text-gray-500">Restaurant Portal</span>
            </div>
        </div>

        <div class="align-center flex flex-row items-center gap-2">
            <div class="relative hidden md:block">
                <i class="fas fa-search -translate-y-1/2 absolute left-3 top-1/2 transform text-gray-400"></i>
                <input type="text" placeholder="Search..." class="rounded-lg border border-gray-200 py-2 pl-10 pr-4 focus:border-transparent focus:ring-2 focus:ring-green-500">
            </div>

            <button class="relative rounded-lg p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-600">
                <i class="fas fa-bell text-xl"></i>
                <span class="notification-dot"></span>
            </button>

            <div class="relative">
                <!-- Avatar button -->
                <button id="userMenuButton"
                        type="button"
                        class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center hover:ring-2 hover:ring-green-500 focus:outline-none"
                        aria-haspopup="true" aria-expanded="false">
                    <i class="fas fa-user text-green-600"></i>
                </button>

                <!-- Dropdown -->
                <div id="userMenu"
                     class="absolute right-0 mt-2 w-56 bg-white border border-gray-200 rounded-xl shadow-lg py-2 hidden z-50">
                    <a asp-area="Restaurant" asp-controller="User" asp-action="Profile"
                       class="flex items-center gap-3 px-4 py-2 text-gray-700 hover:bg-gray-50">
                        <i class="fas fa-id-badge w-5 text-gray-400"></i>
                        <span>Profile</span>
                    </a>

                    <a asp-area="Restaurant" asp-controller="User" asp-action="Settings"
                       class="flex items-center gap-3 px-4 py-2 text-gray-700 hover:bg-gray-50">
                        <i class="fas fa-cog w-5 text-gray-400"></i>
                        <span>Account Settings</span>
                    </a>

                    <!-- Logout (POST) -->
                    <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="w-full flex items-center gap-3 px-4 py-2 text-left text-red-600 hover:bg-red-50">
                            <i class="fas fa-sign-out-alt w-5"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
