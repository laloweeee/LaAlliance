@{
    ViewData["Title"] = "Reports & Analytics";
}

<h2 class="text-2xl font-bold text-gray-800 mb-6">Reports</h2>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Report Builder -->
    <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold mb-4">Build Report</h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">From</label>
                <input id="repFrom" type="date" class="w-full px-3 py-2 border rounded-lg">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">To</label>
                <input id="repTo" type="date" class="w-full px-3 py-2 border rounded-lg">
            </div>
        </div>

        <div class="mt-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">Type</label>
            <div class="space-y-2">
                <label class="flex items-center"><input type="radio" name="repType" value="sales" class="mr-2" checked>Sales Summary</label>
                <label class="flex items-center"><input type="radio" name="repType" value="orders" class="mr-2">Order Details</label>
                <label class="flex items-center"><input type="radio" name="repType" value="inventory" class="mr-2">Inventory Snapshot</label>
            </div>
        </div>

        <div class="mt-6 flex gap-2">
            <button type="button" class="px-4 py-2 rounded bg-gray-800 text-white hover:bg-black" onclick="downloadReportPdf()">Download PDF</button>
            <button type="button" class="px-4 py-2 rounded bg-blue-600 text-white hover:bg-blue-700" onclick="emailReport()">Email Report</button>
        </div>
    </div>

    <!-- Preview / Tips -->
    <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold mb-2">Preview</h3>
        <p class="text-gray-600">Choose a date range and report type, then download or email the report.</p>

        <div class="mt-4 border rounded-lg p-6 text-gray-500 h-64 overflow-auto" id="reportPreview">
            Report preview area
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // demo actions to mirror the sample page behavior
        window.downloadReportPdf = function () {
          const from = document.getElementById('repFrom').value || '(no start)';
          const to   = document.getElementById('repTo').value   || '(no end)';
          const type = document.querySelector('input[name="repType"]:checked')?.value || 'sales';
          const msg  = `Generating ${type} report\nFrom: ${from}\nTo: ${to}\n\n(This is a demo action.)`;
          alert(msg);
          // In real app, call your backend to generate and return a file.
        };

        window.emailReport = function () {
          const from = document.getElementById('repFrom').value || '(no start)';
          const to   = document.getElementById('repTo').value   || '(no end)';
          const type = document.querySelector('input[name="repType"]:checked')?.value || 'sales';
          const prev = document.getElementById('reportPreview');
          prev.textContent = `Queued email for ${type} report (${from} → ${to}).`;
          // In real app, call your backend to email the report.
        };
    </script>
}
