@model ASI.Basecode.Services.ServiceModels.StaffViewModel

@{
    ViewData["Title"] = "Update Staff Member";
}

<div class="max-w-3xl mx-auto bg-white rounded-lg shadow">
    <div class="flex items-center justify-between px-6 py-4 border-b">
        <h2 class="text-2xl font-bold text-gray-800">Update Staff Member</h2>

        <a asp-area="Restaurant" asp-controller="Staff" asp-action="Index"
           class="text-gray-600 hover:text-gray-800 text-sm">
           ← Back to Staff Management
        </a>
    </div>

    <div class="p-6">
        @if (TempData["Error"] != null)
        {
            <div class="mb-4 rounded bg-red-50 text-red-800 px-4 py-2">
                @TempData["Error"]
            </div>
        }

        <form asp-area="Restaurant" asp-controller="Staff" asp-action="UpdateStaffMember" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <!-- Hidden Staff ID -->
            <input type="hidden" asp-for="StaffID" />

            <!-- First / Last / Email -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">First Name</label>
                    <input type="text" asp-for="FirstName"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="John" required>
                    <span asp-validation-for="FirstName" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Last Name</label>
                    <input type="text" asp-for="LastName"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Doe" required>
                    <span asp-validation-for="LastName" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                    <input type="email" asp-for="Email"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="john@restaurant.com" required>
                    <span asp-validation-for="Email" class="text-red-600 text-xs"></span>
                </div>
            </div>

            <!-- Contact Number / Role -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Contact Number</label>
                    <input type="tel" asp-for="ContactNumber"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="(09xx) xxx-xxxx" required>
                    <span asp-validation-for="ContactNumber" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Role</label>
                    <select asp-for="Role"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg" required>
                        <option value="Admin">Admin</option>
                        <option value="Staff">Staff</option>
                    </select>
                    <span asp-validation-for="Role" class="text-red-600 text-xs"></span>
                </div>
            </div>

            <!-- Status -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                    <select asp-for="Status"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg" required>
                        <option value="Active">Active</option>
                        <option value="Suspended">Suspended</option>
                        <option value="Terminated">Terminated</option>
                    </select>
                    <span asp-validation-for="Status" class="text-red-600 text-xs"></span>
                    <p class="text-xs text-gray-500 mt-1">Change staff status as needed.</p>
                </div>
            </div>

            <!-- Password (Optional for Update) -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                    <input type="password" asp-for="Password"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Leave blank to keep current">
                    <span asp-validation-for="Password" class="text-red-600 text-xs"></span>
                    <p class="text-xs text-gray-500 mt-1">Leave blank to keep the current password.</p>
                </div>
            </div>

            <div class="flex justify-end space-x-4 pt-6 border-t">
                <a asp-area="Restaurant" asp-controller="Staff" asp-action="Index"
                   class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                    Cancel
                </a>
                <button type="submit"
                        class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg">
                    Update Staff Member
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}