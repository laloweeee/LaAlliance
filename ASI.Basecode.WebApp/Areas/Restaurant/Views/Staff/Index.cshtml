@using ASI.Basecode.Services.ServiceModels
@model IEnumerable<ASI.Basecode.Services.ServiceModels.StaffList>

@{
    ViewData["Title"] = "Staff Management";

    string Initials(string f, string l)
        => $"{(string.IsNullOrWhiteSpace(f) ? "" : f.Trim()[0].ToString())}{(string.IsNullOrWhiteSpace(l) ? "" : l.Trim()[0].ToString())}".ToUpper();

    string RoleBadgeClass(string role) => role == "Admin"
        ? "bg-green-100 text-green-800"
        : "bg-blue-100 text-blue-800";

    string StatusBadgeClass(string status) =>
        status == "Active"    ? "bg-green-100 text-green-800" :
        status == "Suspended" ? "bg-yellow-100 text-yellow-800" :
                                 "bg-red-100 text-red-800";
}

<div id="staff" class="section active">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-800">Staff Management</h2>

        <a asp-area="Restaurant" asp-action="AddStaffMember" asp-controller="Staff"
           class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition-colors">
            <i class="fas fa-plus mr-2"></i>Add Staff Member
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 rounded bg-green-50 text-green-800 px-4 py-2">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 rounded bg-red-50 text-red-800 px-4 py-2">
            @TempData["Error"]
        </div>
    }

    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Staff Member</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Login</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @if (Model != null && Model.Any())
                {
                    foreach (var s in Model)
                    {
                        <tr data-id="@s.Id">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                                        <span class="text-blue-600 font-medium">@Initials(s.FirstName, s.LastName)</span>
                                    </div>
                                    <div class="ml-4">
                                        <div class="text-sm font-medium text-gray-900">@($"{s.FirstName} {s.LastName}")</div>
                                        <div class="text-sm text-gray-500">@s.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @RoleBadgeClass(s.Role)">@s.Role</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @StatusBadgeClass(s.Status)">@s.Status</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @(!string.IsNullOrWhiteSpace(s.LastLogin) ? s.LastLogin : "—")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                                <a asp-area="Restaurant"
                                   asp-controller="Staff"
                                   asp-action="AddStaffMember"
                                   asp-route-id="@s.Id"
                                   class="text-blue-600 hover:text-blue-900">Edit</a>

                                <form asp-area="Restaurant"
                                      asp-controller="Staff"
                                      asp-action="DeleteStaff"
                                      method="post"
                                      class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="staffID" value="@s.Id" />
                                    <button type="submit"
                                            class="text-red-600 hover:text-red-900"
                                            onclick="return confirm('Delete this staff member?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-6 py-4 text-sm text-gray-500">
                            No staff yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
