@{
    ViewData["Title"] = "Add Staff Member";
}

<div class="max-w-3xl mx-auto bg-white rounded-lg shadow">
    <div class="flex items-center justify-between px-6 py-4 border-b">
        <h2 class="text-2xl font-bold text-gray-800">Add Staff Member</h2>

        <a asp-area="Restaurant" asp-controller="Staff" asp-action="Index"
           class="text-gray-600 hover:text-gray-800 text-sm">
           ← Back to Staff Management
        </a>
    </div>

    <div class="p-6">
        <form asp-area="Restaurant" asp-controller="Staff" asp-action="CreateStaffInfo" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <!-- Hidden ID for future edit support (optional) -->
            <input type="hidden" id="editingStaffId" name="Id" value="@Context.Request.Query["id"]" />

            <!-- First / Last / Email -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">First Name</label>
                    <input type="text" id="staffFirstName" name="FirstName"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="John" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Last Name</label>
                    <input type="text" id="staffLastName" name="LastName"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="Doe" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                    <input type="email" id="staffEmail" name="Email"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="john@restaurant.com" required>
                </div>
            </div>

            <!-- Contact Number / Role -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Contact Number</label>
                    <input type="tel" id="staffPhone" name="ContactNumber"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="(09xx) xxx-xxxx" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Role</label>
                    <select id="staffRole" name="Role"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg" required>
                        <option>Admin</option>
                        <option>Staff</option>
                    </select>
                </div>
            </div>

            <!-- Status (disabled, auto Active) -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                    <!-- Disabled select for display -->
                    <select id="staffStatusDisplay"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-600" disabled>
                        <option selected>Active</option>
                        <option>Suspended</option>
                        <option>Terminated</option>
                    </select>
                    <!-- Hidden field actually submitted -->
                    <input type="hidden" id="staffStatus" name="Status" value="Active" />
                    <p class="text-xs text-gray-500 mt-1">New staff are created as <b>Active</b> by default.</p>
                </div>
            </div>

            <!-- Password -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                    <input type="password" id="staffPassword" name="Password"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="••••••••" required>
                </div>
            </div>

            <div class="flex justify-end space-x-4 pt-6 border-t">
                <a asp-area="Restaurant" asp-controller="Staff" asp-action="Index"
                   class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                    Cancel
                </a>
                <button id="staffSubmitBtn" type="submit"
                        class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg">
                    Add Staff Member
                </button>
            </div>
        </form>
    </div>
</div>
