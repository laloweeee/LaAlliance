@model ASI.Basecode.WebApp.Areas.Customer.Models.AccountViewModel
@{
    ViewData["Title"] = "Edit Profile - LaAlliancé";
}

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-emerald-50/30 to-gray-50">
    <div class="p-4 md:p-6 lg:p-8">
        <div class="max-w-2xl mx-auto">
            <!-- Back Navigation -->
            <nav class="flex items-center gap-2 text-sm text-gray-600 mb-6">
                <a asp-action="Index" asp-controller="Home" asp-area="Customer" class="hover:text-emerald-600 transition-colors">
                    <i class="fas fa-home"></i> Home
                </a>
                <i class="fas fa-chevron-right text-xs"></i>
                <a asp-action="Index" asp-controller="Account" asp-area="Customer" class="hover:text-emerald-600 transition-colors">
                    My Account
                </a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-emerald-600 font-medium">Edit Profile</span>
            </nav>

            <!-- Form Card -->
            <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
                <!-- Header -->
                <div class="bg-gradient-to-r from-emerald-600 to-emerald-700 p-6 md:p-8">
                    <div class="flex items-center gap-4">
                        <div class="w-16 h-16 bg-white/20 backdrop-blur-sm rounded-xl flex items-center justify-center shadow-lg">
                            <i class="fas fa-user-edit text-white text-2xl"></i>
                        </div>
                        <div>
                            <h1 class="text-2xl md:text-3xl font-bold text-white">Edit Profile</h1>
                            <p class="text-emerald-100 mt-1">Update your name and contact information</p>
                        </div>
                    </div>
                </div>

                <!-- Form Content -->
                <form asp-action="UpdateProfile" asp-controller="Account" asp-area="Customer" method="post" class="p-6 md:p-8">
                    @Html.AntiForgeryToken()
                    <div class="space-y-6">
                        <!-- First Name -->
                        <div>
                            <label class="block text-gray-700 font-semibold mb-2 flex items-center gap-2">
                                <i class="fas fa-user text-emerald-600"></i>
                                First Name
                                <span class="text-red-500">*</span>
                            </label>
                            <input type="text" 
                                   asp-for="FirstName"
                                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none"
                                   placeholder="Enter your first name"
                                   required />
                            <span asp-validation-for="FirstName" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <!-- Last Name -->
                        <div>
                            <label class="block text-gray-700 font-semibold mb-2 flex items-center gap-2">
                                <i class="fas fa-user text-emerald-600"></i>
                                Last Name
                                <span class="text-red-500">*</span>
                            </label>
                            <input type="text" 
                                   asp-for="LastName"
                                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none"
                                   placeholder="Enter your last name"
                                   required />
                            <span asp-validation-for="LastName" class="text-red-500 text-sm mt-1 block"></span>
                        </div>

                        <!-- Contact Number -->
                        <div>
                            <label class="block text-gray-700 font-semibold mb-2 flex items-center gap-2">
                                <i class="fas fa-phone text-emerald-600"></i>
                                Contact Number
                                <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 font-medium">+63</span>
                                <input type="tel" 
                                       asp-for="ContactNumber"
                                       class="w-full pl-14 pr-4 py-3 border-2 border-gray-200 rounded-xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none"
                                       placeholder="9XX XXX XXXX"
                                       pattern="[0-9]{10,11}"
                                       required />
                            </div>
                            <span asp-validation-for="ContactNumber" class="text-red-500 text-sm mt-1 block"></span>
                            <p class="text-sm text-gray-500 mt-2">
                                <i class="fas fa-info-circle"></i>
                                Format: 09XX XXX XXXX or 9XX XXX XXXX
                            </p>
                        </div>

                        <!-- Info Banner -->
                        <div class="bg-blue-50 border-2 border-blue-200 rounded-xl p-4">
                            <div class="flex items-start gap-3">
                                <i class="fas fa-info-circle text-blue-600 text-xl mt-0.5"></i>
                                <div>
                                    <h4 class="font-semibold text-blue-900 mb-1">Profile Update</h4>
                                    <p class="text-sm text-blue-700 leading-relaxed">
                                        Changes to your name and contact number will be reflected immediately across your account. 
                                        To update your email or password, please use the respective change options on your account page.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex flex-col sm:flex-row gap-3 pt-6 border-t border-gray-200">
                            <button type="submit" 
                                    class="flex-1 bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white px-6 py-3.5 rounded-xl font-bold shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2">
                                <i class="fas fa-save"></i>
                                <span>Save Changes</span>
                            </button>
                            <a asp-action="Index" asp-controller="Account" asp-area="Customer"
                               class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-3.5 rounded-xl font-bold transition-all flex items-center justify-center gap-2">
                                <i class="fas fa-times"></i>
                                <span>Cancel</span>
                            </a>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Help Text -->
            <div class="mt-6 text-center">
                <p class="text-sm text-gray-600">
                    Need help? <a href="#" class="text-emerald-600 hover:underline font-semibold">Contact Support</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}