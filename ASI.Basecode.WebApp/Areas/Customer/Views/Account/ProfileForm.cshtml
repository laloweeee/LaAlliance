@model ASI.Basecode.WebApp.Areas.Customer.Models.AccountViewModel
@{
    ViewData["Title"] = "Edit Profile - LaAlliancé";
}

<div class="min-h-screen bg-gray-50">
    <div class="p-6">
        <div class="max-w-7xl mx-auto">
            <!-- Page Header - Matching cart style -->
            <div class="mb-8">
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Edit Profile</h1>
                <p class="text-gray-600">Update your name and contact information</p>
            </div>

            <!-- Main Content Container - Matching cart layout -->
            <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
                <div class="flex flex-col lg:flex-row gap-6">
                    <!-- Left Column - Form Content -->
                    <div class="flex-1">
                        <!-- Edit Profile Card - Matching My Account style -->
                        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-all duration-300 overflow-hidden mb-6">
                            <div class="p-6">
                                <div class="flex justify-between items-start mb-6">
                                    <div>
                                        <h2 class="text-xl font-bold text-gray-900 mb-2 flex items-center gap-3">
                                            <div class="w-10 h-10 bg-green-600 rounded-lg flex items-center justify-center">
                                                <i class="fas fa-user-edit text-white"></i>
                                            </div>
                                            Edit Profile Information
                                        </h2>
                                        <p class="text-gray-600">Update your personal details</p>
                                    </div>
                                    <!-- Back Button -->
                                    <a asp-action="Index" asp-controller="Account" asp-area="Customer"
                                       class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-4 py-2 rounded-lg font-semibold transition-colors flex items-center gap-2">
                                        <i class="fas fa-arrow-left"></i>
                                        <span>Back</span>
                                    </a>
                                </div>

                                <form asp-action="UpdateProfile" asp-controller="Account" asp-area="Customer" method="post">
                                    @Html.AntiForgeryToken()
                                    
                                    <div class="space-y-6">
                                        <!-- First Name -->
                                        <div>
                                            <label class="block text-gray-700 font-semibold mb-3">
                                                First Name
                                                <span class="text-red-500">*</span>
                                            </label>
                                            <input type="text" 
                                                   asp-for="FirstName"
                                                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-100 transition-all outline-none"
                                                   placeholder="Enter your first name"
                                                   required />
                                            <span asp-validation-for="FirstName" class="text-red-500 text-sm mt-2 block"></span>
                                        </div>

                                        <!-- Last Name -->
                                        <div>
                                            <label class="block text-gray-700 font-semibold mb-3">
                                                Last Name
                                                <span class="text-red-500">*</span>
                                            </label>
                                            <input type="text" 
                                                   asp-for="LastName"
                                                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-100 transition-all outline-none"
                                                   placeholder="Enter your last name"
                                                   required />
                                            <span asp-validation-for="LastName" class="text-red-500 text-sm mt-2 block"></span>
                                        </div>

                                        <!-- Contact Number -->
                                        <div>
                                            <label class="block text-gray-700 font-semibold mb-3">
                                                Contact Number
                                                <span class="text-red-500">*</span>
                                            </label>
                                            <div class="relative">
                                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 font-medium">+63</span>
                                                <input type="tel" 
                                                       asp-for="ContactNumber"
                                                       class="w-full pl-14 pr-4 py-3 border-2 border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-100 transition-all outline-none"
                                                       placeholder="9XX XXX XXXX"
                                                       pattern="[0-9]{10,11}"
                                                       required />
                                            </div>
                                            <span asp-validation-for="ContactNumber" class="text-red-500 text-sm mt-2 block"></span>
                                            <p class="text-sm text-gray-500 mt-2 flex items-center gap-2">
                                                <i class="fas fa-info-circle text-gray-400"></i>
                                                Format: 09XX XXX XXXX or 9XX XXX XXXX
                                            </p>
                                        </div>

                                        <!-- Action Buttons -->
                                        <div class="flex gap-4 pt-6 border-t border-gray-200">
                                            <button type="submit" 
                                                    class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors flex items-center justify-center gap-2 shadow-sm hover:shadow-md">
                                                <i class="fas fa-save"></i>
                                                <span>Save Changes</span>
                                            </button>
                                            <a asp-action="Index" asp-controller="Account" asp-area="Customer"
                                               class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-6 py-3 rounded-lg font-semibold transition-colors flex items-center justify-center gap-2">
                                                <i class="fas fa-times"></i>
                                                <span>Cancel</span>
                                            </a>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column - Info Sidebar -->
                    <div class="lg:w-80">
                        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sticky top-6">
                            <h3 class="text-lg font-bold text-gray-800 mb-4">Update Information</h3>
                            
                            <!-- Info Section -->
                            <div class="space-y-4">
                                <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
                                    <div class="flex items-start gap-3">
                                        <div class="w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                                            <i class="fas fa-info text-white text-xs"></i>
                                        </div>
                                        <div class="text-sm text-blue-800">
                                            <p class="font-semibold mb-1">Profile Update</p>
                                            <p>Changes to your name and contact number will be reflected immediately across your account.</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="bg-gray-50 border border-gray-200 rounded-xl p-4">
                                    <div class="flex items-start gap-3">
                                        <div class="w-6 h-6 bg-gray-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                                            <i class="fas fa-envelope text-white text-xs"></i>
                                        </div>
                                        <div class="text-sm text-gray-700">
                                            <p class="font-semibold mb-1">Email & Password</p>
                                            <p>To update your email or password, please use the respective options on your account page.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Help Text -->
                            <div class="mt-6 pt-4 border-t border-gray-200">
                                <p class="text-sm text-gray-600 text-center">
                                    Need help? <a href="#" class="text-green-600 hover:underline font-semibold">Contact Support</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}