@model ASI.Basecode.WebApp.Areas.Customer.Models.AccountViewModel
@{
    ViewData["Title"] = "My Account - LaAlliancé";
}

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-emerald-50/30 to-gray-50">
    <div class="p-2 md:p-4 lg:p-6">
        <div class="max-w-[1200px] mx-auto">
            <!-- Page Header -->
            <div class="mb-6">
                <nav class="flex items-center gap-2 text-sm text-gray-600 mb-4">
                    <a asp-action="Index" asp-controller="Home" asp-area="Customer" class="hover:text-emerald-600 transition-colors">
                        <i class="fas fa-home"></i> Home
                    </a>
                    <i class="fas fa-chevron-right text-xs"></i>
                    <span class="text-emerald-600 font-medium">My Account</span>
                </nav>
                <h1 class="text-3xl md:text-4xl font-bold text-gray-900 flex items-center gap-3">
                    <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg">
                        <i class="fas fa-user-circle text-white text-xl"></i>
                    </div>
                    My Account
                </h1>
                <p class="text-gray-600 mt-2">Manage your profile, addresses, and preferences</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-6 p-4 bg-green-100 border border-green-200 text-green-800 rounded-lg flex items-center gap-3">
                    <i class="fas fa-check-circle text-green-600"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-6 p-4 bg-red-100 border border-red-200 text-red-800 rounded-lg flex items-center gap-3">
                    <i class="fas fa-exclamation-triangle text-red-600"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            <div class="flex flex-col gap-6">
                <!-- PROFILE INFORMATION CARD -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="bg-gradient-to-r from-emerald-600 to-emerald-700 p-6">
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fas fa-user"></i> Profile Information
                        </h2>
                        <p class="text-emerald-100 text-sm mt-1">Your personal details and credentials</p>
                    </div>

                    <div class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <!-- Email -->
                            <div class="md:col-span-2">
                                <label class="block text-gray-700 font-semibold mb-2 flex items-center gap-2">
                                    <i class="fas fa-envelope text-emerald-600"></i>
                                    Email Address
                                </label>
                                <div class="flex flex-col sm:flex-row gap-3">
                                    <input type="email" 
                                           class="flex-1 px-4 py-3 border-2 border-gray-200 rounded-xl bg-gray-50 text-gray-700 font-medium" 
                                           value="@Model.Email" 
                                           readonly />
                                    <a asp-action="EmailForm" asp-controller="Account" asp-area="Customer"
                                       class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3 rounded-xl font-semibold transition-all flex items-center justify-center gap-2 shadow-sm hover:shadow-md whitespace-nowrap">
                                        <i class="fas fa-edit"></i>
                                        <span>Change Email</span>
                                    </a>
                                </div>
                            </div>

                            <!-- Password -->
                            <div class="md:col-span-2">
                                <label class="block text-gray-700 font-semibold mb-2 flex items-center gap-2">
                                    <i class="fas fa-lock text-emerald-600"></i>
                                    Password
                                </label>
                                <div class="flex flex-col sm:flex-row gap-3">
                                    <input type="password" 
                                           class="flex-1 px-4 py-3 border-2 border-gray-200 rounded-xl bg-gray-50 text-gray-700 font-medium" 
                                           value="••••••••••••" 
                                           readonly />
                                    <a asp-action="PasswordForm" asp-controller="Account" asp-area="Customer"
                                       class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3 rounded-xl font-semibold transition-all flex items-center justify-center gap-2 shadow-sm hover:shadow-md whitespace-nowrap">
                                        <i class="fas fa-key"></i>
                                        <span>Change Password</span>
                                    </a>
                                </div>
                            </div>

                            <!-- First Name -->
                            <div>
                                <label class="block text-gray-700 font-semibold mb-2">First Name</label>
                                <input type="text" 
                                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl bg-gray-50 text-gray-700" 
                                       value="@Model.FirstName" 
                                       readonly />
                            </div>

                            <!-- Last Name -->
                            <div>
                                <label class="block text-gray-700 font-semibold mb-2">Last Name</label>
                                <input type="text" 
                                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl bg-gray-50 text-gray-700" 
                                       value="@Model.LastName" 
                                       readonly />
                            </div>

                            <!-- Contact Number -->
                            <div class="md:col-span-2">
                                <label class="block text-gray-700 font-semibold mb-2 flex items-center gap-2">
                                    <i class="fas fa-phone text-emerald-600"></i>
                                    Contact Number
                                </label>
                                <input type="text" 
                                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl bg-gray-50 text-gray-700" 
                                       value="@Model.ContactNumber" 
                                       readonly />
                            </div>
                        </div>

                        <!-- Edit Profile Button -->
                        <div class="mt-6 pt-6 border-t border-gray-100">
                            <a asp-action="ProfileForm" asp-controller="Account" asp-area="Customer"
                               class="inline-flex items-center gap-2 bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white px-6 py-3 rounded-xl font-semibold shadow-md hover:shadow-lg transition-all">
                                <i class="fas fa-user-edit"></i>
                                <span>Edit Name & Contact</span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- ADDRESSES CARD -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="bg-gradient-to-r from-blue-600 to-blue-700 p-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                                    <i class="fas fa-map-marker-alt"></i> Delivery Addresses
                                </h2>
                                <p class="text-blue-100 text-sm mt-1">Manage your delivery locations</p>
                            </div>
                            <a asp-action="AddressForm" asp-controller="Account" asp-area="Customer"
                               class="bg-white hover:bg-blue-50 text-blue-700 px-4 py-2 rounded-xl font-semibold transition-all flex items-center gap-2 shadow-md">
                                <i class="fas fa-plus"></i>
                                <span class="hidden sm:inline">Add Address</span>
                            </a>
                        </div>
                    </div>

                    <div class="p-6">
                        @if (Model.Addresses.Any())
                        {
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
                                @foreach (var address in Model.Addresses)
                                {
                                    <div class="group relative bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl border-2 border-blue-100 hover:border-blue-300 transition-all duration-300 overflow-hidden shadow-sm hover:shadow-md">
                                        <!-- Address Header -->
                                        <div class="p-5 pb-3">
                                            <div class="flex items-start justify-between mb-3">
                                                <div class="flex items-center gap-2">
                                                    <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
                                                        <i class="fas fa-home text-white"></i>
                                                    </div>
                                                    <div>
                                                        <span class="font-bold text-gray-900 text-lg">@address.AddressType</span>
                                                        @if (address.IsDefault)
                                                        {
                                                            <span class="ml-2 px-2 py-1 bg-emerald-600 text-white text-xs rounded-full font-semibold">
                                                                <i class="fas fa-check-circle"></i> Default
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Address Details -->
                                            <div class="space-y-2 mb-3">
                                                <div class="flex items-start gap-2">
                                                    <i class="fas fa-location-dot text-blue-600 mt-1"></i>
                                                    <p class="text-gray-700 font-medium leading-relaxed">
                                                        @address.Street, @address.Barangay<br />
                                                        @address.City, @address.Province @address.ZipCode
                                                    </p>
                                                </div>
                                                @if (!string.IsNullOrEmpty(address.AddressNote))
                                                {
                                                    <div class="flex items-start gap-2">
                                                        <i class="fas fa-sticky-note text-amber-500 mt-1"></i>
                                                        <p class="text-gray-600 text-sm">@address.AddressNote</p>
                                                    </div>
                                                }
                                                <div class="flex items-center gap-2 text-xs text-gray-500">
                                                    <i class="fas fa-map-pin"></i>
                                                    <span>@address.Latitude.ToString("F6"), @address.Longitude.ToString("F6")</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Map Preview -->
                                        <div class="w-full h-48 border-t-2 border-blue-100">
                                            <iframe
                                                width="100%"
                                                height="100%"
                                                style="border:0;"
                                                loading="lazy"
                                                allowfullscreen
                                                referrerpolicy="no-referrer-when-downgrade"
                                                src="https://www.google.com/maps?q=@address.Latitude,@address.Longitude&hl=en&z=16&output=embed">
                                            </iframe>
                                        </div>

                                        <!-- Action Buttons -->
                                        <div class="p-4 bg-white border-t-2 border-blue-100 flex gap-2">
                                            <a asp-action="AddressForm" asp-controller="Account" asp-area="Customer" 
                                               asp-route-id="@address.UserAddressID"
                                               class="flex-1 text-center bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-lg font-semibold transition-all flex items-center justify-center gap-2">
                                                <i class="fas fa-edit"></i>
                                                <span>Edit</span>
                                            </a>
                                            <button onclick="confirmDelete(@address.UserAddressID)" 
                                                    class="flex-1 bg-red-500 hover:bg-red-600 text-white px-4 py-2.5 rounded-lg font-semibold transition-all flex items-center justify-center gap-2">
                                                <i class="fas fa-trash"></i>
                                                <span>Delete</span>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-12">
                                <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                    <i class="fas fa-map-marked-alt text-gray-400 text-4xl"></i>
                                </div>
                                <h3 class="text-xl font-bold text-gray-900 mb-2">No addresses yet</h3>
                                <p class="text-gray-600 mb-6">Add your first delivery address to get started</p>
                                <a asp-action="AddressForm" asp-controller="Account" asp-area="Customer"
                                   class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-semibold transition-all">
                                    <i class="fas fa-plus"></i>
                                    <span>Add Your First Address</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- PAYMENT METHODS CARD -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="bg-gradient-to-r from-purple-600 to-purple-700 p-6">
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fas fa-credit-card"></i> Payment Methods
                        </h2>
                        <p class="text-purple-100 text-sm mt-1">Available payment options</p>
                    </div>

                    <div class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            <!-- Cash on Delivery -->
                            <div class="relative bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl border-2 border-emerald-200 p-5 hover:shadow-md transition-all">
                                <div class="absolute top-3 right-3">
                                    <span class="bg-emerald-600 text-white text-xs font-bold px-2 py-1 rounded-full">
                                        AVAILABLE
                                    </span>
                                </div>
                                <div class="flex items-center gap-4 mb-3">
                                    <div class="w-14 h-14 bg-emerald-600 rounded-xl flex items-center justify-center shadow-md">
                                        <i class="fas fa-hand-holding-dollar text-white text-2xl"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-gray-900 text-lg">Cash on Delivery</h3>
                                        <p class="text-sm text-gray-600">Pay when you receive</p>
                                    </div>
                                </div>
                                <p class="text-xs text-gray-600 leading-relaxed">
                                    Pay with cash when your order arrives at your doorstep. No prepayment needed.
                                </p>
                            </div>

                            <!-- Credit/Debit Card (Coming Soon) -->
                            <div class="relative bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl border-2 border-gray-200 p-5 opacity-70">
                                <div class="absolute top-3 right-3">
                                    <span class="bg-gray-400 text-white text-xs font-bold px-2 py-1 rounded-full">
                                        COMING SOON
                                    </span>
                                </div>
                                <div class="flex items-center gap-4 mb-3">
                                    <div class="w-14 h-14 bg-gray-300 rounded-xl flex items-center justify-center shadow-md">
                                        <i class="fas fa-credit-card text-white text-2xl"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-gray-600 text-lg">Credit/Debit Card</h3>
                                        <p class="text-sm text-gray-500">Visa, Mastercard, Amex</p>
                                    </div>
                                </div>
                                <p class="text-xs text-gray-500 leading-relaxed">
                                    Secure online payment with your credit or debit card.
                                </p>
                            </div>

                            <!-- E-Wallet (Coming Soon) -->
                            <div class="relative bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl border-2 border-gray-200 p-5 opacity-70">
                                <div class="absolute top-3 right-3">
                                    <span class="bg-gray-400 text-white text-xs font-bold px-2 py-1 rounded-full">
                                        COMING SOON
                                    </span>
                                </div>
                                <div class="flex items-center gap-4 mb-3">
                                    <div class="w-14 h-14 bg-gray-300 rounded-xl flex items-center justify-center shadow-md">
                                        <i class="fas fa-wallet text-white text-2xl"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-gray-600 text-lg">E-Wallet</h3>
                                        <p class="text-sm text-gray-500">GCash, PayMaya, etc.</p>
                                    </div>
                                </div>
                                <p class="text-xs text-gray-500 leading-relaxed">
                                    Pay instantly using your favorite e-wallet service.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmDelete(addressId) {
        if (confirm('Are you sure you want to delete this address? This action cannot be undone.')) {
            // Add your delete logic here
            window.location.href = '@Url.Action("DeleteAddress", "Account", new { area = "Customer" })' + '?id=' + addressId;
        }
    }
</script>