@model ASI.Basecode.WebApp.Areas.Customer.Models.UserAddressViewModel
@{
    ViewData["Title"] = Model?.UserAddressID > 0 ? "Edit Address - LaAlliancé" : "Add Address - LaAlliancé";
    var isEdit = Model?.UserAddressID > 0;
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
}

<div class="min-h-screen bg-gray-50">
    <div class="p-6">
        <div class="max-w-7xl mx-auto">
            <!-- Page Header - Matching cart style -->
            <div class="mb-8">
                <h1 class="text-3xl font-bold text-gray-900 mb-2">@(isEdit ? "Edit Address" : "Add New Address")</h1>
                <p class="text-gray-600">@(isEdit ? "Update your delivery location" : "Add a new delivery location")</p>
            </div>

            <!-- Main Content Container - Matching cart layout -->
            <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
                <div class="flex flex-col lg:flex-row gap-6">
                    <!-- Left Column - Form Content -->
                    <div class="flex-1">
                        <!-- Address Form Card - Matching My Account style -->
                        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-all duration-300 overflow-hidden mb-6">
                            <div class="p-6">
                                <div class="flex justify-between items-start mb-6">
                                    <div>
                                        <h2 class="text-xl font-bold text-gray-900 mb-2 flex items-center gap-3">
                                            <div class="w-10 h-10 bg-green-600 rounded-lg flex items-center justify-center">
                                                <i class="fas @(isEdit ? "fa-edit" : "fa-map-location-dot") text-white"></i>
                                            </div>
                                            @(isEdit ? "Edit Address" : "Add New Address")
                                        </h2>
                                        <p class="text-gray-600">@(isEdit ? "Update your delivery location" : "Add a new delivery location")</p>
                                    </div>
                                    <!-- Back Button -->
                                    <a href="@(string.IsNullOrEmpty(returnUrl) ? Url.Action("Index", "Account", new { area = "Customer" }) : returnUrl)"
                                        class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-4 py-2 rounded-lg font-semibold transition-colors flex items-center gap-2">
                                        <i class="fas fa-arrow-left"></i>
                                        <span>Back</span>
                                    </a>
                                </div>

                                <form asp-action="SaveAddress" asp-controller="Account" asp-area="Customer" method="post" asp-route-returnUrl="@returnUrl">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="UserAddressID" />
                                    <input type="hidden" asp-for="AddressID" />
                                    <input type="hidden" asp-for="Latitude" id="latitude" />
                                    <input type="hidden" asp-for="Longitude" id="longitude" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    
                                    <div class="space-y-6">
                                        <!-- Address Type & Default -->
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                            <div>
                                                <label class="block text-gray-700 font-semibold mb-3">
                                                    Address Type <span class="text-red-500">*</span>
                                                </label>
                                                <select asp-for="AddressType"
                                                        class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-100 transition-all outline-none">
                                                    <option value="Home">🏠 Home</option>
                                                    <option value="Work">💼 Work</option>
                                                    <option value="Other">📍 Other</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label class="block text-gray-700 font-semibold mb-3">
                                                    Set as Default
                                                </label>
                                                <div class="flex items-center h-12 px-4 border-2 border-gray-200 rounded-xl bg-gray-50">
                                                    <input type="checkbox" 
                                                           asp-for="IsDefault"
                                                           class="w-5 h-5 text-green-600 rounded focus:ring-green-500" />
                                                    <span class="ml-3 text-gray-700">Default address</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Street Address -->
                                        <div>
                                            <label class="block text-gray-700 font-semibold mb-3">
                                                Street Address <span class="text-red-500">*</span>
                                            </label>
                                            <input type="text" 
                                                   asp-for="Street"
                                                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-100 transition-all outline-none"
                                                   placeholder="House/Unit No., Building, Street Name"
                                                   required />
                                        </div>

                                        <!-- Barangay & City -->
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                            <div>
                                                <label class="block text-gray-700 font-semibold mb-3">
                                                    Barangay <span class="text-red-500">*</span>
                                                </label>
                                                <input type="text" 
                                                       asp-for="Barangay"
                                                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-100 transition-all outline-none"
                                                       placeholder="Barangay"
                                                       required />
                                            </div>
                                            <div>
                                                <label class="block text-gray-700 font-semibold mb-3">
                                                    City <span class="text-red-500">*</span>
                                                </label>
                                                <input type="text" 
                                                       asp-for="City"
                                                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-100 transition-all outline-none"
                                                       placeholder="City"
                                                       required />
                                            </div>
                                        </div>

                                        <!-- Province & Zip Code -->
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                            <div>
                                                <label class="block text-gray-700 font-semibold mb-3">
                                                    Province <span class="text-red-500">*</span>
                                                </label>
                                                <input type="text" 
                                                       asp-for="Province"
                                                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-100 transition-all outline-none"
                                                       placeholder="Province"
                                                       required />
                                            </div>
                                            <div>
                                                <label class="block text-gray-700 font-semibold mb-3">
                                                    Zip Code <span class="text-red-500">*</span>
                                                </label>
                                                <input type="text" 
                                                       asp-for="ZipCode"
                                                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-100 transition-all outline-none"
                                                       placeholder="Postal Code"
                                                       pattern="[0-9]{4}"
                                                       required />
                                            </div>
                                        </div>

                                        <!-- Address Note -->
                                        <div>
                                            <label class="block text-gray-700 font-semibold mb-3">
                                                Additional Notes
                                            </label>
                                            <textarea asp-for="AddressNote"
                                                      rows="3"
                                                      class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-100 transition-all outline-none resize-none"
                                                      placeholder="Landmarks, special instructions, etc."></textarea>
                                            <p class="text-sm text-gray-500 mt-2 flex items-center gap-2">
                                                <i class="fas fa-lightbulb text-gray-400"></i>
                                                Help our delivery team find you easily
                                            </p>
                                        </div>

                                        <!-- Action Buttons -->
                                        <div class="flex gap-4 pt-6 border-t border-gray-200">
                                            <button type="submit" 
                                                    class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors flex items-center justify-center gap-2 shadow-sm hover:shadow-md">
                                                <i class="fas fa-save"></i>
                                                <span>@(isEdit ? "Update Address" : "Save Address")</span>
                                            </button>
                                            <a href="@(string.IsNullOrEmpty(returnUrl) ? Url.Action("Index", "Account", new { area = "Customer" }) : returnUrl)"
                                               class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-6 py-3 rounded-lg font-semibold transition-colors flex items-center justify-center gap-2">
                                                <i class="fas fa-times"></i>
                                                <span>Cancel</span>
                                            </a>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column - Map Sidebar -->
                    <div class="lg:w-96">
                        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sticky top-6">
                            <h3 class="text-lg font-bold text-gray-800 mb-4">Pin Your Location</h3>
                            
                            <!-- Auto-fill Info Banner -->
                            <div class="mb-4 bg-blue-50 border border-blue-200 rounded-lg p-3">
                                <div class="flex items-start gap-2">
                                    <i class="fas fa-magic text-blue-600 mt-0.5"></i>
                                    <div class="text-sm text-blue-800">
                                        <p class="font-semibold mb-1">Auto-fill Enabled!</p>
                                        <p class="text-xs">Address fields will be automatically filled when you select a location on the map.</p>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Map Container -->
                            <div class="mb-4 rounded-xl overflow-hidden border-2 border-gray-200">
                                <div id="addressMap" class="w-full h-64"></div>
                            </div>

                            <!-- Map Controls -->
                            <div class="space-y-3 mb-4">
                                <button type="button" 
                                        id="currentLocationBtn"
                                        class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-lg font-semibold transition-colors flex items-center justify-center gap-2">
                                    <i class="fas fa-location-crosshairs"></i>
                                    <span>Use Current Location</span>
                                </button>
                                <button type="button" 
                                        id="searchAddressBtn"
                                        class="w-full bg-green-600 hover:bg-green-700 text-white px-4 py-2.5 rounded-lg font-semibold transition-colors flex items-center justify-center gap-2">
                                    <i class="fas fa-search"></i>
                                    <span>Search Address</span>
                                </button>
                            </div>

                            <!-- Coordinates Display -->
                            <div class="bg-gray-50 border border-gray-200 rounded-xl p-4">
                                <div class="text-sm text-gray-700 mb-2">
                                    <p class="font-semibold mb-1">Current Coordinates:</p>
                                    <div class="flex items-center gap-4 text-xs">
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-location-dot text-blue-600"></i>
                                            <span class="font-mono">@(Model?.Latitude.ToString("F6") ?? "10.315700")</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-location-dot text-green-600"></i>
                                            <span class="font-mono">@(Model?.Longitude.ToString("F6") ?? "123.885400")</span>
                                        </div>
                                    </div>
                                </div>
                                <p class="text-xs text-gray-600 mt-2">
                                    <i class="fas fa-info-circle text-gray-400"></i>
                                    Drag the marker on the map to adjust your exact location
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey"></script>
    <script src="~/js/maps.js"></script>
    <style>
        @@keyframes slideInRight {
            from {
                transform: translateX(400px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
        
        @@keyframes slideOutRight {
            from {
                transform: translateX(0);
                opacity: 1;
            }
            to {
                transform: translateX(400px);
                opacity: 0;
            }
        }
    </style>
    <script>
        // Setup search address button to use form fields
        function setupSearchButton() {
            const searchBtn = document.getElementById('searchAddressBtn');
            if (searchBtn) {
                searchBtn.addEventListener('click', function() {
                    const streetInput = document.querySelector('input[name="Street"]');
                    const barangayInput = document.querySelector('input[name="Barangay"]');
                    const cityInput = document.querySelector('input[name="City"]');
                    const provinceInput = document.querySelector('input[name="Province"]');
                    
                    const street = streetInput ? streetInput.value.trim() : '';
                    const barangay = barangayInput ? barangayInput.value.trim() : '';
                    const city = cityInput ? cityInput.value.trim() : '';
                    const province = provinceInput ? provinceInput.value.trim() : '';
                    
                    if (!street && !city && !barangay) {
                        alert('Please fill in at least Street, Barangay, or City fields to search.');
                        return;
                    }

                    // Build address string
                    const addressParts = [street, barangay, city, province, 'Philippines'].filter(part => part);
                    const address = addressParts.join(', ');
                    
                    const originalHTML = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Searching...';
                    this.disabled = true;

                    // Use the global geocoder from maps.js
                    if (typeof geocoder !== 'undefined') {
                        geocoder.geocode({ address: address }, (results, status) => {
                            if (status === 'OK' && results[0]) {
                                const location = results[0].geometry.location;
                                
                                // Use the global map and placeMarker function from maps.js
                                if (typeof map !== 'undefined' && typeof placeMarker === 'function') {
                                    map.setCenter(location);
                                    map.setZoom(17);
                                    placeMarker(location);
                                }
                                
                                this.innerHTML = '<i class="fas fa-check"></i> Found!';
                            } else {
                                alert('Address not found on map. Please click on the map to set location manually.');
                                this.innerHTML = '<i class="fas fa-times"></i> Not Found';
                            }
                            
                            setTimeout(() => {
                                this.innerHTML = originalHTML;
                                this.disabled = false;
                            }, 2000);
                        });
                    } else {
                        alert('Map is not ready yet. Please try again in a moment.');
                        this.innerHTML = originalHTML;
                        this.disabled = false;
                    }
                });
            }
        }

        // Initialize when document is ready
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(function() {
                setupSearchButton();
            }, 500);
        });
    </script>
}