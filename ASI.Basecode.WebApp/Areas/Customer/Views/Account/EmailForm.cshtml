@{
    ViewData["Title"] = "Change Email - LaAlliancé";
}

@model ASI.Basecode.WebApp.Areas.Customer.Models.EmailViewModel

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-blue-50/30 to-gray-50">
    <div class="p-4 md:p-6 lg:p-8">
        <div class="max-w-2xl mx-auto">
            <!-- Back Navigation -->
            <nav class="flex items-center gap-2 text-sm text-gray-600 mb-6">
                <a asp-action="Index" asp-controller="Home" asp-area="Customer" class="hover:text-blue-600 transition-colors">
                    <i class="fas fa-home"></i> Home
                </a>
                <i class="fas fa-chevron-right text-xs"></i>
                <a asp-action="Index" asp-controller="Account" asp-area="Customer" class="hover:text-blue-600 transition-colors">
                    My Account
                </a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-blue-600 font-medium">Change Email</span>
            </nav>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-6 bg-red-50 border-2 border-red-500 rounded-xl p-4">
                    <p class="text-red-700 font-semibold flex items-center gap-2">
                        <i class="fas fa-exclamation-circle"></i>
                        @TempData["ErrorMessage"]
                    </p>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-6 bg-green-50 border-2 border-green-500 rounded-xl p-4">
                    <p class="text-green-700 font-semibold flex items-center gap-2">
                        <i class="fas fa-check-circle"></i>
                        @TempData["SuccessMessage"]
                    </p>
                </div>
            }

            <!-- Form Card -->
            <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
                <!-- Header -->
                <div class="bg-gradient-to-r from-blue-600 to-blue-700 p-6 md:p-8">
                    <div class="flex items-center gap-4">
                        <div class="w-16 h-16 bg-white/20 backdrop-blur-sm rounded-xl flex items-center justify-center shadow-lg">
                            <i class="fas fa-envelope text-white text-2xl"></i>
                        </div>
                        <div>
                            <h1 class="text-2xl md:text-3xl font-bold text-white">Change Email Address</h1>
                            <p class="text-blue-100 mt-1">Update your email and verify with OTP</p>
                        </div>
                    </div>
                </div>

                <!-- Form Content -->
                <form asp-action="SendEmailOTP" asp-controller="Account" asp-area="Customer" method="post" class="p-6 md:p-8">
                    @Html.AntiForgeryToken()
                    <div class="space-y-6">
                        <!-- Current Email (Read-only) -->
                        <div>
                            <label asp-for="CurrentEmail" class="block text-gray-700 font-semibold mb-2 flex items-center gap-2">
                                <i class="fas fa-envelope text-gray-500"></i>
                                Current Email Address
                            </label>
                            <input asp-for="CurrentEmail"
                                   type="email" 
                                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl bg-gray-50 text-gray-600"
                                   readonly />
                        </div>

                        <!-- New Email -->
                        <div>
                            <label asp-for="NewEmail" class="block text-gray-700 font-semibold mb-2 flex items-center gap-2">
                                <i class="fas fa-envelope text-blue-600"></i>
                                New Email Address
                                <span class="text-red-500">*</span>
                            </label>
                            <input asp-for="NewEmail"
                                   type="email" 
                                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:ring-4 focus:ring-blue-100 transition-all outline-none"
                                   placeholder="Enter your new email address"
                                   required />
                            <span asp-validation-for="NewEmail" class="text-sm text-red-500"></span>
                            <p class="text-sm text-gray-500 mt-2">
                                <i class="fas fa-info-circle"></i>
                                We'll send a 6-digit verification code to this email
                            </p>
                        </div>

                        <!-- Confirm New Email -->
                        <div>
                            <label asp-for="ConfirmEmail" class="block text-gray-700 font-semibold mb-2 flex items-center gap-2">
                                <i class="fas fa-envelope-circle-check text-blue-600"></i>
                                Confirm New Email
                                <span class="text-red-500">*</span>
                            </label>
                            <input asp-for="ConfirmEmail"
                                   type="email" 
                                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:ring-4 focus:ring-blue-100 transition-all outline-none"
                                   placeholder="Re-enter your new email address"
                                   required />
                            <span asp-validation-for="ConfirmEmail" class="text-sm text-red-500"></span>
                        </div>

                        <!-- Security Notice -->
                        <div class="bg-amber-50 border-2 border-amber-200 rounded-xl p-4">
                            <div class="flex items-start gap-3">
                                <i class="fas fa-shield-halved text-amber-600 text-xl mt-0.5"></i>
                                <div>
                                    <h4 class="font-semibold text-amber-900 mb-1">Security Verification Required</h4>
                                    <p class="text-sm text-amber-700 leading-relaxed">
                                        For your security, we'll verify your current email first, then send a verification code to your new email address. 
                                        You'll need to enter both codes to complete the email change.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Steps Indicator -->
                        <div class="bg-blue-50 rounded-xl p-5">
                            <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                                <i class="fas fa-list-check text-blue-600"></i>
                                Next Steps:
                            </h4>
                            <div class="space-y-3">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">1</div>
                                    <p class="text-sm text-gray-700">Verify your current email address</p>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 bg-gray-300 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">2</div>
                                    <p class="text-sm text-gray-600">Enter your new email address</p>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 bg-gray-300 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">3</div>
                                    <p class="text-sm text-gray-600">Verify new email with OTP code</p>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex flex-col sm:flex-row gap-3 pt-6 border-t border-gray-200">
                            <button type="submit" 
                                    class="flex-1 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-6 py-3.5 rounded-xl font-bold shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2">
                                <i class="fas fa-paper-plane"></i>
                                <span>Continue with Verification</span>
                            </button>
                            <a asp-action="Index" asp-controller="Account" asp-area="Customer"
                               class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-3.5 rounded-xl font-bold transition-all flex items-center justify-center gap-2">
                                <i class="fas fa-times"></i>
                                <span>Cancel</span>
                            </a>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Help Text -->
            <div class="mt-6 text-center">
                <p class="text-sm text-gray-600">
                    Having trouble? <a href="#" class="text-blue-600 hover:underline font-semibold">Contact Support</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Email confirmation validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const newEmail = document.querySelector('input[name="NewEmail"]').value;
            const confirmEmail = document.querySelector('input[name="ConfirmEmail"]').value;
            
            if (newEmail !== confirmEmail) {
                e.preventDefault();
                alert('Email addresses do not match. Please try again.');
                return false;
            }
        });
    </script>
}