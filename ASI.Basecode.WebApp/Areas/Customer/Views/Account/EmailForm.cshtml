@{
    ViewData["Title"] = "Change Email - LaAlliancé";
}

@model ASI.Basecode.WebApp.Areas.Customer.Models.EmailViewModel

<div class="min-h-screen bg-gray-50">
    <div class="p-6">
        <div class="max-w-7xl mx-auto">
            <!-- Back Navigation -->
            <nav class="flex items-center gap-2 text-sm text-gray-600 mb-6">
                <a asp-action="Index" asp-controller="Home" asp-area="Customer" class="hover:text-blue-600 transition-colors">
                    <i class="fas fa-home"></i> Home
                </a>
                <i class="fas fa-chevron-right text-xs"></i>
                <a asp-action="Index" asp-controller="Account" asp-area="Customer" class="hover:text-blue-600 transition-colors">
                    My Account
                </a>
                <i class="fas fa-chevron-right text-xs"></i>
                <span class="text-blue-600 font-medium">Change Email</span>
            </nav>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="fixed top-4 right-4 z-50 animate-fade-in">
                    <div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-800 rounded-xl shadow-sm flex items-center gap-3">
                        <div class="w-6 h-6 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-check text-white text-xs"></i>
                        </div>
                        <span class="font-medium">@TempData["SuccessMessage"]</span>
                    </div>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="fixed top-4 right-4 z-50 animate-fade-in">
                    <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-800 rounded-xl shadow-sm flex items-center gap-3">
                        <div class="w-6 h-6 bg-red-500 rounded-full flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-exclamation-triangle text-white text-xs"></i>
                        </div>
                        <span class="font-medium">@TempData["ErrorMessage"]</span>
                    </div>
                </div>
            }

            <!-- Main Content Container - Matching cart layout -->
            <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6 max-w-xl mx-auto">
                <div class="flex flex-col gap-6">
                    <!-- Email Change Card -->
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-all duration-300 overflow-hidden">
                        <div class="p-6">
                            <div class="flex items-center gap-4 mb-6">
                                <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-envelope text-white"></i>
                                </div>
                                <div>
                                    <h2 class="text-xl font-bold text-gray-900 mb-1">Change Email Address</h2>
                                    <p class="text-gray-600">Update your email and verify with OTP</p>
                                </div>
                            </div>
                            <form asp-action="SendEmailOTP" asp-controller="Account" asp-area="Customer" method="post">
                                @Html.AntiForgeryToken()
                                <div class="space-y-6">
                                    <!-- Current Email (Read-only) -->
                                    <div>
                                        <label asp-for="CurrentEmail" class="block text-gray-700 font-semibold mb-3 flex items-center gap-2">
                                            <i class="fas fa-envelope text-blue-600"></i>
                                            Current Email Address
                                        </label>
                                        <input asp-for="CurrentEmail"
                                               type="email" 
                                               class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl bg-gray-50 text-gray-700 font-medium"
                                               readonly />
                                    </div>
                                    <!-- New Email -->
                                    <div>
                                        <label asp-for="NewEmail" class="block text-gray-700 font-semibold mb-3 flex items-center gap-2">
                                            <i class="fas fa-envelope text-blue-600"></i>
                                            New Email Address
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input asp-for="NewEmail"
                                               type="email" 
                                               class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:ring-4 focus:ring-blue-100 transition-all outline-none"
                                               placeholder="Enter your new email address"
                                               required />
                                        <span asp-validation-for="NewEmail" class="text-sm text-red-500"></span>
                                        <p class="text-sm text-gray-500 mt-2">
                                            <i class="fas fa-info-circle"></i>
                                            We'll send a 6-digit verification code to this email
                                        </p>
                                    </div>
                                    <!-- Confirm New Email -->
                                    <div>
                                        <label asp-for="ConfirmEmail" class="block text-gray-700 font-semibold mb-3 flex items-center gap-2">
                                            <i class="fas fa-envelope-circle-check text-blue-600"></i>
                                            Confirm New Email
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input asp-for="ConfirmEmail"
                                               type="email" 
                                               class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:ring-4 focus:ring-blue-100 transition-all outline-none"
                                               placeholder="Re-enter your new email address"
                                               required />
                                        <span asp-validation-for="ConfirmEmail" class="text-sm text-red-500"></span>
                                    </div>
                                    <!-- Security Notice -->
                                    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
                                        <div class="flex items-start gap-3">
                                            <i class="fas fa-shield-halved text-amber-600 text-xl mt-0.5"></i>
                                            <div>
                                                <h4 class="font-semibold text-amber-900 mb-1">Security Verification Required</h4>
                                                <p class="text-sm text-amber-700 leading-relaxed">
                                                    For your security, we'll verify your current email first, then send a verification code to your new email address. 
                                                    You'll need to enter both codes to complete the email change.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Steps Indicator -->
                                    <div class="bg-blue-50 rounded-xl p-5">
                                        <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                                            <i class="fas fa-list-check text-blue-600"></i>
                                            Next Steps:
                                        </h4>
                                        <div class="space-y-3">
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">1</div>
                                                <p class="text-sm text-gray-700">Verify your current email address</p>
                                            </div>
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 bg-gray-300 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">2</div>
                                                <p class="text-sm text-gray-600">Enter your new email address</p>
                                            </div>
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 bg-gray-300 text-white rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0">3</div>
                                                <p class="text-sm text-gray-600">Verify new email with OTP code</p>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Action Buttons -->
                                    <div class="flex flex-col sm:flex-row gap-3 pt-6 border-t border-gray-200">
                                        <button type="submit" 
                                                class="flex-1 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3.5 rounded-lg font-bold shadow-sm hover:shadow-md transition-all flex items-center justify-center gap-2">
                                            <i class="fas fa-paper-plane"></i>
                                            <span>Continue with Verification</span>
                                        </button>
                                        <a asp-action="Index" asp-controller="Account" asp-area="Customer"
                                           class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-3.5 rounded-lg font-bold transition-all flex items-center justify-center gap-2">
                                            <i class="fas fa-times"></i>
                                            <span>Cancel</span>
                                        </a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <!-- Help Text -->
                    <div class="text-center py-4">
                        <p class="text-sm text-gray-600">
                            Having trouble? <a href="#" class="text-blue-600 hover:underline font-semibold">Contact Support</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<style>
    @@keyframes fade-in {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
        animation: fade-in 0.3s ease-out;
    }
</style>
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script>
    // Auto-hide toast after 3 seconds (same as cart)
    document.addEventListener('DOMContentLoaded', function() {
        const toast = document.querySelector('.animate-fade-in');
        if (toast) {
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-10px)';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
        // Email confirmation validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const newEmail = document.querySelector('input[name="NewEmail"]').value;
            const confirmEmail = document.querySelector('input[name="ConfirmEmail"]').value;
            if (newEmail !== confirmEmail) {
                e.preventDefault();
                alert('Email addresses do not match. Please try again.');
                return false;
            }
        });
    });
</script>
}