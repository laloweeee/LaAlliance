@model ASI.Basecode.WebApp.Areas.Customer.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout | LaAlliance";
    var defaultAddress = Model.Addresses?.FirstOrDefault(a => a.IsDefault);
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Review and Place Your Order</h1>
            <p class="text-gray-600">Complete your purchase with confidence</p>
        </div>

        <form asp-action="PlaceOrder" method="post" class="grid grid-cols-1 lg:grid-cols-3 gap-8" id="checkoutForm">
            @Html.AntiForgeryToken()
            <!-- Left Column: Order Type, Delivery Address and Personal Details -->
            <div class="lg:col-span-2 space-y-6">
                
                <!-- Section 0: Order Type Selection -->
                <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
                    <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-shopping-bag text-green-600"></i>
                        Order Type
                    </h2>
                    <div class="grid grid-cols-2 gap-4">
                        <label class="relative cursor-pointer">
                            <input type="radio" asp-for="OrderType" value="Delivery" class="peer sr-only" checked />
                            <div class="p-4 border-2 border-gray-200 rounded-xl peer-checked:border-green-600 peer-checked:bg-green-50 transition-all hover:border-green-300">
                                <div class="flex flex-col items-center gap-2">
                                    <i class="fas fa-truck text-3xl text-gray-400 peer-checked:text-green-600"></i>
                                    <span class="font-semibold text-gray-700">Delivery</span>
                                    <span class="text-xs text-gray-500">We deliver to your door</span>
                                </div>
                            </div>
                        </label>
                        <label class="relative cursor-pointer">
                            <input type="radio" asp-for="OrderType" value="Pickup" class="peer sr-only" />
                            <div class="p-4 border-2 border-gray-200 rounded-xl peer-checked:border-green-600 peer-checked:bg-green-50 transition-all hover:border-green-300">
                                <div class="flex flex-col items-center gap-2">
                                    <i class="fas fa-store text-3xl text-gray-400 peer-checked:text-green-600"></i>
                                    <span class="font-semibold text-gray-700">Pickup</span>
                                    <span class="text-xs text-gray-500">Pick up at our store</span>
                                </div>
                            </div>
                        </label>
                    </div>
                    <span asp-validation-for="OrderType" class="text-red-500 text-sm mt-2 block"></span>
                </div>

                <!-- Section 1: Delivery Address (Hidden for Pickup) -->
                <div id="deliveryAddressSection" class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
                    <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-map-marker-alt text-green-600"></i>
                        Delivery Address
                    </h2>
                    
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <!-- Address Form -->
                        <div class="space-y-4">
                        <!-- Address Display and Actions -->
                            <div id="addressDisplay" class="space-y-3">
                                <div class="grid-2 gap-3">
                                    <a asp-area="Customer" asp-action="AddressForm" asp-controller="Account" asp-route-returnUrl="@Url.Action("CheckOut", "Cart", new { area = "Customer" })" class="bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-4 py-3 rounded-xl font-semibold transition-all flex items-center justify-center gap-2 shadow-md hover:shadow-lg">
                                        <i class="fas fa-plus"></i>
                                        <span>Add New Address</span>
                                    </a>
                                </div>
                            </div>
                            <!-- Address Selection Options -->
                            <div id="addressSelection" class="space-y-3">
                                <h3 class="text-sm font-medium text-gray-700 mb-2">Choose Delivery Location:</h3>
                                @if (Model.Addresses != null && Model.Addresses.Any())
                                {
                                    foreach (var address in Model.Addresses)
                                    {
                                        <label class="relative cursor-pointer">
                                            @{
                                                var isChecked = (Model.SelectedAddressId == address.UserAddressID || (Model.SelectedAddressId == null && address.IsDefault));
                                            }
                                            <input type="radio" name="SelectedAddressId" value="@address.UserAddressID"
                                                class="peer sr-only address-radio"
                                                data-street="@address.Street"
                                                data-barangay="@address.Barangay"
                                                data-city="@address.City"
                                                data-province="@address.Province"
                                                data-zipcode="@address.ZipCode"
                                                data-latitude="@address.Latitude"
                                                data-longitude="@address.Longitude"
                                                @(isChecked ? "checked" : "") />
                                            <div class="p-3 border-2 border-gray-200 rounded-xl peer-checked:border-green-600 peer-checked:bg-green-50 transition-all hover:border-green-300 mb-2">
                                                <div class="flex items-start gap-3">
                                                    <div class="w-5 h-5 border-2 border-gray-300 rounded-full peer-checked:border-green-600 peer-checked:bg-green-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                                                        <i class="fas fa-check text-white text-xs hidden peer-checked:block"></i>
                                                    </div>
                                                    <div class="flex-1">
                                                        <div class="flex items-center gap-2 mb-1">
                                                            <span class="font-semibold text-gray-900 text-sm">@address.AddressType</span>
                                                            @if (address.IsDefault)
                                                            {
                                                                <span class="bg-green-600 text-white text-xs px-2 py-0.5 rounded-full font-semibold">
                                                                    Default
                                                                </span>
                                                            }
                                                        </div>
                                                        <p class="text-xs text-gray-700">
                                                            @address.Street, @address.Barangay, @address.City
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </label>
                                    }
                                }
                                else
                                {
                                    <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-xl">
                                        <p class="text-sm text-yellow-800">No addresses found. Please add a delivery address.</p>
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <!-- Hidden coordinates fields -->
                        <input type="hidden" id="latitudeInput" value="@defaultAddress?.Latitude" />
                        <input type="hidden" id="longitudeInput" value="@defaultAddress?.Longitude" />

                        <!-- Interactive Map -->
                        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden h-fit">
                            <!-- Map Header -->
                            <div class="bg-gradient-to-r from-blue-600 to-blue-700 p-4">
                                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                    <i class="fas fa-map"></i>
                                    Delivery Location
                                </h3>
                                <p class="text-blue-100 text-sm mt-1" id="mapAddressText">
                                    @if (defaultAddress != null)
                                    {
                                        <span>@defaultAddress.Street, @defaultAddress.Barangay, @defaultAddress.City</span>
                                    }
                                    else
                                    {
                                        <span>Select an address to view location</span>
                                    }
                                </p>
                            </div>

                            <!-- Map Container -->
                            <div class="relative">
                                <div id="addressMap" class="w-full h-[300px] lg:h-[350px]"></div>
                            </div>

                            <!-- Map Instructions -->
                            <div class="p-4 bg-gray-50 border-t border-gray-200">
                                <!-- Coordinates Display -->
                                <div class="mt-3 pt-3 border-t border-gray-200">
                                    <div class="flex items-center justify-center gap-4 text-xs text-gray-600">
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-location-dot text-blue-600"></i>
                                            <span class="font-semibold">Lat:</span>
                                            <span id="displayLat" class="font-mono">@(defaultAddress?.Latitude.ToString("F6") ?? "10.315700")</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-location-dot text-teal-600"></i>
                                            <span class="font-semibold">Lng:</span>
                                            <span id="displayLng" class="font-mono">@(defaultAddress?.Longitude.ToString("F6") ?? "123.885400")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Delivery Notes -->
                <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
                    <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-sticky-note text-green-600"></i>
                        Delivery Notes
                    </h2>
                    <div>
                        <textarea asp-for="DeliveryNotes" 
                                  rows="3" 
                                  class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors resize-none" 
                                  placeholder="Add any special instructions for delivery (e.g., gate code, landmarks, delivery time preferences)"></textarea>
                        <p class="text-xs text-gray-500 mt-2">Optional: Add delivery instructions or notes</p>
                    </div>
                </div>

                <!-- Section 3: Payment Method -->
                <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-credit-card text-green-600"></i>
                        Payment Method
                    </h2>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-gray-700 font-medium mb-3">Select Payment Method</label>
                            <div class="space-y-2">
                                <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:border-green-500 transition-colors cursor-pointer">
                                    <input type="radio" asp-for="PaymentMethod" value="GCash" class="radio-input" />
                                    <i class="fas fa-mobile-alt text-blue-600"></i>
                                    <span>GCash</span>
                                </label>
                                <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:border-green-500 transition-colors cursor-pointer">
                                    <input type="radio" asp-for="PaymentMethod" value="CreditCard" class="radio-input" />
                                    <i class="fas fa-credit-card text-purple-600"></i>
                                    <span>Credit/Debit Card</span>
                                </label>
                                <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:border-green-500 transition-colors cursor-pointer">
                                    <input type="radio" asp-for="PaymentMethod" value="CashOnDelivery" class="radio-input" />
                                    <i class="fas fa-money-bill-wave text-green-600"></i>
                                    <span>Cash on Delivery</span>
                                </label>
                            </div>
                            <span asp-validation-for="PaymentMethod" class="text-red-500 text-sm mt-2 block"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 4: Voucher Code (Optional) -->
                @if (!string.IsNullOrEmpty(Model.VoucherCode) || true)
                {
                    <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
                        <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                            <i class="fas fa-ticket-alt text-green-600"></i>
                            Voucher Code
                        </h2>
                        <div class="flex gap-3">
                            <input asp-for="VoucherCode" 
                                   type="text" 
                                   class="flex-1 px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors uppercase" 
                                   placeholder="Enter voucher code" />
                            <button type="button" 
                                    id="applyVoucherBtn"
                                    class="bg-green-600 hover:bg-green-700 text-white font-semibold px-6 py-3 rounded-xl transition-colors">
                                Apply
                            </button>
                        </div>
                        <p class="text-xs text-gray-500 mt-2">Optional: Enter a valid voucher code for discounts</p>
                    </div>
                }
            </div> 

            <!-- Right Column: Order Summary -->
            <div class="lg:col-span-1">
                <!-- Order Summary -->
            
                <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6 sticky top-6">
                    <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-receipt text-green-600"></i>
                        Order Summary
                    </h2>
                    
                    <!-- Order Type Badge -->
                    <div class="mb-4 p-3 bg-gradient-to-r from-green-50 to-teal-50 border border-green-200 rounded-xl">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium text-gray-700">Order Type:</span>
                            <span class="font-bold text-green-700" id="orderTypeBadge">@Model.OrderType</span>
                        </div>
                    </div>

                    <!-- Shipping Address (for Delivery only) -->
                    <div id="shippingAddressDisplay" class="mb-4 p-3 bg-gray-50 border border-gray-200 rounded-xl">
                        <h3 class="text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
                            <i class="fas fa-map-marker-alt text-green-600"></i>
                            Shipping Address
                        </h3>
                        <p class="text-xs text-gray-600" id="summaryAddress">
                            @if (defaultAddress != null)
                            {
                                <span>@defaultAddress.Street, @defaultAddress.Barangay, @defaultAddress.City, @defaultAddress.Province @defaultAddress.ZipCode</span>
                            }
                            else
                            {
                                <span class="text-gray-400">Please select an address</span>
                            }
                        </p>
                    </div>
                    
                    <!-- Order Items -->
                    <div class="space-y-4 mb-6 max-h-96 overflow-y-auto [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
                        @if (Model.Cart?.CartItems != null && Model.Cart.CartItems.Any())
                        {
                            foreach (var item in Model.Cart.CartItems)
                            {
                                var itemAddOnsTotal = item.CartItemOptions?.Sum(opt => opt.AdditionalPrice) ?? 0m;
                                var itemTotalPrice = item.Quantity * (item.UnitPrice + itemAddOnsTotal);
                                
                                <div class="flex gap-3 py-3 border-b border-gray-100 last:border-b-0">
                                    <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0">
                                        <span class="text-green-600 font-bold text-sm">@item.Quantity</span>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h4 class="font-semibold text-gray-900 text-sm">@item.ProductName</h4>
                                        @if (item.CartItemOptions != null && item.CartItemOptions.Any())
                                        {
                                            <div class="mt-1 text-xs text-gray-600">
                                                @foreach (var opt in item.CartItemOptions)
                                                {
                                                    <div>
                                                        + @opt.OptionName
                                                        @if (opt.AdditionalPrice > 0)
                                                        {
                                                            <span class="text-green-600">(+₱@opt.AdditionalPrice.ToString("F2"))</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="text-right">
                                        <p class="font-semibold text-gray-900 text-sm">₱@itemTotalPrice.ToString("F2")</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-gray-500 text-center py-4">Your cart is empty</p>
                        }
                    </div>

                    <!-- Order Totals -->
                    <div class="space-y-3 pt-4 border-t border-gray-200">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">Subtotal</span>
                            <span class="text-gray-900" id="subtotalAmount">₱@Model.SubTotal.ToString("F2")</span>
                        </div>
                        <div class="flex justify-between text-sm" id="deliveryFeeRow">
                            <span class="text-gray-600">Delivery Fee</span>
                            <span class="text-gray-900" id="deliveryFeeAmount">₱@Model.DeliveryFee.ToString("F2")</span>
                        </div>
                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="flex justify-between text-sm text-green-600" id="discountRow">
                                <span>Voucher Discount</span>
                                <span id="discountAmount">-₱@Model.DiscountAmount.ToString("F2")</span>
                            </div>
                        }
                        <div class="flex justify-between text-lg font-bold pt-3 border-t border-gray-200">
                            <span class="text-gray-900">Total Amount</span>
                            <span class="text-green-600" id="totalAmount">₱@Model.Total.ToString("F2")</span>
                        </div>
                    </div>

                    <!-- Place Order Button -->
                    <button type="submit" 
                            class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-4 px-6 rounded-xl transition-colors flex items-center justify-center gap-2 mt-6 shadow-lg shadow-green-200">
                        <i class="fas fa-check-circle"></i>
                        <span>Place Order</span>
                    </button>

                    <!-- Security Badge -->
                    <div class="text-center mt-4">
                        <p class="text-xs text-gray-500 flex items-center justify-center gap-1">
                            <i class="fas fa-shield-alt text-green-500"></i>
                            Your payment information is secure and encrypted
                        </p>
                    </div>
                </div>
            </div>
            <!-- Loading Modal -->
            <div id="loadingModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
                <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md mx-4 text-center">
                    <!-- Animated Spinner -->
                    <div class="mb-6 flex justify-center">
                        <div class="relative">
                            <!-- Outer rotating ring -->
                            <div class="w-20 h-20 border-4 border-green-200 border-t-green-600 rounded-full animate-spin"></div>
                            <!-- Inner pulse circle -->
                            <div class="absolute inset-0 flex items-center justify-center">
                                <div class="w-12 h-12 bg-green-100 rounded-full animate-pulse"></div>
                            </div>
                            <!-- Center icon -->
                            <div class="absolute inset-0 flex items-center justify-center">
                                <i class="fas fa-shopping-bag text-green-600 text-2xl"></i>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Loading Text -->
                    <h3 class="text-2xl font-bold text-gray-900 mb-2">Processing Your Order</h3>
                    <p class="text-gray-600 mb-4">Please wait while we prepare your order...</p>
                    
                    <!-- Progress Steps -->
                    <div class="space-y-2 text-sm text-left bg-gray-50 rounded-lg p-4">
                        <div class="flex items-center gap-3 text-green-600">
                            <i class="fas fa-check-circle"></i>
                            <span>Validating order details</span>
                        </div>
                        <div class="flex items-center gap-3 text-gray-400" id="step2">
                            <i class="fas fa-circle-notch fa-spin"></i>
                            <span>Processing payment</span>
                        </div>
                        <div class="flex items-center gap-3 text-gray-400" id="step3">
                            <i class="fas fa-circle"></i>
                            <span>Confirming order</span>
                        </div>
                    </div>
                    
                    <!-- Warning Message -->
                    <div class="mt-4 p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                        <p class="text-xs text-yellow-800 flex items-center justify-center gap-2">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span>Please do not close or refresh this page</span>
                        </p>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey"></script>
    <script src="~/js/maps.js"></script>
    <script src="~/js/place-order.js"></script>
    <script>
        window.checkoutSubtotal = @Model.SubTotal;
        window.deliveryFee = @Model.DeliveryFee;
    </script>

    <!-- Loading Modal Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const checkoutForm = document.getElementById('checkoutForm');
            const loadingModal = document.getElementById('loadingModal');
            const step2 = document.getElementById('step2');
            const step3 = document.getElementById('step3');
            
            checkoutForm.addEventListener('submit', function(e) {
                // First, run all client-side validations
                if (!validateFormBeforeSubmit()) {
                    e.preventDefault();
                    return false;
                }
                
                // Only show modal if validations pass
                loadingModal.classList.remove('hidden');
                
                // Animate progress steps
                setTimeout(function() {
                    step2.querySelector('i').classList.remove('fa-circle-notch', 'fa-spin');
                    step2.querySelector('i').classList.add('fa-check-circle');
                    step2.classList.remove('text-gray-400');
                    step2.classList.add('text-green-600');
                    
                    step3.querySelector('i').classList.remove('fa-circle');
                    step3.querySelector('i').classList.add('fa-circle-notch', 'fa-spin');
                    step3.classList.remove('text-gray-400');
                    step3.classList.add('text-blue-600');
                }, 1000);
                
                setTimeout(function() {
                    step3.querySelector('i').classList.remove('fa-circle-notch', 'fa-spin');
                    step3.querySelector('i').classList.add('fa-check-circle');
                    step3.classList.remove('text-blue-600');
                    step3.classList.add('text-green-600');
                }, 2000);

                return true;
            });
        });
    </script>
}