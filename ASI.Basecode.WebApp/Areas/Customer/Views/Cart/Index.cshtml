@*

*@

@model ASI.Basecode.Services.ServiceModels.CartViewModel
@{
    ViewData["Title"] = "LaAlliancé";
}

<div class="p-1 md:p-2 lg:p-4 bg-gray-50 min-h-screen">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900">Shopping Cart</h1>
            <p class="text-gray-600 mt-2">Review your items before checkout</p>
        </div>

        <div class="flex flex-col lg:flex-row gap-6">
            <!-- Cart Items Section -->
            <div class="flex-1">
                <!-- Empty Cart State -->
                @if (Model?.CartItems == null || !Model.CartItems.Any())
                {
                    <div class="bg-white rounded-2xl shadow-sm p-12 text-center">
                        <div class="flex flex-col items-center">
                            <div class="w-32 h-32 bg-gray-100 rounded-full flex items-center justify-center mb-6">
                                <i class="fas fa-shopping-cart text-gray-400 text-5xl"></i>
                            </div>
                            <h2 class="text-2xl font-bold text-gray-900 mb-3">Your cart is empty</h2>
                            <p class="text-gray-600 mb-6">Add some delicious items to get started!</p>
                            <a href="/" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-8 py-3 rounded-xl transition-colors inline-flex items-center gap-2">
                                <i class="fas fa-utensils"></i>
                                <span>Browse Menu</span>
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Cart Items List -->
                    <div class="space-y-4">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow overflow-hidden">
                                <div class="p-4 md:p-6">
                                    <div class="flex gap-4">
                                        <!-- Product Image -->
                                        <div class="flex-shrink-0">
                                            <div class="w-24 h-24 md:w-32 md:h-32 rounded-xl overflow-hidden bg-gray-100">
                                                @if (!string.IsNullOrEmpty(item.ProductImage))
                                                {
                                                    <img src="@item.ProductImage" 
                                                         alt="@item.ProductName" 
                                                         class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    <div class="w-full h-full flex items-center justify-center">
                                                        <i class="fas fa-image text-gray-300 text-3xl"></i>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <!-- Product Details -->
                                        <div class="flex-1 min-w-0">
                                            <div class="flex justify-between items-start mb-2">
                                                <div>
                                                    <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-1">
                                                        @item.ProductName
                                                    </h3>
                                                    <p class="text-emerald-600 font-semibold text-lg">
                                                        ₱@item.UnitPrice.ToString("F2")
                                                    </p>
                                                </div>
                                                <button type="button" class="text-gray-400 hover:text-red-500 transition-colors p-2">
                                                    <i class="fas fa-trash text-lg"></i>
                                                </button>
                                            </div>

                                            <!-- Selected Options -->
                                            @if (item.Options != null && item.Options.Any())
                                            {
                                                <div class="mb-3 space-y-1">
                                                    @foreach (var option in item.Options)
                                                    {
                                                        <div class="flex items-center text-sm text-gray-600">
                                                            <i class="fas fa-circle text-xs text-gray-400 mr-2"></i>
                                                            <span class="font-medium">@option.OptionGroupName:</span>
                                                            <span class="ml-1">@option.OptionName</span>
                                                            @if (option.AdditionalPrice > 0)
                                                            {
                                                                <span class="ml-2 text-emerald-600 font-semibold">
                                                                    (+₱@option.AdditionalPrice.ToString("F2"))
                                                                </span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            <!-- Quantity Controls & Total -->
                                            <div class="flex items-center justify-between mt-4">
                                                <!-- Quantity Control -->
                                                <div class="flex items-center gap-3 bg-gray-50 rounded-xl p-1">
                                                    <button type="button" 
                                                            class="w-8 h-8 flex items-center justify-center bg-white hover:bg-gray-100 rounded-lg transition-colors shadow-sm">
                                                        <i class="fas fa-minus text-gray-600 text-xs"></i>
                                                    </button>
                                                    <span class="w-8 text-center font-bold text-gray-900">@item.Quantity</span>
                                                    <button type="button" 
                                                            class="w-8 h-8 flex items-center justify-center bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition-colors shadow-sm">
                                                        <i class="fas fa-plus text-xs"></i>
                                                    </button>
                                                </div>

                                                <!-- Item Total -->
                                                <div class="text-right">
                                                    <p class="text-sm text-gray-500 mb-1">Item Total</p>
                                                    <p class="text-xl font-bold text-gray-900">
                                                        ₱@item.TotalPrice.ToString("F2")
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Continue Shopping Button -->
                    <div class="mt-6">
                        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 text-emerald-600 hover:text-emerald-700 font-semibold transition-colors">
                            <i class="fas fa-arrow-left"></i>
                            <span>Continue Shopping</span>
                        </a>
                    </div>
                }
            </div>

            <!-- Order Summary Sidebar -->
            @if (Model?.CartItems != null && Model.CartItems.Any())
            {
                <div class="lg:w-96">
                    <div class="bg-white rounded-2xl shadow-sm sticky top-4">
                        <div class="p-6">
                            <h2 class="text-2xl font-bold text-gray-900 mb-6">Order Summary</h2>

                            <!-- Summary Details -->
                            <div class="space-y-4 mb-6">
                                <div class="flex justify-between items-center pb-3 border-b border-gray-100">
                                    <span class="text-gray-600">Items (@Model.TotalItems)</span>
                                    <span class="font-semibold text-gray-900">₱@Model.TotalAmount.ToString("F2")</span>
                                </div>

                                <div class="flex justify-between items-center pb-3 border-b border-gray-100">
                                    <span class="text-gray-600">Delivery Fee</span>
                                    <span class="font-semibold text-gray-900">₱50.00</span>
                                </div>

                                <div class="flex justify-between items-center pb-3 border-b border-gray-100">
                                    <span class="text-gray-600">Service Fee</span>
                                    <span class="font-semibold text-gray-900">₱20.00</span>
                                </div>

                                <!-- Promo Code -->
                                <div class="pt-2">
                                    <div class="flex gap-2">
                                        <input type="text" 
                                               placeholder="Enter promo code" 
                                               class="flex-1 px-4 py-2 border-2 border-gray-200 rounded-lg focus:border-emerald-500 focus:outline-none text-sm" />
                                        <button type="button" 
                                                class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-lg transition-colors text-sm">
                                            Apply
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Total -->
                            <div class="bg-emerald-50 rounded-xl p-4 mb-6">
                                <div class="flex justify-between items-center">
                                    <span class="text-lg font-semibold text-gray-700">Total</span>
                                    <span class="text-2xl font-bold text-emerald-600">
                                        ₱@((Model.TotalAmount + 70).ToString("F2"))
                                    </span>
                                </div>
                            </div>

                            <!-- Checkout Button -->
                            <button type="button" 
                                    class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-4 px-6 rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl flex items-center justify-center gap-2 text-lg">
                                <i class="fas fa-lock"></i>
                                <span>Proceed to Checkout</span>
                            </button>

                            <!-- Security Badge -->
                            <div class="mt-4 flex items-center justify-center gap-2 text-sm text-gray-500">
                                <i class="fas fa-shield-alt text-emerald-600"></i>
                                <span>Secure checkout</span>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Info Card -->
                    <div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-2xl p-6 mt-4 border border-emerald-100">
                        <div class="flex items-start gap-3">
                            <div class="w-10 h-10 bg-emerald-600 rounded-full flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-truck text-white"></i>
                            </div>
                            <div>
                                <h3 class="font-semibold text-gray-900 mb-1">Free Delivery</h3>
                                <p class="text-sm text-gray-600">On orders over ₱500</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sample Data Display (Remove when integrating real data) -->
        @if (Model == null || !Model.CartItems.Any())
        {
            <!-- Demo Cart Items for Design Preview -->
            <div class="mt-8 p-4 bg-yellow-50 border border-yellow-200 rounded-xl">
                <p class="text-yellow-800 text-sm">
                    <i class="fas fa-info-circle mr-2"></i>
                    <strong>Design Preview:</strong> Add items to cart to see the full UI
                </p>
            </div>
        }
    </div>
</div>

<style>
    /* Custom Scrollbar */
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    /* Card Hover Effect */
    .card-hover {
        transition: all 0.3s ease;
    }
    .card-hover:hover {
        transform: translateY(-2px);
    }
</style>