@using ASI.Basecode.WebApp.Models
@model ASI.Basecode.Services.ServiceModels.CartViewModel
@{
    ViewData["Title"] = "LaAlliancé";
}

<div class="p-6 bg-gray-50 min-h-screen">
    @Html.AntiForgeryToken()

    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-800 mb-2">Your Cart</h1>
            <p class="text-gray-600">Review and manage your selected items</p>
        </div>

        <!-- Main Content Container -->
        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden">
            <div class="flex flex-col lg:flex-row">
                <!-- Cart Items Section -->
                <div class="flex-1 border-r border-gray-200">
                    <div class="p-6">
                        @if (Model?.CartItems == null || !Model.CartItems.Any())
                        {
                            <div class="text-center py-12">
                                <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
                                    <i class="fas fa-shopping-cart text-gray-400 text-3xl"></i>
                                </div>
                                <h2 class="text-2xl font-bold text-gray-800 mb-3">Your cart is empty</h2>
                                <p class="text-gray-600 mb-6">Add some delicious items to get started!</p>
                                <a href="@Url.Action("Index", "Home", new { area = "Customer" })" class="bg-green-600 hover:bg-green-700 text-white font-semibold px-8 py-3 rounded-xl transition-colors inline-flex items-center gap-2">
                                    <i class="fas fa-utensils"></i>
                                    <span>Browse Menu</span>
                                </a>
                            </div>
                        }
                        else
                        {
                            <!-- Cart Items List -->
                            <div class="space-y-4">
                                @foreach (var item in Model.CartItems)
                                {
                                    var itemAddOnsTotal = item.CartItemOptions?.Sum(opt => opt.AdditionalPrice) ?? 0m;
                                    var itemTotalPrice = item.Quantity * (item.UnitPrice + itemAddOnsTotal);
                                    
                                    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-md transition-all duration-200" id="cart-item-@item.CartItemID">
                                        <div class="p-6">
                                            <div class="flex gap-4">
                                                <!-- Product Image -->
                                                <div class="flex-shrink-0">
                                                    @if (!string.IsNullOrEmpty(item.ProductImage))
                                                    {
                                                        <img src="@item.ProductImage" alt="@item.ProductName" 
                                                             class="w-24 h-24 object-cover rounded-lg shadow-sm" loading="lazy" />
                                                    }
                                                    else
                                                    {
                                                        <div class="w-24 h-24 bg-gray-100 rounded-lg flex items-center justify-center">
                                                            <i class="fas fa-utensils text-gray-400 text-xl"></i>
                                                        </div>
                                                    }
                                                </div>
                                                
                                                <!-- Product Details -->
                                                <div class="flex-1 min-w-0">
                                                    <div class="flex justify-between items-start mb-3">
                                                        <div class="flex-1">
                                                            <h3 class="text-lg font-bold text-gray-800 mb-2">@item.ProductName</h3>
                                                            
                                                            <!-- Display Customized Orders -->
                                                            @if (item.CartItemOptions != null && item.CartItemOptions.Any())
                                                            {
                                                                <div class="mb-3 p-3">
                                                                    @foreach (var option in item.CartItemOptions)
                                                                    {
                                                                        <div class="text-sm text-gray-700 mb-1 last:mb-0">
                                                                            <span class="font-semibold text-gray-800">@option.OptionGroupName:</span>
                                                                            <span class="ml-1">@option.OptionName</span>
                                                                            @if (option.AdditionalPrice > 0)
                                                                            {
                                                                                <span class="text-green-600 font-medium ml-1">(+₱@option.AdditionalPrice.ToString("F2"))</span>
                                                                            }
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="mb-3">
                                                                    <span class="text-sm text-gray-500">No customizations</span>
                                                                </div>
                                                            }

                                                            <!-- Price Section - Total Price moved below Base Price -->
                                                            <div class="space-y-1">
                                                                <p class="text-sm text-gray-600 font-medium">Base Price: ₱@item.UnitPrice.ToString("F2")</p>
                                                                <p class="text-green-600 font-bold text-lg item-total-price" data-cart-item-id="@item.CartItemID">
                                                                    ₱@itemTotalPrice.ToString("F2")
                                                                </p>
                                                            </div>
                                                        </div>
                                                        
                                                        <!-- Action Buttons & Quantity -->
                                                        <div class="flex flex-col items-end gap-4">
                                                            <!-- Action Buttons -->
                                                            <div class="flex gap-2">
                                                                <!-- Edit Button -->
                                                                <a href="@Url.Action("EditCartItem", "Home", new { area = "Customer", cartItemID = item.CartItemID })" 
                                                                   class="w-10 h-10 flex items-center justify-center bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg transition-colors duration-200"
                                                                   title="Edit customizations">
                                                                    <i class="fas fa-edit text-sm"></i>
                                                                </a>
                                                                <!-- Delete Button -->
                                                                <button type="button" 
                                                                        class="w-10 h-10 flex items-center justify-center bg-red-50 hover:bg-red-100 text-red-600 rounded-lg transition-colors duration-200"
                                                                        data-confirm-delete
                                                                        data-item-id="@item.CartItemID"
                                                                        data-item-name="@item.ProductName"
                                                                        data-url="@Url.Action("Remove", "Cart", new { area = "Customer" })"
                                                                        data-hidden-name="cartItemID"
                                                                        title="Remove item">
                                                                    <i class="fas fa-trash text-sm"></i>
                                                                </button>
                                                            </div>

                                                            <!-- Quantity Selector -->
                                                            <div class="flex flex-col items-end gap-2">
                                                                <div class="quantity-selector flex items-center gap-2">
                                                                    <span class="quantity-loading ml-2 hidden" aria-hidden="true">
                                                                        <i class="fas fa-spinner fa-pulse text-gray-500"></i>
                                                                    </span>
                                                                    <div class="flex items-center gap-2 bg-gray-50 rounded-lg p-2 border border-gray-200" data-cart-item-id="@item.CartItemID">
                                                                        <button type="button"
                                                                                class="quantity-btn-decrease w-8 h-8 flex items-center justify-center bg-white hover:bg-gray-100 rounded-lg border border-gray-300 transition-colors duration-200"
                                                                                data-cart-item-id="@item.CartItemID"
                                                                                data-action="decrease"
                                                                                @(item.Quantity <= 1 ? "disabled" : "")>
                                                                            <i class="fas fa-minus text-gray-600 text-xs"></i>
                                                                        </button>
                                                                        <span class="quantity-display w-8 text-center font-bold text-gray-800 text-sm">@item.Quantity</span>
                                                                        <button type="button"
                                                                                class="quantity-btn-increase w-8 h-8 flex items-center justify-center bg-green-500 hover:bg-green-600 text-white rounded-lg border border-green-500 transition-colors duration-200"
                                                                                data-cart-item-id="@item.CartItemID"
                                                                                data-action="increase">
                                                                            <i class="fas fa-plus text-xs"></i>
                                                                        </button>
                                                                    </div>
                                                                </div>                                 
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Order Summary Sidebar -->
                @if (Model?.CartItems != null && Model.CartItems.Any())
                {
                    <div class="lg:w-80">
                        <div class="p-6 h-full flex flex-col">
                            <h3 class="text-xl font-bold text-gray-800 mb-6">Order Summary</h3>
                            <div class="space-y-4 mb-6 flex-1">
                                <div class="flex justify-between text-sm">
                                    <span class="text-gray-600">Subtotal (<span id="total-items">@Model.TotalItems</span> items)</span>
                                    <span class="font-medium" id="subtotal">₱@Model.SubTotal.ToString("F2")</span>
                                </div>
                                <div class="flex justify-between text-sm">
                                    <span class="text-gray-600">Delivery Fee</span>
                                    <span class="font-medium" id="delivery-fee">₱@Model.DeliveryFee.ToString("F2")</span>
                                </div>
                                <div class="border-t border-gray-200 pt-4 mt-4">
                                    <div class="flex justify-between text-lg font-bold">
                                        <span class="text-gray-800">Total</span>
                                        <span class="text-green-600" id="item-total-price">₱@Model.Total.ToString("F2")</span>
                                    </div>
                                </div>
                            </div>
                            <a href="@Url.Action("Index", "Checkout", new { area = "Customer" })" 
                               class="w-full bg-green-600 hover:bg-green-700 text-white py-4 px-6 rounded-xl font-semibold transition-colors duration-200 flex items-center justify-center gap-3 shadow-sm hover:shadow-md">
                                <i class="fas fa-credit-card"></i>
                                <span>Proceed to Checkout</span>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/confirmModal.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function getAntiForgeryToken() {
                return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            }

            function updateQuantity(cartItemId, action, selector) {
                const display = selector.querySelector('.quantity-display');
                const loading = selector.querySelector('.quantity-loading');
                const decreaseBtn = selector.querySelector('.quantity-btn-decrease');
                const increaseBtn = selector.querySelector('.quantity-btn-increase');
                const currentQty = parseInt(display.textContent);
                const newQty = action === 'increase' ? currentQty + 1 : currentQty - 1;
                
                if (newQty < 1) return;

                // Show loading state
                loading.classList.remove('hidden');
                decreaseBtn.disabled = true;
                increaseBtn.disabled = true;

                const formData = new FormData();
                formData.append('cartItemID', cartItemId);
                formData.append('quantity', newQty);
                formData.append('__RequestVerificationToken', getAntiForgeryToken());

                fetch('@Url.Action("UpdateQuantity", "Cart", new { area = "Customer" })', {
                    method: 'POST',
                    body: formData
                })
                .then(async response => {
                    const contentType = response.headers.get('content-type') || '';
                    
                    if (!response.ok) {
                        throw new Error(`Server error: ${response.status}`);
                    }
                    
                    if (contentType.includes('application/json')) {
                        return response.json();
                    }
                    
                    const text = await response.text();
                    throw new Error('Unexpected response format from server');
                })
                .then(data => {
                    if (data.success) {
                        // Update quantity display
                        display.textContent = data.newQuantity;
                        
                        // Update item total price with correct selector
                        const itemTotalPrice = document.querySelector(`.item-total-price[data-cart-item-id="${cartItemId}"]`);
                        if (itemTotalPrice) {
                            itemTotalPrice.textContent = `₱${data.itemTotalPrice.toFixed(2)}`;
                        }
                        
                        // Update order summary
                        const totalItemsEl = document.getElementById('total-items');
                        if (totalItemsEl) totalItemsEl.textContent = data.totalItems;
                        
                        const subtotalEl = document.getElementById('subtotal');
                        if (subtotalEl) subtotalEl.textContent = `₱${data.subTotal.toFixed(2)}`;
                        
                        const deliveryFeeEl = document.getElementById('delivery-fee');
                        if (deliveryFeeEl) deliveryFeeEl.textContent = `₱${data.deliveryFee.toFixed(2)}`;
                        
                        // Fixed: Changed from 'grand-total' to 'item-total-price' to match your HTML
                        const grandTotalEl = document.getElementById('item-total-price');
                        if (grandTotalEl) grandTotalEl.textContent = `₱${data.total.toFixed(2)}`;
                        
                        // Enable/disable decrease button based on quantity
                        decreaseBtn.disabled = data.newQuantity <= 1;
                    } else {
                        alert(data.message || 'Failed to update quantity');
                        // Revert display on failure
                        display.textContent = currentQty;
                    }
                })
                .catch(error => {
                    console.error('Error updating quantity:', error);
                    alert('An error occurred while updating the quantity. Please refresh and try again.');
                    // Revert display on error
                    display.textContent = currentQty;
                })
                .finally(() => {
                    // Hide loading and re-enable buttons
                    loading.classList.add('hidden');
                    const finalQty = parseInt(display.textContent);
                    decreaseBtn.disabled = finalQty <= 1;
                    increaseBtn.disabled = false;
                });
            }

            // Attach event listeners to quantity buttons
            document.querySelectorAll('.quantity-btn-decrease, .quantity-btn-increase').forEach(button => {
                button.addEventListener('click', function() {
                    const cartItemId = this.getAttribute('data-cart-item-id');
                    const action = this.getAttribute('data-action');
                    const selector = this.closest('.quantity-selector');
                    
                    if (!cartItemId || !action || !selector) {
                        console.error('Missing required attributes');
                        return;
                    }
                    
                    updateQuantity(cartItemId, action, selector);
                });
            });
        });
    </script>
}