@model ASI.Basecode.Services.ServiceModels.ProductViewModel
@{
    var successMessage = TempData["SuccessMessage"]?.ToString();
}

<div class="min-h-[calc(100vh-6rem)] min-w-full py-4 md:py-8 bg-gradient-to-br from-gray-50 to-emerald-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Back Button -->
        <div class="mb-6 md:mb-8 animate-slide-down">
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" 
                class="inline-flex items-center gap-2 px-4 py-2.5 bg-white text-emerald-600 hover:text-white hover:bg-emerald-600 rounded-xl transition-all duration-300 group shadow-md hover:shadow-lg font-semibold">
                <i class="fas fa-arrow-left transform group-hover:-translate-x-1 transition-transform"></i>
                <span>Back to Menu</span>
            </a>
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="mb-6 p-4 bg-green-100 border border-green-200 text-green-800 rounded-lg shadow-sm animate-fade-in">
                <i class="fas fa-check-circle mr-2"></i>
                @successMessage
            </div>
        }

        <!-- Main Content Grid -->
        <div class="grid lg:grid-cols-5 gap-6 lg:gap-8">
            <!-- LEFT SIDE - Product Image & Info -->
            <div class="lg:col-span-2">
                <!-- Product Image Card -->
                <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100 sticky top-4 animate-fade-in">
                    <div class="relative aspect-square">
                        <img src="@Model.ProductImage" alt="@Model.ProductName" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
                        
                        <!-- Badges -->
                        <div class="absolute top-4 left-4 flex flex-col gap-2">
                            <div class="bg-gradient-to-r from-emerald-500 to-teal-500 text-white px-4 py-2 rounded-full text-sm font-bold shadow-lg flex items-center gap-2 backdrop-blur-sm">
                                <i class="fas fa-star"></i>
                            </div>
                        </div>

                        <!-- Favorite Button -->
                        <button class="absolute top-4 right-4 w-12 h-12 bg-white/90 backdrop-blur-sm hover:bg-white rounded-full shadow-lg flex items-center justify-center transition-all duration-300 hover:scale-110 group">
                            <i class="far fa-heart text-gray-400 group-hover:fas group-hover:text-red-500 text-xl transition-all"></i>
                        </button>
                    </div>
                    
                    <!-- Product Details -->
                    <div class="p-6 md:p-8 bg-gradient-to-b from-white to-gray-50">
                        <div class="flex items-start justify-between mb-3">
                            <h1 class="text-2xl md:text-3xl font-bold text-gray-900 flex-1">@Model.ProductName</h1>
                        </div>
                        
                        <div class="flex items-baseline gap-3 mb-4">
                            <span class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent">
                                ₱@Model.ProductPrice.ToString("F2")
                            </span>
                            <span class="text-sm text-gray-500 bg-gray-100 px-3 py-1 rounded-full">base price</span>
                        </div>

                        <div class="bg-white rounded-xl p-4 border border-gray-100 mb-4">
                            <p class="text-sm md:text-base text-gray-600 leading-relaxed">@Model.ProductDescription</p>
                        </div>

                        <!-- Features -->
                        <div class="grid grid-cols-3 gap-3">
                            <div class="bg-emerald-50 rounded-lg p-3 text-center border border-emerald-100">
                                <i class="fas fa-clock text-emerald-600 text-xl mb-1"></i>
                                <div class="text-xs font-semibold text-emerald-700">15-20 min</div>
                            </div>
                            <div class="bg-blue-50 rounded-lg p-3 text-center border border-blue-100">
                                <i class="fas fa-truck text-blue-600 text-xl mb-1"></i>
                                <div class="text-xs font-semibold text-blue-700">Free Delivery</div>
                            </div>
                            <div class="bg-purple-50 rounded-lg p-3 text-center border border-purple-100">
                                <i class="fas fa-leaf text-purple-600 text-xl mb-1"></i>
                                <div class="text-xs font-semibold text-purple-700">Fresh</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT SIDE - Customization Options -->
            <div class="lg:col-span-3">
                <div class="bg-white rounded-3xl shadow-xl p-6 md:p-8 border border-gray-100 animate-slide-up">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-teal-500 rounded-xl flex items-center justify-center shadow-lg">
                            <i class="fas fa-sliders-h text-white text-xl"></i>
                        </div>
                        <h2 class="text-2xl md:text-3xl font-bold text-gray-900">Customize Your Order</h2>
                    </div>

                    <form asp-area="Customer" asp-controller="Home" asp-action="AddToCart" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productID" value="@Model.ProductID" />

                        <!-- Customization Groups -->
                        @if (Model.CustomizationGroups != null && Model.CustomizationGroups.Any())
                        {
                            <div class="space-y-6 md:space-y-8 mb-8">
                                @foreach (var group in Model.CustomizationGroups)
                                {
                                    <div class="bg-gradient-to-br from-gray-50 to-white rounded-2xl p-5 md:p-6 border-2 border-gray-100 hover:border-emerald-200 transition-all duration-300">
                                        <div class="flex items-center justify-between mb-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center">
                                                    <i class="fas fa-check text-emerald-600 text-sm"></i>
                                                </div>
                                                <h3 class="text-lg md:text-xl font-bold text-gray-900">
                                                    @group.OptionGroupName
                                                </h3>
                                            </div>
                                            @if (group.IsRequired)
                                            {
                                                <span class="bg-gradient-to-r from-red-500 to-pink-500 text-white text-xs font-bold px-4 py-1.5 rounded-full shadow-md">
                                                    Required
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="bg-gradient-to-r from-gray-400 to-gray-500 text-white text-xs font-bold px-4 py-1.5 rounded-full shadow-md">
                                                    Optional
                                                </span>
                                            }
                                        </div>
                                        
                                        <p class="text-sm text-gray-500 mb-4 flex items-center gap-2">
                                            <i class="fas fa-info-circle text-emerald-600"></i>
                                            @if (group.NumberOfChoice == 1)
                                            {
                                                <span>Choose 1 option</span>
                                            }
                                            else
                                            {
                                                <span>Choose up to @group.NumberOfChoice options</span>
                                            }
                                        </p>

                                        <!-- Options List -->
                                        <div class="space-y-3">
                                            @foreach (var item in group.ProductOptionItems)
                                            {
                                                <label class="option-label group relative flex items-center p-4 bg-white rounded-xl cursor-pointer transition-all duration-300 border-2 border-gray-200 hover:border-emerald-400 hover:shadow-md">
                                                    @if (group.NumberOfChoice == 1)
                                                    {
                                                        <input type="radio" 
                                                               name="option_@group.ProductOptionGroupID" 
                                                               value="@item.ProductOptionItemsID"
                                                               data-price="@item.AdditionalPrice"
                                                               class="option-input w-5 h-5 text-emerald-600 focus:ring-emerald-500 focus:ring-2 cursor-pointer" />
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" 
                                                               name="option_@group.ProductOptionGroupID" 
                                                               value="@item.ProductOptionItemsID"
                                                               data-price="@item.AdditionalPrice"
                                                               class="option-input w-5 h-5 text-emerald-600 rounded focus:ring-emerald-500 focus:ring-2 cursor-pointer" />
                                                    }
                                                    
                                                    <div class="ml-4 flex-1">
                                                        <span class="option-text font-semibold text-base text-gray-900 group-hover:text-emerald-700 transition-colors">
                                                            @item.OptionName
                                                        </span>
                                                    </div>
                                                    
                                                    @if (item.AdditionalPrice > 0)
                                                    {
                                                        <div class="flex items-center gap-2">
                                                            <span class="option-price text-emerald-600 font-bold text-base bg-emerald-50 px-3 py-1 rounded-full">
                                                                +₱@item.AdditionalPrice.ToString("F2")
                                                            </span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="option-price text-gray-400 text-sm font-semibold bg-gray-100 px-3 py-1 rounded-full">
                                                            Free
                                                        </span>
                                                    }

                                                    <!-- Checkmark Animation -->
                                                    <div class="absolute inset-0 border-2 border-emerald-500 rounded-xl opacity-0 transition-opacity duration-300 pointer-events-none option-checkmark"></div>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        
                        <!-- Quantity Selector -->
                        <div class="mb-8">
                            <label class="flex items-center gap-3 mb-4">
                                <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-hashtag text-blue-600 text-sm"></i>
                                </div>
                                <span class="text-lg md:text-xl font-bold text-gray-900">Quantity</span>
                            </label>
                            <div class="flex items-center gap-4">
                                <button type="button" 
                                        onclick="decrementQuantity()"
                                        class="w-14 h-14 flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200 hover:from-gray-200 hover:to-gray-300 rounded-2xl transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-105 group">
                                    <i class="fas fa-minus text-gray-700 text-lg group-hover:scale-110 transition-transform"></i>
                                </button>
                                <input type="number" 
                                       id="quantity" 
                                       name="quantity" 
                                       value="1" 
                                       min="1" 
                                       max="99"
                                       class="w-24 h-14 text-center text-2xl font-bold border-3 border-gray-200 rounded-2xl focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all shadow-inner" />
                                <button type="button" 
                                        onclick="incrementQuantity()"
                                        class="w-14 h-14 flex items-center justify-center bg-gradient-to-br from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white rounded-2xl transition-all duration-300 shadow-lg hover:shadow-xl transform hover:scale-105 group">
                                    <i class="fas fa-plus text-lg group-hover:scale-110 transition-transform"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Total Price Display -->
                        <div class="bg-gradient-to-br from-emerald-500 to-teal-600 rounded-2xl p-6 mb-6 shadow-xl border-2 border-emerald-400">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-white/20 backdrop-blur-sm rounded-xl flex items-center justify-center">
                                        <i class="fas fa-calculator text-white"></i>
                                    </div>
                                    <span class="text-lg font-semibold text-white">Total Price</span>
                                </div>
                                <span id="totalPrice" class="text-3xl md:text-4xl font-bold text-white drop-shadow-lg">
                                    ₱@Model.ProductPrice.ToString("F2")
                                </span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex gap-4">
                            <button type="submit" 
                                    id="addToCartBtn"
                                    class="flex-1 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-bold py-4 px-6 rounded-2xl transition-all duration-300 shadow-xl hover:shadow-2xl flex items-center justify-center gap-3 text-lg transform hover:scale-105 group">
                                <i class="fas fa-shopping-cart text-xl group-hover:animate-bounce"></i>
                                <span>Add to Cart</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Animations */
    @@keyframes slide-down {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fade-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .animate-slide-down {
        animation: slide-down 0.6s ease-out;
    }

    .animate-slide-up {
        animation: slide-up 0.6s ease-out;
    }

    .animate-fade-in {
        animation: fade-in 0.8s ease-out;
    }

    /* Selected option highlight */
    .option-input:checked + div + div + .option-checkmark,
    .option-input:checked ~ .option-checkmark {
        opacity: 1;
    }

    .option-input:checked ~ * {
        color: inherit;
    }

    /* Custom number input */
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type="number"] {
        -moz-appearance: textfield;
    }

    /* Smooth transitions */
    * {
        transition-property: color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
</style>

<script>
    function incrementQuantity() {
        const input = document.getElementById('quantity');
        const currentValue = parseInt(input.value) || 1;
        if (currentValue < 99) {
            input.value = currentValue + 1;
            updateTotalPrice();
        }
    }

    function decrementQuantity() {
        const input = document.getElementById('quantity');
        const currentValue = parseInt(input.value) || 1;
        if (currentValue > 1) {
            input.value = currentValue - 1;
            updateTotalPrice();
        }
    }

    function updateTotalPrice() {
        const basePrice = @Model.ProductPrice;
        const quantity = parseInt(document.getElementById('quantity').value) || 1;
        
        let additionalPrice = 0;
        
        @foreach (var group in Model.CustomizationGroups)
        {
            <text>
            const selectedGroup@(group.ProductOptionGroupID) = document.querySelectorAll('input[name="option_@group.ProductOptionGroupID"]:checked');
            selectedGroup@(group.ProductOptionGroupID).forEach(input => {
                const optionPrice = parseFloat(input.dataset.price) || 0;
                additionalPrice += optionPrice;
            });
            </text>
        }
        
        const totalPrice = (basePrice + additionalPrice) * quantity;
        document.getElementById('totalPrice').textContent = '₱' + totalPrice.toFixed(2);
    }

    function updateOptionHighlight() {
        document.querySelectorAll('.option-label').forEach(label => {
            const input = label.querySelector('.option-input');
            if (input.checked) {
                label.classList.add('bg-emerald-50', 'border-emerald-500', 'shadow-lg');
                label.classList.remove('bg-white', 'border-gray-200');
            } else {
                label.classList.remove('bg-emerald-50', 'border-emerald-500', 'shadow-lg');
                label.classList.add('bg-white', 'border-gray-200');
            }
        });
    }

    function validateForm(event) {
        const requiredGroups = [];
        @foreach (var group in Model.CustomizationGroups.Where(g => g.IsRequired))
        {
            <text>
            requiredGroups.push({
                id: @group.ProductOptionGroupID,
                name: '@group.OptionGroupName'
            });
            </text>
        }

        for (const group of requiredGroups) {
            const selected = document.querySelectorAll(`input[name="option_${group.id}"]:checked`);
            if (selected.length === 0) {
                event.preventDefault();
                alert(`Please select an option for ${group.name}`);
                return false;
            }
        }
        
        return true;
    }

    document.addEventListener('DOMContentLoaded', function() {
        const optionInputs = document.querySelectorAll('input[type="checkbox"], input[type="radio"]');
        optionInputs.forEach(input => {
            input.addEventListener('change', function() {
                updateTotalPrice();
                updateOptionHighlight();
            });
        });
        
        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', validateForm);
        }
        
        updateOptionHighlight();
    });
</script>