@model ASI.Basecode.Services.ServiceModels.ProductViewModel
@{
    var successMessage = TempData["SuccessMessage"]?.ToString();
}

@Html.AntiForgeryToken()

<div class="min-h-screen bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Back Button -->
        <div class="mb-8">
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" 
                class="inline-flex items-center gap-3 px-5 py-3 bg-white text-gray-700 hover:text-white hover:bg-green-500 rounded-xl transition-all duration-300 group shadow-sm hover:shadow-md border border-gray-200 font-medium">
                <i class="fas fa-arrow-left transform group-hover:-translate-x-1 transition-transform"></i>
                <span>Back to Menu</span>
            </a>
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-800 rounded-xl shadow-sm animate-fade-in flex items-center gap-3">
                <div class="w-6 h-6 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-check text-white text-xs"></i>
                </div>
                <span class="font-medium">@successMessage</span>
            </div>
        }

        <!-- Main Content Grid -->
    
        <div class="flex flex-col lg:flex-row gap-6 p-0">
            <!-- Product Image Card - Made more compact -->
            <div class="lg:w-2/5">
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="relative aspect-[4/3]">
                        <img src="@Model.ProductImage" alt="@Model.ProductName" 
                            class="w-full h-full object-cover transition-transform duration-300 hover:scale-105" />
                        
                        <!-- Badges -->
                        <div class="absolute top-3 left-3">
                            <div class="bg-green-500 text-white px-2 py-1.5 rounded-full text-xs font-semibold flex items-center gap-1">
                                <i class="fas fa-star text-amber-400 text-xs"></i>
                                <span>@Model.CategoryName</span>
                            </div>
                        </div>

                        <!-- Favorite Button -->
                        <button class="favorite-toggle absolute top-3 right-3 w-8 h-8 bg-white/95 hover:bg-white rounded-full shadow-sm flex items-center justify-center transition-all duration-200 hover:scale-110 group border border-gray-200"
                                data-product-id="@Model.ProductID"
                                title="Add to favorites">
                            <i class="far fa-heart text-gray-500 text-sm group-hover:fas group-hover:text-rose-500 transition-all"></i>
                        </button>
                    </div>
                    
                    <!-- Product Details - More compact -->
                    <div class="p-4">
                        <div class="flex items-start justify-between mb-3">
                            <h1 class="text-lg font-bold text-gray-900 leading-tight">@Model.ProductName</h1>
                            <div class="flex items-center gap-1 bg-amber-50 px-2 py-1 rounded-full border border-amber-200">
                                <i class="fas fa-star text-amber-500 text-xs"></i>
                                <span class="text-xs font-semibold text-amber-700">4.8</span>
                            </div>
                        </div>
                        
                        <div class="flex items-baseline gap-2 mb-3">
                            <span class="text-xl font-bold text-gray-900">
                                ₱@Model.ProductPrice.ToString("F2")
                            </span>
                            <span class="text-xs text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">base price</span>
                        </div>

                        <div class="mb-4">
                            <p class="text-gray-600 leading-relaxed text-xs line-clamp-3">@Model.ProductDescription</p>
                        </div>

                        <!-- Features - More compact -->
                        <div class="grid grid-cols-3 gap-2">
                            <div class="bg-gray-50 rounded-lg p-2 text-center border border-gray-200 group hover:shadow-sm transition-all">
                                <i class="fas fa-clock text-gray-600 text-sm mb-1"></i>
                                <div class="text-xs font-medium text-gray-700">15-20 min</div>
                            </div>
                            <div class="bg-gray-50 rounded-lg p-2 text-center border border-gray-200 group hover:shadow-sm transition-all">
                                <i class="fas fa-truck text-gray-600 text-sm mb-1"></i>
                                <div class="text-xs font-medium text-gray-700">Free Delivery</div>
                            </div>
                            <div class="bg-gray-50 rounded-lg p-2 text-center border border-gray-200 group hover:shadow-sm transition-all">
                                <i class="fas fa-leaf text-gray-600 text-sm mb-1"></i>
                                <div class="text-xs font-medium text-gray-700">Fresh</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Customize Order (Middle) -->
            <div class="lg:w-2/5">
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-4">Customize Your Order</h3>
                    <form asp-area="Customer" asp-controller="Home" asp-action="AddToCart" method="post" id="orderForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productID" value="@Model.ProductID" />
                        <input type="hidden" name="cartItemID" value="@(ViewBag.CartItemID ?? 0)" />

                        <!-- Customization Groups -->
                        @if (Model.CustomizationGroups != null && Model.CustomizationGroups.Any())
                        {
                            <div class="space-y-6 mb-8" id="customizationGroups">
                                @foreach (var group in Model.CustomizationGroups)
                                {
                                    <div class="mb-4">
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            @group.OptionGroupName
                                            @if (group.IsRequired)
                                            {
                                                <span class="text-rose-500 ml-2">• Required</span>
                                            }
                                        </label>
                                        <div class="space-y-2" data-option-group="@group.ProductOptionGroupID">
                                            @foreach (var item in group.ProductOptionItems)
                                            {
                                                var isSelected = false;
                                                if (ViewBag.SelectedOptions != null)
                                                {
                                                    var groupOptions = ViewBag.SelectedOptions[group.ProductOptionGroupID] as List<int>;
                                                    isSelected = groupOptions?.Contains(item.ProductOptionItemsID) == true;
                                                }
                                                
                                                <label class="custom-option flex items-center gap-4 p-4 border border-gray-200 rounded-xl hover:border-green-300 transition-all duration-200 cursor-pointer @(isSelected ? "border-green-500 bg-green-50 shadow-sm" : "")"
                                                    data-option-id="@item.ProductOptionItemsID"
                                                    data-group-id="@group.ProductOptionGroupID"
                                                    data-is-radio="@(group.NumberOfChoice == 1)">
                                                    
                                                    <!-- Radio/Checkbox Button - Always on the left -->
                                                    <div class="flex items-center justify-center flex-shrink-0">
                                                        @if (group.NumberOfChoice == 1)
                                                        {
                                                            <!-- Radio button -->
                                                            <input type="radio" 
                                                                name="option_@group.ProductOptionGroupID" 
                                                                value="@item.ProductOptionItemsID"
                                                                data-price="@item.AdditionalPrice"
                                                                class="sr-only peer" 
                                                                @(isSelected ? "checked" : "") />
                                                            <div class="w-3 h-3 border-2 border-gray-300 rounded-full flex items-center justify-center transition-all duration-200 peer-checked:bg-green-500 peer-checked:border-green-500">
                                                                <div class="w-2 h-2 bg-white rounded-full opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <!-- Checkbox -->
                                                            <input type="checkbox" 
                                                                name="option_@group.ProductOptionGroupID" 
                                                                value="@item.ProductOptionItemsID"
                                                                data-price="@item.AdditionalPrice"
                                                                class="sr-only peer" 
                                                                data-max-choices="@group.NumberOfChoice"
                                                                @(isSelected ? "checked" : "") />
                                                            <div class="w-6 h-6 border-2 border-gray-300 rounded flex items-center justify-center transition-all duration-200 peer-checked:bg-green-500 peer-checked:border-green-500">
                                                                <i class="fas fa-check text-white text-xs opacity-0 peer-checked:opacity-100 transition-opacity"></i>
                                                            </div>
                                                        }
                                                    </div>

                                                    <!-- Option Content -->
                                                    <div class="flex-1 flex items-center justify-between">
                                                        <span class="text-sm font-medium text-gray-900">@item.OptionName</span>
                                                        @if (item.AdditionalPrice > 0)
                                                        {
                                                            <span class="text-green-600 font-semibold text-sm ">
                                                                +₱@item.AdditionalPrice.ToString("F2")
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-gray-500 font-medium text-sm bg-gray-100 px-3 py-1 rounded-lg">
                                                                Free
                                                            </span>
                                                        }
                                                    </div>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                                    <!-- Quantity Selector -->
                                    <div class="mb-6">
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Quantity</label>
                                        <div class="flex items-center gap-3 max-w-xs">
                                            <button type="button" 
                                                    onclick="adjustQuantity(-1)"
                                                    class="w-10 h-10 flex items-center justify-center bg-gray-100 hover:bg-gray-200 rounded-full border border-gray-200 transition-colors duration-200">
                                                <i class="fas fa-minus text-gray-600 text-sm"></i>
                                            </button>
                                            <input type="number" 
                                                id="quantity" 
                                                name="quantity" 
                                                value="@(ViewBag.ExistingQuantity ?? 1)" 
                                                min="1" 
                                                max="99"
                                                class="w-15 h-10 text-center text-gray font-bold border-2 border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-100 bg-white" />
                                            <button type="button" 
                                                    onclick="adjustQuantity(1)"
                                                    class="w-10 h-10 flex items-center justify-center bg-green-500 hover:bg-green-600 text-white rounded-full border border-green-500 transition-colors duration-200">
                                                <i class="fas fa-plus text-sm"></i>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Total Price Card (Right) -->
                        <div class="lg:w-1/5">
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sticky top-6">
                                <h3 class="text-lg font-bold text-gray-800 mb-4">Order Summary</h3>
                                <div class="space-y-3 mb-6">
                                    <div class="flex justify-between text-sm">
                                        <span class="text-gray-600">Base Price</span>
                                        <span class="font-medium">₱@Model.ProductPrice.ToString("F2")</span>
                                    </div>
                                    <div class="flex justify-between text-sm">
                                        <span class="text-gray-600">Extras</span>
                                        <span class="font-medium" id="extrasPrice">₱0.00</span>
                                    </div>
                                    <div class="border-t border-gray-200 pt-2">
                                        <div class="flex justify-between text-base font-bold">
                                            <span>Total</span>
                                            <span class="text-green-600" id="totalPrice">₱@Model.ProductPrice.ToString("F2")</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="space-y-3">
                                    <button type="submit" 
                                            id="addToCartBtn"
                                            form="orderForm"
                                            class="w-full bg-green-600 hover:bg-green-700 text-white py-3 px-4 rounded-lg font-semibold transition-colors duration-200 flex items-center justify-center gap-2">
                                        <i class="fas fa-shopping-cart"></i>
                                        <span>Add to Cart</span>
                                    </button>
                                    <button class="w-full border border-green-600 text-green-600 hover:bg-green-50 py-3 px-4 rounded-lg font-semibold transition-colors duration-200">
                                        Save for Later
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


<style>
    /* Animations */
    @@keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .animate-fade-in {
        animation: fade-in 0.8s ease-out;
    }

    /* Custom option selection styles */
    .custom-option.peer-checked {
        border-color: #10b981;
        background-color: #f0fdf4;
    }

    /* Hide native inputs */
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* Custom number input */
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type="number"] {
        -moz-appearance: textfield;
    }

    /* Custom scrollbar */
    .overflow-y-auto::-webkit-scrollbar {
        width: 6px;
    }

    .overflow-y-auto::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 3px;
    }

    .overflow-y-auto::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }

    .overflow-y-auto::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }
</style>
@section Scripts {
<script>
    class ProductCustomizer {
        constructor() {
        this.basePrice = @Model.ProductPrice;
        this.init();
        }

        init() {
            this.bindEvents();
            this.updateTotalPrice();
            this.setupOptionSelection(); // Add this line
        }
        
        // ADD THIS NEW METHOD
        setupOptionSelection() {
            document.querySelectorAll('.custom-option').forEach(option => {
                const input = option.querySelector('input[type="radio"], input[type="checkbox"]');
                const label = option;
                
                input.addEventListener('change', () => {
                    this.updateOptionVisualState(option, input);
                    this.updateTotalPrice();
                });
                
                label.addEventListener('click', (e) => {
                    if (input.type === 'radio' && !input.checked) {
                        const groupName = input.getAttribute('name');
                        document.querySelectorAll(`input[name="${groupName}"]`).forEach(radio => {
                            radio.checked = false;
                            const radioLabel = radio.closest('.custom-option');
                            if (radioLabel) {
                                this.updateOptionVisualState(radioLabel, radio);
                            }
                        });
                        
                        input.checked = true;
                        this.updateOptionVisualState(label, input);
                        this.updateTotalPrice();
                    }
                });
                
                this.updateOptionVisualState(label, input);
            });
        }

        // ADD THIS HELPER METHOD
        updateOptionVisualState(label, input) {
            if (input.checked) {
                label.classList.add('border-green-500', 'bg-green-50');
                label.classList.remove('border-gray-200');
            } else {
                label.classList.remove('border-green-500', 'bg-green-50');
                label.classList.add('border-gray-200');
            }
        }

        bindEvents() {
        // Option selection - listen to all customization inputs
        document.querySelectorAll('input[type="radio"], input[type="checkbox"]').forEach(input => {
            input.addEventListener('change', () => this.updateTotalPrice());
        });

        // Quantity input
        const quantityInput = document.getElementById('quantity');
        quantityInput.addEventListener('input', () => this.updateTotalPrice());
        quantityInput.addEventListener('change', () => this.validateQuantity());
        }

        calculateAdditionalPrice() {
            let additionalPrice = 0;
            
            // Get all checked customization options
            const checkedOptions = document.querySelectorAll('input[type="radio"]:checked, input[type="checkbox"]:checked');
            
            checkedOptions.forEach(input => {
                const price = parseFloat(input.getAttribute('data-price')) || 0;
                additionalPrice += price;
            });
            
            return additionalPrice;
        }

        updateTotalPrice() {
            const quantity = this.getQuantity();
            const additionalPrice = this.calculateAdditionalPrice();
            const totalPrice = (this.basePrice + additionalPrice) * quantity;

            // Update all price displays
            document.getElementById('totalPrice').textContent = `₱${totalPrice.toFixed(2)}`;
            document.getElementById('extrasPrice').textContent = `₱${additionalPrice.toFixed(2)}`;
        }

        getQuantity() {
            const input = document.getElementById('quantity');
            return parseInt(input.value) || 1;
        }

        validateQuantity() {
            const input = document.getElementById('quantity');
            let value = parseInt(input.value);
            
            if (isNaN(value) || value < 1) value = 1;
            if (value > 99) value = 99;
            
            input.value = value;
            this.updateTotalPrice();
        }

        adjustQuantity(change) {
            const input = document.getElementById('quantity');
            let value = parseInt(input.value) || 1;
            value += change;
            
            if (value < 1) value = 1;
            if (value > 99) value = 99;
            
            input.value = value;
            this.updateTotalPrice();
        }

        validateForm(event) {
            const requiredGroups = [];
            @foreach (var group in Model.CustomizationGroups.Where(g => g.IsRequired))
            {
                <text>
                requiredGroups.push({
                    id: @group.ProductOptionGroupID,
                    name: '@group.OptionGroupName'
                });
                </text>
            }

            for (const group of requiredGroups) {
                const selected = document.querySelectorAll(`input[name="option_${group.id}"]:checked`);
                if (selected.length === 0) {
                    event.preventDefault();
                    this.highlightRequiredGroup(group.id);
                    alert(`Please select an option for "${group.name}"`);
                    return false;
                }
            }

            return true;
        }

        highlightRequiredGroup(groupId) {
            const group = document.querySelector(`input[name="option_${groupId}"]`)?.closest('.mb-4');
            if (group) {
                group.style.border = '2px solid #ef4444';
                group.style.borderRadius = '8px';
                group.style.padding = '8px';
                setTimeout(() => {
                    group.style.border = '';
                    group.style.padding = '';
                }, 2000);
            }
        }
    }

    // Initialize when DOM is loaded
    document.addEventListener('DOMContentLoaded', () => {
        window.productCustomizer = new ProductCustomizer();
    });

    // Global function for quantity buttons
    function adjustQuantity(change) {
        if (window.productCustomizer) {
            window.productCustomizer.adjustQuantity(change);
        }
    }

    // Favorite toggle functionality - FIXED VERSION
        document.addEventListener('DOMContentLoaded', function() {
            const favoriteButtons = document.querySelectorAll('.favorite-toggle');
            
            favoriteButtons.forEach(button => {
                const productId = button.getAttribute('data-product-id');
                
                // Check initial favorite state
                checkFavoriteState(productId, button);
                
                // Add click event
                button.addEventListener('click', function() {
                    toggleFavorite(productId, button);
                });
            });
            
            function checkFavoriteState(productId, button) {
                fetch(`/Customer/Favorites/IsProductInFavorites?productId=${productId}`)
                    .then(response => {
                        if (!response.ok) throw new Error('Network response was not ok');
                        return response.json();
                    })
                    .then(isFavorite => {
                        updateButtonAppearance(button, isFavorite);
                    })
                    .catch(error => {
                        console.error('Error checking favorite state:', error);
                        updateButtonAppearance(button, false);
                    });
            }
            
            function toggleFavorite(productId, button) {
            // Use FormData instead of JSON
            const formData = new FormData();
            formData.append('productID', productId);
            
            // Get the anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (token) {
                formData.append('__RequestVerificationToken', token);
            }
            
            // Show loading state
            const icon = button.querySelector('i');
            icon.classList.add('fa-spinner', 'fa-spin');
            icon.classList.remove('far', 'fas', 'fa-heart');
            
            fetch('/Customer/Favorites/ToggleFavorite', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    updateButtonAppearance(button, data.isFavorite);
                    showFavoriteNotification(data.message, data.isFavorite);
                    updateFavoriteCount(data.isFavorite);
                } else {
                    throw new Error(data.message || 'Operation failed');
                }
            })
            .catch(error => {
                console.error('Error toggling favorite:', error);
                showFavoriteNotification('Failed to update favorites. Please try again.', false);
                checkFavoriteState(productId, button);
            })
            .finally(() => {
                icon.classList.remove('fa-spinner', 'fa-spin');
                icon.classList.add('fa-heart');
            });
        }
            
            function updateButtonAppearance(button, isFavorite) {
                const icon = button.querySelector('i');
                if (isFavorite) {
                    icon.classList.remove('far', 'text-gray-500');
                    icon.classList.add('fas', 'text-rose-500');
                    button.classList.add('bg-rose-50', 'border-rose-300');
                } else {
                    icon.classList.remove('fas', 'text-rose-500');
                    icon.classList.add('far', 'text-gray-500');
                    button.classList.remove('bg-rose-50', 'border-rose-300');
                }
            }
            
            function updateFavoriteCount(isAdded) {
                const favoriteCountElements = document.querySelectorAll('.favorite-count');
                favoriteCountElements.forEach(element => {
                    let currentCount = parseInt(element.textContent) || 0;
                    if (isAdded) {
                        currentCount += 1;
                    } else {
                        currentCount = Math.max(0, currentCount - 1);
                    }
                    element.textContent = currentCount;
                });
            }
            
            function showFavoriteNotification(message, isFavorite) {
                // Remove any existing notifications
                const existingNotifications = document.querySelectorAll('.favorite-notification');
                existingNotifications.forEach(notification => notification.remove());
                
                // Create and show notification
                const notification = document.createElement('div');
                notification.className = `favorite-notification fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 transform transition-all duration-300 ${
                    isFavorite ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-rose-50 border border-rose-200 text-rose-800'
                }`;
                notification.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 ${
                            isFavorite ? 'bg-green-500' : 'bg-rose-500'
                        }">
                            <i class="fas ${isFavorite ? 'fa-heart' : 'fa-times'} text-white text-xs"></i>
                        </div>
                        <span class="text-sm font-medium">${message}</span>
                    </div>
                `;
                
                document.body.appendChild(notification);
                
                // Animate in
                setTimeout(() => {
                    notification.style.opacity = '1';
                    notification.style.transform = 'translateY(0)';
                }, 10);
                
                // Remove after 3 seconds
                setTimeout(() => {
                    notification.style.opacity = '0';
                    notification.style.transform = 'translateY(-10px)';
                    setTimeout(() => {
                        if (notification.parentNode) {
                            notification.remove();
                        }
                    }, 300);
                }, 3000);
            }
        });
</script>
}