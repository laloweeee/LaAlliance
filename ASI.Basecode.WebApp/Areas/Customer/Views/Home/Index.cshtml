@model ASI.Basecode.WebApp.Areas.Customer.Models.HomeViewModel
@{
    ViewData["Title"] = "LaAlliancé";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="min-h-screen bg-gray-50 font-inter">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- Hero Banner -->
        <div class="rounded-2xl mb-8 relative overflow-hidden h-96">
            <img src="https://template.canva.com/EAGc0MQo6qY/1/0/1600w-NDIQ-aX6840.jpg" alt="Delivery person" class="w-full h-full object-fill">
            <button class="absolute bottom-6 right-6 bg-white text-gray-800 px-8 py-3 rounded-xl font-semibold transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-105 hover:bg-gray-50 active:scale-95">
                Order Now
            </button>
        </div>

       <!-- Search Section -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-4">
            <div class="flex flex-col lg:flex-row gap-4 items-center">
                <div class="flex-1 w-full">
                    <div class="relative">
                        <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                        <input id="menuSearch"
                        type="text"
                        placeholder="Search for delicious food..."
                        class="w-full pl-12 pr-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-200 transition-colors outline-none"
                        autocomplete="off">

                        </div>
                </div>
                <select class="w-full lg:w-64 px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-200 transition-colors font-medium outline-none">
                    <option>Price: Low to High</option>
                    <option>Price: High to Low</option>
                    <option>Newest First</option>
                </select>
            </div>
        </div>
            
        <!-- Filter Section -->
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Categories</h2>
        <div class="flex flex-wrap gap-6 mb-8">
            <div class="flex flex-col items-center">
                <button class="category-filter w-20 h-20 rounded-lg bg-gray-200 overflow-hidden mb-2 transition-all" data-category="all">
                    <img src="https://i.pinimg.com/1200x/c4/40/0f/c4400f1f2c8441cb7c6eea6844a79135.jpg" alt="All Items" class="w-full h-full object-cover transition-transform">
                </button>
                <span class="text-sm font-medium text-gray-700">All Items</span>
            </div>
            
            @foreach (var category in Model.Categories)
            {
                <div class="flex flex-col items-center">
                    <button class="category-filter w-20 h-20 rounded-lg bg-gray-200 overflow-hidden mb-2 transition-all"
                            data-category="@category.CategoryID">
                        <img src="https://i.pinimg.com/1200x/c4/40/0f/c4400f1f2c8441cb7c6eea6844a79135.jpg" alt="@category.CategoryName" class="w-full h-full object-cover transition-transform">
                    </button>
                    <span class="text-sm font-medium text-gray-700">@category.CategoryName</span>
                </div>
            }
        </div>

        <!-- Products Section -->
        <!-- Replace the entire Products Section with this: -->
    @if (Model.Products.Any() && Model.Categories.Any())
    {
        <div class="space-y-8"> <!-- Reduced from space-y-12 -->
            @foreach (var category in Model.Categories)
            {
                var productsInCategory = Model.Products.Where(p => p.CategoryID == category.CategoryID).ToList();
                
                if (productsInCategory.Any())
                {
                    <div id="category-@category.CategoryID" class="category-section">
                        <!-- Category Header -->
                        <div class="mb-4">
                            <h3 class="text-xl font-bold text-gray-900">@category.CategoryName</h3>
                            <p class="text-gray-600">Discover our delicious @category.CategoryName offerings</p>
                        </div>
                        
                        <!-- Products Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                            @foreach (var product in productsInCategory)
                            {
                                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
                                    <!-- Your existing product card content -->
                                    <div class="h-40 bg-gray-100 overflow-hidden relative">
                                        @if (!string.IsNullOrEmpty(product.ProductImage))
                                        {
                                            <img src="@product.ProductImage"
                                                alt="@product.ProductName"
                                                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
                                        }
                                        else
                                        {
                                            <div class="flex items-center justify-center h-full">
                                                <i class="fas fa-image text-gray-300 text-3xl"></i>
                                            </div>
                                        }
                                    </div>

                                    <div class="p-3">
                                        <div class="flex items-center justify-between mb-2">
                                            <h3 class="font-bold text-lg text-gray-900 line-clamp-1">
                                                @product.ProductName
                                            </h3>
                                            <div class="bg-white/95 backdrop-blur-sm px-2 py-1 rounded-full flex items-center gap-1">
                                                <i class="fas fa-star text-yellow-400 text-xs"></i>
                                                <span class="text-xs font-semibold text-gray-700">4.8</span>
                                            </div>
                                        </div>
                                        <p class="text-gray-600 text-sm mb-2 line-clamp-2 leading-snug">
                                            @(product.ProductDescription?.Length > 80 ? product.ProductDescription.Substring(0, 77) + "..." : product.ProductDescription)
                                        </p>

                                        <div class="flex items-center text-gray-500 text-sm mb-2">
                                            <i class="fas fa-clock mr-1"></i>
                                            <span>25-30 min</span>
                                        </div>

                                        <div class="flex items-center justify-between">
                                            <span class="text-lg font-bold text-green-600">₱@product.ProductPrice.ToString("0.00")</span>
                                            <a asp-action="ProductToCart" asp-controller="Home" asp-area="Customer"
                                            asp-route-productID="@product.ProductID"
                                            class="bg-green-500 text-white px-3 py-2 rounded-md font-semibold hover:bg-green-600 transition-colors flex items-center gap-1">
                                                <i class="fas fa-cart-plus text-sm"></i>
                                                <span class="text-sm">Add</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }

    <style>
        .line-clamp-1 {
            overflow: hidden;
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 1;
        }
        
        .line-clamp-2 {
            overflow: hidden;
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const categoryFilters = document.querySelectorAll('.category-filter');
        const categorySections = document.querySelectorAll('.category-section');
        const searchInput = document.querySelector('input[type="text"]');

        // Category filter functionality
        categoryFilters.forEach(button => {
            button.addEventListener('click', function() {
                const category = this.getAttribute('data-category');
                
                // Update active button
                categoryFilters.forEach(btn => {
                    btn.classList.remove('bg-green-600', 'text-white');
                    btn.classList.add('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
                });
                this.classList.add('bg-green-600', 'text-white');
                this.classList.remove('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');

                // Show/hide categories
                if (category === 'all') {
                    categorySections.forEach(section => {
                        section.style.display = 'block';
                    });
                } else {
                    categorySections.forEach(section => {
                        if (section.id === `category-${category}`) {
                            section.style.display = 'block';
                        } else {
                            section.style.display = 'none';
                        }
                    });
                }
            });
        });

        // Search functionality
        if (searchInput) {
            searchInput.addEventListener('input', function(e) {
                const searchTerm = e.target.value.toLowerCase();
                
                categorySections.forEach(section => {
                    const products = section.querySelectorAll('.bg-white');
                    let hasVisibleProducts = false;
                    
                    products.forEach(product => {
                        const productName = product.querySelector('h3').textContent.toLowerCase();
                        const productDescription = product.querySelector('p').textContent.toLowerCase();
                        
                        if (productName.includes(searchTerm) || productDescription.includes(searchTerm)) {
                            product.style.display = 'block';
                            hasVisibleProducts = true;
                        } else {
                            product.style.display = 'none';
                        }
                    });
                    
                    // Show/hide category section based on visible products
                    section.style.display = hasVisibleProducts ? 'block' : 'none';
                });
            });
        }
    });

    //Filter button hover effects
    document.addEventListener('DOMContentLoaded', function() {
        const categoryFilters = document.querySelectorAll('.category-filter');
        
        categoryFilters.forEach(button => {
            // Add hover effect to image button only
            button.addEventListener('mouseenter', function() {
                if (!this.classList.contains('active')) {
                    this.classList.add('ring-2', 'ring-green-300');
                    const img = this.querySelector('img');
                    img.classList.add('scale-105');
                }
            });
            
            button.addEventListener('mouseleave', function() {
                if (!this.classList.contains('active')) {
                    this.classList.remove('ring-2', 'ring-green-300');
                    const img = this.querySelector('img');
                    img.classList.remove('scale-105');
                }
            });
            
            // Add click effect to image button only (stays active)
            button.addEventListener('click', function() {
                // Remove active state from all buttons
                categoryFilters.forEach(btn => {
                    btn.classList.remove('active', 'ring-2', 'ring-green-300');
                    const img = btn.querySelector('img');
                    img.classList.remove('scale-105');
                });
                
                // Add active state to clicked button only
                this.classList.add('active', 'ring-2', 'ring-green-300');
                const img = this.querySelector('img');
                img.classList.add('scale-105');
            });
        });
    });
</script>