@model ASI.Basecode.WebApp.Areas.Customer.Models.HomeViewModel
@{
    ViewData["Title"] = "LaAlliancé";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="min-h-screen bg-gray-50 font-inter">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- Hero Banner -->
        <div class="rounded-2xl mb-8 relative overflow-hidden h-96">
            <img src="https://template.canva.com/EAGc0MQo6qY/1/0/1600w-NDIQ-aX6840.jpg" alt="Delivery person" class="w-full h-full object-fill">
            <button class="absolute bottom-6 right-6 bg-white text-gray-800 px-8 py-3 rounded-xl font-semibold transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-105 hover:bg-gray-50 active:scale-95">
                Order Now
            </button>
        </div>

       <!-- Search Section -->
        <div class="flex flex-col lg:flex-row gap-4 items-center mb-8">
            <div class="flex-1 w-full">
                <div class="relative">
                    <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                    <input id="menuSearch"
                        type="text"
                        placeholder="Search for delicious food..."
                        class="w-full pl-12 pr-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-gray-500 focus:border-gray-200 transition-colors outline-none"
                        autocomplete="off">
                </div>
            </div>
            <div class="w-full lg:w-auto">
                <div class="relative">
                    <select id="sortSelect" class="w-full lg:w-64 px-4 py-3 pr-10 border border-gray-200 rounded-xl focus:ring-2 focus:ring-gray-500 focus:border-gray-200 transition-colors font-medium outline-none appearance-none bg-white">
                        <option value="">Sort by Pricing</option>
                        <option value="price-low">Price: Low to High</option>
                        <option value="price-high">Price: High to Low</option>
                        <option value="name">Name: A to Z</option>
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-400">
                        <i class="fas fa-chevron-down"></i>
                    </div>
                </div>
            </div>
        </div>
                    
        <!-- Filter Section -->
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Categories</h2>
        <div class="flex flex-wrap gap-6 mb-8">
            <div class="flex flex-col items-center">
                <button class="category-filter w-20 h-20 rounded-lg bg-gray-200 overflow-hidden mb-2 transition-all active-category" data-category="all">
                    <img src="https://i.pinimg.com/1200x/c4/40/0f/c4400f1f2c8441cb7c6eea6844a79135.jpg" alt="All Items" class="w-full h-full object-cover transition-transform">
                </button>
                <span class="text-sm font-medium text-gray-700">All Items</span>
            </div>
            
            @foreach (var category in Model.Categories)
            {
                <div class="flex flex-col items-center">
                    <button class="category-filter w-20 h-20 rounded-lg bg-gray-200 overflow-hidden mb-2 transition-all"
                            data-category="@category.CategoryID">
                        <img src="https://i.pinimg.com/1200x/c4/40/0f/c4400f1f2c8441cb7c6eea6844a79135.jpg" alt="@category.CategoryName" class="w-full h-full object-cover transition-transform">
                    </button>
                    <span class="text-sm font-medium text-gray-700">@category.CategoryName</span>
                </div>
            }
        </div>

        <!-- Products Section -->
        @if (Model.Products.Any() && Model.Categories.Any())
        {
            <div class="space-y-8">
                @foreach (var category in Model.Categories)
                {
                    var productsInCategory = Model.Products.Where(p => p.CategoryID == category.CategoryID).ToList();
                    
                    if (productsInCategory.Any())
                    {
                        <div id="category-@category.CategoryID" class="category-section">
                            <!-- Category Header -->
                            <div class="mb-4">
                                <h3 class="text-xl font-bold text-gray-900">@category.CategoryName</h3>
                                <p class="text-gray-600">Discover our delicious @category.CategoryName offerings</p>
                            </div>
                            
                            <!-- Products Grid -->
                            <div class="products-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8" data-category="@category.CategoryID">
                                @foreach (var product in productsInCategory)
                                {
                                    <div class="product-card bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow"
                                         data-product-name="@product.ProductName.ToLower()"
                                         data-product-description="@product.ProductDescription.ToLower()"
                                         data-product-price="@product.ProductPrice"
                                         data-product-id="@product.ProductID"
                                         data-category="@product.CategoryID">
                                        <!-- Product Image -->
                                        <div class="h-40 bg-gray-100 overflow-hidden relative">
                                            @if (!string.IsNullOrEmpty(product.ProductImage))
                                            {
                                                <img src="@product.ProductImage"
                                                    alt="@product.ProductName"
                                                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
                                            }
                                            else
                                            {
                                                <div class="flex items-center justify-center h-full">
                                                    <i class="fas fa-image text-gray-300 text-3xl"></i>
                                                </div>
                                            }
                                        </div>

                                        <div class="p-3">
                                            <div class="flex items-center justify-between mb-2">
                                                <h3 class="product-name font-bold text-lg text-gray-900 line-clamp-1">
                                                    @product.ProductName
                                                </h3>
                                                <div class="bg-white/95 backdrop-blur-sm px-2 py-1 rounded-full flex items-center gap-1">
                                                    <i class="fas fa-star text-yellow-400 text-xs"></i>
                                                    <span class="text-xs font-semibold text-gray-700">4.8</span>
                                                </div>
                                            </div>
                                            <p class="product-description text-gray-600 text-sm mb-2 line-clamp-2 leading-snug">
                                                @(product.ProductDescription?.Length > 80 ? product.ProductDescription.Substring(0, 77) + "..." : product.ProductDescription)
                                            </p>

                                            <div class="flex items-center text-gray-500 text-sm mb-2">
                                                <i class="fas fa-clock mr-1"></i>
                                                <span>25-30 min</span>
                                            </div>

                                            <div class="flex items-center justify-between">
                                                <span class="text-lg font-bold text-green-600 product-price">₱@product.ProductPrice.ToString("0.00")</span>
                                                <a asp-action="ProductToCart" asp-controller="Home" asp-area="Customer"
                                                asp-route-productID="@product.ProductID"
                                                class="bg-green-500 text-white px-3 py-2 rounded-md font-semibold hover:bg-green-600 transition-colors flex items-center gap-1">
                                                    <i class="fas fa-cart-plus text-sm"></i>
                                                    <span class="text-sm">Add</span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

<style>
    .line-clamp-1 {
        overflow: hidden;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 1;
    }
    
    .line-clamp-2 {
        overflow: hidden;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .product-card {
        transition: all 0.3s ease;
    }

    .product-card.hidden {
        display: none;
    }

    .category-section.hidden {
        display: none;
    }

    .fade-in {
        animation: fadeIn 0.3s ease-in;
    }

    .active-category {
        border: 3px solid #16a34a;
        box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.2);
    }

    .category-filter:hover {
        transform: scale(1.05);
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const categoryFilters = document.querySelectorAll('.category-filter');
        const categorySections = document.querySelectorAll('.category-section');
        const searchInput = document.getElementById('menuSearch');
        const sortSelect = document.getElementById('sortSelect');
        const productCards = document.querySelectorAll('.product-card');

        let currentCategory = 'all';
        let currentSort = '';

        // Category filter functionality
        categoryFilters.forEach(button => {
            button.addEventListener('click', function() {
                currentCategory = this.getAttribute('data-category');
                
                // Update active button styling
                categoryFilters.forEach(btn => {
                    btn.classList.remove('active-category');
                });
                this.classList.add('active-category');

                // Filter products by category
                filterProductsByCategory(currentCategory);
                
                // Apply current search and sort filters
                applySearchFilter();
                applySorting();
            });
        });

        // Search functionality
        if (searchInput) {
            searchInput.addEventListener('input', function(e) {
                applySearchFilter();
                applySorting();
            });
        }

        // Sort functionality
        if (sortSelect) {
            sortSelect.addEventListener('change', function() {
                currentSort = this.value;
                applySorting();
            });
        }

        function filterProductsByCategory(categoryId) {
            // Show/hide products based on category
            productCards.forEach(card => {
                const productCategory = card.getAttribute('data-category');
                
                if (categoryId === 'all' || productCategory === categoryId) {
                    card.classList.remove('hidden');
                    card.classList.add('fade-in');
                } else {
                    card.classList.add('hidden');
                }
            });

            // Show/hide category sections
            categorySections.forEach(section => {
                const sectionCategory = section.id.replace('category-', '');
                const visibleProductsInSection = section.querySelectorAll('.product-card:not(.hidden)');
                
                if (categoryId === 'all' || sectionCategory === categoryId) {
                    if (visibleProductsInSection.length > 0) {
                        section.classList.remove('hidden');
                    } else {
                        section.classList.add('hidden');
                    }
                } else {
                    section.classList.add('hidden');
                }
            });
        }

        function applySearchFilter() {
            const searchTerm = searchInput.value.toLowerCase().trim();
            
            if (searchTerm === '') {
                // If no search term, just apply category filter
                filterProductsByCategory(currentCategory);
                return;
            }

            // Apply search filter within current category
            productCards.forEach(card => {
                const productName = card.getAttribute('data-product-name');
                const productDescription = card.getAttribute('data-product-description');
                const productCategory = card.getAttribute('data-category');
                
                const matchesSearch = productName.includes(searchTerm) || productDescription.includes(searchTerm);
                const matchesCategory = currentCategory === 'all' || productCategory === currentCategory;
                
                if (matchesSearch && matchesCategory) {
                    card.classList.remove('hidden');
                    card.classList.add('fade-in');
                } else {
                    card.classList.add('hidden');
                }
            });

            // Update category sections visibility
            categorySections.forEach(section => {
                const visibleProductsInSection = section.querySelectorAll('.product-card:not(.hidden)');
                const sectionCategory = section.id.replace('category-', '');
                
                const shouldShowSection = (currentCategory === 'all' || sectionCategory === currentCategory) && 
                                       visibleProductsInSection.length > 0;
                
                if (shouldShowSection) {
                    section.classList.remove('hidden');
                } else {
                    section.classList.add('hidden');
                }
            });
        }

        function applySorting() {
            if (!currentSort) return;

            const productGrids = document.querySelectorAll('.products-grid');
            
            productGrids.forEach(grid => {
                const visibleProducts = Array.from(grid.querySelectorAll('.product-card:not(.hidden)'));
                
                if (visibleProducts.length === 0) return;

                visibleProducts.sort((a, b) => {
                    const priceA = parseFloat(a.getAttribute('data-product-price'));
                    const priceB = parseFloat(b.getAttribute('data-product-price'));
                    const nameA = a.getAttribute('data-product-name');
                    const nameB = b.getAttribute('data-product-name');
                    
                    switch (currentSort) {
                        case 'price-low':
                            return priceA - priceB;
                        case 'price-high':
                            return priceB - priceA;
                        case 'name':
                            return nameA.localeCompare(nameB);
                        default:
                            return 0;
                    }
                });

                // Reorder products in the grid with animation
                visibleProducts.forEach((product, index) => {
                    setTimeout(() => {
                        grid.appendChild(product);
                        product.classList.add('fade-in');
                    }, index * 50);
                });
            });
        }

        // Filter button hover effects
        categoryFilters.forEach(button => {
            button.addEventListener('mouseenter', function() {
                if (!this.classList.contains('active-category')) {
                    this.style.transform = 'scale(1.05)';
                    const img = this.querySelector('img');
                    if (img) img.style.transform = 'scale(1.1)';
                }
            });
            
            button.addEventListener('mouseleave', function() {
                if (!this.classList.contains('active-category')) {
                    this.style.transform = 'scale(1)';
                    const img = this.querySelector('img');
                    if (img) img.style.transform = 'scale(1)';
                }
            });
        });

        // Initialize with "All Items" selected
        filterProductsByCategory('all');
    });
</script>
}