@model ASI.Basecode.WebApp.Areas.Customer.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout - LaAlliance";
    var subtotal = Model.Cart?.CartItems?.Sum(item => item.Quantity * (item.UnitPrice + (item.Options?.Sum(opt => opt.AdditionalPrice) ?? 0))) ?? 0;
    var deliveryFee = Model.OrderType == "Pickup" ? 0.00m : 50.00m;
    var total = subtotal + deliveryFee;
    var defaultAddress = Model.Addresses?.FirstOrDefault(a => a.IsDefault);
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Review and Place Your Order</h1>
            <p class="text-gray-600">Complete your purchase with confidence</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 p-4 bg-red-100 border border-red-200 text-red-800 rounded-xl flex items-center gap-3 animate-fade-in">
                <i class="fas fa-exclamation-triangle text-red-600"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        <form asp-action="PlaceOrder" method="post" class="grid grid-cols-1 lg:grid-cols-3 gap-8" id="checkoutForm">
            @Html.AntiForgeryToken()

            <!-- Left Column: Order Type, Delivery Address and Personal Details -->
            <div class="lg:col-span-2 space-y-6">
                
                <!-- Section 0: Order Type Selection -->
                <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
                    <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-shopping-bag text-green-600"></i>
                        Order Type
                    </h2>
                    <div class="grid grid-cols-2 gap-4">
                        <label class="relative cursor-pointer">
                            <input type="radio" name="OrderType" value="Delivery" class="peer sr-only" checked />
                            <div class="p-4 border-2 border-gray-200 rounded-xl peer-checked:border-green-600 peer-checked:bg-green-50 transition-all hover:border-green-300">
                                <div class="flex flex-col items-center gap-2">
                                    <i class="fas fa-truck text-3xl text-gray-400 peer-checked:text-green-600"></i>
                                    <span class="font-semibold text-gray-700">Delivery</span>
                                    <span class="text-xs text-gray-500">We deliver to your door</span>
                                </div>
                            </div>
                        </label>
                        <label class="relative cursor-pointer">
                            <input type="radio" name="OrderType" value="Pickup" class="peer sr-only" />
                            <div class="p-4 border-2 border-gray-200 rounded-xl peer-checked:border-green-600 peer-checked:bg-green-50 transition-all hover:border-green-300">
                                <div class="flex flex-col items-center gap-2">
                                    <i class="fas fa-store text-3xl text-gray-400 peer-checked:text-green-600"></i>
                                    <span class="font-semibold text-gray-700">Pickup</span>
                                    <span class="text-xs text-gray-500">Pick up at our store</span>
                                </div>
                            </div>
                        </label>
                    </div>
                    <span asp-validation-for="OrderType" class="text-red-500 text-sm mt-2"></span>
                </div>

                <!-- Section 1: Delivery Address (Hidden for Pickup) -->
                <div id="deliveryAddressSection" class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
                    <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-map-marker-alt text-green-600"></i>
                        Delivery Address
                    </h2>
                    
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <!-- Address Form -->
                        <div class="space-y-4">
                            <!-- Address Display (when not editing) -->
                            <div id="addressDisplay" class="space-y-3">
                                <div class="bg-gradient-to-r from-green-50 to-teal-50 border-2 border-green-200 rounded-xl p-4">
                                    <div class="flex items-start gap-3">
                                        <div class="w-10 h-10 bg-green-600 rounded-lg flex items-center justify-center flex-shrink-0">
                                            <i class="fas fa-map-pin text-white"></i>
                                        </div>
                                        <div class="flex-1">
                                            <h3 class="font-semibold text-gray-900 mb-2">Current Address</h3>
                                            <p class="text-sm text-gray-700" id="displayFullAddress">
                                                @if (defaultAddress != null)
                                                {
                                                    <span>@defaultAddress.Street, @defaultAddress.Barangay, @defaultAddress.City, @defaultAddress.Province @defaultAddress.ZipCode</span>
                                                }
                                                else
                                                {
                                                    <span class="text-gray-500">No address saved</span>
                                                }
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <button type="button" 
                                        id="editAddressBtn"
                                        class="w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-4 py-3 rounded-xl font-semibold transition-all flex items-center justify-center gap-2 shadow-md hover:shadow-lg">
                                    <i class="fas fa-edit"></i>
                                    <span>Edit Address Details</span>
                                </button>
                            </div>

                            <!-- Address Edit Form (hidden by default) -->
                            <div id="addressEditForm" class="hidden space-y-4">
                                <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-4">
                                    <p class="text-sm text-blue-800 flex items-center gap-2">
                                        <i class="fas fa-info-circle"></i>
                                        <span>Fill in your address details and use the map to pinpoint your exact location</span>
                                    </p>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Street Address <span class="text-red-500">*</span></label>
                                    <input asp-for="Street" 
                                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors" 
                                           placeholder="House/Unit No., Building, Street Name"
                                           value="@defaultAddress?.Street" />
                                    <span asp-validation-for="Street" class="text-red-500 text-sm mt-1"></span>
                                </div>
                                
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Barangay <span class="text-red-500">*</span></label>
                                        <input asp-for="Barangay" 
                                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors" 
                                               placeholder="Barangay"
                                               value="@defaultAddress?.Barangay" />
                                        <span asp-validation-for="Barangay" class="text-red-500 text-sm mt-1"></span>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">City <span class="text-red-500">*</span></label>
                                        <input asp-for="City" 
                                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors" 
                                               placeholder="City"
                                               value="@defaultAddress?.City" />
                                        <span asp-validation-for="City" class="text-red-500 text-sm mt-1"></span>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Province <span class="text-red-500">*</span></label>
                                        <input asp-for="Province" 
                                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors" 
                                               placeholder="Province"
                                               value="@defaultAddress?.Province" />
                                        <span asp-validation-for="Province" class="text-red-500 text-sm mt-1"></span>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Zip Code <span class="text-red-500">*</span></label>
                                        <input asp-for="ZipCode" 
                                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors" 
                                               placeholder="Postal Code"
                                               pattern="[0-9]{4}"
                                               value="@defaultAddress?.ZipCode" />
                                        <span asp-validation-for="ZipCode" class="text-red-500 text-sm mt-1"></span>
                                    </div>
                                </div>
                                
                                <!-- Map Controls -->
                                <div class="space-y-3">
                                    <div class="grid grid-cols-2 gap-3">
                                        <button type="button" 
                                                id="currentLocationBtn"
                                                class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-lg font-semibold text-sm transition-all flex items-center justify-center gap-2">
                                            <i class="fas fa-location-crosshairs"></i>
                                            <span>Current Location</span>
                                        </button>
                                        <button type="button" 
                                                id="searchAddressBtn"
                                                class="bg-teal-600 hover:bg-teal-700 text-white px-4 py-2.5 rounded-lg font-semibold text-sm transition-all flex items-center justify-center gap-2">
                                            <i class="fas fa-search"></i>
                                            <span>Search on Map</span>
                                        </button>
                                    </div>
                                    
                                    <button type="button" 
                                            id="saveAddressBtn"
                                            class="w-full bg-green-600 hover:bg-green-700 text-white px-4 py-3 rounded-lg font-semibold transition-all flex items-center justify-center gap-2">
                                        <i class="fas fa-check"></i>
                                        <span>Save Address</span>
                                    </button>
                                </div>
                                
                                <!-- Hidden coordinates fields -->
                                <input type="hidden" asp-for="Latitude" id="latitudeInput" value="@defaultAddress?.Latitude" />
                                <input type="hidden" asp-for="Longitude" id="longitudeInput" value="@defaultAddress?.Longitude" />
                            </div>
                        </div>
                        
                        <!-- Interactive Map -->
                        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden h-fit">
                            <!-- Map Header -->
                            <div class="bg-gradient-to-r from-blue-600 to-blue-700 p-4">
                                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                    <i class="fas fa-map"></i>
                                    Pin Your Location
                                </h3>
                                <p class="text-blue-100 text-sm mt-1">Drag the marker to adjust</p>
                            </div>

                            <!-- Map Container -->
                            <div class="relative">
                                <div id="addressMap" class="w-full h-[300px] lg:h-[350px]"></div>
                            </div>

                            <!-- Map Instructions -->
                            <div class="p-4 bg-gray-50 border-t border-gray-200">
                                <!-- Coordinates Display -->
                                <div class="mt-3 pt-3 border-t border-gray-200">
                                    <div class="flex items-center justify-center gap-4 text-xs text-gray-600">
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-location-dot text-blue-600"></i>
                                            <span class="font-semibold">Lat:</span>
                                            <span id="displayLat" class="font-mono">@(defaultAddress?.Latitude.ToString("F6") ?? "10.315700")</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-location-dot text-teal-600"></i>
                                            <span class="font-semibold">Lng:</span>
                                            <span id="displayLng" class="font-mono">@(defaultAddress?.Longitude.ToString("F6") ?? "123.885400")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Personal Details -->
                <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
                    <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-user text-green-600"></i>
                        Personal Details
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                            <input asp-for="FullName" 
                                   class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors" 
                                   value="@Model.FullName" />
                            <span asp-validation-for="FullName" class="text-red-500 text-sm mt-1"></span>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Contact Number</label>
                            <input asp-for="ContactNumber" 
                                   class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors" 
                                   value="@Model.ContactNumber" />
                            <span asp-validation-for="ContactNumber" class="text-red-500 text-sm mt-1"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Payment Method -->
                <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-credit-card text-green-600"></i>
                        Payment Method
                    </h2>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-gray-700 font-medium">Select Payment Method</label>
                            <div class="space-y-2">
                                <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:border-green-500 transition-colors cursor-pointer">
                                    <input type="radio" name="PaymentMethod" value="Cash" class="radio-input" />
                                    <span>Cash on Delivery</span>
                                </label>
                                <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:border-green-500 transition-colors cursor-pointer">
                                    <input type="radio" name="PaymentMethod" value="GCash" class="radio-input" />
                                    <span>GCash</span>
                                </label>
                                <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:border-green-500 transition-colors cursor-pointer">
                                    <input type="radio" name="PaymentMethod" value="Card" class="radio-input" />
                                    <span>Credit/Debit Card</span>
                                </label>
                            </div>
                            <span asp-validation-for="PaymentMethod" class="text-red-500 text-sm"></span>
                        </div>
                        
                        <!-- GCash Number Field -->
                        <div id="gcashFields" class="hidden space-y-4">
                            <div>
                                <label class="block text-gray-700 font-medium">GCash Number</label>
                                <input type="text" 
                                    name="GcashNumber" 
                                    id="gcashNumberInput"
                                    maxlength="11"
                                    class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 transition-colors"
                                    placeholder="09XXXXXXXXX" 
                                    autocomplete="off" 
                                    inputmode="numeric" />
                                <span class="text-xs text-gray-500 mt-1">Enter 11-digit mobile number (09XXXXXXXXX)</span>
                                <span id="gcashError" class="text-red-500 text-xs hidden">Please enter exactly 11 digits</span>
                            </div>
                        </div>
                        
                        <!-- Card Payment Fields -->
                        <div id="cardFields" class="hidden space-y-4">
                            <!-- Card Number -->
                            <div>
                                <label class="block text-gray-700 font-medium">Card Number</label>
                                <input type="text" 
                                    name="CardNumber" 
                                    id="cardNumberInput"
                                    maxlength="19"
                                    class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 transition-colors" 
                                    placeholder="1234 5678 9012 3456" 
                                    autocomplete="cc-number"
                                    inputmode="numeric" />
                                <span class="text-xs text-gray-500 mt-1">Enter 16-digit card number</span>
                                <span id="cardNumberError" class="text-red-500 text-xs hidden">Please enter exactly 16 digits</span>
                            </div>
                            
                            <div class="grid grid-cols-2 gap-4">
                                <!-- Expiry Date -->
                                <div>
                                    <label class="block text-gray-700 font-medium">Expiry Date</label>
                                    <input type="text" 
                                        name="CardExpiry" 
                                        id="cardExpiryInput"
                                        maxlength="5"
                                        class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 transition-colors" 
                                        placeholder="MM/YY" 
                                        autocomplete="cc-exp"
                                        inputmode="numeric" />
                                    <span class="text-xs text-gray-500 mt-1">MM/YY format</span>
                                    <span id="expiryError" class="text-red-500 text-xs hidden">Please enter valid expiry date</span>
                                </div>
                                
                                <!-- CVV -->
                                <div>
                                    <label class="block text-gray-700 font-medium">CVV</label>
                                    <input type="text" 
                                        name="CardCVV" 
                                        id="cardCvvInput"
                                        maxlength="3"
                                        class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 transition-colors" 
                                        placeholder="123" 
                                        autocomplete="cc-csc"
                                        inputmode="numeric" />
                                    <span class="text-xs text-gray-500 mt-1">3-digit security code</span>
                                    <span id="cvvError" class="text-red-500 text-xs hidden">Please enter exactly 3 digits</span>
                                </div>
                            </div>
                            
                            <!-- Cardholder Name -->
                            <div>
                                <label class="block text-gray-700 font-medium">Cardholder Name</label>
                                <input type="text" 
                                    name="CardholderName" 
                                    id="cardholderNameInput"
                                    class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 transition-colors" 
                                    placeholder="John Doe" 
                                    autocomplete="cc-name" />
                                <span class="text-xs text-gray-500 mt-1">Name as it appears on card</span>
                                <span id="nameError" class="text-red-500 text-xs hidden">Please enter cardholder name</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div> 

            <!-- Right Column: Order Summary -->
            <div class="lg:col-span-1">
                <!-- Order Summary -->
                <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6 sticky top-6">
                    <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-receipt text-green-600"></i>
                        Order Summary
                    </h2>
                    
                    <!-- Order Type Badge -->
                    <div class="mb-4 p-3 bg-gradient-to-r from-green-50 to-teal-50 border border-green-200 rounded-xl">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium text-gray-700">Order Type:</span>
                            <span class="font-bold text-green-700" id="orderTypeBadge">Delivery</span>
                        </div>
                    </div>

                    <!-- Shipping Address (for Delivery only) -->
                    <div id="shippingAddressDisplay" class="mb-4 p-3 bg-gray-50 border border-gray-200 rounded-xl">
                        <h3 class="text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
                            <i class="fas fa-map-marker-alt text-green-600"></i>
                            Shipping Address
                        </h3>
                        <p class="text-xs text-gray-600" id="summaryAddress">
                            @if (defaultAddress != null)
                            {
                                <span>@defaultAddress.Street, @defaultAddress.Barangay, @defaultAddress.City, @defaultAddress.Province @defaultAddress.ZipCode</span>
                            }
                            else
                            {
                                <span class="text-gray-400">Please enter your address</span>
                            }
                        </p>
                    </div>
                    
                    <!-- Order Items -->
                    <div class="space-y-4 mb-6 max-h-96 overflow-y-auto [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
                        @if (Model.Cart?.CartItems != null && Model.Cart.CartItems.Any())
                        {
                            foreach (var item in Model.Cart.CartItems)
                            {
                                var itemAddOnsTotal = item.Options?.Sum(opt => opt.AdditionalPrice) ?? 0m;
                                var itemTotalPrice = item.Quantity * (item.UnitPrice + itemAddOnsTotal);
                                
                                <div class="flex gap-3 py-3 border-b border-gray-100 last:border-b-0">
                                    <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0">
                                        <span class="text-green-600 font-bold text-sm">@item.Quantity</span>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h4 class="font-semibold text-gray-900 text-sm">@item.ProductName</h4>
                                        @if (item.Options != null && item.Options.Any())
                                        {
                                            <div class="mt-1 text-xs text-gray-600">
                                                @foreach (var opt in item.Options)
                                                {
                                                    <div>
                                                        + @opt.OptionName
                                                        @if (opt.AdditionalPrice > 0)
                                                        {
                                                            <span class="text-green-600">(+₱@opt.AdditionalPrice.ToString("F2"))</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="text-right">
                                        <p class="font-semibold text-gray-900 text-sm">₱@itemTotalPrice.ToString("F2")</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-gray-500 text-center py-4">Your cart is empty</p>
                        }
                    </div>

                    <!-- Order Totals -->
                    <div class="space-y-3 pt-4 border-t border-gray-200">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">Subtotal</span>
                            <span class="text-gray-900">₱@subtotal.ToString("F2")</span>
                        </div>
                        <div class="flex justify-between text-sm" id="deliveryFeeRow">
                            <span class="text-gray-600">Delivery Fee</span>
                            <span class="text-gray-900" id="deliveryFeeAmount">₱@deliveryFee.ToString("F2")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.VoucherCode))
                        {
                            <div class="flex justify-between text-sm text-green-600">
                                <span>Voucher Discount</span>
                                <span>-₱0.00</span>
                            </div>
                        }
                        <div class="flex justify-between text-lg font-bold pt-3 border-t border-gray-200">
                            <span class="text-gray-900">Total Amount</span>
                            <span class="text-green-600" id="totalAmount">₱@total.ToString("F2")</span>
                        </div>
                    </div>

                    <!-- Place Order Button -->
                    <button type="submit" 
                            class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-4 px-6 rounded-xl transition-colors flex items-center justify-center gap-2 mt-6 shadow-lg shadow-green-200">
                        <span>Place Order</span>
                    </button>

                    <!-- Security Badge -->
                    <div class="text-center mt-4">
                        <p class="text-xs text-gray-500 flex items-center justify-center gap-1">
                            <i class="fas fa-shield-alt text-green-500"></i>
                            Your payment information is secure and encrypted
                        </p>
                    </div>
                </div>
            </div> <!-- Close right column (lg:col-span-1) -->
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey"></script>
    <script src="~/js/maps.js"></script>
    <script>
        // Global variables
        let isEditingAddress = false;
        const subtotal = @subtotal;

        // Order Type Toggle Handler
        document.addEventListener('DOMContentLoaded', function() {
            const orderTypeRadios = document.querySelectorAll('input[name="OrderType"]');
            const deliveryAddressSection = document.getElementById('deliveryAddressSection');
            const shippingAddressDisplay = document.getElementById('shippingAddressDisplay');
            const deliveryFeeRow = document.getElementById('deliveryFeeRow');
            const deliveryFeeAmount = document.getElementById('deliveryFeeAmount');
            const totalAmount = document.getElementById('totalAmount');
            const orderTypeBadge = document.getElementById('orderTypeBadge');

            function updateOrderType() {
                const selectedType = document.querySelector('input[name="OrderType"]:checked').value;
                orderTypeBadge.textContent = selectedType;

                if (selectedType === 'Pickup') {
                    deliveryAddressSection.classList.add('hidden');
                    shippingAddressDisplay.classList.add('hidden');
                    deliveryFeeAmount.textContent = '₱0.00';
                    const newTotal = subtotal;
                    totalAmount.textContent = '₱' + newTotal.toFixed(2);
                } else {
                    deliveryAddressSection.classList.remove('hidden');
                    shippingAddressDisplay.classList.remove('hidden');
                    deliveryFeeAmount.textContent = '₱50.00';
                    const newTotal = subtotal + 50;
                    totalAmount.textContent = '₱' + newTotal.toFixed(2);
                }
            }

            orderTypeRadios.forEach(radio => {
                radio.addEventListener('change', updateOrderType);
            });

            // Initialize on page load
            updateOrderType();
        });

        // Address Edit/Save Handler
        document.getElementById('editAddressBtn').addEventListener('click', function() {
            const addressDisplay = document.getElementById('addressDisplay');
            const addressEditForm = document.getElementById('addressEditForm');
            
            addressDisplay.classList.add('hidden');
            addressEditForm.classList.remove('hidden');
            isEditingAddress = true;

            // Clear the input fields to allow new address entry
            document.querySelector('input[name="Street"]').value = '';
            document.querySelector('input[name="Barangay"]').value = '';
            document.querySelector('input[name="City"]').value = '';
            document.querySelector('input[name="Province"]').value = '';
            document.querySelector('input[name="ZipCode"]').value = '';
        });

        document.getElementById('saveAddressBtn').addEventListener('click', function() {
            const street = document.querySelector('input[name="Street"]').value.trim();
            const barangay = document.querySelector('input[name="Barangay"]').value.trim();
            const city = document.querySelector('input[name="City"]').value.trim();
            const province = document.querySelector('input[name="Province"]').value.trim();
            const zipCode = document.querySelector('input[name="ZipCode"]').value.trim();

            if (!street || !barangay || !city || !province || !zipCode) {
                alert('Please fill in all address fields');
                return;
            }

            // Update display
            const fullAddress = `${street}, ${barangay}, ${city}, ${province} ${zipCode}`;
            document.getElementById('displayFullAddress').textContent = fullAddress;
            document.getElementById('summaryAddress').textContent = fullAddress;

            // Toggle back to display mode
            document.getElementById('addressDisplay').classList.remove('hidden');
            document.getElementById('addressEditForm').classList.add('hidden');
            isEditingAddress = false;
        });

        // Payment method toggle and validation
        const paymentMethods = document.querySelectorAll('input[name="PaymentMethod"]');
        const gcashFields = document.getElementById('gcashFields');
        const cardFields = document.getElementById('cardFields');

        function togglePaymentFields() {
            const selectedMethod = document.querySelector('input[name="PaymentMethod"]:checked');
            
            gcashFields.classList.add('hidden');
            cardFields.classList.add('hidden');
            
            if (selectedMethod && selectedMethod.value === 'GCash') {
                gcashFields.classList.remove('hidden');
            } else if (selectedMethod && selectedMethod.value === 'Card') {
                cardFields.classList.remove('hidden');
            }
        }

        paymentMethods.forEach(method => {
            method.addEventListener('change', togglePaymentFields);
        });

        // GCash Input Validation
        const gcashInput = document.getElementById('gcashNumberInput');
        if (gcashInput) {
            gcashInput.addEventListener('input', function(e) {
                this.value = this.value.replace(/\D/g, '');
                if (this.value.length > 11) {
                    this.value = this.value.slice(0, 11);
                }
                const errorElement = document.getElementById('gcashError');
                if (this.value.length > 0 && this.value.length !== 11) {
                    errorElement.classList.remove('hidden');
                } else {
                    errorElement.classList.add('hidden');
                }
            });
        }

        // Card Number Validation
        const cardNumberInput = document.getElementById('cardNumberInput');
        if (cardNumberInput) {
            cardNumberInput.addEventListener('input', function(e) {
                let value = this.value.replace(/\D/g, '');
                if (value.length > 16) {
                    value = value.slice(0, 16);
                }
                let formattedValue = '';
                for (let i = 0; i < value.length; i++) {
                    if (i > 0 && i % 4 === 0) {
                        formattedValue += ' ';
                    }
                    formattedValue += value[i];
                }
                this.value = formattedValue;
                const errorElement = document.getElementById('cardNumberError');
                const digitCount = value.length;
                if (digitCount > 0 && digitCount !== 16) {
                    errorElement.classList.remove('hidden');
                } else {
                    errorElement.classList.add('hidden');
                }
            });
        }

        // Expiry Date Validation
        const expiryInput = document.getElementById('cardExpiryInput');
        if (expiryInput) {
            expiryInput.addEventListener('input', function(e) {
                let value = this.value.replace(/\D/g, '');
                if (value.length > 4) {
                    value = value.slice(0, 4);
                }
                if (value.length >= 2) {
                    value = value.slice(0, 2) + '/' + value.slice(2);
                }
                this.value = value;
                const errorElement = document.getElementById('expiryError');
                const digitCount = value.replace(/\D/g, '').length;
                if (digitCount > 0 && digitCount !== 4) {
                    errorElement.classList.remove('hidden');
                } else {
                    errorElement.classList.add('hidden');
                }
                if (digitCount >= 2) {
                    const month = parseInt(value.slice(0, 2));
                    if (month < 1 || month > 12) {
                        errorElement.textContent = 'Month must be between 01-12';
                        errorElement.classList.remove('hidden');
                    } else {
                        errorElement.textContent = 'Please enter valid expiry date';
                    }
                }
            });
        }

        // CVV Validation
        const cvvInput = document.getElementById('cardCvvInput');
        if (cvvInput) {
            cvvInput.addEventListener('input', function(e) {
                this.value = this.value.replace(/\D/g, '');
                if (this.value.length > 3) {
                    this.value = this.value.slice(0, 3);
                }
                const errorElement = document.getElementById('cvvError');
                if (this.value.length > 0 && this.value.length !== 3) {
                    errorElement.classList.remove('hidden');
                } else {
                    errorElement.classList.add('hidden');
                }
            });
        }

        // Cardholder Name Validation
        const nameInput = document.getElementById('cardholderNameInput');
        if (nameInput) {
            nameInput.addEventListener('input', function(e) {
                this.value = this.value.replace(/[^a-zA-Z\s\-']/g, '');
                const errorElement = document.getElementById('nameError');
                if (this.value.length === 0) {
                    errorElement.classList.remove('hidden');
                } else {
                    errorElement.classList.add('hidden');
                }
            });
        }

        // Search Address Button
        function setupSearchButton() {
            const searchBtn = document.getElementById('searchAddressBtn');
            if (searchBtn) {
                searchBtn.addEventListener('click', function() {
                    const streetInput = document.querySelector('input[name="Street"]');
                    const barangayInput = document.querySelector('input[name="Barangay"]');
                    const cityInput = document.querySelector('input[name="City"]');
                    const provinceInput = document.querySelector('input[name="Province"]');
                    
                    const street = streetInput ? streetInput.value.trim() : '';
                    const barangay = barangayInput ? barangayInput.value.trim() : '';
                    const city = cityInput ? cityInput.value.trim() : '';
                    const province = provinceInput ? provinceInput.value.trim() : '';
                    
                    if (!street && !city && !barangay) {
                        alert('Please fill in at least Street, Barangay, or City fields to search.');
                        return;
                    }

                    const addressParts = [street, barangay, city, province, 'Philippines'].filter(part => part);
                    const address = addressParts.join(', ');
                    
                    const originalHTML = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Searching...';
                    this.disabled = true;

                    if (typeof geocoder !== 'undefined') {
                        geocoder.geocode({ address: address }, (results, status) => {
                            if (status === 'OK' && results[0]) {
                                const location = results[0].geometry.location;
                                if (typeof map !== 'undefined' && typeof placeMarker === 'function') {
                                    map.setCenter(location);
                                    map.setZoom(17);
                                    placeMarker(location);
                                }
                                this.innerHTML = '<i class="fas fa-check"></i> Found!';
                            } else {
                                alert('Address not found on map. Please click on the map to set location manually.');
                                this.innerHTML = '<i class="fas fa-times"></i> Not Found';
                            }
                            setTimeout(() => {
                                this.innerHTML = originalHTML;
                                this.disabled = false;
                            }, 2000);
                        });
                    } else {
                        alert('Map is not ready yet. Please try again in a moment.');
                        this.innerHTML = originalHTML;
                        this.disabled = false;
                    }
                });
            }
        }

        // Initialize search button
        setTimeout(function() {
            setupSearchButton();
        }, 500);
    </script>
}