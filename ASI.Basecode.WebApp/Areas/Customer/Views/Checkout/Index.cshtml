@model ASI.Basecode.WebApp.Areas.Customer.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout - LaAlliance";
    var subtotal = Model.Cart?.CartItems?.Sum(item => item.Quantity * (item.UnitPrice + (item.CartItemOptions?.Sum(opt => opt.AdditionalPrice) ?? 0))) ?? 0;
    var deliveryFee = Model.OrderType == "Pickup" ? 0.00m : 50.00m;
    var total = subtotal + deliveryFee;
    var defaultAddress = Model.Addresses?.FirstOrDefault(a => a.IsDefault);
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Review and Place Your Order</h1>
            <p class="text-gray-600">Complete your purchase with confidence</p>
        </div>

        <form asp-action="PlaceOrder" method="post" class="grid grid-cols-1 lg:grid-cols-3 gap-8" id="checkoutForm">
            @Html.AntiForgeryToken()

            <!-- Left Column: Order Type, Delivery Address and Personal Details -->
            <div class="lg:col-span-2 space-y-6">
                
                <!-- Section 0: Order Type Selection -->
                <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
                    <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-shopping-bag text-green-600"></i>
                        Order Type
                    </h2>
                    <div class="grid grid-cols-2 gap-4">
                        <label class="relative cursor-pointer">
                            <input type="radio" name="OrderType" value="Delivery" class="peer sr-only" checked />
                            <div class="p-4 border-2 border-gray-200 rounded-xl peer-checked:border-green-600 peer-checked:bg-green-50 transition-all hover:border-green-300">
                                <div class="flex flex-col items-center gap-2">
                                    <i class="fas fa-truck text-3xl text-gray-400 peer-checked:text-green-600"></i>
                                    <span class="font-semibold text-gray-700">Delivery</span>
                                    <span class="text-xs text-gray-500">We deliver to your door</span>
                                </div>
                            </div>
                        </label>
                        <label class="relative cursor-pointer">
                            <input type="radio" name="OrderType" value="Pickup" class="peer sr-only" />
                            <div class="p-4 border-2 border-gray-200 rounded-xl peer-checked:border-green-600 peer-checked:bg-green-50 transition-all hover:border-green-300">
                                <div class="flex flex-col items-center gap-2">
                                    <i class="fas fa-store text-3xl text-gray-400 peer-checked:text-green-600"></i>
                                    <span class="font-semibold text-gray-700">Pickup</span>
                                    <span class="text-xs text-gray-500">Pick up at our store</span>
                                </div>
                            </div>
                        </label>
                    </div>
                    <span asp-validation-for="OrderType" class="text-red-500 text-sm mt-2"></span>
                </div>

                <!-- Section 1: Delivery Address (Hidden for Pickup) -->
                <div id="deliveryAddressSection" class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
                    <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-map-marker-alt text-green-600"></i>
                        Delivery Address
                    </h2>
                    
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <!-- Address Form -->
                        <div class="space-y-4">
                        <!-- Address Display and Actions -->
                            <div id="addressDisplay" class="space-y-3">
                                <div class="grid-2 gap-3">
                                    <a asp-area="Customer" asp-action="AddressForm" asp-controller="Account" asp-route-returnUrl="@Url.Action("Index", "Checkout", new { area = "Customer" })" class="bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-4 py-3 rounded-xl font-semibold transition-all flex items-center justify-center gap-2 shadow-md hover:shadow-lg">
                                        <i class="fas fa-plus"></i>
                                        <span>Add New Address</span>
                                    </a>
                                </div>
                            </div>
                            <!-- Address Selection Options -->
                            <div id="addressSelection" class="space-y-3">
                                <h3 class="text-sm font-medium text-gray-700 mb-2">Choose Delivery Location:</h3>
                                @if (Model.Addresses != null && Model.Addresses.Any())
                                {
                                    foreach (var address in Model.Addresses)
                                    {
                                        <label class="relative cursor-pointer">
                                            <input type="radio" name="SelectedAddressId" value="@address.UserAddressID" 
                                                class="peer sr-only address-radio" 
                                                data-street="@address.Street"
                                                data-barangay="@address.Barangay"
                                                data-city="@address.City"
                                                data-province="@address.Province"
                                                data-zipcode="@address.ZipCode"
                                                data-latitude="@address.Latitude"
                                                data-longitude="@address.Longitude"
                                                @(address.IsDefault ? "checked" : "") />
                                            <div class="p-3 border-2 border-gray-200 rounded-xl peer-checked:border-green-600 peer-checked:bg-green-50 transition-all hover:border-green-300 mb-2">
                                                <div class="flex items-start gap-3">
                                                    <div class="w-5 h-5 border-2 border-gray-300 rounded-full peer-checked:border-green-600 peer-checked:bg-green-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                                                        <i class="fas fa-check text-white text-xs hidden peer-checked:block"></i>
                                                    </div>
                                                    <div class="flex-1">
                                                        <div class="flex items-center gap-2 mb-1">
                                                            <span class="font-semibold text-gray-900 text-sm">@address.AddressType</span>
                                                            @if (address.IsDefault)
                                                            {
                                                                <span class="bg-green-600 text-white text-xs px-2 py-0.5 rounded-full font-semibold">
                                                                    Default
                                                                </span>
                                                            }
                                                        </div>
                                                        <p class="text-xs text-gray-700">
                                                            @address.Street, @address.Barangay, @address.City
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </label>
                                    }
                                }
                            </div>
                        </div>
                        
                        <!-- Hidden coordinates fields -->
                        <input type="hidden" id="latitudeInput" value="@defaultAddress?.Latitude" />
                        <input type="hidden" id="longitudeInput" value="@defaultAddress?.Longitude" />

                        <!-- Interactive Map -->
                        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden h-fit">
                            <!-- Map Header -->
                            <div class="bg-gradient-to-r from-blue-600 to-blue-700 p-4">
                                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                    <i class="fas fa-map"></i>
                                    Delivery Location
                                </h3>
                                <p class="text-blue-100 text-sm mt-1" id="mapAddressText">
                                    @if (defaultAddress != null)
                                    {
                                        <span>@defaultAddress.Street, @defaultAddress.Barangay, @defaultAddress.City</span>
                                    }
                                    else
                                    {
                                        <span>Select an address to view location</span>
                                    }
                                </p>
                            </div>

                            <!-- Map Container -->
                            <div class="relative">
                                <div id="addressMap" class="w-full h-[300px] lg:h-[350px]"></div>
                            </div>

                            <!-- Map Instructions -->
                            <div class="p-4 bg-gray-50 border-t border-gray-200">
                                <!-- Coordinates Display -->
                                <div class="mt-3 pt-3 border-t border-gray-200">
                                    <div class="flex items-center justify-center gap-4 text-xs text-gray-600">
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-location-dot text-blue-600"></i>
                                            <span class="font-semibold">Lat:</span>
                                            <span id="displayLat" class="font-mono">@(defaultAddress?.Latitude.ToString("F6") ?? "10.315700")</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-location-dot text-teal-600"></i>
                                            <span class="font-semibold">Lng:</span>
                                            <span id="displayLng" class="font-mono">@(defaultAddress?.Longitude.ToString("F6") ?? "123.885400")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Personal Details -->
                <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6">
                    <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-truck text-green-600"></i>
                        Delivery Notes
                    </h2>
                    <div>
                        <div>
                            <input asp-for="DeliveryNotes" type="text" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors" />
                        </div>
                    </div>
                </div>

                <!-- Section 3: Payment Method -->
                <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-credit-card text-green-600"></i>
                        Payment Method
                    </h2>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-gray-700 font-medium">Select Payment Method</label>
                            <div class="space-y-2">
                                <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:border-green-500 transition-colors cursor-pointer">
                                    <input type="radio" name="PaymentMethod" value="CashOnDelivery" class="radio-input" />
                                    <span>Cash on Delivery</span>
                                </label>
                                <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:border-green-500 transition-colors cursor-pointer">
                                    <input type="radio" name="PaymentMethod" value="GCash" class="radio-input" />
                                    <span>GCash</span>
                                </label>
                                <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg hover:border-green-500 transition-colors cursor-pointer">
                                    <input type="radio" name="PaymentMethod" value="Card" class="radio-input" />
                                    <span>Credit/Debit Card</span>
                                </label>
                            </div>
                            <span asp-validation-for="PaymentMethod" class="text-red-500 text-sm"></span>
                        </div>
                        
                        <!-- GCash Number Field -->
                        <div id="gcashFields" class="hidden space-y-4">
                            <div>
                                <label class="block text-gray-700 font-medium">GCash Number</label>
                                <input type="text" 
                                    name="GcashNumber" 
                                    id="gcashNumberInput"
                                    maxlength="11"
                                    class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 transition-colors"
                                    placeholder="09XXXXXXXXX" 
                                    autocomplete="off" 
                                    inputmode="numeric" />
                                <span class="text-xs text-gray-500 mt-1">Enter 11-digit mobile number (09XXXXXXXXX)</span>
                                <span id="gcashError" class="text-red-500 text-xs hidden">Please enter exactly 11 digits</span>
                            </div>
                        </div>
                        
                        <!-- Card Payment Fields -->
                        <div id="cardFields" class="hidden space-y-4">
                            <!-- Card Number -->
                            <div>
                                <label class="block text-gray-700 font-medium">Card Number</label>
                                <input type="text" 
                                    name="CardNumber" 
                                    id="cardNumberInput"
                                    maxlength="19"
                                    class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 transition-colors" 
                                    placeholder="1234 5678 9012 3456" 
                                    autocomplete="cc-number"
                                    inputmode="numeric" />
                                <span class="text-xs text-gray-500 mt-1">Enter 16-digit card number</span>
                                <span id="cardNumberError" class="text-red-500 text-xs hidden">Please enter exactly 16 digits</span>
                            </div>
                            
                            <div class="grid grid-cols-2 gap-4">
                                <!-- Expiry Date -->
                                <div>
                                    <label class="block text-gray-700 font-medium">Expiry Date</label>
                                    <input type="text" 
                                        name="CardExpiry" 
                                        id="cardExpiryInput"
                                        maxlength="5"
                                        class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 transition-colors" 
                                        placeholder="MM/YY" 
                                        autocomplete="cc-exp"
                                        inputmode="numeric" />
                                    <span class="text-xs text-gray-500 mt-1">MM/YY format</span>
                                    <span id="expiryError" class="text-red-500 text-xs hidden">Please enter valid expiry date</span>
                                </div>
                                
                                <!-- CVV -->
                                <div>
                                    <label class="block text-gray-700 font-medium">CVV</label>
                                    <input type="text" 
                                        name="CardCVV" 
                                        id="cardCvvInput"
                                        maxlength="3"
                                        class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 transition-colors" 
                                        placeholder="123" 
                                        autocomplete="cc-csc"
                                        inputmode="numeric" />
                                    <span class="text-xs text-gray-500 mt-1">3-digit security code</span>
                                    <span id="cvvError" class="text-red-500 text-xs hidden">Please enter exactly 3 digits</span>
                                </div>
                            </div>
                            
                            <!-- Cardholder Name -->
                            <div>
                                <label class="block text-gray-700 font-medium">Cardholder Name</label>
                                <input type="text" 
                                    name="CardholderName" 
                                    id="cardholderNameInput"
                                    class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 transition-colors" 
                                    placeholder="John Doe" 
                                    autocomplete="cc-name" />
                                <span class="text-xs text-gray-500 mt-1">Name as it appears on card</span>
                                <span id="nameError" class="text-red-500 text-xs hidden">Please enter cardholder name</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div> 

            <!-- Right Column: Order Summary -->
            <div class="lg:col-span-1">
                <!-- Order Summary -->
            
                <div class="bg-white rounded-2xl shadow-lg border border-gray-200 p-6 sticky top-6">
                    <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-receipt text-green-600"></i>
                        Order Summary
                    </h2>
                    
                    <!-- Order Type Badge -->
                    <div class="mb-4 p-3 bg-gradient-to-r from-green-50 to-teal-50 border border-green-200 rounded-xl">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium text-gray-700">Order Type:</span>
                            <span class="font-bold text-green-700" id="orderTypeBadge">Delivery</span>
                        </div>
                    </div>

                    <!-- Shipping Address (for Delivery only) -->
                    <div id="shippingAddressDisplay" class="mb-4 p-3 bg-gray-50 border border-gray-200 rounded-xl">
                        <h3 class="text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
                            <i class="fas fa-map-marker-alt text-green-600"></i>
                            Shipping Address
                        </h3>
                        <p class="text-xs text-gray-600" id="summaryAddress">
                            @if (defaultAddress != null)
                            {
                                <span>@defaultAddress.Street, @defaultAddress.Barangay, @defaultAddress.City, @defaultAddress.Province @defaultAddress.ZipCode</span>
                            }
                            else
                            {
                                <span class="text-gray-400">Please enter your address</span>
                            }
                        </p>
                    </div>
                    
                    <!-- Order Items -->
                    <div class="space-y-4 mb-6 max-h-96 overflow-y-auto [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
                        @if (Model.Cart?.CartItems != null && Model.Cart.CartItems.Any())
                        {
                            foreach (var item in Model.Cart.CartItems)
                            {
                                var itemAddOnsTotal = item.CartItemOptions?.Sum(opt => opt.AdditionalPrice) ?? 0m;
                                var itemTotalPrice = item.Quantity * (item.UnitPrice + itemAddOnsTotal);
                                
                                <div class="flex gap-3 py-3 border-b border-gray-100 last:border-b-0">
                                    <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0">
                                        <span class="text-green-600 font-bold text-sm">@item.Quantity</span>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h4 class="font-semibold text-gray-900 text-sm">@item.ProductName</h4>
                                        @if (item.CartItemOptions != null && item.CartItemOptions.Any())
                                        {
                                            <div class="mt-1 text-xs text-gray-600">
                                                @foreach (var opt in item.CartItemOptions)
                                                {
                                                    <div>
                                                        + @opt.OptionName
                                                        @if (opt.AdditionalPrice > 0)
                                                        {
                                                            <span class="text-green-600">(+₱@opt.AdditionalPrice.ToString("F2"))</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="text-right">
                                        <p class="font-semibold text-gray-900 text-sm">₱@itemTotalPrice.ToString("F2")</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-gray-500 text-center py-4">Your cart is empty</p>
                        }
                    </div>

                    <!-- Order Totals -->
                    <div class="space-y-3 pt-4 border-t border-gray-200">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">Subtotal</span>
                            <span class="text-gray-900">₱@subtotal.ToString("F2")</span>
                        </div>
                        <div class="flex justify-between text-sm" id="deliveryFeeRow">
                            <span class="text-gray-600">Delivery Fee</span>
                            <span class="text-gray-900" id="deliveryFeeAmount">₱@deliveryFee.ToString("F2")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.VoucherCode))
                        {
                            <div class="flex justify-between text-sm text-green-600">
                                <span>Voucher Discount</span>
                                <span>-₱0.00</span>
                            </div>
                        }
                        <div class="flex justify-between text-lg font-bold pt-3 border-t border-gray-200">
                            <span class="text-gray-900">Total Amount</span>
                            <span class="text-green-600" id="totalAmount">₱@total.ToString("F2")</span>
                        </div>
                    </div>

                    <!-- Place Order Button -->
                    <button type="submit" 
                            class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-4 px-6 rounded-xl transition-colors flex items-center justify-center gap-2 mt-6 shadow-lg shadow-green-200">
                        <span>Place Order</span>
                    </button>

                    <!-- Security Badge -->
                    <div class="text-center mt-4">
                        <p class="text-xs text-gray-500 flex items-center justify-center gap-1">
                            <i class="fas fa-shield-alt text-green-500"></i>
                            Your payment information is secure and encrypted
                        </p>
                    </div>
                </div>
            </div> <!-- Close right column -->
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey"></script>
    <script src="~/js/maps.js"></script>
    <script src="~/js/place-order.js"></script>
    <script>
        window.checkoutSubtotal = @subtotal;
    </script>
}