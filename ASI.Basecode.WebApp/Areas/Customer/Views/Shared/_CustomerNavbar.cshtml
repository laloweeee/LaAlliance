@using Microsoft.AspNetCore.Http
<!-- Navbar -->
<div id="navbar" class="bg-green-600 w-full transition-colors duration-300 ease-in-out">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex justify-between items-center">
        <!-- Logo -->
        <h1 class="text-white text-2xl font-black">
            LaAlliancé
        </h1>

        <!-- Nav + Login Container -->
        <div class="flex items-center gap-7">
            <!-- Navigation Links (hidden on mobile) -->
            <div class="hidden md:flex items-center gap-7">
                <a href="#"
                   class="relative text-white text-lg font-medium cursor-pointer transition duration-300 ease-in-out hover:text-green-300">
                    Home
                </a>
                <a href="#"
                   class="relative text-white text-lg font-medium cursor-pointer transition duration-300 ease-in-out hover:text-green-300">
                    Menu
                </a>
                <a href="#"
                   class="relative text-white text-lg font-medium cursor-pointer transition duration-300 ease-in-out hover:text-green-300">
                    About
                </a>
            </div>

            <!-- Login Button (always visible) -->
            <a asp-area="" asp-controller="Account" asp-action="SignOutUser" class="text-white bg-green-600 font-bold rounded-md px-6 py-2 transition duration-300 ease-in-out hover:bg-green-200 hover:text-green-600 hover:scale-105 hover:shadow-lg">
                Logout
            </a>
        </div>
    </div>
</div>
