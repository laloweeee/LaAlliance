
@model ASI.Basecode.WebApp.Areas.Customer.Models.ProductModalViewModel

<div class="bg-black/80">
    <div class="flex items-center justify-center min-h-screen">
        <!-- Modal content goes here -->
        <div class="bg-white rounded-lg w-full p-4 max-w-4xl">
            <div class="flex flex-col space-y-2">
                <div class="flex justify-end border-b pb-2">
                    <button class="text-gray-500 hover:text-gray-700" onclick="closeModal()">
                        <i class="fas fa-times fa-lg"></i>
                    </button>
                </div>
                <!-- IMAGE -->
                <div>
                    <img src="@Model.ProductImage" alt="@Model.ProductName" class="w-full h-24 object-cover rounded-lg" />
                </div>
                <!-- DETAILS -->
                <div>
                    <h2 class="text-2xl font-bold text-gray-900 mb-2">@Model.ProductName</h2>
                    <p class="text-gray-700 mb-4">@Model.ProductDescription</p>
                    <div class="flex items-center justify-between">
                        <span class="text-green-600 font-bold text-lg">₱@Model.ProductPrice.ToString("0.00")</span>
                    </div>
                </div>
                <!-- CUSTOMIZATION OPTIONS -->
                <div>
                    <h3 class="text-lg font-semibold mb-2">Customization Options</h3>
                    <div class="space-y-4 max-h-64 overflow-y-auto">
                        <form asp-area="Customer" asp-controller="Home" asp-action="AddToCart" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productID" value="@Model.ProductID" />

                            <!-- Customization Groups -->
                            @if (Model.CustomizationGroups != null && Model.CustomizationGroups.Any())
                            {
                                foreach (var group in Model.CustomizationGroups)
                                {
                                    <div class="mb-6 md:mb-8 pb-6 md:pb-8 border-b border-gray-200 last:border-b-0">
                                        <div class="flex items-center justify-between mb-3 md:mb-4">
                                            <h3 class="text-base md:text-lg font-semibold text-gray-900">
                                                @group.OptionGroupName
                                            </h3>
                                            @if (group.IsRequired)
                                            {
                                                <span class="bg-red-100 text-red-700 text-xs font-semibold px-2 md:px-3 py-1 rounded-full">
                                                    Required
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="bg-gray-100 text-gray-600 text-xs font-semibold px-2 md:px-3 py-1 rounded-full">
                                                    Optional
                                                </span>
                                            }
                                        </div>
                                        
                                        <p class="text-xs md:text-sm text-gray-500 mb-3 md:mb-4">
                                            @if (group.NumberOfChoice == 1)
                                            {
                                                <span>Choose 1 option</span>
                                            }
                                            else
                                            {
                                                <span>Choose up to @group.NumberOfChoice options</span>
                                            }
                                        </p>

                                        <!-- Options List -->
                                        <div class="space-y-2 md:space-y-3">
                                            @foreach (var item in group.ProductOptionItems)
                                            {
                                                <label class="option-label relative flex items-center p-3 md:p-4 bg-gray-50 rounded-xl cursor-pointer transition-all duration-200 border-2 border-transparent hover:border-emerald-200">
                                                    @if (group.NumberOfChoice == 1)
                                                    {
                                                        <input type="radio" 
                                                            name="option_@group.ProductOptionGroupID" 
                                                            value="@item.ProductOptionItemsID"
                                                            data-price="@item.AdditionalPrice"
                                                            class="option-input w-4 h-4 md:w-5 md:h-5 text-emerald-600 focus:ring-emerald-500 focus:ring-2" />
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" 
                                                            name="option_@group.ProductOptionGroupID" 
                                                            value="@item.ProductOptionItemsID"
                                                            data-price="@item.AdditionalPrice"
                                                            class="option-input w-4 h-4 md:w-5 md:h-5 text-emerald-600 rounded focus:ring-emerald-500 focus:ring-2" />
                                                    }
                                                    
                                                    <div class="ml-3 md:ml-4 flex-1">
                                                        <span class="option-text font-medium text-sm md:text-base text-gray-900">
                                                            @item.OptionName
                                                        </span>
                                                    </div>
                                                    
                                                    @if (item.AdditionalPrice > 0)
                                                    {
                                                        <span class="option-price text-emerald-600 font-semibold text-sm md:text-base">
                                                            +₱@item.AdditionalPrice.ToString("F2")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="option-price text-gray-400 text-xs md:text-sm">
                                                            Free
                                                        </span>
                                                    }
                                                </label>
                                            }
                                        </div>
                                    </div>
                                }
                            }

                            <!-- Quantity Selector -->
                            <div class="mb-6 md:mb-8">
                                <label class="block text-base md:text-lg font-semibold text-gray-900 mb-2 md:mb-3">
                                    Quantity
                                </label>
                                <div class="flex items-center gap-3 md:gap-4">
                                    <button type="button" 
                                            onclick="decrementQuantity()"
                                            class="w-10 h-10 md:w-12 md:h-12 flex items-center justify-center bg-gray-100 hover:bg-gray-200 rounded-xl transition-colors">
                                        <i class="fas fa-minus text-gray-600 text-sm"></i>
                                    </button>
                                    <input type="number" 
                                        id="quantity" 
                                        name="quantity" 
                                        value="1" 
                                        min="1" 
                                        max="99"
                                        class="w-16 md:w-20 h-10 md:h-12 text-center text-lg md:text-xl font-bold border-2 border-gray-200 rounded-xl focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200" />
                                    <button type="button" 
                                            onclick="incrementQuantity()"
                                            class="w-10 h-10 md:w-12 md:h-12 flex items-center justify-center bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl transition-colors">
                                        <i class="fas fa-plus text-sm"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Total Price Display -->
                            <div class="bg-emerald-50 rounded-xl p-4 md:p-6 mb-4 md:mb-6">
                                <div class="flex items-center justify-between">
                                    <span class="text-base md:text-lg font-semibold text-gray-700">Total Price</span>
                                    <span id="totalPrice" class="text-2xl md:text-3xl font-bold text-emerald-600">
                                        ₱@Model.ProductPrice.ToString("F2")
                                    </span>
                                </div>
                            </div>

                            <!-- Action Button -->
                            <button type="submit" 
                                    id="addToCartBtn"
                                    class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 md:py-4 px-6 rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl flex items-center justify-center gap-2 text-base md:text-lg">
                                <i class="fas fa-shopping-cart"></i>
                                <span>Add to Cart</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>