@using Microsoft.AspNetCore.Http
<!-- Navbar -->
<div id="navbar" class="bg-green-600 w-full transition-colors duration-300 ease-in-out">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-4 lg:py-6 flex justify-between items-center">
        <!-- Left Section: Title and Address -->
        <div class="flex flex-col md:flex-row md:items-center md:gap-4">
            <!-- Logo/Title -->
            <h1 class="text-white text-2xl font-black">
                LaAlliancé
            </h1>
            
            <!-- Address Display -->
            <div class="flex items-center text-white">
                <i class="fas fa-map-marker-alt mr-2"></i>
                <span id="delivery-address" class="text-sm md:text-base">
                    Loading address...
                </span>
            </div>
        </div>

        <!-- Right Section: Auth and Cart -->
        <div class="flex items-center gap-4">
            @if (User.Identity.IsAuthenticated)
            {
                <!-- Profile Button -->
                <div class="relative group">
                    <button class="flex items-center text-white hover:text-green-300 transition duration-300 ease-in-out">
                        <i class="fas fa-user-circle text-2xl mr-2"></i>
                        <span class="hidden md:inline">@User.Identity.Name</span>
                        <i class="fas fa-chevron-down ml-1"></i>
                    </button>
                    
                    <!-- Profile Dropdown -->
                    <div class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                        <div class="py-2">
                            <a href="#" class="block px-4 py-2 text-gray-800 hover:bg-green-50 hover:text-green-600">
                                My Profile
                            </a>
                            <a href="#" class="block px-4 py-2 text-gray-800 hover:bg-green-50 hover:text-green-600">
                                Order History
                            </a>
                            <hr class="my-1">
                            <a asp-area="" asp-controller="Account" asp-action="SignOutUser" class="block px-4 py-2 text-gray-800 hover:bg-green-50 hover:text-green-600">
                                Logout
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Cart Button -->
                <button id="cart-button" class="relative flex items-center text-white hover:text-green-300 transition duration-300 ease-in-out">
                    <i class="fas fa-shopping-cart text-2xl"></i>
                    <span id="cart-count" class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center">0</span>
                </button>
            }
            else
            {
                <!-- Login Button -->
                <a asp-area="" asp-controller="Account" asp-action="Login" class="text-white bg-green-700 font-bold rounded-md px-6 py-2 transition duration-300 ease-in-out hover:bg-green-200 hover:text-green-600 hover:scale-105 hover:shadow-lg">
                    Login
                </a>

                <!-- Disabled Cart -->
                <button disabled class="relative flex items-center text-gray-400 cursor-not-allowed opacity-50">
                    <i class="fas fa-shopping-cart text-2xl"></i>
                    <span class="absolute -top-2 -right-2 bg-gray-400 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center">0</span>
                </button>
            }
        </div>
    </div>
</div>

<script>
// Function to get cookie value by name
function getCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
    return null;
}

// Function to convert coordinates to address using Google Maps Geocoding API
async function getAddressFromCoordinates(lat, lng) {
    try {
        // You'll need to add your Google Maps API key here
        const apiKey = 'YOUR_GOOGLE_MAPS_API_KEY'; // Replace with your actual API key
        const response = await fetch(`https://maps.googleapis.com/maps/api/geocode/json?latlng=${lat},${lng}&key=${apiKey}`);
        const data = await response.json();
        
        if (data.status === 'OK' && data.results.length > 0) {
            return data.results[0].formatted_address;
        } else {
            return 'Address not found';
        }
    } catch (error) {
        console.error('Error fetching address:', error);
        return 'Error loading address';
    }
}

// Function to load and display address from cookie
async function loadAddressFromCookie() {
    const addressElement = document.getElementById('delivery-address');
    const locationCookie = getCookie('userLocation'); // Adjust cookie name as needed
    
    if (locationCookie) {
        try {
            // Assuming the cookie stores coordinates as "lat,lng" format
            const [lat, lng] = locationCookie.split(',');
            if (lat && lng) {
                const address = await getAddressFromCoordinates(parseFloat(lat), parseFloat(lng));
                addressElement.textContent = address;
            } else {
                addressElement.textContent = 'Invalid location data';
            }
        } catch (error) {
            console.error('Error parsing location cookie:', error);
            addressElement.textContent = 'Error loading address';
        }
    } else {
        addressElement.textContent = 'No delivery address set';
    }
}

// Load address when page loads
document.addEventListener('DOMContentLoaded', loadAddressFromCookie);

// Cart functionality placeholder
document.addEventListener('DOMContentLoaded', function() {
    const cartButton = document.getElementById('cart-button');
    if (cartButton) {
        cartButton.addEventListener('click', function() {
            // Placeholder for cart functionality
            alert('Cart functionality will be implemented here');
        });
    }
});
</script>
