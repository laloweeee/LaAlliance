<div id="topbar" class="px-4 py-3 md:px-6 md:py-4 w-full bg-gradient-to-r from-emerald-700 via-emerald-800 to-emerald-900 shadow-lg">
    <div class="flex items-center justify-between w-full max-w-full">
        <!-- LOGO -->
        <div class="flex flex-row items-center gap-3 group">
            <div class="bg-white rounded-lg p-2 shadow-md transform group-hover:scale-105 transition-all duration-300">
                <img src="~/img/LaAlliance-logo.png" alt="logo" class="h-6 w-auto md:h-10" />
            </div>
            <div>
                <span class="text-xl md:text-3xl text-white font-bold sidebar-logo tracking-wide">LaAlliancé</span>
                <p class="text-xs md:text-sm text-emerald-100 font-medium">Online Delivery</p>
            </div>
        </div>
        
        <!-- LINKS -->
        <div class="flex flex-row items-center gap-2 md:gap-3">
            <!-- MENU (Mobile & Desktop) -->
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" 
               class="group cursor-pointer bg-white/10 hover:bg-white/20 backdrop-blur-sm p-2 md:p-3 rounded-xl hover:scale-105 transition-all duration-300 flex flex-row gap-2 items-center border border-white/20">
                <i class="fa-solid fa-utensils text-white text-md md:text-lg group-hover:rotate-12 transition-transform"></i>
                <h2 class="text-sm text-white hidden md:block font-medium">Menu</h2>
            </a>

            <!-- NOTIFICATIONS with Badge -->
            <div class="relative group cursor-pointer bg-white/10 hover:bg-white/20 backdrop-blur-sm p-2 md:p-3 rounded-xl hover:scale-105 transition-all duration-300 flex flex-row gap-2 items-center border border-white/20">
                <i class="fa-solid fa-bell text-white text-md md:text-lg group-hover:animate-wiggle"></i>
                <h2 class="text-sm text-white hidden lg:block font-medium">Notifications</h2>
                <!-- Notification Badge -->
                <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center animate-pulse shadow-lg">
                    3
                </span>
            </div>

            <!-- CART with Badge -->
            <a asp-area="Customer" asp-controller="Cart" asp-action="Index" 
               class="relative group cursor-pointer bg-white/10 hover:bg-white/20 backdrop-blur-sm p-2 md:p-3 rounded-xl hover:scale-105 transition-all duration-300 flex flex-row gap-2 items-center border border-white/20">
                <i class="fa-solid fa-cart-shopping text-white text-md md:text-lg group-hover:animate-bounce"></i>
                <h2 class="text-sm text-white hidden md:block font-medium">Cart</h2>
                <!-- Cart Badge -->
                <span id="cartBadge" class="absolute -top-1 -right-1 bg-yellow-400 text-emerald-900 text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center shadow-lg">
                    @(ViewBag.CartCount ?? 0)
                </span>
            </a>

            <!-- PROFILE DROPDOWN -->
            <div class="relative">
                <button id="profileBtn" 
                        class="flex flex-row gap-2 items-center cursor-pointer bg-white/10 hover:bg-white/20 backdrop-blur-sm p-2 md:p-3 rounded-xl hover:scale-105 transition-all duration-300 border border-white/20 group">
                    <div class="relative">
                        <i class="fa-solid fa-user text-white text-md md:text-lg"></i>
                        <!-- Online Status Indicator -->
                        <span class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 bg-green-400 rounded-full border-2 border-emerald-800"></span>
                    </div>
                    <h2 class="hidden md:block text-sm text-white font-medium max-w-[100px] truncate">
                        @((ViewBag.UserName ?? "Guest"))
                    </h2>
                    <i id="chevron" class="fa fa-chevron-down text-white text-xs transition-transform duration-300 group-hover:translate-y-0.5"></i>
                </button>

                <!-- Enhanced Dropdown Menu -->
                <div id="dropdownMenu" class="absolute right-0 mt-3 w-56 bg-white rounded-xl shadow-2xl hidden z-50 overflow-hidden border border-gray-100 animate-slideDown">
                    <!-- User Info Header -->
                    <div class="bg-gradient-to-r from-emerald-600 to-emerald-700 px-4 py-3 border-b border-emerald-500">
                        <div class="flex items-center gap-3">
                            <div class="h-10 w-10 bg-white rounded-full flex items-center justify-center shadow-md">
                                <i class="fa-solid fa-user text-emerald-700 text-lg"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-white font-semibold text-sm truncate">@((ViewBag.UserName ?? "Guest"))</p>
                                <p class="text-emerald-100 text-xs">Customer Account</p>
                            </div>
                        </div>
                    </div>

                    <!-- Menu Items -->
                    <div class="py-2">
                        <a href="#" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-emerald-50 transition-colors group">
                            <div class="w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center group-hover:bg-emerald-200 transition-colors">
                                <i class="fa fa-user text-emerald-600 text-sm"></i>
                            </div>
                            <span class="text-sm font-medium">My Profile</span>
                        </a>

                        <a asp-area="Customer" asp-controller="Order" asp-action="Index" 
                           class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-emerald-50 transition-colors group">
                            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                                <i class="fa fa-shopping-bag text-blue-600 text-sm"></i>
                            </div>
                            <span class="text-sm font-medium">My Orders</span>
                        </a>

                        <a href="#" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-emerald-50 transition-colors group">
                            <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center group-hover:bg-purple-200 transition-colors">
                                <i class="fa fa-heart text-purple-600 text-sm"></i>
                            </div>
                            <span class="text-sm font-medium">Favorites</span>
                        </a>

                        <a href="#" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-emerald-50 transition-colors group">
                            <div class="w-8 h-8 bg-orange-100 rounded-lg flex items-center justify-center group-hover:bg-orange-200 transition-colors">
                                <i class="fa fa-cog text-orange-600 text-sm"></i>
                            </div>
                            <span class="text-sm font-medium">Settings</span>
                        </a>

                        <div class="border-t border-gray-100 my-2"></div>

                        <a asp-area="" asp-controller="Account" asp-action="Logout" 
                           class="flex items-center gap-3 px-4 py-3 text-red-600 hover:bg-red-50 transition-colors group">
                            <div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center group-hover:bg-red-200 transition-colors">
                                <i class="fa fa-sign-out text-red-600 text-sm"></i>
                            </div>
                            <span class="text-sm font-medium">Logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Search Bar -->
    <div class="lg:hidden mt-3">
        <div class="relative w-full">
            <input type="text" 
                   id="mobileSearch"
                   placeholder="Search for meals..." 
                   class="w-full px-4 py-2 pl-10 rounded-full bg-white/95 backdrop-blur-sm text-gray-700 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:bg-white transition-all text-sm shadow-md">
            <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-emerald-600 text-sm"></i>
        </div>
    </div>
</div>

<style>
    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes wiggle {
        0%, 100% { transform: rotate(0deg); }
        25% { transform: rotate(-10deg); }
        75% { transform: rotate(10deg); }
    }

    .animate-slideDown {
        animation: slideDown 0.3s ease-out;
    }

    .animate-wiggle:hover {
        animation: wiggle 0.5s ease-in-out;
    }

    /* Smooth badge animations */
    #cartBadge {
        transition: all 0.3s ease;
    }

    #cartBadge:hover {
        transform: scale(1.1);
    }

    /* Backdrop blur support */
    @@supports (backdrop-filter: blur(10px)) {
        .backdrop-blur-sm {
            backdrop-filter: blur(10px);
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const profileBtn = document.getElementById('profileBtn');
        const dropdownMenu = document.getElementById('dropdownMenu');
        const chevron = document.getElementById('chevron');

        // Toggle dropdown on button click
        profileBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isHidden = dropdownMenu.classList.contains('hidden');

            if (isHidden) {
                dropdownMenu.classList.remove('hidden');
                chevron.classList.add('rotate-180');
            } else {
                dropdownMenu.classList.add('hidden');
                chevron.classList.remove('rotate-180');
            }
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
            if (!profileBtn.contains(e.target) && !dropdownMenu.contains(e.target)) {
                dropdownMenu.classList.add('hidden');
                chevron.classList.remove('rotate-180');
            }
        });

        // Close dropdown when clicking a link
        dropdownMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                dropdownMenu.classList.add('hidden');
                chevron.classList.remove('rotate-180');
            });
        });

        // Update cart badge count
        updateCartBadge();

        // Search functionality
        const searchButtons = document.querySelectorAll('button');
        searchButtons.forEach(btn => {
            if (btn.textContent.trim() === 'Search') {
                btn.addEventListener('click', performSearch);
            }
        });

        // Enter key search for desktop
        document.getElementById('topbarSearch')?.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                performSearch();
            }
        });

        // Enter key search for mobile
        document.getElementById('mobileSearch')?.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                performSearch();
            }
        });

        function performSearch() {
            const searchQuery = document.getElementById('topbarSearch')?.value || 
                              document.getElementById('mobileSearch')?.value;
            if (searchQuery && searchQuery.trim()) {
                // Implement your search logic here
                console.log('Searching for:', searchQuery);
                // Example: window.location.href = `/Customer/Home/Search?q=${encodeURIComponent(searchQuery)}`;
            }
        }

        function updateCartBadge() {
            // Check if we're on a page with cart functionality
            if (typeof window.updateCartBadge === 'function') {
                window.updateCartBadge();
            } else {
                // Fallback: make direct AJAX call
                fetch('/Customer/Cart/GetCartCount')
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            const badge = document.getElementById('cartBadge');
                            badge.textContent = data.count;
                            if (data.count > 0) {
                                badge.classList.remove('hidden');
                            } else {
                                badge.textContent = '0';
                            }
                        }
                    })
                    .catch(error => console.log('Cart count fetch failed:', error));
            }
        }

        // Refresh cart badge every 30 seconds
        setInterval(updateCartBadge, 30000);
    });
</script>