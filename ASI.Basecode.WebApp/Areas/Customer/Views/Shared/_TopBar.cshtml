<div id="topbar" class="px-6 py-3 w-full bg-green shadow-md border-b border-gray-200">
    <div class="flex items-center justify-between w-full max-w-full">
        <!-- LOGO -->
        <div class="flex items-center gap-3">
            <img src="~/img/laAlliance Logo 2.png" alt="LaAlliancé Logo" class="h-10 w-auto filter" />
            <div class="flex flex-col">
                <span class="text-xl font-bold text-gray-800 tracking-tight">LaAlliancé</span>
                <p class="text-xs text-gray-600">Premium Food Delivery</p>
            </div>
        </div>
        
        <!-- NAVIGATION LINKS -->
        <div class="flex items-center gap-2">
            @if (User.IsInRole("Restaurant"))
            {
                <!-- RESTAURANT NAVIGATION -->
                <a asp-area="Restaurant" asp-controller="Dashboard" asp-action="Index" 
                   class="flex items-center gap-2 px-3 py-2 text-gray-600 hover:text-green-600 hover:bg-green-50 rounded-lg transition-all duration-200 font-medium group border border-transparent hover:border-green-200">
                    <i class="fa-solid fa-tachometer-alt text-base"></i>
                    <span class="text-sm font-semibold">Dashboard</span>
                </a>

                <a asp-area="Restaurant" asp-controller="MenuBook" asp-action="Index" 
                   class="flex items-center gap-2 px-3 py-2 text-gray-600 hover:text-green-600 hover:bg-green-50 rounded-lg transition-all duration-200 font-medium group border border-transparent hover:border-green-200">
                    <i class="fa-solid fa-book text-base"></i>
                    <span class="text-sm font-semibold">Menu Book</span>
                </a>

                <a asp-area="Restaurant" asp-controller="Restaurant" asp-action="Index" 
                   class="flex items-center gap-2 px-3 py-2 text-gray-600 hover:text-green-600 hover:bg-green-50 rounded-lg transition-all duration-200 font-medium group border border-transparent hover:border-green-200">
                    <i class="fa-solid fa-store text-base"></i>
                    <span class="text-sm font-semibold">Restaurant</span>
                </a>

                <a asp-area="Restaurant" asp-controller="Promotions" asp-action="Index" 
                   class="flex items-center gap-2 px-3 py-2 text-gray-600 hover:text-green-600 hover:bg-green-50 rounded-lg transition-all duration-200 font-medium group border border-transparent hover:border-green-200">
                    <i class="fa-solid fa-tags text-base"></i>
                    <span class="text-sm font-semibold">Promotions</span>
                </a>

                <a asp-area="Restaurant" asp-controller="Staff" asp-action="Index" 
                   class="flex items-center gap-2 px-3 py-2 text-gray-600 hover:text-green-600 hover:bg-green-50 rounded-lg transition-all duration-200 font-medium group border border-transparent hover:border-green-200">
                    <i class="fa-solid fa-users text-base"></i>
                    <span class="text-sm font-semibold">Staff</span>
                </a>
            }
            else
            {
                <!-- CUSTOMER NAVIGATION -->
                <a asp-area="Customer" asp-controller="Home" asp-action="Index" 
                   class="flex items-center gap-2 px-3 py-2 text-gray-600 hover:text-green-600 hover:bg-green-50 rounded-lg transition-all duration-200 font-medium group border border-transparent hover:border-green-200">
                    <i class="fa-solid fa-utensils text-base"></i>
                    <span class="text-sm font-semibold">Menu</span>
                </a>

                <a asp-area="Customer" asp-controller="Order" asp-action="Index" 
                   class="flex items-center gap-2 px-3 py-2 text-gray-600 hover:text-green-600 hover:bg-green-50 rounded-lg transition-all duration-200 font-medium group border border-transparent hover:border-green-200">
                    <i class="fa-solid fa-clock text-base"></i>
                    <span class="text-sm font-semibold hidden lg:block">Activity</span>
                </a>

                <a asp-area="Customer" asp-controller="Cart" asp-action="Index" 
                   class="flex items-center gap-2 px-3 py-2 text-gray-600 hover:text-green-600 hover:bg-green-50 rounded-lg transition-all duration-200 font-medium group relative border border-transparent hover:border-green-200">
                    <i class="fa-solid fa-shopping-bag text-base"></i>
                    <span class="text-sm font-semibold hidden lg:block">Cart</span>
                    <span id="cartBadge" class="absolute -top-1 -right-1 bg-green-600 text-white text-xs font-bold rounded-full h-4 w-4 flex items-center justify-center shadow-sm">
                        @(ViewBag.CartCount ?? 0)
                    </span>
                </a>
            }

            <!-- PROFILE DROPDOWN -->
            <div class="relative">
                <button id="profileBtn" 
                        class="flex items-center gap-2 px-3 py-2 text-gray-600 hover:bg-green-50 rounded-lg transition-all duration-200 border border-gray-300 hover:border-green-300">
                    <div class="flex items-center gap-2">
                        <div class="w-7 h-7 bg-gradient-to-br from-green-500 to-green-600 rounded-full flex items-center justify-center shadow-sm">
                            <i class="fa-solid fa-user text-white text-xs"></i>
                        </div>
                        <div class="text-left hidden lg:block">
                            <p class="text-sm font-semibold text-gray-800 truncate max-w-[100px]">
                                @((ViewBag.UserName ?? "Guest"))
                            </p>
                            <p class="text-xs text-gray-500">@(User.IsInRole("Restaurant") ? "Admin Restaurant" : "Customer")</p>
                        </div>
                    </div>
                    <i id="chevron" class="fa fa-chevron-down text-gray-500 text-xs transition-transform duration-200 ml-1"></i>
                </button>

                <!-- Dropdown Menu -->
                <div id="dropdownMenu" class="absolute right-0 mt-2 w-56 bg-white rounded-lg shadow-xl border border-gray-200 hidden z-50 overflow-hidden">
                    <!-- User Header -->
                    <div class="px-4 py-3 bg-gradient-to-r from-green-50 to-green-100 border-b border-green-200">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 bg-gradient-to-br from-green-500 to-green-600 rounded-full flex items-center justify-center shadow-sm">
                                <i class="fa-solid fa-user text-white text-sm"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-bold text-gray-800 truncate">@((ViewBag.UserName ?? "Guest"))</p>
                                <p class="text-xs text-gray-600 truncate">customer@laalliance.com</p>
                            </div>
                        </div>
                    </div>

                    <!-- Menu Items -->
                    <div class="py-2">
                        @if (User.IsInRole("Restaurant"))
                        {
                            <a asp-area="Restaurant" asp-controller="User" asp-action="Profile" 
                                class="flex items-center gap-3 px-4 py-2.5 text-gray-700 hover:bg-green-50 transition-colors group border-l-2 border-transparent hover:border-green-500">
                                <div class="w-7 h-7 bg-green-100 rounded flex items-center justify-center">
                                    <i class="fa fa-user text-green-600 text-xs"></i>
                                </div>
                                <span class="text-sm font-medium">Profile</span>
                            </a>
                        }
                        else
                        {
                            <a asp-area="Customer" asp-controller="Account" asp-action="Index" 
                                class="flex items-center gap-3 px-4 py-2.5 text-gray-700 hover:bg-green-50 transition-colors group border-l-2 border-transparent hover:border-green-500">
                                <div class="w-7 h-7 bg-green-100 rounded flex items-center justify-center">
                                    <i class="fa fa-user text-green-600 text-xs"></i>
                                </div>
                                <span class="text-sm font-medium">Profile</span>
                            </a>

                            <!-- Keep Favorites in dropdown too for easy access -->
                            <a href="@Url.Action("Index", "Favorites", new { area = "Customer" })" 
                                class="flex items-center gap-3 px-4 py-2.5 text-gray-700 hover:bg-rose-50 transition-colors group border-l-2 border-transparent hover:border-rose-500">
                                <div class="w-7 h-7 bg-rose-100 rounded flex items-center justify-center">
                                    <i class="fas fa-heart text-rose-600 text-xs"></i>
                                </div>
                                <span class="text-sm font-medium">Favorites</span>
                                @if (ViewBag.FavoriteCount > 0)
                                {
                                    <span class="favorite-count bg-rose-500 text-white text-xs rounded-full px-2 py-1 ml-auto">
                                        @ViewBag.FavoriteCount
                                    </span>
                                }
                            </a>
                        }

                        <div class="border-t border-gray-200 my-1"></div>

                        <a asp-area="" asp-controller="Account" asp-action="Logout" 
                        class="flex items-center gap-3 px-4 py-2.5 text-red-600 hover:bg-red-50 transition-colors group border-l-2 border-transparent hover:border-red-500">
                            <div class="w-7 h-7 bg-red-100 rounded flex items-center justify-center">
                                <i class="fa-solid fa-arrow-right-from-bracket text-red-600 text-xs"></i>
                            </div>
                            <span class="text-sm font-medium">Logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Search Bar -->
    <div class="lg:hidden mt-3">
        <div class="relative w-full max-w-md mx-auto">
            <input type="text" 
                   id="mobileSearch"
                   placeholder="Search restaurants or dishes..." 
                   class="w-full px-4 py-2.5 pl-10 rounded-lg bg-gray-50 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-green-500 focus:bg-white transition-all text-sm border border-gray-300">
            <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const profileBtn = document.getElementById('profileBtn');
        const dropdownMenu = document.getElementById('dropdownMenu');
        const chevron = document.getElementById('chevron');

        // Toggle dropdown
        profileBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            dropdownMenu.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', () => {
            dropdownMenu.classList.add('hidden');
            chevron.classList.remove('rotate-180');
        });

        // Prevent dropdown close when clicking inside
        dropdownMenu.addEventListener('click', (e) => {
            e.stopPropagation();
        });

        // Search functionality
        const mobileSearch = document.getElementById('mobileSearch');
        if (mobileSearch) {
            mobileSearch.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    const searchQuery = this.value.trim();
                    if (searchQuery) {
                        // Implement search logic
                        console.log('Searching for:', searchQuery);
                    }
                }
            });
        }
    });
</script>