@model ASI.Basecode.WebApp.Models.OrderTrackingViewModel 

@{
    ViewData["Title"] = "Order Tracking";
}

<!-- Orders Section -->
<section id="ordersSection">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <h2 class="text-3xl font-bold mb-8 text-gray-800">Order Tracking</h2>
       
        <!-- Current Order -->
        @if (Model.CurrentOrder != null)
        {
            <div id="currentOrder" class="bg-white rounded-xl shadow-sm p-6 mb-8">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-xl font-semibold">Order #@Model.CurrentOrder.OrderNumber</h3>
                    <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium">@Model.CurrentOrder.Status</span>
                </div>
               
                <!-- Order Progress -->
                <div class="mb-6">
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-sm font-medium text-gray-700">Order Progress</span>
                        <span class="text-sm text-gray-500">ETA: @Model.CurrentOrder.ETA</span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div id="orderProgress" class="bg-green-600 h-2 rounded-full" style="width: @(Model.CurrentOrder.ProgressPercentage)%"></div>
                    </div>
                </div>
               
                <!-- Order Steps -->
                <div class="space-y-4">
                    @foreach (var step in Model.CurrentOrder.OrderSteps)
                    {
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 @(step.IsCompleted ? "bg-green-600" : "bg-gray-300") rounded-full flex items-center justify-center">
                                <i class="@step.IconClass @(step.IsCompleted ? "text-white" : "text-gray-500") text-sm"></i>
                            </div>
                            <div>
                                <p class="font-medium @(step.IsCompleted ? "text-gray-800" : "text-gray-500")">@step.StepName</p>
                                <p class="text-sm @(step.IsCompleted ? "text-gray-500" : "text-gray-400")">@step.Timestamp</p>
                            </div>
                        </div>
                    }
                </div>
               
                <!-- Live Tracking Map -->
                @if (Model.CurrentOrder.DeliveryLocation?.Latitude != 0 && Model.CurrentOrder.DeliveryLocation?.Longitude != 0)
                {
                    <div class="mt-6 space-y-4">
                        <h4 class="font-semibold text-gray-800">Live Delivery Tracking</h4>
                        <div id="orderTrackingMap"
                             data-delivery-lat="@Model.CurrentOrder.DeliveryLocation.Latitude"
                             data-delivery-lng="@Model.CurrentOrder.DeliveryLocation.Longitude"
                             data-delivery-address="@Model.CurrentOrder.DeliveryLocation.Address"
                             data-restaurant-lat="@Model.CurrentOrder.RestaurantLocation?.Latitude"
                             data-restaurant-lng="@Model.CurrentOrder.RestaurantLocation?.Longitude"
                             data-restaurant-address="@Model.CurrentOrder.RestaurantLocation?.Address"
                             data-driver-lat="@Model.CurrentOrder.DriverLocation?.Latitude"
                             data-driver-lng="@Model.CurrentOrder.DriverLocation?.Longitude"
                             class="w-full h-96 rounded-xl border-2 border-gray-200 shadow-inner">
                        </div>
                        <div class="flex items-center gap-2 text-sm text-gray-600">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span>Real-time tracking • Delivery to: @Model.CurrentOrder.DeliveryLocation.Address</span>
                        </div>
                        
                        <!-- Cancel Order Button -->
                        <div class="flex justify-end pt-4">
                            <button id="cancelOrderBtn" 
                                    type="button" 
                                    class="bg-red-500 hover:bg-red-700 text-white font-medium py-2 px-6 rounded-lg transition duration-200 ease-in-out transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-opacity-50">
                                <i class="fas fa-times-circle mr-2"></i>
                                Cancel Order
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="mt-6 bg-gray-100 rounded-lg h-48 flex items-center justify-center">
                        <div class="text-center">
                            <i class="fas fa-map-marked-alt text-4xl text-gray-400 mb-2"></i>
                            <p class="text-gray-500">Live tracking map would appear here</p>
                            <p class="text-sm text-gray-400 mt-1">Location data not available</p>
                        </div>
                    </div>
                    
                    <!-- Cancel Order Button (for when map is not available) -->
                    <div class="flex justify-end pt-4">
                        <button id="cancelOrderBtn" 
                                type="button" 
                                class="bg-red-500 hover:bg-red-700 text-white font-medium py-2 px-6 rounded-lg transition duration-200 ease-in-out transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-opacity-50">
                            <i class="fas fa-times-circle mr-2"></i>
                            Cancel Order
                        </button>
                    </div>
                }
            </div>
        }
       
    </div>
</section>

@section Scripts {
    @if (Model.CurrentOrder?.DeliveryLocation?.Latitude != 0 && Model.CurrentOrder?.DeliveryLocation?.Longitude != 0)
    {
        <script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey"></script>
        <script src="~/js/order-tracking-map.js"></script>
    }
    
}